From: Chokri Hammedi <52697989+blue0x1@users.noreply.github.com>
Subject: [PATCH] debug: log every 16th flip with its time

With the GPU memory log on, every 16th flip is logged with the seconds since
the first one, to see how many frames a game presents. Not for a release.

diff --git a/src/graphics/guest_gpu/graphicsRun.cpp b/src/graphics/guest_gpu/graphicsRun.cpp
index adc958574684506097c7e498edc391f1230c19c4..96e3fb25943ced0e387af0c0477802a484ad1337 100644
--- a/src/graphics/guest_gpu/graphicsRun.cpp
+++ b/src/graphics/guest_gpu/graphicsRun.cpp
@@ -9,6 +9,7 @@
 #include "graphics/guest_gpu/command_processor/commandProcessor.h"
 #include "graphics/guest_gpu/command_processor/pm4Dispatch.h"
 #include "graphics/guest_gpu/hardwareContext.h"
+#include "graphics/host_gpu/graphicContext.h"
 #include "graphics/guest_gpu/pm4.h"
 #include "graphics/host_gpu/renderer/debug.h"
 #include "graphics/host_gpu/renderer/render.h"
@@ -23,6 +24,7 @@
 #include <algorithm>
 #include <array>
 #include <atomic>
+#include <chrono>
 #include <cstdio>
 #include <deque>
 #include <memory>
@@ -31,6 +33,8 @@
 #include <thread>
 #include <vector>
 
+#include <fmt/format.h>
+
 namespace Libs::Graphics {
 
 static thread_local Pm4Execution* g_current_execution = nullptr;
@@ -1101,6 +1105,18 @@ void CommandProcessor::Flip(int handle, int index, int flip_mode, int64_t flip_a
 
 void CommandProcessor::NoteFlipForGc() {
 	auto& gpu = m_renderer.GetGpu();
+	if (GraphicContext::GpuMemoryLogEnabled()) {
+		static uint64_t   flips = 0;
+		static const auto start = std::chrono::steady_clock::now();
+		if ((++flips & 15u) == 1u) {
+			const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+			                    std::chrono::steady_clock::now() - start)
+			                    .count();
+			Log::WriteToConsoleAndLog(fmt::format("Flip {} at {:.1f} s (suspend point since last: {})\n",
+			                                      flips, static_cast<double>(ms) / 1000.0,
+			                                      gpu.m_suspend_since_flip));
+		}
+	}
 	if (!gpu.m_suspend_since_flip) {
 		gpu.m_flip_gc_pending = true;
 	}
