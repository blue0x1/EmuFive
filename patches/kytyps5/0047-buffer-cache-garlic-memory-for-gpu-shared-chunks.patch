 		g_direct_cache->WaitDirectWrites(vaddr, size);
 	}
 }
@@ -1004,6 +1006,111 @@ void BufferCache::InitDirectMemory() {
 	g_direct_cache = this;
 	Log::WriteToConsoleAndLog(fmt::format("GPU-shared memory: on, type {}, page {} KB\n",
 	                                      m_direct_type, m_direct_page >> 10u));
+
+	// EmuFive Garlic memory (KYTY_GARLIC_MEMORY=1): Sony's GPU driver maps GPU data with
+	// non-snooped page entries (the Garlic bus); only Onion memory snoops the CPU caches.
+	// Chunks the game allocated with a Garlic type (KYTY_GARLIC_TYPES, default 3 =
+	// WC_GARLIC) take a write-combined type here instead of the cached one. The game already
+	// expects write-combined CPU access there.
+	const char* garlic = std::getenv("KYTY_GARLIC_MEMORY");
+	if (garlic == nullptr || std::strcmp(garlic, "1") != 0) {
+		return;
+	}
+	const char* list = std::getenv("KYTY_GARLIC_TYPES");
+	for (const char* p = list != nullptr ? list : "3"; *p != '\0';) {
+		char*      end   = nullptr;
+		const long value = std::strtol(p, &end, 0);
+		if (end == p) {
+			++p;
+			continue;
+		}
+		m_garlic_guest_types.push_back(static_cast<int>(value));
+		p = end;
+	}
+	const auto host = vk::MemoryPropertyFlagBits::eHostVisible |
+	                  vk::MemoryPropertyFlagBits::eHostCoherent;
+	for (uint32_t i = 0; i < types.memoryTypeCount; i++) {
+		const auto flags = types.memoryTypes[i].propertyFlags;
+		if ((requirements.memoryTypeBits & (1u << i)) != 0 && (flags & host) == host &&
+		    !(flags & vk::MemoryPropertyFlagBits::eHostCached) &&
+		    !(flags & vk::MemoryPropertyFlagBits::eDeviceLocal)) {
+			m_garlic_type = i;
+			break;
+		}
+	}
+	std::string names;
+	for (const int type: m_garlic_guest_types) {
+		names += fmt::format("{}{}", names.empty() ? "" : ",", type);
+	}
+	Log::WriteToConsoleAndLog(
+	    m_garlic_type == UINT32_MAX || m_garlic_guest_types.empty()
+	        ? std::string("Garlic memory: off (no write-combined memory type)\n")
+	        : fmt::format("Garlic memory: on, type {}, guest types {}\n", m_garlic_type, names));
+	if (m_garlic_guest_types.empty()) {
+		m_garlic_type = UINT32_MAX;
+	}
+}
+
+// The Vulkan memory type for a new chunk. Logs each guest memory type the first time a chunk
+// of it moves, so a run shows which types a game uses.
+uint32_t BufferCache::DirectChunkType(uint64_t chunk, bool* busy) {
+	*busy = false;
+	const int guest = LibKernel::Memory::BackingChunkMemoryType(chunk, busy);
+	if (*busy) {
+		// Without Garlic memory the type only feeds the log: do not hold the chunk back.
+		*busy = m_garlic_type != UINT32_MAX;
+		return m_direct_type;
+	}
+	if (m_seen_guest_types.insert(guest).second) {
+		Log::WriteToConsoleAndLog(fmt::format(
+		    "GPU-shared memory: first chunk of guest memory type {} (chunk {})\n", guest, chunk));
+	}
+	if (m_garlic_type == UINT32_MAX || guest < 0 || m_cpu_read_chunks.contains(chunk) ||
+	    std::find(m_garlic_guest_types.begin(), m_garlic_guest_types.end(), guest) ==
+	        m_garlic_guest_types.end()) {
+		return m_direct_type;
+	}
+	return m_garlic_type;
+}
+
+bool BufferCache::IsGarlicChunkAt(uint64_t vaddr, uint64_t size) {
+	if (m_garlic_chunks.empty()) {
+		return false;
+	}
+	uint64_t backing = 0;
+	if (!LibKernel::Memory::GetLinearBacking(vaddr, size, &backing)) {
+		return false;
+	}
+	const auto chunk_size = LibKernel::Memory::GpuSharedChunkSize();
+	for (auto chunk = backing / chunk_size; chunk <= (backing + size - 1) / chunk_size; ++chunk) {
+		if (m_garlic_chunks.contains(chunk)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+void BufferCache::NoteCpuRead(uint64_t vaddr, uint64_t size) {
+	if (m_garlic_type == UINT32_MAX || size == 0) {
+		return;
+	}
+	const auto chunk_size = LibKernel::Memory::GpuSharedChunkSize();
+	// Command buffers are small; one look per 1 MB and the last byte finds their chunks.
+	constexpr uint64_t Step = 1024 * 1024;
+	for (uint64_t done = 0;; done = std::min(done + Step, size - 1)) {
+		uint64_t backing = 0;
+		if (LibKernel::Memory::GetLinearBacking(vaddr + done, 1, &backing)) {
+			const auto chunk = backing / chunk_size;
+			if (m_cpu_read_chunks.insert(chunk).second && m_garlic_chunks.contains(chunk)) {
+				Log::WriteToConsoleAndLog(fmt::format(
+				    "Garlic memory: chunk {} holds command buffers (CPU reads are slower)\n",
+				    chunk));
+			}
+		}
+		if (done == size - 1) {
+			break;
+		}
+	}
 }
 
 // EmuFive: a new GPU-shared chunk moves 32 MB of guest memory into GTT, where it stays pinned for
