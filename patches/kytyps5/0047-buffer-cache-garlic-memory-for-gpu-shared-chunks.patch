index 16ca9bf3ec3f890d09ca68a25d424159b1192ba6..d3ae6f35f2084ad2991df6b6987ad410d407266a 100644
--- a/src/kernel/memory.cpp
+++ b/src/kernel/memory.cpp
@@ -899,6 +899,40 @@ uint64_t GpuSharedChunkSize() {
 	return kGpuSharedChunk;
 }
 
+int BackingChunkMemoryType(uint64_t chunk, bool* busy) {
+	*busy = false;
+	std::unique_lock operation(g_memory_operation_mutex, std::try_to_lock);
+	if (!operation.owns_lock()) {
+		*busy = true;
+		return -1;
+	}
+	if (g_physical_memory == nullptr || chunk >= PhysicalMemory::Size() / kGpuSharedChunk) {
+		return -1;
+	}
+	const uint64_t begin   = chunk * kGpuSharedChunk;
+	const uint64_t end     = begin + kGpuSharedChunk;
+	const auto&    blocks  = g_physical_memory->GetPhysicalBlocks();
+	int            type    = -1;
+	uint64_t       covered = begin;
+	auto           it      = blocks.upper_bound(begin);
+	if (it != blocks.begin()) {
+		--it;
+	}
+	for (; it != blocks.end() && it->first < end && covered < end; ++it) {
+		const auto& block     = it->second;
+		const auto  block_end = block.start_addr + block.size;
+		if (block_end <= covered) {
+			continue;
+		}
+		if (block.start_addr > covered || (type != -1 && type != block.memory_type)) {
+			return -1;
+		}
+		type    = block.memory_type;
+		covered = block_end;
+	}
+	return covered >= end ? type : -1;
+}
