-	if (IsRegionGpuModified(vaddr, size)) {
+	// EmuFive Garlic memory: CPU reads of write-combined memory are slow; the GPU copies it.
+	if (IsRegionGpuModified(vaddr, size) || IsGarlicChunkAt(vaddr, size)) {
 		return ObtainBuffer(vaddr, size, false, false);
 	}
 
@@ -937,6 +938,7 @@ void BufferCache::SynchronizeBda(const RangeSet& mapped) {
 
 void WaitGpuWritesTo(uint64_t vaddr, uint64_t size) {
 	if (g_direct_cache != nullptr) {
