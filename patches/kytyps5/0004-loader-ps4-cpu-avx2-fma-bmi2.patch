+// SPDX-License-Identifier: GPL-2.0-or-later
+// Runs PS5 guest code on CPUs without AVX2, FMA and BMI2, such as the PS4's AMD Jaguar.
+
+#ifndef KYTY_LOADER_JAGUAR_COMPAT_H_
+#define KYTY_LOADER_JAGUAR_COMPAT_H_
+
+#include <Zydis/Zydis.h>
+#include <cstdint>
+
+namespace Xbyak {
+class CodeGenerator;
+} // namespace Xbyak
+
+namespace Loader::JaguarCompat {
+
+// True when the host lacks AVX2, FMA or BMI2, so guest code that uses them must be rewritten.
+// The environment variable KYTY_JAGUAR_COMPAT=1 turns it on anyway (to test on a newer CPU),
+// KYTY_JAGUAR_COMPAT=0 turns it off.
+bool Enabled();
+
+// KYTY_JAGUAR_COMPAT=trap (for testing on a newer CPU): instead of rewriting AVX2/FMA/BMI2
+// instructions at load time, make them fault, so that every one goes through the run-time path.
+bool TrapTest();
+
+// Whether the instruction needs AVX2, FMA or BMI2.
+bool IsMissing(const ZydisDecodedInstruction& instruction);
+
+// Appends host code that has the same effect as the guest instruction at `address`: the same
+// registers, memory and (when `flags_live`) RFLAGS afterwards. It keeps the 128-byte red zone
+// below RSP intact and falls through at the end; the caller adds the jump back. Returns false
+// when the instruction or this form of it is not supported; the generator then holds partial
+// code that the caller must roll back.
+bool Generate(const ZydisDecodedInstruction& instruction, const ZydisDecodedOperand* operands,
+              uint64_t address, Xbyak::CodeGenerator& generator, bool flags_live);
+
+} // namespace Loader::JaguarCompat
+
+#endif /* KYTY_LOADER_JAGUAR_COMPAT_H_ */
