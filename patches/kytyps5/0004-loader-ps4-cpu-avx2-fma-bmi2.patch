+static u64& GuestRip(void* native_context) {
+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+	return reinterpret_cast<u64&>(static_cast<PCONTEXT>(native_context)->Rip);
+#elif defined(__APPLE__)
+	return reinterpret_cast<u64&>(static_cast<ucontext_t*>(native_context)->uc_mcontext->__ss.__rip);
+#else
+	return reinterpret_cast<u64&>(static_cast<ucontext_t*>(native_context)->uc_mcontext.gregs[REG_RIP]);
+#endif
+}
+
+bool RedirectJaguarInstruction(void* native_context) {
+	if (native_context == nullptr || !JaguarCompat::Enabled()) {
+		return false;
+	}
+	u64&  rip    = GuestRip(native_context);
+	auto* module = GetContainingModule(reinterpret_cast<void*>(rip));
+	if (module == nullptr || module->fallback_size == 0) {
+		return false;
+	}
+	static std::mutex fallback_mutex;
+	static u64        hits = 0;
+	std::lock_guard   lock {fallback_mutex};
+	// Sites shorter than a jump keep faulting; report how often, so slow spots show in the log.
+	if (++hits % 1000000 == 0) {
+		std::printf("PS4 CPU compatibility: %" PRIu64 " run-time replacements so far\n", hits);
+	}
+	if (const auto known = module->fallback_sites.find(rip); known != module->fallback_sites.end()) {
+		rip = reinterpret_cast<u64>(known->second);
+		return true;
+	}
+
+	ZydisDecodedInstruction                                  instruction {};
+	std::array<ZydisDecodedOperand, ZYDIS_MAX_OPERAND_COUNT> operands {};
+	const void* bytes     = reinterpret_cast<const void*>(rip);
+	u64         available = std::min<u64>(ZYDIS_MAX_INSTRUCTION_LENGTH,
+	                                      reinterpret_cast<u64>(module->end) - rip);
+	if (const auto original = module->trap_originals.find(rip);
+	    original != module->trap_originals.end()) {
+		bytes     = original->second.data();
+		available = original->second.size();
+	}
+	if (!ZYAN_SUCCESS(ZydisDecoderDecodeFull(&GetDecoder(), bytes, available, &instruction,
+	                                         operands.data())) ||
+	    !JaguarCompat::IsMissing(instruction)) {
+		return false;
+	}
+
+	auto&        generator = module->fallback_gen;
+	const size_t begin     = generator.getSize();
+	Xbyak::ClearError();
+	const bool generated = JaguarCompat::Generate(instruction, operands.data(), rip, generator,
+	                                              /*flags_live=*/true);
+	if (generated && Xbyak::GetError() == 0) {
+		generator.jmp(reinterpret_cast<void*>(rip + instruction.length));
+	}
+	if (!generated || Xbyak::GetError() != 0) {
+		generator.reset();
+		generator.setSize(begin);
+		std::printf("PS4 CPU compatibility: no replacement for %s at %p\n",
+		            ZydisMnemonicGetString(instruction.mnemonic), reinterpret_cast<void*>(rip));
+		return false;
+	}
+	const u8* code = generator.getCode() + begin;
+	Common::VirtualMemory::FlushInstructionCache(reinterpret_cast<u64>(code),
+	                                             generator.getSize() - begin);
+	module->fallback_sites.emplace(rip, code);
+
+	// A site of 5 bytes or more gets a jump to its replacement, written with one atomic store
+	// (other threads may be running this code), so it stops faulting.
+	bool       jumps = false;
+	const s64  rel   = reinterpret_cast<s64>(code) - static_cast<s64>(rip + NearJumpSize);
+	if (instruction.length >= NearJumpSize && rel >= INT32_MIN && rel <= INT32_MAX) {
+		std::array<u8, NearJumpSize> jump {0xe9};
+		const auto                   rel32 = static_cast<s32>(rel);
+		std::memcpy(jump.data() + 1, &rel32, sizeof(rel32));
+		const u64 qword = rip & ~u64 {7};
+		const u64 oword = rip & ~u64 {15};
+		if (rip + NearJumpSize <= qword + 8) {
+			auto*     target   = reinterpret_cast<u64*>(qword);
+			const u64 expected = __atomic_load_n(target, __ATOMIC_ACQUIRE);
+			u64       desired  = expected;
+			std::memcpy(reinterpret_cast<u8*>(&desired) + (rip - qword), jump.data(), jump.size());
+			u64 compare = expected;
+			jumps = __atomic_compare_exchange_n(target, &compare, desired, false, __ATOMIC_ACQ_REL,
+			                                    __ATOMIC_ACQUIRE);
+		} else if (rip + NearJumpSize <= oword + 16) {
+			auto*          target   = reinterpret_cast<unsigned __int128*>(oword);
+			unsigned __int128 expected = 0;
+			std::memcpy(&expected, target, sizeof(expected));
+			unsigned __int128 desired = expected;
+			std::memcpy(reinterpret_cast<u8*>(&desired) + (rip - oword), jump.data(), jump.size());
+			jumps = __sync_bool_compare_and_swap(target, expected, desired);
+		}
+		if (jumps) {
+			Common::VirtualMemory::FlushInstructionCache(rip, NearJumpSize);
+		}
+	}
+	if (module->fallback_sites.size() <= 32) {
+		std::printf("PS4 CPU compatibility: %s at %p replaced at run time%s\n",
+		            ZydisMnemonicGetString(instruction.mnemonic), reinterpret_cast<void*>(rip),
+		            jumps ? "" : " (short: faults each time)");
+	}
+	rip = reinterpret_cast<u64>(code);
+	return true;
+}
