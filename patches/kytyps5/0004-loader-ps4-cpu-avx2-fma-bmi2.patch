+// Whether the status flags as they are after `site` are read before being set again. Calls and
+// returns end the search (no flags are passed through them); anything not followed is live.
+bool FlagsLiveAfter(const DecodedFunction& function, const DecodedCodeInstruction& site) {
+	constexpr ZydisAccessedFlagsMask StatusFlags = ZYDIS_CPUFLAG_CF | ZYDIS_CPUFLAG_PF |
+	                                               ZYDIS_CPUFLAG_AF | ZYDIS_CPUFLAG_ZF |
+	                                               ZYDIS_CPUFLAG_SF | ZYDIS_CPUFLAG_OF;
+	ZydisAccessedFlagsMask pending = StatusFlags;
+	uintptr_t              address = site.address + site.instruction.length;
+	for (int count = 0; count < 64; ++count) {
+		const auto next = function.instructions.find(address);
+		if (next == function.instructions.end()) {
+			return true;
+		}
+		const auto& instruction = next->second.instruction;
+		if (const auto* flags = instruction.cpu_flags; flags != nullptr) {
+			if ((flags->tested & pending) != 0) {
+				return true;
+			}
+			pending &= ~(flags->modified | flags->set_0 | flags->set_1 | flags->undefined);
+		}
+		if (pending == 0) {
+			return false;
+		}
+		const auto category = instruction.meta.category;
+		if (category == ZYDIS_CATEGORY_CALL || category == ZYDIS_CATEGORY_RET) {
+			return false;
+		}
+		if (category == ZYDIS_CATEGORY_COND_BR || IsControlFlowTerminator(instruction)) {
+			return true;
+		}
+		address += instruction.length;
+	}
+	return true;
+}
+
+void CollectJaguarInstructions(const DecodedFunction&                   function,
+                               std::map<uintptr_t, InstructionRewrite>& rewrite_sites,
+                               GuestInstructionPatchResult&             result) {
