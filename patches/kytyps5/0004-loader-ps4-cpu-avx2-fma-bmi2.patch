+		if (!JaguarCompat::IsMissing(decoded.instruction)) {
+			continue;
+		}
+		++result.jaguar.found;
+		auto& rewrite       = rewrite_sites[address];
+		rewrite.replacement = InstructionReplacement::Jaguar;
+		rewrite.flags_live  = FlagsLiveAfter(function, decoded);
+	}
+}
