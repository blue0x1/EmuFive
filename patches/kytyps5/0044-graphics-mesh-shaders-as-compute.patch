diff --git a/src/graphics/host_gpu/shaders/gpu_mesh_compute_indirect.comp b/src/graphics/host_gpu/shaders/gpu_mesh_compute_indirect.comp
new file mode 100644
index 0000000000000000000000000000000000000000..c40315b246cbb283862ed6ae6bae2bf2761c8968
--- /dev/null
+++ b/src/graphics/host_gpu/shaders/gpu_mesh_compute_indirect.comp
@@ -0,0 +1,74 @@
+#version 460
+#extension GL_EXT_buffer_reference : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
+
+// EmuFive: one indirect record of a mesh draw run as compute on a GPU without mesh shaders
+// (IR::MeshComputeSetupDwords). Reads the record like gpu_mesh_indirect.task and writes the draw
+// parameters, the groups per instance, the dispatch of the mesh program and the draw of its
+// triangles. Records past the output buffer draw their first workgroups only.
+layout(local_size_x = 1) in;
+
+layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Record {
+	uint dwords[5];
+};
+layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Setup {
+	uint dwords[16];
+};
+// MeshComputeSetupParams in renderDraw.cpp.
+layout(push_constant) uniform Push {
+	uint64_t record_address;
+	uint64_t index_address;
+	uint64_t setup_address;
+	uint     index_size;
+	uint     index_limit;
+	uint     primitive_size;
+	uint     group_step;
+	uint     max_groups;
+	uint     max_instances;
+	uint     max_total;
+	uint     triangles;
+};
+
+void main() {
+	Record   record    = Record(record_address);
+	uint     count     = record.dwords[0];
+	uint     instances = record.dwords[1];
+	uint64_t address   = index_address;
+	// The base vertex and first instance follow the first index in indexed records.
+	uint base = 2;
+	if (index_size != 0) {
+		// Indices past INDEX_BUFFER_SIZE are never read.
+		const uint first = record.dwords[2];
+		count = min(count, index_limit - min(first, index_limit));
+		address += uint64_t(first) * index_size;
+		base = 3;
+	}
+	uint groups = count < primitive_size ? 0 : (count - primitive_size) / group_step + 1;
+	instances   = min(instances, max_instances);
+	if (groups == 0 || instances == 0) {
+		groups    = 0;
+		instances = 0;
+	} else if (groups >= max_total || groups > max_groups) {
+		groups    = min(min(groups, max_total), max_groups);
+		instances = 1;
+	} else {
+		instances = min(instances, max_total / groups);
+	}
+	Setup setup     = Setup(setup_address);
+	setup.dwords[0] = count;
+	setup.dwords[1] = record.dwords[base];
+	setup.dwords[2] = index_size;
+	setup.dwords[3] = uint(address);
+	setup.dwords[4] = uint(address >> 32);
+	setup.dwords[5] = record.dwords[base + 1];
+	setup.dwords[6] = groups;
+	setup.dwords[7] = 0;
+	setup.dwords[8] = groups;
+	setup.dwords[9] = instances;
+	setup.dwords[10] = 1;
+	setup.dwords[11] = 0;
+	setup.dwords[12] = groups * instances * triangles * 3;
+	setup.dwords[13] = 1;
+	setup.dwords[14] = 0;
+	setup.dwords[15] = 0;
+}
