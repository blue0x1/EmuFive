+#ifndef EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_FRAMETRACE_H_
+#define EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_FRAMETRACE_H_
+
+#include <fmt/format.h>
+
+#include <cstdint>
+#include <functional>
+#include <string>
+
+// EmuFive: a one-frame trace of what the GPU thread runs. Create the file "trace-frame" in the
+// work folder while a game runs; the next frame's draws, dispatches, targets and textures go to
+// frame-trace.txt there, and the trigger file is removed.
+namespace Libs::Graphics::FrameTrace {
+
+bool Active();
+void Write(const std::string& line);
+// `download` brings a GPU-written range back to guest memory before it is printed.
+// `download_image` brings an image back to guest memory and gives its range and guest format.
+void OnFlip(const std::function<void(uint64_t, uint64_t)>&                       download,
+            const std::function<bool(uint32_t, uint64_t*, uint64_t*, uint32_t*)>& download_image);
+void NoteImage(uint32_t id);
+void NoteWritten(uint64_t address, uint64_t size);
+
+template <typename... Args>
+inline void Line(fmt::format_string<Args...> format, Args&&... args) {
+	if (Active()) {
+		Write(fmt::format(format, std::forward<Args>(args)...));
+	}
+}
+
+} // namespace Libs::Graphics::FrameTrace
+
+#endif
