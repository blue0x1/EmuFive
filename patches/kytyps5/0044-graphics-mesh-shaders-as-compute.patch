+// EmuFive: GPUs without mesh shaders (the PS4's GCN GPUs) run a mesh program as a compute
+// shader. Each workgroup writes a record to a buffer: a header (its primitive count, padded to
+// MeshComputeHeaderDwords), max_vertices vertex records with the outputs below in program
+// order, then max_primitives triangles of MeshComputeTriangleDwords (three vertex record offsets
+// in dwords from the buffer start, then the layer). A generated vertex shader draws them.
+inline constexpr uint32_t MeshComputeHeaderDwords   = 4u;
+inline constexpr uint32_t MeshComputeTriangleDwords = 4u;
+// An indirect mesh draw run as compute reads its records on the GPU: a setup shader
+// (gpu_mesh_compute_indirect.comp) writes, per record, the draw parameters
+// (MeshTaskPayloadDwordCount of them) and the groups per instance at MeshComputeSetupGroupsDword,
+// then a VkDispatchIndirectCommand and a VkDrawIndirectCommand. The compute pass finds the
+// setup's address in push dwords 0 and 1.
+inline constexpr uint32_t MeshComputeSetupGroupsDword   = 6u;
+inline constexpr uint32_t MeshComputeSetupDispatchDword = 8u;
+inline constexpr uint32_t MeshComputeSetupDrawDword     = 12u;
+inline constexpr uint32_t MeshComputeSetupDwords        = 16u;
+
+[[nodiscard]] constexpr uint32_t MeshComputeOutputDwords(StageOutputKind kind) {
+	switch (kind) {
+		case StageOutputKind::Position:
+		case StageOutputKind::Parameter: return 4u;
+		case StageOutputKind::ClipDistance:
+		case StageOutputKind::CullDistance: return 1u;
+		default: return 0u;
+	}
+}
+
+template <typename Outputs>
+[[nodiscard]] uint32_t MeshComputeVertexDwords(const Outputs& outputs) {
+	uint32_t dwords = 0;
+	for (const auto& output: outputs) {
+		dwords += MeshComputeOutputDwords(output.kind);
+	}
+	return dwords == 0 ? 1u : dwords;
+}
