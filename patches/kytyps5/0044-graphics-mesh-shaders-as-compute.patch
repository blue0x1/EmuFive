+	const auto VertexRecord = [&](uint32_t vertex) {
+		return EmitAddU32(state, first_vertex,
+		                  EmitBinaryU32(state, spv::OpIMul, vertex, ConstantU32(state, vertex_dwords)));
+	};
+	for (uint32_t half = 0; half < state.lane_count; half++) {
+		state.lane_half      = half;
+		const auto index     = EmitLocalInvocationIndex(state);
+		if (half == 0) {
+			const auto first = state.builder.AllocateId();
+			state.builder.AddFunction(spv::OpIEqual, TypeBool(state), first, index,
+			                          ConstantU32(state, 0));
+			EmitIfCondition(state, first,
+			                [&] { StoreOutputDword(state, base, record, primitives); });
+		}
+		const auto is_vertex = state.builder.AllocateId();
+		state.builder.AddFunction(spv::OpULessThan, TypeBool(state), is_vertex, index, vertices);
+		EmitIfCondition(state, is_vertex, [&] {
+			auto dword = VertexRecord(index);
+			for (const auto& output: state.outputs) {
+				const auto count = IR::MeshComputeOutputDwords(output.kind);
+				if (count == 0) {
+					continue;
+				}
+				const auto type  = MeshOutputType(state, output.kind);
+				const auto value = MeshLoad(state, output.mesh_data_variable,
+				                            spv::StorageClassPrivate, type, ConstantU32(state, half));
+				for (uint32_t component = 0; component < count; component++) {
+					StoreOutputDword(state, base, dword, U32Bits(state, type, value, component));
+					dword = EmitAddU32(state, dword, ConstantU32(state, 1));
+				}
+			}
+		});
+		const auto is_primitive = state.builder.AllocateId();
+		state.builder.AddFunction(spv::OpULessThan, TypeBool(state), is_primitive, index,
+		                          primitives);
+		EmitIfCondition(state, is_primitive, [&] {
+			const auto packed = MeshLoad(state, state.mesh_primitive_data[0], spv::StorageClassPrivate,
+			                             TypeU32(state), ConstantU32(state, half));
+			const auto null_bit =
+			    EmitBinaryU32(state, spv::OpBitwiseAnd, packed, ConstantU32(state, 0x80000000u));
+			const auto culled = state.builder.AllocateId();
+			state.builder.AddFunction(spv::OpINotEqual, TypeBool(state), culled, null_bit,
+			                          ConstantU32(state, 0));
+			uint32_t vertex[3] {};
+			const auto triangle = EmitAddU32(
+			    state, first_triangle,
+			    EmitBinaryU32(state, spv::OpIMul, index,
+			                  ConstantU32(state, IR::MeshComputeTriangleDwords)));
+			// A culled or broken triangle collapses whole onto vertex 0 and draws nothing; moving
+			// only its bad corners would stretch it across the screen.
+			uint32_t raw[3] {};
+			uint32_t keep = Unary(state, spv::OpLogicalNot, TypeBool(state), culled);
+			// Line and point outputs repeat their last vertex, so they draw nothing.
+			const auto size = mesh.output_primitive_size;
+			for (uint32_t component = 0; component < 3; component++) {
+				if (component >= size) {
+					raw[component] = raw[size - 1u];
+					continue;
+				}
+				raw[component] = state.builder.AllocateId();
+				state.builder.AddFunction(spv::OpBitFieldUExtract, TypeU32(state), raw[component],
+				                          packed, ConstantU32(state, component * 10u),
+				                          ConstantU32(state, 9));
+				const auto inside = state.builder.AllocateId();
+				state.builder.AddFunction(spv::OpULessThan, TypeBool(state), inside, raw[component],
+				                          vertices);
+				const auto both = state.builder.AllocateId();
+				state.builder.AddFunction(spv::OpLogicalAnd, TypeBool(state), both, keep, inside);
+				keep = both;
+			}
+			for (uint32_t component = 0; component < 3; component++) {
+				vertex[component] = state.builder.AllocateId();
+				state.builder.AddFunction(spv::OpSelect, TypeU32(state), vertex[component], keep,
+				                          raw[component], ConstantU32(state, 0));
+				StoreOutputDword(state, base,
+				                 EmitAddU32(state, triangle, ConstantU32(state, component)),
+				                 VertexRecord(vertex[component]));
+			}
+			uint32_t layer = ConstantU32(state, 0);
+			for (const auto& output: state.outputs) {
+				if (output.kind == IR::StageOutputKind::Layer) {
+					layer = MeshLoad(state, output.mesh_data_variable, spv::StorageClassWorkgroup,
+					                 TypeU32(state), vertex[mesh.provoking_vertex]);
+				}
+			}
+			StoreOutputDword(state, base, EmitAddU32(state, triangle, ConstantU32(state, 3)), layer);
+		});
+	}
+	state.lane_half = 0;
+	state.builder.AddFunction(spv::OpReturn);
+	state.builder.AddFunction(spv::OpFunctionEnd);
+}
