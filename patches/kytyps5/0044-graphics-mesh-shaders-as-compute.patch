+		DefineInterface();
+		main = Result(spv::OpFunction, void_type, spv::FunctionControlMaskNone, function_type);
+		builder.AddEntryPoint(spv::ExecutionModelVertex, main, "main", interfaces);
+		ResultWithoutType(spv::OpLabel);
+
+		base = Result(spv::OpBitcast, u64_type,
+		              Result(spv::OpCompositeConstruct, uvec2_type,
+		                     Push(IR::PushData::MeshComputeAddressDword),
+		                     Push(IR::PushData::MeshComputeAddressDword + 1u)));
+		const auto vertex   = Result(spv::OpBitcast, uint_type, Load(int_type, vertex_index));
+		const auto triangle = Result(spv::OpUDiv, uint_type, vertex, Uint(3));
+		const auto corner   = Result(spv::OpUMod, uint_type, vertex, Uint(3));
+		const auto per_group = Push(IR::PushData::MeshComputePrimitiveDword);
+		const auto group     = Result(spv::OpUDiv, uint_type, triangle, per_group);
+		const auto local     = Result(spv::OpUMod, uint_type, triangle, per_group);
+		const auto record =
+		    Result(spv::OpIMul, uint_type, group, Push(IR::PushData::MeshComputeRecordDword));
+		const auto count = LoadDword(record);
+		const auto valid = Result(spv::OpULessThan, bool_type, local, count);
+		const auto entry = Add(Add(record, Push(IR::PushData::MeshComputeTriangleDword)),
+		                       Result(spv::OpIMul, uint_type, local,
+		                              Uint(IR::MeshComputeTriangleDwords)));
+		// Triangles past the count collapse onto the workgroup's first vertex record.
+		auto dword = Result(spv::OpSelect, uint_type, valid, LoadDword(Add(entry, corner)),
+		                    Add(record, Uint(IR::MeshComputeHeaderDwords)));
+		if (layer != 0) {
+			Store(layer,
+			      Result(spv::OpSelect, uint_type, valid, LoadDword(Add(entry, Uint(3))), Uint(0)));
+		}
+		for (size_t i = 0; i < outputs.size(); i++) {
+			const auto& output = outputs[i];
+			const auto  count  = IR::MeshComputeOutputDwords(output.kind);
+			if (count == 0) {
+				continue;
+			}
+			if (count == 1) {
+				const auto value = Result(spv::OpBitcast, float_type, LoadDword(dword));
+				const auto array = output.kind == IR::StageOutputKind::ClipDistance ? clip : cull;
+				Store(Result(spv::OpAccessChain, output_float, array, Int(output.index)), value);
+			} else {
+				uint32_t components[4] {};
+				for (uint32_t c = 0; c < 4; c++) {
+					components[c] =
+					    Result(spv::OpBitcast, float_type, LoadDword(Add(dword, Uint(c))));
+				}
+				const auto value = Result(spv::OpCompositeConstruct, vec4_type, components[0],
+				                          components[1], components[2], components[3]);
+				if (output.kind == IR::StageOutputKind::Position) {
+					Store(Result(spv::OpAccessChain, output_vec4, per_vertex, Int(0)), value);
+				} else {
+					Store(parameters[i], value);
+				}
+			}
+			dword = Add(dword, Uint(count));
+		}
+		builder.AddFunction(spv::OpReturn);
+		builder.AddFunction(spv::OpFunctionEnd);
+		return builder.Build();
+	}
+
+private:
+	void DefineInterface() {
+		vertex_index = AddInterface(spv::StorageClassInput, int_type);
+		Decorate(vertex_index, spv::DecorationBuiltIn, spv::BuiltInVertexIndex);
+
+		const auto push_array = builder.DecoratedType(
+		    spv::OpTypeArray, {{spv::OpDecorate, {spv::DecorationArrayStride, sizeof(uint32_t)}}},
+		    uint_type, Uint(IR::PushData::DwordCount));
+		const auto push_block = builder.DecoratedType(
+		    spv::OpTypeStruct,
+		    {{spv::OpMemberDecorate, {0, spv::DecorationOffset, 0}},
+		     {spv::OpDecorate, {spv::DecorationBlock}}},
+		    push_array);
+		push = AddInterface(spv::StorageClassPushConstant, push_block);
+		push_uint = Pointer(spv::StorageClassPushConstant, uint_type);
+
+		const auto per_vertex_type = builder.DecoratedType(
+		    spv::OpTypeStruct,
+		    {{spv::OpMemberDecorate, {0u, spv::DecorationBuiltIn, spv::BuiltInPosition}},
+		     {spv::OpDecorate, {spv::DecorationBlock}}},
+		    vec4_type);
+		per_vertex  = AddInterface(spv::StorageClassOutput, per_vertex_type);
+		output_vec4 = Pointer(spv::StorageClassOutput, vec4_type);
+
+		uint32_t clip_count = 0;
+		uint32_t cull_count = 0;
+		parameters.resize(outputs.size());
+		for (size_t i = 0; i < outputs.size(); i++) {
+			const auto& output = outputs[i];
+			switch (output.kind) {
+				case IR::StageOutputKind::Parameter:
+					parameters[i] = AddInterface(spv::StorageClassOutput, vec4_type);
+					Decorate(parameters[i], spv::DecorationLocation, output.location);
+					break;
+				case IR::StageOutputKind::ClipDistance:
+					clip_count = std::max(clip_count, output.index + 1u);
+					break;
+				case IR::StageOutputKind::CullDistance:
+					cull_count = std::max(cull_count, output.index + 1u);
+					break;
+				case IR::StageOutputKind::Layer:
+					if (layer == 0) {
+						builder.RequireCapability(spv::CapabilityShaderLayer);
+						layer = AddInterface(spv::StorageClassOutput, uint_type);
+						Decorate(layer, spv::DecorationBuiltIn, spv::BuiltInLayer);
+					}
+					break;
+				default: break;
+			}
+		}
+		output_float = Pointer(spv::StorageClassOutput, float_type);
+		if (clip_count != 0) {
+			builder.RequireCapability(spv::CapabilityClipDistance);
+			clip = AddInterface(spv::StorageClassOutput,
+			                    builder.Type(spv::OpTypeArray, float_type, Uint(clip_count)));
+			Decorate(clip, spv::DecorationBuiltIn, spv::BuiltInClipDistance);
+		}
+		if (cull_count != 0) {
+			builder.RequireCapability(spv::CapabilityCullDistance);
+			cull = AddInterface(spv::StorageClassOutput,
+			                    builder.Type(spv::OpTypeArray, float_type, Uint(cull_count)));
+			Decorate(cull, spv::DecorationBuiltIn, spv::BuiltInCullDistance);
+		}
+	}
+
+	uint32_t Push(uint32_t index) {
+		return Load(uint_type, Result(spv::OpAccessChain, push_uint, push, Int(0), Int(index)));
+	}
+
+	uint32_t LoadDword(uint32_t dword) {
+		const auto offset =
+		    Result(spv::OpShiftLeftLogical, u64_type, Result(spv::OpUConvert, u64_type, dword),
+		           builder.Constant(spv::OpConstant, u64_type, 2u, 0u));
+		const auto pointer = Result(spv::OpConvertUToPtr, physical_uint,
+		                            Result(spv::OpIAdd, u64_type, base, offset));
+		const auto value = builder.AllocateId();
+		builder.AddFunction(spv::OpLoad, uint_type, value, pointer, spv::MemoryAccessAlignedMask,
+		                    4u);
+		return value;
+	}
+
+	uint32_t Add(uint32_t left, uint32_t right) {
+		return Result(spv::OpIAdd, uint_type, left, right);
+	}
+
+	uint32_t Load(uint32_t type, uint32_t pointer) { return Result(spv::OpLoad, type, pointer); }
+
+	void Store(uint32_t pointer, uint32_t value) { builder.AddFunction(spv::OpStore, pointer, value); }
+
+	uint32_t Int(uint32_t value) { return builder.Constant(spv::OpConstant, int_type, value); }
+
+	uint32_t Uint(uint32_t value) { return builder.Constant(spv::OpConstant, uint_type, value); }
+
+	uint32_t Pointer(spv::StorageClass storage, uint32_t type) {
+		return builder.Type(spv::OpTypePointer, storage, type);
+	}
+
+	uint32_t AddInterface(spv::StorageClass storage, uint32_t type) {
+		const auto variable = builder.DefineGlobalVariable(Pointer(storage, type), storage);
+		interfaces.push_back(variable);
+		return variable;
+	}
+
+	void Decorate(uint32_t target, spv::Decoration decoration, uint32_t value) {
+		builder.AddAnnotation(spv::OpDecorate, target, decoration, value);
+	}
+
+	template <typename... Args>
+	uint32_t Result(spv::Op opcode, uint32_t type, Args... operands) {
+		const auto id = builder.AllocateId();
+		builder.AddFunction(opcode, type, id, operands...);
+		return id;
+	}
+
+	template <typename... Args>
+	uint32_t ResultWithoutType(spv::Op opcode, Args... operands) {
+		const auto id = builder.AllocateId();
+		builder.AddFunction(opcode, id, operands...);
+		return id;
+	}
+
+	Builder                          builder {0x00010500u};
+	std::span<const IR::StageOutput> outputs;
+	std::vector<uint32_t>            interfaces;
+	std::vector<uint32_t>            parameters;
+	uint32_t                         main          = 0;
+	uint32_t                         void_type     = 0;
+	uint32_t                         bool_type     = 0;
+	uint32_t                         uint_type     = 0;
+	uint32_t                         int_type      = 0;
+	uint32_t                         u64_type      = 0;
+	uint32_t                         float_type    = 0;
+	uint32_t                         vec4_type     = 0;
+	uint32_t                         uvec2_type    = 0;
+	uint32_t                         function_type = 0;
+	uint32_t                         physical_uint = 0;
+	uint32_t                         push_uint     = 0;
+	uint32_t                         output_vec4   = 0;
+	uint32_t                         output_float  = 0;
+	uint32_t                         vertex_index  = 0;
+	uint32_t                         push          = 0;
+	uint32_t                         per_vertex    = 0;
+	uint32_t                         layer         = 0;
+	uint32_t                         clip          = 0;
+	uint32_t                         cull          = 0;
+	uint32_t                         base          = 0;
+};
+
+} // namespace
+
+std::vector<uint32_t> BuildMeshComputeVertexShader(std::span<const IR::StageOutput> outputs) {
+	return MeshComputeVertexEmitter(outputs).Emit();
+}
+
+} // namespace Libs::Graphics
