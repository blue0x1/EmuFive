diff --git a/src/graphics/host_gpu/renderer/frameTrace.cpp b/src/graphics/host_gpu/renderer/frameTrace.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7c6a62204ce73bd2d0d77207aca9c0f8a0e863ea
--- /dev/null
+++ b/src/graphics/host_gpu/renderer/frameTrace.cpp
@@ -0,0 +1,166 @@
+#include "graphics/host_gpu/renderer/frameTrace.h"
+
+#include "common/logging/log.h"
+
+#include "kernel/memory.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <cmath>
+#include <map>
+#include <set>
+#include <vector>
+
+namespace Libs::Graphics::FrameTrace {
+
+static std::FILE* g_file   = nullptr;
+static uint32_t   g_flips  = 0;
+static uint32_t   g_checks = 0;
+static std::map<uint64_t, uint64_t> g_written;
+static std::set<uint32_t>           g_images;
+
+void NoteImage(uint32_t id) {
+	if (g_file != nullptr) {
+		g_images.insert(id);
+	}
+}
+
+static float HalfToFloat(uint16_t h) {
+	const uint32_t sign = (h >> 15u) & 1u, exp = (h >> 10u) & 31u, man = h & 1023u;
+	float v = 0;
+	if (exp == 0) {
+		v = std::ldexp(static_cast<float>(man), -24);
+	} else if (exp == 31) {
+		v = man != 0 ? NAN : INFINITY;
+	} else {
+		v = std::ldexp(static_cast<float>(man | 1024u), static_cast<int>(exp) - 25);
+	}
+	return sign ? -v : v;
+}
+
+static float Unpack11(uint32_t bits, uint32_t man_bits) {
+	const uint32_t exp = bits >> man_bits, man = bits & ((1u << man_bits) - 1u);
+	if (exp == 31) return man != 0 ? NAN : INFINITY;
+	if (exp == 0) return std::ldexp(static_cast<float>(man), -14 - static_cast<int>(man_bits));
+	return std::ldexp(static_cast<float>(man | (1u << man_bits)),
+	                  static_cast<int>(exp) - 15 - static_cast<int>(man_bits));
+}
+
+// Min, max, mean and NaN/Inf counts of a float image's channels (tiling does not matter here).
+static std::string ImageStats(uint64_t address, uint64_t size, uint32_t format) {
+	size = std::min<uint64_t>(size, 64ull << 20u);
+	std::vector<uint8_t> data(size);
+	if (!LibKernel::Memory::TryReadBacking(address, data.data(), size)) {
+		return "unreadable";
+	}
+	std::vector<float> values;
+	uint32_t           channels = 1;
+	switch (format) {
+		case 71: channels = 4; [[fallthrough]];  // 16_16_16_16 float
+		case 13:                                 // 16 float
+			for (size_t i = 0; i + 1 < size; i += 2) values.push_back(HalfToFloat(data[i] | (data[i + 1] << 8u)));
+			break;
+		case 77: channels = 4; [[fallthrough]];  // 32_32_32_32 float
+		case 64: if (format == 64) channels = 2; [[fallthrough]];
+		case 22:
+			for (size_t i = 0; i + 3 < size; i += 4) { float f; std::memcpy(&f, &data[i], 4); values.push_back(f); }
+			break;
+		case 36:                                 // 11_11_10 float
+			channels = 3;
+			for (size_t i = 0; i + 3 < size; i += 4) {
+				uint32_t w; std::memcpy(&w, &data[i], 4);
+				values.push_back(Unpack11(w & 0x7ffu, 6));
+				values.push_back(Unpack11((w >> 11u) & 0x7ffu, 6));
+				values.push_back(Unpack11(w >> 22u, 5));
+			}
+			break;
+		default: return fmt::format("format {} not decoded", format);
+	}
+	std::string text;
+	for (uint32_t c = 0; c < channels; c++) {
+		double sum = 0; float lo = INFINITY, hi = -INFINITY; uint64_t nan = 0, inf = 0, n = 0, zero = 0;
+		for (size_t i = c; i < values.size(); i += channels) {
+			const float v = values[i];
+			if (std::isnan(v)) { nan++; continue; }
+			if (std::isinf(v)) { inf++; continue; }
+			lo = std::min(lo, v); hi = std::max(hi, v); sum += v; n++; zero += v == 0.0f;
+		}
+		text += fmt::format(" c{}: min {:g} max {:g} mean {:g} zero {} nan {} inf {} |", c, lo, hi,
+		                    n ? sum / static_cast<double>(n) : 0.0, zero, nan, inf);
+	}
+	return text;
+}
+
+void NoteWritten(uint64_t address, uint64_t size) {
+	if (g_file != nullptr && size <= 4096) {
+		auto& s = g_written[address];
+		s       = std::max(s, size);
+	}
+}
+
+bool Active() {
+	return g_file != nullptr;
+}
+
+void Write(const std::string& line) {
+	if (g_file != nullptr) {
+		std::fputs(line.c_str(), g_file);
+		std::fputc('\n', g_file);
+	}
+}
+
+void OnFlip(const std::function<void(uint64_t, uint64_t)>&                       download,
+            const std::function<bool(uint32_t, uint64_t*, uint64_t*, uint32_t*)>& download_image) {
+	if (g_file != nullptr) {
+		std::fprintf(g_file, "FLIP %u\n", g_flips);
+		if (++g_flips >= 2) {
+			for (const auto& [address, size]: g_written) {
+				download(address, size);
+				std::vector<uint32_t> words((std::min<uint64_t>(size, 256) + 3) / 4);
+				if (!LibKernel::Memory::TryReadBacking(address, words.data(), words.size() * 4)) {
+					continue;
+				}
+				std::string text = fmt::format("BUFFER {:x} size {}:", address, size);
+				for (size_t i = 0; i < words.size(); i++) {
+					float f = 0;
+					std::memcpy(&f, &words[i], 4);
+					text += fmt::format(" {:08x}({:g})", words[i], f);
+				}
+				std::fprintf(g_file, "%s\n", text.c_str());
+			}
+			g_written.clear();
+			for (const auto id: g_images) {
+				uint64_t address = 0, size = 0;
+				uint32_t format = 0;
+				if (!download_image(id, &address, &size, &format)) {
+					std::fprintf(g_file, "IMAGE %u not downloadable\n", id);
+					continue;
+				}
+				std::fprintf(g_file, "IMAGE %u addr=%llx size=%llu fmt=%u:%s\n", id,
+				             static_cast<unsigned long long>(address),
+				             static_cast<unsigned long long>(size), format,
+				             ImageStats(address, size, format).c_str());
+			}
+			g_images.clear();
+			std::fclose(g_file);
+			g_file = nullptr;
+			Log::WriteToConsoleAndLog("Frame trace written to frame-trace.txt\n");
+		}
+		return;
+	}
+	if ((++g_checks & 7u) != 0) {
+		return;
+	}
+	if (std::FILE* probe = std::fopen("trace-frame", "r"); probe != nullptr) {
+		std::fclose(probe);
+		std::remove("trace-frame");
+		g_file  = std::fopen("frame-trace.txt", "w");
+		g_flips = 0;
+		if (g_file != nullptr) {
+			std::fputs("FLIP start\n", g_file);
+		}
+	}
+}
+
+} // namespace Libs::Graphics::FrameTrace
