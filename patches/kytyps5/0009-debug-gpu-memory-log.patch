From: Chokri Hammedi <52697989+blue0x1@users.noreply.github.com>
Subject: [PATCH] debug: log GPU memory use (KYTY_GPU_MEM_LOG)

With KYTY_GPU_MEM_LOG set, or a file named gpu-mem-log in the working folder:
- the GPU memory heaps (VK_EXT_memory_budget) and the kernel driver's VRAM and
  GTT use are logged every 32 submits, and always when a submit fails;
- every image and buffer allocation of 4 MB or more is logged with what it is
  and the running total.
To find what fills the PS4 GPU's memory before "Not enough memory for command
submission". A debug aid: not for a release.

diff --git a/src/graphics/host_gpu/graphicContext.h b/src/graphics/host_gpu/graphicContext.h
index e7ff557f70ce0aa7f78bf0f7278d82af288aa2d4..74d7639f1e32b97ffd05f0288b16826de36af242 100644
--- a/src/graphics/host_gpu/graphicContext.h
+++ b/src/graphics/host_gpu/graphicContext.h
@@ -9,6 +9,7 @@
 #include <map>
 #include <mutex>
 #include <span>
+#include <string>
 #include <tuple>
 #include <vector>
 #include <vk_mem_alloc.h>
@@ -108,6 +109,9 @@ struct GraphicContext {
 	[[nodiscard]] bool CreateAllocator();
 	void               DestroyAllocator();
 	void               LogMemoryBudget() const;
+	// KYTY_GPU_MEM_LOG (or a gpu-mem-log file in the working folder): log GPU memory use.
+	[[nodiscard]] static bool GpuMemoryLogEnabled();
+	void NoteAllocation(const char* kind, VmaAllocation allocation, const std::string& what) const;
 	[[nodiscard]] bool CanReportMemoryUsage() const noexcept { return memory_budget_ext_enabled; }
 	[[nodiscard]] uint64_t GetDeviceMemoryUsage() const;
 	[[nodiscard]] uint64_t GetTotalMemoryBudget() const;
diff --git a/src/graphics/host_gpu/renderer/cache/streamBuffer.cpp b/src/graphics/host_gpu/renderer/cache/streamBuffer.cpp
index faa969b2249167ec91801bce96ad196f8c6cb68d..8666436baf0d77177485cd2de6330f873827f77e 100644
