diff --git a/src/graphics/host_gpu/renderer/commandScheduler.cpp b/src/graphics/host_gpu/renderer/commandScheduler.cpp
index 930a5a83ae72aa168b1c648886dac0a389f61012..501106493a9f78771073ae041c62ec81fe13a327 100644
--- a/src/graphics/host_gpu/renderer/commandScheduler.cpp
+++ b/src/graphics/host_gpu/renderer/commandScheduler.cpp
@@ -5,6 +5,11 @@
 #include "graphics/host_gpu/graphicContext.h"
 
 #include <algorithm>
+#include <array>
+#include <fmt/format.h>
+#include <string>
+#include <cstdio>
+#include <cstdlib>
 #include <optional>
 
 namespace Libs::Graphics {
@@ -335,7 +340,35 @@ uint64_t CommandScheduler::Submit(SubmitInfo submit) {
 	}
 	Common::DebugCounters::Add(Common::DebugCounters::Counter::QueueSubmits);
 
+	// The GPU memory heaps every 32 submits (with KYTY_GPU_MEM_LOG set, or a file named
+	// gpu-mem-log in the working folder), to find what fills them.
+	const bool mem_log = GraphicContext::GpuMemoryLogEnabled();
+	const auto log_memory = [&](const char* when) {
+		std::array<GraphicContext::HeapUsage, VK_MAX_MEMORY_HEAPS> heaps {};
+		const auto count = graphics.GetHeapUsage(heaps);
+		std::string text = fmt::format("GPU memory {} tick {}:", when, tick);
+		for (uint32_t i = 0; i < count; i++) {
+			text += fmt::format(" heap{}{} {}/{} MB ({} allocs)", i, heaps[i].device_local ? "(vram)" : "",
+			                    heaps[i].usage >> 20u, heaps[i].budget >> 20u, heaps[i].allocations);
+		}
+		// What the kernel driver itself has placed, for every process.
+		for (const char* name: {"vram", "gtt"}) {
+			const auto path = fmt::format("/sys/class/drm/card0/device/mem_info_{}_used", name);
+			if (std::FILE* f = std::fopen(path.c_str(), "r"); f != nullptr) {
+				unsigned long long used = 0;
+				if (std::fscanf(f, "%llu", &used) == 1) {
+					text += fmt::format(" kernel-{} {} MB", name, used >> 20u);
+				}
+				std::fclose(f);
+			}
+		}
+		Log::WriteToConsoleAndLog(text + "\n");
+	};
+	if (mem_log && (tick % 32u) == 0) {
+		log_memory("at");
+	}
 	if (result != vk::Result::eSuccess) {
+		log_memory("when the submit failed at");
 		EXIT("vkQueueSubmit failed: %s, tick=%" PRIu64 "\n", vk::to_string(result).c_str(), tick);
 	}
 
diff --git a/src/graphics/host_gpu/vma.cpp b/src/graphics/host_gpu/vma.cpp
index 1ea3fa8d803814304edd30ec37950fb0c98b9bf2..63ba8e296a6d7c0a574275d71e47ebb424d4ccf0 100644
--- a/src/graphics/host_gpu/vma.cpp
+++ b/src/graphics/host_gpu/vma.cpp
@@ -20,7 +20,12 @@
 #include "graphics/host_gpu/graphicContext.h"
 
 #include <algorithm>
+#include <atomic>
 #include <cinttypes>
+#include <cstdio>
+#include <cstdlib>
+#include <fmt/format.h>
+#include <string>
 
 namespace Libs::Graphics {
 
@@ -60,6 +65,37 @@ void GraphicContext::DestroyAllocator() {
 	allocator = nullptr;
 }
 
+bool GraphicContext::GpuMemoryLogEnabled() {
+	static const bool enabled = [] {
+		if (std::getenv("KYTY_GPU_MEM_LOG") != nullptr) {
+			return true;
+		}
+		std::FILE* probe = std::fopen("gpu-mem-log", "r");
+		if (probe != nullptr) {
+			std::fclose(probe);
+		}
+		return probe != nullptr;
+	}();
+	return enabled;
+}
+
+// Logs each allocation of 4 MB or more, with the running total of all logged ones.
+void GraphicContext::NoteAllocation(const char* kind, VmaAllocation allocation,
+                                    const std::string& what) const {
+	if (!GpuMemoryLogEnabled() || allocation == nullptr) {
+		return;
+	}
+	VmaAllocationInfo info {};
+	vmaGetAllocationInfo(allocator, allocation, &info);
+	static std::atomic<uint64_t> total = 0;
+	const auto                   sum   = total.fetch_add(info.size) + info.size;
+	if (info.size >= (4ull << 20u)) {
+		Log::WriteToConsoleAndLog(fmt::format("GPU alloc {} {} MB ({}), memory type {}, total {} MB\n",
+		                                      kind, info.size >> 20u, what, info.memoryType,
+		                                      sum >> 20u));
+	}
+}
+
 void GraphicContext::LogMemoryBudget() const {
 	if (allocator == nullptr || physical_device == nullptr) {
 		return;
@@ -164,6 +200,13 @@ bool GraphicContext::CreateImage(const vk::ImageCreateInfo& image_info, VulkanIm
 		return false;
 	}
 
+	NoteAllocation("image", image.allocation,
+	               fmt::format("{}x{}x{} format {} mips {} layers {} samples {} usage 0x{:x}",
+	                           image_info.extent.width, image_info.extent.height,
+	                           image_info.extent.depth, static_cast<int>(image_info.format),
+	                           image_info.mipLevels, image_info.arrayLayers,
+	                           static_cast<uint32_t>(image_info.samples),
+	                           static_cast<uint32_t>(image_info.usage)));
 	image.format     = image_info.format;
 	image.image_type = image_info.imageType;
 	image.extent     = image_info.extent;
