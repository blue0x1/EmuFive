From: Chokri Hammedi <52697989+blue0x1@users.noreply.github.com>
Subject: [PATCH] presentation: KYTY_FPS_LOG writes the frame rate to the log every 10 s

EmuFive reads the fps-log lines for its test reports (average, lowest and
highest FPS of a session).
---
diff --git a/src/graphics/presentation/performanceOverlay.cpp b/src/graphics/presentation/performanceOverlay.cpp
index 64b7d2a8e83dcab957e179ef418eb39597f9a270..7ea9a0679a62c55e5bdbef25a3cba0c970347c53 100644
--- a/src/graphics/presentation/performanceOverlay.cpp
+++ b/src/graphics/presentation/performanceOverlay.cpp
@@ -748,10 +748,46 @@ void DrawMemoryAndIo(const Snapshot& shown) {
 
 std::atomic<uint64_t> g_fps_flips {0};
 
+namespace {
+
+// KYTY_FPS_LOG: the frame rate goes to the log every 10 s ("fps-log: 23.4"), for EmuFive's test
+// reports (average, lowest and highest FPS of a session).
+bool FpsLogEnabled() noexcept {
+	static const bool enabled = [] {
+		const char* value = std::getenv("KYTY_FPS_LOG");
+		return value != nullptr && *value != '\0' && std::string(value) != "0";
+	}();
+	return enabled;
+}
+
+void FpsLogFlip() noexcept {
+	static std::mutex        mutex;
+	static Clock::time_point start {};
+	static uint64_t          flips = 0;
+	std::scoped_lock         lock(mutex);
+	const auto               now = Clock::now();
+	if (start == Clock::time_point {}) {
+		start = now;
+	}
+	flips++;
+	const double seconds = std::chrono::duration<double>(now - start).count();
+	if (seconds >= 10.0) {
+		std::printf("fps-log: %.1f\n", static_cast<double>(flips) / seconds);
+		std::fflush(stdout);
+		start = now;
+		flips = 0;
+	}
+}
+
+} // namespace
+
 void PerformanceOverlayRecordFlip(uint32_t guest_width, uint32_t guest_height) noexcept {
 	if (FpsCounterEnabled()) {
 		g_fps_flips.fetch_add(1, std::memory_order_relaxed);
 	}
+	if (FpsLogEnabled()) {
+		FpsLogFlip();
+	}
 	if (!Common::DebugCounters::Enabled()) {
 		return;
 	}
