+// Homebrew built with the ps5-native-app-boilerplate ships a sce_module/libc.prx that only
+// satisfies the loader: every function it exports, malloc included, is
+// "pxor xmm0, xmm0; xor eax, eax; ret". The console binds those imports to its own libc.
+static bool IsStubLibcProgram(const Program* p) {
+	static constexpr uint8_t RETURN_ZERO[] = {0x66, 0x0F, 0xEF, 0xC0, 0x31, 0xC0, 0xC3};
