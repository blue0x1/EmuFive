diff --git a/src/libs/libcCompat.cpp b/src/libs/libcCompat.cpp
new file mode 100644
index 0000000..7bfc151
--- /dev/null
+++ b/src/libs/libcCompat.cpp
@@ -0,0 +1,1001 @@
+// C library functions for homebrew that ships a stand-in sce_module/libc.prx.
+//
+// PS5 homebrew built with the ps5-native-app-boilerplate (Snes9x PS5, Genesis Plus GX PS5,
+// SwanStation PS5, ...) carries a libc.prx that only satisfies the loader: every function it
+// exports returns 0, and the console binds the title's libc imports to its own C library. The
+// runtime linker uses these functions in that case only (see IsStubLibcProgram in
+// loader/runtimeLinker.cpp); a real libc.prx keeps its own implementations.
+//
+// Guest FILE* values are host FILE* values, as for the stdout object LibcInternal exports.
+// wchar_t is 16 bits on the PS5, so the wide character functions do not use the host's.
+
+#include "common/abi.h"
+#include "common/assert.h"
+#include "common/common.h"
+#include "common/logging/log.h"
+#include "kernel/fileSystem.h"
+#include "libs/errno.h"
+#include "libs/guestPrintf.h"
+#include "libs/libs.h"
+#include "libs/vaContext.h"
+#include "loader/symbolDatabase.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cmath>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <filesystem>
+#include <string>
+
+namespace Libs::LibcCompat {
+
+LIB_VERSION("LibcCompat", 1, "LibcCompat", 1, 1);
+
+using guest_wchar_t = uint16_t;
+using guest_cmp_t   = KYTY_SYSV_ABI int (*)(const void*, const void*);
+
+// FreeBSD errno values (1..34 are the same on Linux and Windows).
+constexpr int GUEST_EBADF  = 9;
+constexpr int GUEST_ENOMEM = 12;
+constexpr int GUEST_EINVAL = 22;
+constexpr int GUEST_ERANGE = 34;
+constexpr int GUEST_EILSEQ = 86;
+constexpr int GUEST_EIO    = 5;
+
+static int g_isthreaded = 1; // stdio macros then call the functions instead of reading FILE
+static int g_mb_cur_max = 1; // MB_CUR_MAX of the C locale
+
+// stdin, stdout and stderr are these pointers in FreeBSD's stdio.h.
+static FILE* g_stdinp  = nullptr;
+static FILE* g_stdoutp = nullptr;
+static FILE* g_stderrp = nullptr;
+
+static void SetErrno(int e) {
+	*Posix::GetErrorAddr() = e;
+}
+
+static void SetErrnoFromHost(int e) {
+	SetErrno(e > 0 && e <= GUEST_ERANGE ? e : GUEST_EIO);
+}
+
+// ---- heap -------------------------------------------------------------------------------------
+
+// Every block has a header in front, so free and realloc work for any alignment.
+struct BlockHeader {
+	void*  base;
+	size_t size;
+	size_t reserved[2];
+};
+static_assert(sizeof(BlockHeader) == 32);
+
+static void* Alloc(size_t size, size_t align) {
+	align = std::max<size_t>(align, 16);
+	if ((align & (align - 1)) != 0 || size > SIZE_MAX - align - sizeof(BlockHeader)) {
+		return nullptr;
+	}
+	void* base = std::malloc(size + align + sizeof(BlockHeader));
+	if (base == nullptr) {
+		return nullptr;
+	}
+	auto user = (reinterpret_cast<uintptr_t>(base) + sizeof(BlockHeader) + align - 1) & ~(align - 1);
+	auto* hdr = reinterpret_cast<BlockHeader*>(user - sizeof(BlockHeader));
+	hdr->base = base;
+	hdr->size = size;
+	return reinterpret_cast<void*>(user);
+}
+
+static BlockHeader* Header(void* p) {
+	return reinterpret_cast<BlockHeader*>(static_cast<uint8_t*>(p) - sizeof(BlockHeader));
+}
+
+static KYTY_SYSV_ABI void* malloc(size_t size) {
+	void* p = Alloc(std::max<size_t>(size, 1), 16);
+	if (p == nullptr) {
+		SetErrno(GUEST_ENOMEM);
+	}
+	return p;
+}
+
+static KYTY_SYSV_ABI void free(void* p) {
+	if (p != nullptr) {
+		std::free(Header(p)->base);
+	}
+}
+
+static KYTY_SYSV_ABI void* calloc(size_t n, size_t size) {
+	if (size != 0 && n > SIZE_MAX / size) {
+		SetErrno(GUEST_ENOMEM);
+		return nullptr;
+	}
+	void* p = malloc(n * size);
+	if (p != nullptr) {
+		std::memset(p, 0, n * size);
+	}
+	return p;
+}
+
+static KYTY_SYSV_ABI void* realloc(void* p, size_t size) {
+	if (p == nullptr) {
+		return malloc(size);
+	}
+	void* n = malloc(size);
+	if (n != nullptr) {
+		std::memcpy(n, p, std::min(Header(p)->size, size));
+		free(p);
+	}
+	return n;
+}
+
+static KYTY_SYSV_ABI void* aligned_alloc(size_t align, size_t size) {
+	void* p = Alloc(std::max<size_t>(size, 1), align);
+	if (p == nullptr) {
+		SetErrno((align & (align - 1)) != 0 ? GUEST_EINVAL : GUEST_ENOMEM);
+	}
+	return p;
+}
+
+static KYTY_SYSV_ABI int posix_memalign(void** out, size_t align, size_t size) {
+	if (out == nullptr || align < sizeof(void*) || (align & (align - 1)) != 0) {
+		return GUEST_EINVAL;
+	}
+	void* p = Alloc(std::max<size_t>(size, 1), align);
+	if (p == nullptr) {
+		return GUEST_ENOMEM;
+	}
+	*out = p;
+	return 0;
+}
+
+static char* CopyString(const char* s, size_t n) {
+	auto* d = static_cast<char*>(malloc(n + 1));
+	if (d != nullptr) {
+		std::memcpy(d, s, n);
+		d[n] = '\0';
+	}
+	return d;
+}
+
+static KYTY_SYSV_ABI char* strdup(const char* s) {
+	return CopyString(s, std::strlen(s));
+}
+
+static KYTY_SYSV_ABI char* strndup(const char* s, size_t n) {
+	return CopyString(s, strnlen(s, n));
+}
+
+// ---- strings and characters (C locale) --------------------------------------------------------
+
+static KYTY_SYSV_ABI void* memchr(const void* s, int c, size_t n) {
+	return const_cast<void*>(std::memchr(s, c, n));
+}
+
+static int AsciiLower(int c) {
+	return (c >= 'A' && c <= 'Z') ? c - 'A' + 'a' : c;
+}
+
+static KYTY_SYSV_ABI int tolower(int c) {
+	return AsciiLower(c);
+}
+
+static KYTY_SYSV_ABI int toupper(int c) {
+	return (c >= 'a' && c <= 'z') ? c - 'a' + 'A' : c;
+}
+
+static KYTY_SYSV_ABI int islower(int c) {
+	return static_cast<int>(c >= 'a' && c <= 'z');
+}
+
+static KYTY_SYSV_ABI int isalpha(int c) {
+	return static_cast<int>((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'));
+}
+
+static KYTY_SYSV_ABI int isalnum(int c) {
+	return static_cast<int>(isalpha(c) != 0 || (c >= '0' && c <= '9'));
+}
+
+static KYTY_SYSV_ABI int isspace(int c) {
+	return static_cast<int>(c == ' ' || (c >= '\t' && c <= '\r'));
+}
+
+static KYTY_SYSV_ABI int isxdigit(int c) {
+	return static_cast<int>((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') ||
+	                        (c >= 'A' && c <= 'F'));
+}
+
+static KYTY_SYSV_ABI int strncasecmp(const char* a, const char* b, size_t n) {
+	for (size_t i = 0; i < n; i++) {
+		int ca = AsciiLower(static_cast<unsigned char>(a[i]));
+		int cb = AsciiLower(static_cast<unsigned char>(b[i]));
+		if (ca != cb || ca == 0) {
+			return ca - cb;
+		}
+	}
+	return 0;
+}
+
+static KYTY_SYSV_ABI int strcasecmp(const char* a, const char* b) {
+	return strncasecmp(a, b, SIZE_MAX);
+}
+
+static KYTY_SYSV_ABI int strcoll(const char* a, const char* b) {
+	return std::strcmp(a, b);
+}
+
+static KYTY_SYSV_ABI size_t strxfrm(char* dst, const char* src, size_t n) {
+	size_t len = std::strlen(src);
+	if (len < n) {
+		std::memcpy(dst, src, len + 1);
+	}
+	return len;
+}
+
+static KYTY_SYSV_ABI size_t strcspn(const char* s, const char* reject) {
+	return std::strcspn(s, reject);
+}
+
+static KYTY_SYSV_ABI size_t strlcpy(char* dst, const char* src, size_t n) {
+	size_t len = std::strlen(src);
+	if (n != 0) {
+		size_t c = std::min(len, n - 1);
+		std::memcpy(dst, src, c);
+		dst[c] = '\0';
+	}
+	return len;
+}
+
+static const char* ErrorText(int e) {
+	if (e == 0) {
+		return "No error: 0";
+	}
+	if (e > 0 && e <= GUEST_ERANGE) {
+		return std::strerror(e);
+	}
+	return nullptr;
+}
+
+static KYTY_SYSV_ABI char* strerror(int e) {
+	static thread_local char buf[64];
+	if (const char* t = ErrorText(e); t != nullptr) {
+		std::snprintf(buf, sizeof(buf), "%s", t);
+	} else {
+		std::snprintf(buf, sizeof(buf), "Unknown error: %d", e);
+	}
+	return buf;
+}
+
+static KYTY_SYSV_ABI int strerror_r(int e, char* buf, size_t len) {
+	const char* t   = strerror(e);
+	size_t      n   = std::strlen(t);
+	int         ret = (ErrorText(e) == nullptr ? GUEST_EINVAL : 0);
+	if (len == 0) {
+		return GUEST_ERANGE;
+	}
+	std::memcpy(buf, t, std::min(n, len - 1));
+	buf[std::min(n, len - 1)] = '\0';
+	return n >= len ? GUEST_ERANGE : ret;
+}
+
+static KYTY_SYSV_ABI char* setlocale(int /*category*/, const char* locale) {
+	static char c_locale[] = "C";
+	if (locale == nullptr || locale[0] == '\0' || std::strcmp(locale, "C") == 0 ||
+	    std::strcmp(locale, "POSIX") == 0) {
+		return c_locale;
+	}
+	return nullptr;
+}
+
+// ---- numbers ----------------------------------------------------------------------------------
+
+template <class T, class F>
+static T HostStrto(F f, const char* s, char** end) {
+	errno = 0;
+	T v   = f(s, end);
+	if (errno == ERANGE) {
+		SetErrno(GUEST_ERANGE);
+	}
+	return v;
+}
+
+template <class T, class F>
+static T HostStrtoBase(F f, const char* s, char** end, int base) {
+	errno = 0;
+	T v   = f(s, end, base);
+	if (errno == ERANGE) {
+		SetErrno(GUEST_ERANGE);
+	} else if (errno == EINVAL) {
+		SetErrno(GUEST_EINVAL);
+	}
+	return v;
+}
+
+static KYTY_SYSV_ABI double strtod(const char* s, char** end) {
+	return HostStrto<double>(std::strtod, s, end);
+}
+
+static KYTY_SYSV_ABI float strtof(const char* s, char** end) {
+	return HostStrto<float>(std::strtof, s, end);
+}
+
+// The guest's long double is the x87 80-bit type, as on Linux and macOS hosts.
+static KYTY_SYSV_ABI long double strtold(const char* s, char** end) {
+	return HostStrto<long double>(std::strtold, s, end);
+}
+
+static KYTY_SYSV_ABI long long strtoll(const char* s, char** end, int base) { // NOLINT(google-runtime-int)
+	return HostStrtoBase<long long>(std::strtoll, s, end, base);              // NOLINT(google-runtime-int)
+}
+
+static KYTY_SYSV_ABI unsigned long long strtoull(const char* s, char** end, // NOLINT(google-runtime-int)
+                                                  int base) {
+	return HostStrtoBase<unsigned long long>(std::strtoull, s, end, base); // NOLINT(google-runtime-int)
+}
+
+static KYTY_SYSV_ABI double atan(double x) {
+	return std::atan(x);
+}
+
+static KYTY_SYSV_ABI double log(double x) {
+	return std::log(x);
+}
+
+static KYTY_SYSV_ABI double fmod(double x, double y) {
+	return std::fmod(x, y);
+}
+
+static KYTY_SYSV_ABI float fmodf(float x, float y) {
+	return std::fmod(x, y);
+}
+
+static KYTY_SYSV_ABI float expf(float x) {
+	return std::exp(x);
+}
+
+static KYTY_SYSV_ABI float exp2f(float x) {
+	return std::exp2(x);
+}
+
+static KYTY_SYSV_ABI float powf(float x, float y) {
+	return std::pow(x, y);
+}
+
+static KYTY_SYSV_ABI long lroundf(float x) { // NOLINT(google-runtime-int)
+	return std::lround(x);
+}
+
+// ---- sorting and searching (guest comparison functions) -------------------------------------
+
+static thread_local guest_cmp_t g_qsort_cmp = nullptr;
+
+static int QsortCompare(const void* a, const void* b) {
+	return g_qsort_cmp(a, b);
+}
+
+static KYTY_SYSV_ABI void qsort(void* base, size_t n, size_t size, guest_cmp_t cmp) {
+	auto* saved = g_qsort_cmp; // a comparison function may sort too
+	g_qsort_cmp = cmp;
+	std::qsort(base, n, size, QsortCompare);
+	g_qsort_cmp = saved;
+}
+
+static KYTY_SYSV_ABI void* bsearch(const void* key, const void* base, size_t n, size_t size,
+                                   guest_cmp_t cmp) {
+	size_t lo = 0;
+	size_t hi = n;
+	while (lo < hi) {
+		size_t      mid = lo + (hi - lo) / 2;
+		const auto* p   = static_cast<const uint8_t*>(base) + mid * size;
+		int         c   = cmp(key, p);
+		if (c == 0) {
+			return const_cast<uint8_t*>(p);
+		}
+		if (c < 0) {
+			hi = mid;
+		} else {
+			lo = mid + 1;
+		}
+	}
+	return nullptr;
+}
+
+// ---- time -------------------------------------------------------------------------------------
+
+static KYTY_SYSV_ABI char* ctime(const int64_t* t) {
+	static constexpr const char* DAYS[]   = {"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"};
+	static constexpr const char* MONTHS[] = {"Jan", "Feb", "Mar", "Apr", "May", "Jun",
+	                                         "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"};
+	static thread_local char     buf[32];
+	if (t == nullptr) {
+		return nullptr;
+	}
+	auto      tt = static_cast<time_t>(*t);
+	struct tm tm {};
+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+	if (localtime_s(&tm, &tt) != 0) {
+		return nullptr;
+	}
+#else
+	if (localtime_r(&tt, &tm) == nullptr) {
+		return nullptr;
+	}
+#endif
+	std::snprintf(buf, sizeof(buf), "%.3s %.3s%3d %.2d:%.2d:%.2d %d\n", DAYS[tm.tm_wday % 7],
+	              MONTHS[tm.tm_mon % 12], tm.tm_mday, tm.tm_hour, tm.tm_min, tm.tm_sec,
+	              tm.tm_year + 1900);
+	return buf;
+}
+
+// ---- stdio (host FILE*) -----------------------------------------------------------------------
+
+static std::filesystem::path HostPath(const char* path) {
+	std::string p = path;
+	if (!p.empty() && p[0] != '/') {
+		p = "/app0/" + p;
+	}
+	return LibKernel::FileSystem::GetRealFilename(p);
+}
+
+static KYTY_SYSV_ABI FILE* fopen(const char* path, const char* mode) {
+	if (path == nullptr || mode == nullptr) {
+		SetErrno(GUEST_EINVAL);
+		return nullptr;
+	}
+	auto host = HostPath(path);
+	LOGF("\t fopen %s (%s) -> %s\n", path, mode, host.string().c_str());
+	if (host.empty()) {
+		SetErrno(Posix::POSIX_ENOENT);
+		return nullptr;
+	}
+	std::string m = mode;
+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+	if (m.find('b') == std::string::npos) {
+		m += 'b'; // the guest has no text mode
+	}
+	FILE* f = _wfopen(host.c_str(), std::wstring(m.begin(), m.end()).c_str());
+#else
+	FILE* f = std::fopen(host.c_str(), m.c_str());
+#endif
+	if (f == nullptr) {
+		SetErrnoFromHost(errno);
+	}
+	return f;
+}
+
+static KYTY_SYSV_ABI int fclose(FILE* f) {
+	return std::fclose(f);
+}
+
+static KYTY_SYSV_ABI int remove(const char* path) {
+	auto host = HostPath(path);
+	if (host.empty()) {
+		SetErrno(Posix::POSIX_ENOENT);
+		return -1;
+	}
+	std::error_code ec;
+	if (!std::filesystem::remove(host, ec)) {
+		SetErrnoFromHost(ec ? ec.value() : ENOENT);
+		return -1;
+	}
+	return 0;
+}
+
+static KYTY_SYSV_ABI size_t fread(void* p, size_t size, size_t n, FILE* f) {
+	return std::fread(p, size, n, f);
+}
+
+static KYTY_SYSV_ABI size_t fwrite(const void* p, size_t size, size_t n, FILE* f) {
+	return std::fwrite(p, size, n, f);
+}
+
+static KYTY_SYSV_ABI int fgetc(FILE* f) {
+	return std::fgetc(f);
+}
+
+static KYTY_SYSV_ABI int getc(FILE* f) {
+	return std::fgetc(f);
+}
+
+static KYTY_SYSV_ABI int ungetc(int c, FILE* f) {
+	return std::ungetc(c, f);
+}
+
+static KYTY_SYSV_ABI char* fgets(char* s, int n, FILE* f) {
+	return std::fgets(s, n, f);
+}
+
+static KYTY_SYSV_ABI int fputc(int c, FILE* f) {
+	return std::fputc(c, f);
+}
+
+static KYTY_SYSV_ABI int putchar(int c) {
+	return std::fputc(c, stdout);
+}
+
+static KYTY_SYSV_ABI int fputs(const char* s, FILE* f) {
+	return std::fputs(s, f);
+}
+
+static KYTY_SYSV_ABI int fseeko(FILE* f, int64_t off, int whence) {
+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+	return _fseeki64(f, off, whence);
+#else
+	return ::fseeko(f, static_cast<off_t>(off), whence);
+#endif
+}
+
+static KYTY_SYSV_ABI int fseek(FILE* f, long off, int whence) { // NOLINT(google-runtime-int)
+	return LibcCompat::fseeko(f, off, whence);
+}
+
+static KYTY_SYSV_ABI int64_t ftello(FILE* f) {
+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+	return _ftelli64(f);
+#else
+	return ::ftello(f);
+#endif
+}
+
+static KYTY_SYSV_ABI long ftell(FILE* f) { // NOLINT(google-runtime-int)
+	return static_cast<long>(LibcCompat::ftello(f)); // NOLINT(google-runtime-int)
+}
+
+static KYTY_SYSV_ABI void rewind(FILE* f) {
+	std::rewind(f);
+}
+
+static KYTY_SYSV_ABI int feof(FILE* f) {
+	return std::feof(f);
+}
+
+static KYTY_SYSV_ABI int ferror(FILE* f) {
+	return std::ferror(f);
+}
+
+static KYTY_SYSV_ABI void clearerr(FILE* f) {
+	std::clearerr(f);
+}
+
+// The guest's descriptors are the emulator's, not the host's: a FILE* has none.
+static KYTY_SYSV_ABI int fileno(FILE* /*f*/) {
+	SetErrno(GUEST_EBADF);
+	return -1;
+}
+
+static KYTY_SYSV_ABI void flockfile(FILE* f) {
+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+	_lock_file(f);
+#else
+	::flockfile(f);
+#endif
+}
+
+static KYTY_SYSV_ABI void funlockfile(FILE* f) {
+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+	_unlock_file(f);
+#else
+	::funlockfile(f);
+#endif
+}
