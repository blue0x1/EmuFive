+// ---- formatted input --------------------------------------------------------------------------
+
+// The guest's va_list is the System V x86-64 one, which Linux and macOS hosts use too.
+#if KYTY_PLATFORM != KYTY_PLATFORM_WINDOWS
+static va_list& HostVaList(VaList* va) {
+	static_assert(sizeof(VaList) == sizeof(va_list));
+	return *reinterpret_cast<va_list*>(va);
+}
+#endif
+
+static KYTY_SYSV_ABI int vsscanf(const char* s, const char* format, VaList* va) {
+#if KYTY_PLATFORM != KYTY_PLATFORM_WINDOWS
+	return std::vsscanf(s, format, HostVaList(va));
+#else
+	EXIT("vsscanf is not implemented on Windows\n");
+	return -1;
+#endif
+}
+
+static KYTY_SYSV_ABI int sscanf(VA_ARGS) { // NOLINT(cert-dcl50-cpp)
+	VA_CONTEXT(ctx); // NOLINT(cppcoreguidelines-pro-type-member-init,hicpp-member-init)
+	const char* s      = VaArg_ptr<const char>(&ctx.va_list);
+	const char* format = VaArg_ptr<const char>(&ctx.va_list);
+	return vsscanf(s, format, &ctx.va_list);
+}
+
+static KYTY_SYSV_ABI int fscanf(VA_ARGS) { // NOLINT(cert-dcl50-cpp)
+	VA_CONTEXT(ctx); // NOLINT(cppcoreguidelines-pro-type-member-init,hicpp-member-init)
+	FILE*       f      = VaArg_ptr<FILE>(&ctx.va_list);
+	const char* format = VaArg_ptr<const char>(&ctx.va_list);
+#if KYTY_PLATFORM != KYTY_PLATFORM_WINDOWS
+	return std::vfscanf(f, format, HostVaList(&ctx.va_list));
+#else
+	EXIT("fscanf is not implemented on Windows\n");
+	return -1;
+#endif
+}
