+// FreeBSD and the hosts use the same values: _IOFBF 0, _IOLBF 1, _IONBF 2.
+static KYTY_SYSV_ABI int setvbuf(FILE* f, char* buf, int mode, size_t size) {
+	return std::setvbuf(f, buf, mode, size);
+}
+
+static KYTY_SYSV_ABI void perror(const char* s) {
+	const char* t = strerror(*Posix::GetErrorAddr());
+	if (s != nullptr && s[0] != '\0') {
+		std::fprintf(stderr, "%s: %s\n", s, t);
+	} else {
+		std::fprintf(stderr, "%s\n", t);
+	}
+}
+
+// ---- formatted output (KytyPS5's guest printf) -------------------------------------------------
+
+static int CopyOut(const std::string& str, char* s, size_t n) {
+	if (n != 0) {
+		size_t c = std::min(str.size(), n - 1);
+		std::memcpy(s, str.data(), c);
+		s[c] = '\0';
+	}
+	return static_cast<int>(str.size());
+}
+
+static KYTY_SYSV_ABI int vsnprintf(char* s, size_t n, const char* format, VaList* va) {
+	std::string str;
+	GuestVFormat(&str, format, va);
+	return CopyOut(str, s, n);
+}
+
+static KYTY_SYSV_ABI int sprintf(VA_ARGS) { // NOLINT(cert-dcl50-cpp)
+	VA_CONTEXT(ctx); // NOLINT(cppcoreguidelines-pro-type-member-init,hicpp-member-init)
+	char*       s      = VaArg_ptr<char>(&ctx.va_list);
+	const char* format = VaArg_ptr<const char>(&ctx.va_list);
+	std::string str;
+	GuestVFormat(&str, format, &ctx.va_list);
+	return CopyOut(str, s, SIZE_MAX);
+}
+
+static int AllocOut(const std::string& str, char** out) {
+	*out = CopyString(str.data(), str.size());
+	return *out == nullptr ? -1 : static_cast<int>(str.size());
+}
+
+static KYTY_SYSV_ABI int vasprintf(char** out, const char* format, VaList* va) {
+	std::string str;
+	GuestVFormat(&str, format, va);
+	return AllocOut(str, out);
+}
+
+static KYTY_SYSV_ABI int asprintf(VA_ARGS) { // NOLINT(cert-dcl50-cpp)
+	VA_CONTEXT(ctx); // NOLINT(cppcoreguidelines-pro-type-member-init,hicpp-member-init)
+	auto**      out    = VaArg_ptr<char*>(&ctx.va_list);
+	const char* format = VaArg_ptr<const char>(&ctx.va_list);
+	std::string str;
+	GuestVFormat(&str, format, &ctx.va_list);
+	return AllocOut(str, out);
+}
+
+static int WriteOut(const std::string& str, FILE* f) {
+	if (f == stdout || f == stderr) {
+		LOGF_COLOR(Log::Color::BrightMagenta, "%s", str.c_str());
+		return static_cast<int>(str.size());
+	}
+	return std::fwrite(str.data(), 1, str.size(), f) == str.size() ? static_cast<int>(str.size())
+	                                                                : -1;
+}
+
+static KYTY_SYSV_ABI int vfprintf(FILE* f, const char* format, VaList* va) {
+	std::string str;
+	GuestVFormat(&str, format, va);
+	return WriteOut(str, f);
+}
+
+static KYTY_SYSV_ABI int fprintf(VA_ARGS) { // NOLINT(cert-dcl50-cpp)
+	VA_CONTEXT(ctx); // NOLINT(cppcoreguidelines-pro-type-member-init,hicpp-member-init)
+	FILE*       f      = VaArg_ptr<FILE>(&ctx.va_list);
+	const char* format = VaArg_ptr<const char>(&ctx.va_list);
+	std::string str;
+	GuestVFormat(&str, format, &ctx.va_list);
+	return WriteOut(str, f);
+}
