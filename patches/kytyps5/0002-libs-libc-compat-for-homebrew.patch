+// ---- multibyte and wide characters (C locale, 16-bit wchar_t) ---------------------------------
+
+// FreeBSD's C locale maps each byte to the wide character with the same value.
+static KYTY_SYSV_ABI size_t mbrtowc(guest_wchar_t* pwc, const char* s, size_t n, void* /*ps*/) {
+	if (s == nullptr) {
+		return 0;
+	}
+	if (n == 0) {
+		return static_cast<size_t>(-2);
+	}
+	auto c = static_cast<unsigned char>(*s);
+	if (pwc != nullptr) {
+		*pwc = c;
+	}
+	return c == 0 ? 0 : 1;
+}
+
+static KYTY_SYSV_ABI size_t mbrlen(const char* s, size_t n, void* ps) {
+	return mbrtowc(nullptr, s, n, ps);
+}
+
+static KYTY_SYSV_ABI int mbtowc(guest_wchar_t* pwc, const char* s, size_t n) {
+	if (s == nullptr) {
+		return 0;
+	}
+	if (n == 0) {
+		SetErrno(GUEST_EILSEQ);
+		return -1;
+	}
+	return static_cast<int>(mbrtowc(pwc, s, n, nullptr));
+}
+
+static KYTY_SYSV_ABI size_t mbsrtowcs(guest_wchar_t* dst, const char** src, size_t len,
+                                      void* /*ps*/) {
+	const char* s = *src;
+	size_t      i = 0;
+	for (; dst == nullptr || i < len; i++) {
+		auto c = static_cast<unsigned char>(s[i]);
+		if (dst != nullptr) {
+			dst[i] = c;
+		}
+		if (c == 0) {
+			if (dst != nullptr) {
+				*src = nullptr;
+			}
+			return i;
+		}
+	}
+	*src = s + i;
+	return i;
+}
+
+static KYTY_SYSV_ABI size_t wcrtomb(char* s, guest_wchar_t wc, void* /*ps*/) {
+	if (s == nullptr) {
+		return 1;
+	}
+	if (wc > 0xff) {
+		SetErrno(GUEST_EILSEQ);
+		return static_cast<size_t>(-1);
+	}
+	*s = static_cast<char>(wc);
+	return 1;
+}
+
+static KYTY_SYSV_ABI size_t wcslen(const guest_wchar_t* s) {
+	size_t n = 0;
+	while (s[n] != 0) {
+		n++;
+	}
+	return n;
+}
+
+static KYTY_SYSV_ABI guest_wchar_t* wmemchr(const guest_wchar_t* s, guest_wchar_t c, size_t n) {
+	for (size_t i = 0; i < n; i++) {
+		if (s[i] == c) {
+			return const_cast<guest_wchar_t*>(s + i);
+		}
+	}
+	return nullptr;
+}
+
+static KYTY_SYSV_ABI int wmemcmp(const guest_wchar_t* a, const guest_wchar_t* b, size_t n) {
+	for (size_t i = 0; i < n; i++) {
+		if (a[i] != b[i]) {
+			return a[i] < b[i] ? -1 : 1;
+		}
+	}
+	return 0;
+}
+
+static KYTY_SYSV_ABI int wcscoll(const guest_wchar_t* a, const guest_wchar_t* b) {
+	for (;; a++, b++) {
+		if (*a != *b) {
+			return *a < *b ? -1 : 1;
+		}
+		if (*a == 0) {
+			return 0;
+		}
+	}
+}
+
+static KYTY_SYSV_ABI size_t wcsxfrm(guest_wchar_t* dst, const guest_wchar_t* src, size_t n) {
+	size_t len = wcslen(src);
+	if (len < n) {
+		std::memcpy(dst, src, (len + 1) * sizeof(guest_wchar_t));
+	}
+	return len;
+}
