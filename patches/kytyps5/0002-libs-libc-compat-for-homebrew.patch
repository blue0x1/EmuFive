+// Number parsing reads ASCII only, so the wide string is narrowed up to the first other
+// character and parsed with the narrow function.
+template <class T, class F>
+static T WideToNumber(F f, const guest_wchar_t* s, guest_wchar_t** end) {
+	std::string narrow;
+	for (const guest_wchar_t* p = s; *p != 0 && *p < 0x80; p++) {
+		narrow += static_cast<char>(*p);
+	}
+	char* narrow_end = nullptr;
+	T     v          = f(narrow.c_str(), &narrow_end);
+	if (end != nullptr) {
+		*end = const_cast<guest_wchar_t*>(s + (narrow_end - narrow.c_str()));
+	}
+	return v;
+}
+
+static KYTY_SYSV_ABI double wcstod(const guest_wchar_t* s, guest_wchar_t** end) {
+	return WideToNumber<double>(strtod, s, end);
+}
+
+static KYTY_SYSV_ABI float wcstof(const guest_wchar_t* s, guest_wchar_t** end) {
+	return WideToNumber<float>(strtof, s, end);
+}
+
+static KYTY_SYSV_ABI long double wcstold(const guest_wchar_t* s, guest_wchar_t** end) {
+	return WideToNumber<long double>(strtold, s, end);
+}
+
+static KYTY_SYSV_ABI long long wcstoll(const guest_wchar_t* s, guest_wchar_t** end, // NOLINT
+                                       int base) {
+	return WideToNumber<long long>( // NOLINT(google-runtime-int)
+	    [base](const char* n, char** e) { return strtoll(n, e, base); }, s, end);
+}
+
+static KYTY_SYSV_ABI long wcstol(const guest_wchar_t* s, guest_wchar_t** end, int base) { // NOLINT
+	return static_cast<long>(wcstoll(s, end, base)); // NOLINT(google-runtime-int)
+}
+
+static KYTY_SYSV_ABI unsigned long long wcstoull(const guest_wchar_t* s, // NOLINT
+                                                 guest_wchar_t** end, int base) {
+	return WideToNumber<unsigned long long>( // NOLINT(google-runtime-int)
+	    [base](const char* n, char** e) { return strtoull(n, e, base); }, s, end);
+}
+
+static KYTY_SYSV_ABI unsigned long wcstoul(const guest_wchar_t* s, guest_wchar_t** end, // NOLINT
+                                           int base) {
+	return static_cast<unsigned long>(wcstoull(s, end, base)); // NOLINT(google-runtime-int)
+}
+
+static KYTY_SYSV_ABI int swprintf(VA_ARGS) { // NOLINT(cert-dcl50-cpp)
+	VA_CONTEXT(ctx); // NOLINT(cppcoreguidelines-pro-type-member-init,hicpp-member-init)
+	auto*       s      = VaArg_ptr<guest_wchar_t>(&ctx.va_list);
+	size_t      n      = VaArg_size_t(&ctx.va_list);
+	const auto* wfmt   = VaArg_ptr<const guest_wchar_t>(&ctx.va_list);
+	std::string format;
+	for (const guest_wchar_t* p = wfmt; *p != 0; p++) {
+		format += static_cast<char>(*p < 0x80 ? *p : '?');
+	}
+	std::string str;
+	GuestVFormat(&str, format.c_str(), &ctx.va_list);
+	if (n == 0 || str.size() >= n) {
+		if (n != 0) {
+			s[0] = 0;
+		}
+		SetErrno(GUEST_ERANGE);
+		return -1;
+	}
+	for (size_t i = 0; i < str.size(); i++) {
+		s[i] = static_cast<unsigned char>(str[i]);
+	}
+	s[str.size()] = 0;
+	return static_cast<int>(str.size());
+}
