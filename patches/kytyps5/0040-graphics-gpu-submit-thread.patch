+		}
+	}
 	m_priority_thread.request_stop();
 	m_operation_available.notify_all();
 	if (m_priority_thread.joinable()) {
@@ -323,15 +332,91 @@
 	EXIT_IF(m_command.IsInvalid());
 
 	m_command.End();
-	const auto buffer   = m_command.m_buffer;
-	auto&      graphics = m_graphics;
-	EXIT_IF(graphics.queue == nullptr);
+	const auto buffer = m_command.m_buffer;
+	EXIT_IF(m_graphics.queue == nullptr);
+	uint64_t tick;
+	if (m_threaded_submit) {
+		{
+			std::lock_guard lock(m_submit_mutex);
+			tick = m_master.NextTick();
+			m_submits.push_back({buffer, submit, tick});
+		}
+		m_submit_available.notify_one();
+	} else {
+		// Work the GPU thread queued must reach the queue first (presenting reads its frames).
+		m_graphics.DrainQueuedSubmits();
+		Common::LockGuard lock(m_graphics.queue_mutex);
+		tick = m_master.NextTick();
+		QueueSubmit(buffer, submit, tick);
+	}
+	m_command.m_buffer = nullptr;
+	return tick;
+}
+
+void CommandScheduler::EnableSubmitThread() {
+	EXIT_IF(m_threaded_submit);
+	m_threaded_submit = true;
+	m_graphics.drain_queued_submits_context = this;
+	m_graphics.drain_queued_submits = [](void* context) {
+		static_cast<CommandScheduler*>(context)->DrainSubmits();
+	};
+	m_master.SetBeforeWait(
+	    [](void* context, uint64_t tick) { static_cast<CommandScheduler*>(context)->WaitSubmitted(tick); },
+	    this);
+	m_submit_thread = std::jthread([this](std::stop_token stop) { SubmitThread(stop); });
+	printf("CommandScheduler: GPU submit thread on\n");
+}
+
+void CommandScheduler::SubmitThread(std::stop_token stop) {
+	for (;;) {
+		QueuedSubmit item;
+		{
+			std::unique_lock lock(m_submit_mutex);
+			m_submit_available.wait(lock, stop, [this] { return !m_submits.empty(); });
+			if (m_submits.empty()) {
+				return; // Stop requested with nothing left.
+			}
+			item = m_submits.front();
+			m_submits.pop_front();
+			m_submit_busy = true;
+		}
+		{
+			Common::LockGuard lock(m_graphics.queue_mutex);
+			QueueSubmit(item.buffer, item.submit, item.tick);
+		}
+		{
+			std::lock_guard lock(m_submit_mutex);
+			m_submitted_tick = item.tick;
+			m_submit_busy    = false;
+		}
+		m_submit_done.notify_all();
+	}
+}
+
+void CommandScheduler::DrainSubmits() {
+	if (!m_threaded_submit || std::this_thread::get_id() == m_submit_thread.get_id()) {
+		return;
+	}
+	std::unique_lock lock(m_submit_mutex);
+	m_submit_done.wait(lock, [this] { return m_submits.empty() && !m_submit_busy; });
+}
 
+void CommandScheduler::WaitSubmitted(uint64_t tick) {
+	if (!m_threaded_submit || std::this_thread::get_id() == m_submit_thread.get_id()) {
+		return;
+	}
+	std::unique_lock lock(m_submit_mutex);
+	m_submit_done.wait(lock, [this, tick] {
+		// A tick still in m_submits (or being submitted) has not reached Vulkan yet.
+		return m_submitted_tick >= tick || (m_submits.empty() && !m_submit_busy);
+	});
+}
+
+// Hands one command buffer to Vulkan, signalling `tick`. queue_mutex is held by the caller.
+void CommandScheduler::QueueSubmit(vk::CommandBuffer buffer, SubmitInfo& submit, uint64_t tick) {
+	auto&      graphics = m_graphics;
 	vk::Result result;
-	uint64_t   tick;
 	{
-		Common::LockGuard lock(graphics.queue_mutex);
-		tick = m_master.NextTick();
 		submit.AddSignal(m_master.Handle(), tick);
 
 		vk::TimelineSemaphoreSubmitInfo timeline_info {};
@@ -389,8 +474,6 @@
 		EXIT("vkQueueSubmit failed: %s, tick=%" PRIu64 "\n", vk::to_string(result).c_str(), tick);
 	}
 
-	m_command.m_buffer = nullptr;
-	return tick;
 }
 
