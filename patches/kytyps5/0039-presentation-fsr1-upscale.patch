+// KYTY_FSR: a game frame smaller than the screen is upscaled with AMD FSR 1 (EASU) instead of a
+// linear blit (with KYTY_OUTPUT_1080P on a 4K TV). SDR frames only.
+static bool FsrEnabled() {
+	static const bool enabled = [] {
+		const char* value = std::getenv("KYTY_FSR");
+		return value != nullptr && *value != '\0' && std::string(value) != "0";
+	}();
+	return enabled;
+}
