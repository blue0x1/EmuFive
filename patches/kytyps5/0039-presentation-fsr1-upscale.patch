--- /dev/null
+++ b/src/graphics/host_gpu/shaders/gpu_video_out_fsr.frag
@@ -0,0 +1,116 @@
+#version 450
+// AMD FidelityFX Super Resolution 1.0, EASU (the edge-adaptive upscaler), as one full-screen pass
+// from the game's frame to the screen. Written after AMD's ffx_fsr1.h (MIT license, Copyright (c)
+// 2021 Advanced Micro Devices, Inc.). Used with KYTY_FSR when the game draws smaller than the
+// screen (KYTY_OUTPUT_1080P on a 4K TV): edges stay sharp where a linear blit blurs them.
+
+layout(location = 0) in vec2 uv;
+layout(location = 0) out vec4 color;
+layout(binding = 0) uniform sampler2D source;
+layout(push_constant) uniform Flags {
+	uint flags;
+};
+
+ivec2 g_max;
+
+vec3 Fetch(ivec2 p) {
+	return texelFetch(source, clamp(p, ivec2(0), g_max), 0).rgb;
+}
+
+float Luma(vec3 c) {
+	return c.b * 0.5 + (c.r * 0.5 + c.g);
+}
+
+void Tap(inout vec3 aC, inout float aW, vec2 off, vec2 dir, vec2 len, float lob, float clp, vec3 c) {
+	vec2 v;
+	v.x = off.x * dir.x + off.y * dir.y;
+	v.y = off.x * (-dir.y) + off.y * dir.x;
+	v *= len;
+	float d2 = min(v.x * v.x + v.y * v.y, clp);
+	float wB = (2.0 / 5.0) * d2 - 1.0;
+	float wA = lob * d2 - 1.0;
+	wB *= wB;
+	wA *= wA;
+	wB = (25.0 / 16.0) * wB - (25.0 / 16.0 - 1.0);
+	float w = wB * wA;
+	aC += c * w;
+	aW += w;
+}
+
+void Set(inout vec2 dir, inout float len, float w, float lA, float lB, float lC, float lD, float lE) {
+	float dc = lD - lC;
+	float cb = lC - lB;
+	float lenX = max(abs(dc), abs(cb));
+	lenX = lenX > 0.0 ? 1.0 / lenX : 0.0;
+	float dirX = lD - lB;
+	dir.x += dirX * w;
+	lenX = clamp(abs(dirX) * lenX, 0.0, 1.0);
+	lenX *= lenX;
+	len += lenX * w;
+	float ec = lE - lC;
+	float ca = lC - lA;
+	float lenY = max(abs(ec), abs(ca));
+	lenY = lenY > 0.0 ? 1.0 / lenY : 0.0;
+	float dirY = lE - lA;
+	dir.y += dirY * w;
+	lenY = clamp(abs(dirY) * lenY, 0.0, 1.0);
+	lenY *= lenY;
+	len += lenY * w;
+}
+
+void main() {
+	g_max = textureSize(source, 0) - ivec2(1);
+	vec2 pp = uv * vec2(textureSize(source, 0)) - vec2(0.5);
+	vec2 fp = floor(pp);
+	pp -= fp;
+	ivec2 p = ivec2(fp);
+	//    b c
+	//  e f g h
+	//  i j k l
+	//    n o
+	vec3 b = Fetch(p + ivec2(0, -1)), c = Fetch(p + ivec2(1, -1));
+	vec3 e = Fetch(p + ivec2(-1, 0)), f = Fetch(p), g = Fetch(p + ivec2(1, 0)), h = Fetch(p + ivec2(2, 0));
+	vec3 i = Fetch(p + ivec2(-1, 1)), j = Fetch(p + ivec2(0, 1)), k = Fetch(p + ivec2(1, 1)), l = Fetch(p + ivec2(2, 1));
+	vec3 n = Fetch(p + ivec2(0, 2)), o = Fetch(p + ivec2(1, 2));
+	float bL = Luma(b), cL = Luma(c), eL = Luma(e), fL = Luma(f), gL = Luma(g), hL = Luma(h);
+	float iL = Luma(i), jL = Luma(j), kL = Luma(k), lL = Luma(l), nL = Luma(n), oL = Luma(o);
+
+	vec2 dir = vec2(0.0);
+	float len = 0.0;
+	Set(dir, len, (1.0 - pp.x) * (1.0 - pp.y), bL, eL, fL, gL, jL);
+	Set(dir, len, pp.x * (1.0 - pp.y), cL, fL, gL, hL, kL);
+	Set(dir, len, (1.0 - pp.x) * pp.y, fL, iL, jL, kL, nL);
+	Set(dir, len, pp.x * pp.y, gL, jL, kL, lL, oL);
+
+	vec2 dir2 = dir * dir;
+	float dirR = dir2.x + dir2.y;
+	bool zro = dirR < 1.0 / 32768.0;
+	dirR = zro ? 1.0 : inversesqrt(dirR);
+	dir.x = zro ? 1.0 : dir.x;
+	dir *= dirR;
+	len = len * 0.5;
+	len *= len;
+	float stretch = (dir.x * dir.x + dir.y * dir.y) / max(abs(dir.x), abs(dir.y));
+	vec2 len2 = vec2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
+	float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
+	float clp = 1.0 / lob;
+
+	vec3 min4 = min(min(f, g), min(j, k));
+	vec3 max4 = max(max(f, g), max(j, k));
+	vec3 aC = vec3(0.0);
+	float aW = 0.0;
+	Tap(aC, aW, vec2(0.0, -1.0) - pp, dir, len2, lob, clp, b);
+	Tap(aC, aW, vec2(1.0, -1.0) - pp, dir, len2, lob, clp, c);
+	Tap(aC, aW, vec2(-1.0, 1.0) - pp, dir, len2, lob, clp, i);
+	Tap(aC, aW, vec2(0.0, 1.0) - pp, dir, len2, lob, clp, j);
+	Tap(aC, aW, vec2(0.0, 0.0) - pp, dir, len2, lob, clp, f);
+	Tap(aC, aW, vec2(-1.0, 0.0) - pp, dir, len2, lob, clp, e);
+	Tap(aC, aW, vec2(1.0, 1.0) - pp, dir, len2, lob, clp, k);
+	Tap(aC, aW, vec2(2.0, 1.0) - pp, dir, len2, lob, clp, l);
+	Tap(aC, aW, vec2(2.0, 0.0) - pp, dir, len2, lob, clp, h);
+	Tap(aC, aW, vec2(1.0, 0.0) - pp, dir, len2, lob, clp, g);
+	Tap(aC, aW, vec2(1.0, 2.0) - pp, dir, len2, lob, clp, o);
+	Tap(aC, aW, vec2(0.0, 2.0) - pp, dir, len2, lob, clp, n);
+	vec3 rgb = min(max4, max(min4, aC / aW));
+	color = vec4(rgb, 1.0);
+}
