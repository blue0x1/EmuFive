diff --git a/src/graphics/host_gpu/vma.cpp b/src/graphics/host_gpu/vma.cpp
index 63ba8e296a6d7c0a574275d71e47ebb424d4ccf0..53cbe98b80f1678a87517a0f1e3f1d02c088a7dd 100644
--- a/src/graphics/host_gpu/vma.cpp
+++ b/src/graphics/host_gpu/vma.cpp
@@ -25,7 +25,11 @@
 #include <cstdio>
 #include <cstdlib>
 #include <fmt/format.h>
+#include <map>
+#include <mutex>
 #include <string>
+#include <unordered_map>
+#include <vector>
 
 namespace Libs::Graphics {
 
@@ -79,6 +83,57 @@ bool GraphicContext::GpuMemoryLogEnabled() {
 	return enabled;
 }
 
+namespace {
+struct LiveAllocation {
+	uint64_t    size = 0;
+	std::string group;
+};
+std::mutex& LiveMutex() {
+	static std::mutex mutex;
+	return mutex;
+}
+std::unordered_map<VmaAllocation, LiveAllocation>& LiveAllocations() {
+	static std::unordered_map<VmaAllocation, LiveAllocation> live;
+	return live;
+}
+} // namespace
+
+void GraphicContext::NoteFree(VmaAllocation allocation) {
+	if (!GpuMemoryLogEnabled() || allocation == nullptr) {
+		return;
+	}
+	std::scoped_lock lock {LiveMutex()};
+	LiveAllocations().erase(allocation);
+}
+
+std::string GraphicContext::LiveMemorySummary() {
+	if (!GpuMemoryLogEnabled()) {
+		return {};
+	}
+	std::map<std::string, std::pair<uint64_t, uint32_t>> groups;
+	uint64_t images = 0;
+	uint64_t buffers = 0;
+	{
+		std::scoped_lock lock {LiveMutex()};
+		for (const auto& [allocation, live]: LiveAllocations()) {
+			auto& group = groups[live.group];
+			group.first += live.size;
+			group.second++;
+			(live.group.starts_with("image") ? images : buffers) += live.size;
+		}
+	}
+	std::vector<std::pair<std::string, std::pair<uint64_t, uint32_t>>> sorted(groups.begin(), groups.end());
+	std::sort(sorted.begin(), sorted.end(),
+	          [](const auto& a, const auto& b) { return a.second.first > b.second.first; });
+	std::string text = fmt::format("Live GPU memory: images {} MB, buffers {} MB\n", images >> 20u,
+	                               buffers >> 20u);
+	for (size_t i = 0; i < sorted.size() && i < 25; i++) {
+		text += fmt::format("  {:5} MB  x{:<4} {}\n", sorted[i].second.first >> 20u,
+		                    sorted[i].second.second, sorted[i].first);
+	}
+	return text;
+}
+
 // Logs each allocation of 4 MB or more, with the running total of all logged ones.
 void GraphicContext::NoteAllocation(const char* kind, VmaAllocation allocation,
                                     const std::string& what) const {
@@ -87,6 +142,15 @@ void GraphicContext::NoteAllocation(const char* kind, VmaAllocation allocation,
 	}
 	VmaAllocationInfo info {};
 	vmaGetAllocationInfo(allocator, allocation, &info);
+	{
+		// Group buffers by usage and flags, not by guest address.
+		std::string group = what;
+		if (const auto pos = group.find("usage"); std::string(kind) == "buffer" && pos != std::string::npos) {
+			group = group.substr(pos);
+		}
+		std::scoped_lock lock {LiveMutex()};
+		LiveAllocations()[allocation] = {info.size, std::string(kind) + " " + group};
+	}
 	static std::atomic<uint64_t> total = 0;
 	const auto                   sum   = total.fetch_add(info.size) + info.size;
 	if (info.size >= (4ull << 20u)) {
@@ -225,6 +289,7 @@ void GraphicContext::DeleteImage(VulkanImage& image) {
 	KYTY_PROFILER_FUNCTION();
 	EXIT_IF(allocator == nullptr || image.image == nullptr || image.allocation == nullptr);
 
+	NoteFree(image.allocation);
 	vmaDestroyImage(allocator, image.image, image.allocation);
 	image.image      = nullptr;
 	image.allocation = nullptr;
