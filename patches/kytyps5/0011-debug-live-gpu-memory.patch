 	if (m_buffer != nullptr) {
+		GraphicContext::NoteFree(m_allocation);
 		vmaDestroyBuffer(m_graphics->allocator, m_buffer, m_allocation);
 	}
 }
diff --git a/src/graphics/host_gpu/renderer/commandScheduler.cpp b/src/graphics/host_gpu/renderer/commandScheduler.cpp
index 501106493a9f78771073ae041c62ec81fe13a327..9b9929be13b88b7c5e6a37f68f784143420ca26a 100644
