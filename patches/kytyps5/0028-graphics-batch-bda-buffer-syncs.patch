From: Chokri Hammedi <52697989+blue0x1@users.noreply.github.com>
Subject: [PATCH] graphics: batch buffer syncs before address-reading shaders

Before a shader that reads guest memory by address, PrepareBda uploads
every range the CPU wrote since the last one. It did each buffer with its
own SynchronizeBuffer: a render-pass break and two full barriers apiece.
DREDGE writes ~330 cached buffers per frame this way.

Collect the ranges first, then do one staging upload, one render-pass
break and one barrier pair, then every copy. The perf log counts the
batches as "buffer-sync-batch" (work = buffers).

---
--- a/src/common/perfTrace.h
+++ b/src/common/perfTrace.h
@@ -32,6 +32,7 @@ enum Site : int {
 	WatchImageOn,
 	WatchImageOff,
 	StreamUpload,
+	BufferSyncBatch,
 	Count
 };
 
@@ -41,7 +42,7 @@ inline constexpr std::array<const char*, Count> Names {
     "image-via-buffer-down", "image-via-buffer-up", "image-copy-other", "draw-feedback-copy",
     "buffer-staging-copy", "buffer-download", "buffer-copy", "clear-color",
     "protect-buffer", "unprotect-buffer", "protect-image", "unprotect-image",
-    "stream-upload"};
+    "stream-upload", "buffer-sync-batch"};
 
 inline std::array<std::atomic<uint64_t>, Count> g_count {};
 inline std::array<std::atomic<uint64_t>, Count> g_work {};
--- a/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
+++ b/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
@@ -785,10 +785,70 @@ void BufferCache::SynchronizeBuffersInRange(uint64_t vaddr, uint64_t size) {
 		auto&      buffer = m_slot_buffers[it->second];
 		const auto start  = std::max(buffer.CpuAddress(), vaddr);
 		const auto finish = std::min(buffer.CpuAddress() + buffer.Size(), end);
-		if (start < finish) {
-			(void)SynchronizeBuffer(buffer, start, finish - start, false, false);
+		if (start >= finish) {
+			continue;
 		}
+		const auto first = m_batch_copies.size();
+		m_memory_tracker.ForEachUploadRange(
+		    start, finish - start, false,
+		    [&](uint64_t address, uint64_t bytes) noexcept {
+			    m_batch_copies.emplace_back(m_batch_size, buffer.Offset(address), bytes);
+			    m_batch_size += bytes;
+		    },
+		    []() noexcept {});
+		if (m_batch_copies.size() > first) {
+			m_batch_buffers.push_back({&buffer, first, m_batch_copies.size() - first});
+		}
+	}
+}
+
+// Shaders that read guest memory by address sync every range the CPU wrote since the last
+// such draw. One upload, one render-pass break and one barrier pair cover all of them,
+// instead of a pair of full barriers per buffer.
+void BufferCache::FlushBufferSyncs() {
+	if (m_batch_buffers.empty()) {
+		return;
 	}
+	Common::DebugCounters::Add(Common::DebugCounters::Counter::BufferUploadBytes, m_batch_size);
+	const auto staging = UploadMemory(m_graphics, m_scheduler, m_staging_buffer, m_batch_size, 4,
+	    vk::BufferUsageFlagBits::eTransferSrc, [&](uint8_t* mapped, uint64_t base_offset) {
+		for (const auto& pending: m_batch_buffers) {
+			for (uint64_t i = 0; i < pending.count; i++) {
+				auto&      copy    = m_batch_copies[pending.first + i];
+				const auto address = pending.buffer->CpuAddress() + copy.dstOffset;
+				if (!LibKernel::Memory::CopySparseMemory(address, mapped + copy.srcOffset,
+				                                         copy.size)) {
+					EXIT("BufferCache: failed to read sparse guest buffer memory\n");
+				}
+				copy.srcOffset += base_offset;
+			}
+		}
+	});
+	auto& command = m_scheduler.Current();
+	command.EndRendering();
+	const auto        native = command.Handle();
+	vk::MemoryBarrier before {};
+	before.srcAccessMask = vk::AccessFlagBits::eMemoryRead | vk::AccessFlagBits::eMemoryWrite |
+	                       vk::AccessFlagBits::eTransferRead | vk::AccessFlagBits::eTransferWrite;
+	before.dstAccessMask = vk::AccessFlagBits::eTransferWrite;
+	native.pipelineBarrier(vk::PipelineStageFlagBits::eAllCommands,
+	                       vk::PipelineStageFlagBits::eTransfer, vk::DependencyFlagBits::eByRegion,
+	                       1, &before, 0, nullptr, 0, nullptr);
+	Common::PerfTrace::Add(Common::PerfTrace::BufferSyncBatch, m_batch_buffers.size());
+	for (const auto& pending: m_batch_buffers) {
+		native.copyBuffer(staging.first->Handle(), pending.buffer->Handle(),
+		                  static_cast<uint32_t>(pending.count), m_batch_copies.data() + pending.first);
+	}
+	GpuProfile::Stamp(native, "buffer-copy");
+	vk::MemoryBarrier after {};
+	after.srcAccessMask = vk::AccessFlagBits::eTransferWrite;
+	after.dstAccessMask = vk::AccessFlagBits::eMemoryRead | vk::AccessFlagBits::eMemoryWrite;
+	native.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer,
+	                       vk::PipelineStageFlagBits::eAllCommands, vk::DependencyFlagBits::eByRegion,
+	                       1, &after, 0, nullptr, 0, nullptr);
+	m_batch_buffers.clear();
+	m_batch_copies.clear();
+	m_batch_size = 0;
 }
 
 } // namespace Libs::Graphics
--- a/src/graphics/host_gpu/renderer/cache/bufferCache.h
+++ b/src/graphics/host_gpu/renderer/cache/bufferCache.h
@@ -86,7 +86,9 @@ public:
 	void               MarkColorMetadataChecked(uint64_t vaddr, uint64_t size, uint32_t keys);
 	[[nodiscard]] bool IsColorMetadataChecked(uint64_t vaddr, uint64_t size, uint32_t keys) const;
 	void               ProcessFaultBuffer();
+	// Collects CPU-modified ranges of the cached buffers in range; FlushBufferSyncs records them.
 	void               SynchronizeBuffersInRange(uint64_t vaddr, uint64_t size);
+	void               FlushBufferSyncs();
 	// Queue after the range's state change becomes visible, or a drain could consume it first.
 	void                   QueueBdaSync(uint64_t vaddr, uint64_t size);
 	[[nodiscard]] RangeSet TakeBdaSync();
@@ -152,6 +154,14 @@ private:
 	uint64_t m_trigger_gc_memory  = 1ull * 1024 * 1024 * 1024;
 	uint64_t m_critical_gc_memory = 2ull * 1024 * 1024 * 1024;
 	uint64_t m_gc_tick            = 0;
+	struct PendingSync {
+		Buffer*  buffer;
+		uint64_t first;
+		uint64_t count;
+	};
+	std::vector<PendingSync>    m_batch_buffers;
+	std::vector<vk::BufferCopy> m_batch_copies;
+	uint64_t                    m_batch_size = 0;
 };
 
 } // namespace Libs::Graphics
--- a/src/graphics/host_gpu/renderer/renderContext.cpp
+++ b/src/graphics/host_gpu/renderer/renderContext.cpp
@@ -134,6 +134,7 @@ void RenderContext::PrepareBda() {
 			m_buffer_cache.SynchronizeBuffersInRange(start, finish - start);
 		});
 	});
+	m_buffer_cache.FlushBufferSyncs();
 	m_fault_process_pending = true;
 }
 
