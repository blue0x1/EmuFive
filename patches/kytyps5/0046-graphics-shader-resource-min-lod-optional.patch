From: EmuFive <blue0x1>
Date: 2026-11-25
Subject: [PATCH 0046] graphics: shaderResourceMinLod is optional

Upstream KytyPS5 now needs shaderResourceMinLod, which the PS4's GCN2 GPU
(RADV Liverpool/Gladius) does not have, so no device was found. The feature is
now enabled only when the GPU has it; without it, image samples with a LOD
clamp (implicit LOD or gradients) drop the clamp. Explicit-LOD samples still
clamp with a max.

diff --git a/src/graphics/host_gpu/renderer/pipeline/shaderResourceBarrier.cpp b/src/graphics/host_gpu/renderer/pipeline/shaderResourceBarrier.cpp
index 5533e595417a9a64998b0737fcbba5c72c22a20b..fb37724367348ecb27c0b1ce19318f5f2a2dcee2 100644
--- a/src/graphics/host_gpu/renderer/pipeline/shaderResourceBarrier.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/shaderResourceBarrier.cpp
@@ -12,6 +12,7 @@ namespace Libs::Graphics {
 namespace {
 bool g_mesh_programs_run_as_compute = false;
 bool g_fragment_shader_barycentric  = false;
+bool g_shader_resource_min_lod     = true;
 } // namespace
 
 void SetMeshProgramsRunAsCompute(bool value) {
@@ -30,6 +31,14 @@ bool FragmentShaderBarycentric() {
 	return g_fragment_shader_barycentric;
 }
 
+void SetShaderResourceMinLod(bool value) {
+	g_shader_resource_min_lod = value;
+}
+
+bool ShaderResourceMinLod() {
+	return g_shader_resource_min_lod;
+}
+
 vk::ShaderStageFlagBits NativeShaderStage(ShaderType stage) {
 	switch (stage) {
 		case ShaderType::Local:
