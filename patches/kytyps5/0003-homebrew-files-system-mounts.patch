From: Chokri Hammedi <52697989+blue0x1@users.noreply.github.com>
Subject: [PATCH] homebrew: files, directories, system calls, foreground user, extra mounts

For PS5 homebrew built with the ps5-native-app-boilerplate (Snes9x PS5):
- LibcCompat: opendir/readdir/closedir (packed PS5 dirents from
  KernelGetdents), lstat, access, rename, realpath, readv/writev, sysconf,
  getenv, signal functions that accept a handler and never call it, poll
  that waits out its timeout, inet_pton/ntop/aton, and small stubs.
- UserService: sceUserServiceGetForegroundUser (the configured user).
- LibcInternal fflush: any stream, not only stdout (guest FILE* are host ones).
- KYTY_MOUNTS: host folders as guest paths, for example
  "/data=/home/ps5/data;/mnt/usb0=/media/ps5-usb".
---
diff --git a/src/emulator.cpp b/src/emulator.cpp
index 306bf9e..4058b42 100644
--- a/src/emulator.cpp
+++ b/src/emulator.cpp
@@ -86,6 +86,38 @@ static void MountSandboxDirs() {
 	MountOrCreateDir("_DownloadData/" + title_id, "/download0");
 	MountOrCreateDir("_TempData/" + title_id, "/temp0");
 	MountOrCreateDir("_TempData/" + title_id, "/temp");
+
+	// KYTY_MOUNTS adds host folders as guest paths, for example
+	// "/data=/home/user/ps5-data;/mnt/usb0=/media/usb". A missing folder is created.
+	if (const char* mounts = std::getenv("KYTY_MOUNTS"); mounts != nullptr) {
+		std::string list = mounts;
+		size_t      i    = 0;
+		while (i < list.size()) {
+			size_t end = list.find(';', i);
+			if (end == std::string::npos) {
+				end = list.size();
+			}
+			std::string entry = list.substr(i, end - i);
+			size_t      eq    = entry.find('=');
+			if (eq != std::string::npos && eq > 0 && entry[0] == '/' && eq + 1 < entry.size()) {
+				auto dir   = Common::PathFromUtf8(entry.substr(eq + 1));
+				auto point = entry.substr(0, eq);
+				if (!Common::File::IsDirectoryExisting(dir)) {
+					Common::File::CreateDirectories(dir);
+				}
+				if (Common::File::IsDirectoryExisting(dir)) {
+					Libs::LibKernel::FileSystem::Mount(dir, point);
+					LOGF("Mounted %s -> %s\n", point.c_str(), Common::PathToString(dir).c_str());
+				} else {
+					LOGF("KYTY_MOUNTS: %s is not a folder, %s not mounted\n",
+					     Common::PathToString(dir).c_str(), point.c_str());
+				}
+			} else if (!entry.empty()) {
+				LOGF("KYTY_MOUNTS: ignoring \"%s\" (expected /guest/path=host/path)\n", entry.c_str());
+			}
+			i = end + 1;
+		}
+	}
 }
 
