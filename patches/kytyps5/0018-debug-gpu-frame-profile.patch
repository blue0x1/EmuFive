diff --git a/src/graphics/host_gpu/renderer/gpuProfile.h b/src/graphics/host_gpu/renderer/gpuProfile.h
new file mode 100644
index 0000000000000000000000000000000000000000..c40b5c7e3bb7dc8e0dc04f9d530547846a62996d
--- /dev/null
+++ b/src/graphics/host_gpu/renderer/gpuProfile.h
@@ -0,0 +1,126 @@
+#ifndef EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_GPUPROFILE_H_
+#define EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_GPUPROFILE_H_
+
+// Debug: times one frame in every 16 on the GPU (with a perf-log file in the working folder).
+// A timestamp after each guest draw and dispatch and each emulator pass; the time since the
+// previous one is charged to it. The GPU thread records; results are read once that frame's
+// submits complete.
+#include "common/logging/log.h"
+#include "graphics/host_gpu/graphicContext.h"
+#include "graphics/host_gpu/renderer/commandScheduler.h"
+
+#include <algorithm>
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <fmt/format.h>
+
+namespace Libs::Graphics::GpuProfile {
+
+struct Label {
+	const char* kind = "";
+	uint64_t    key  = 0;
+	uint32_t    w    = 0;
+	uint32_t    h    = 0;
+};
+
+struct State {
+	vk::Device         device  = nullptr;
+	vk::QueryPool      pool    = nullptr;
+	double             period  = 1.0;
+	bool               recording = false;
+	bool               reading   = false;
+	uint32_t           flips     = 0;
+	std::vector<Label> labels;
+};
+
+inline constexpr uint32_t MaxStamps = 8192;
+
+inline State& Get() {
+	static State state;
+	return state;
+}
+
+inline void Stamp(vk::CommandBuffer command, const char* kind, uint64_t key = 0, uint32_t w = 0,
+                  uint32_t h = 0) {
+	auto& s = Get();
+	if (!s.recording || s.labels.size() >= MaxStamps) {
+		return;
+	}
+	command.writeTimestamp(vk::PipelineStageFlagBits::eBottomOfPipe, s.pool,
+	                       static_cast<uint32_t>(s.labels.size()));
+	s.labels.push_back({kind, key, w, h});
+}
+
+// At each flip, on the GPU thread, after the flip's command list was flushed.
+inline void OnFlip(GraphicContext& graphics, CommandScheduler& scheduler) {
+	auto& s = Get();
+	if (s.pool == nullptr) {
+		s.device = graphics.device;
+		vk::QueryPoolCreateInfo info {};
+		info.queryType  = vk::QueryType::eTimestamp;
+		info.queryCount = MaxStamps;
+		if (graphics.device.createQueryPool(&info, nullptr, &s.pool) != vk::Result::eSuccess) {
+			s.pool = nullptr;
+			return;
+		}
+		s.period = graphics.physical_device_properties.limits.timestampPeriod;
+	}
+	if (s.recording) {
+		scheduler.EndRendering();
+		Stamp(scheduler.Current().Handle(), "end-of-frame");
+		s.recording = false;
+		s.reading   = true;
+		auto labels = std::make_shared<std::vector<Label>>(std::move(s.labels));
+		s.labels.clear();
+		scheduler.DeferOperation([labels] {
+			auto& state = Get();
+			std::vector<uint64_t> stamps(labels->size());
+			const auto result = state.device.getQueryPoolResults(
+			    state.pool, 0, static_cast<uint32_t>(stamps.size()),
+			    stamps.size() * sizeof(uint64_t), stamps.data(), sizeof(uint64_t),
+			    vk::QueryResultFlagBits::e64);
+			state.reading = false;
+			if (result != vk::Result::eSuccess || stamps.size() < 2) {
+				return;
+			}
+			std::map<std::string, std::pair<double, uint32_t>> groups;
+			double total = 0;
+			for (size_t i = 1; i < stamps.size(); i++) {
+				const double ms = static_cast<double>(stamps[i] - stamps[i - 1]) * state.period / 1e6;
+				total += ms;
+				const auto& l   = (*labels)[i];
+				auto&       g   = groups[l.w != 0 ? fmt::format("{} {:016x} {}x{}", l.kind, l.key, l.w, l.h)
+				                                  : fmt::format("{} {:016x}", l.kind, l.key)];
+				g.first += ms;
+				g.second++;
+			}
+			std::vector<std::pair<std::string, std::pair<double, uint32_t>>> sorted(groups.begin(),
+			                                                                       groups.end());
+			std::sort(sorted.begin(), sorted.end(),
+			          [](const auto& a, const auto& b) { return a.second.first > b.second.first; });
+			std::string text = fmt::format("GPU frame profile: {:.1f} ms in {} stamps\n", total,
+			                               stamps.size());
+			for (size_t i = 0; i < sorted.size() && i < 25; i++) {
+				text += fmt::format("  {:7.1f} ms  x{:<4} {}\n", sorted[i].second.first,
+				                    sorted[i].second.second, sorted[i].first);
+			}
+			Log::WriteToConsoleAndLog(text);
+		});
+		return;
+	}
+	if (!s.reading && (++s.flips % 16u) == 0u) {
+		scheduler.EndRendering();
+		auto command = scheduler.Current().Handle();
+		command.resetQueryPool(s.pool, 0, MaxStamps);
+		s.recording = true;
+		Stamp(command, "start");
+	}
+}
+
+} // namespace Libs::Graphics::GpuProfile
+
+#endif // EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_GPUPROFILE_H_
