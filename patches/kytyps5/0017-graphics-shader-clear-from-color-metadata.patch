+bool BlitHelper::CanPredicatedClear(vk::Format format) const {
+	const auto limit = m_graphics.GetPhysicalDeviceProperties().limits.maxPushConstantsSize;
+	const std::string_view numeric = vk::componentNumericFormat(format, 0);
+	return limit >= sizeof(float) * 4 * 8 + sizeof(uint32_t) * 2 && numeric != "UINT" &&
+	       numeric != "SINT" && vk::componentCount(format) != 0 &&
+	       !vk::isCompressed(format);
+}
+
+vk::Pipeline BlitHelper::GetClearPipeline(PipelineKey key) {
+	const auto cached = std::ranges::find(m_clear_pipelines, key, &Pipeline::key);
+	if (cached != m_clear_pipelines.end()) {
+		return cached->handle;
+	}
+	const auto samples = vulkan_sample_count(key.samples);
+	EXIT_IF(samples == vk::SampleCountFlagBits {} || key.format == vk::Format::eUndefined);
+
+	std::array<vk::PipelineShaderStageCreateInfo, 2> stages {};
+	stages[0].stage  = vk::ShaderStageFlagBits::eVertex;
+	stages[0].module = m_vertex_shader;
+	stages[0].pName  = "main";
+	stages[1].stage  = vk::ShaderStageFlagBits::eFragment;
+	stages[1].module = m_clear_shader;
+	stages[1].pName  = "main";
+
+	vk::PipelineVertexInputStateCreateInfo   vertex_input {};
+	vk::PipelineInputAssemblyStateCreateInfo input_assembly {};
+	input_assembly.topology = vk::PrimitiveTopology::eTriangleList;
+	vk::PipelineViewportStateCreateInfo viewport {};
+	viewport.viewportCount = 1;
+	viewport.scissorCount  = 1;
+	vk::PipelineRasterizationStateCreateInfo rasterization {};
+	rasterization.lineWidth = 1.0f;
+	vk::PipelineMultisampleStateCreateInfo multisample {};
+	multisample.rasterizationSamples = samples;
+	vk::PipelineDepthStencilStateCreateInfo depth {};
+	vk::PipelineColorBlendAttachmentState   attachment {};
+	attachment.colorWriteMask = vk::ColorComponentFlagBits::eR | vk::ColorComponentFlagBits::eG |
+	                            vk::ColorComponentFlagBits::eB | vk::ColorComponentFlagBits::eA;
+	vk::PipelineColorBlendStateCreateInfo color_blend {};
+	color_blend.attachmentCount = 1;
+	color_blend.pAttachments    = &attachment;
+	const std::array dynamic_states {vk::DynamicState::eViewport, vk::DynamicState::eScissor};
+	vk::PipelineDynamicStateCreateInfo dynamic {};
+	dynamic.dynamicStateCount = static_cast<uint32_t>(dynamic_states.size());
+	dynamic.pDynamicStates    = dynamic_states.data();
+
+	vk::PipelineRenderingCreateInfo rendering {};
+	rendering.colorAttachmentCount    = 1;
+	rendering.pColorAttachmentFormats = &key.format;
+
+	vk::GraphicsPipelineCreateInfo create {};
+	create.pNext               = &rendering;
+	create.stageCount          = static_cast<uint32_t>(stages.size());
+	create.pStages             = stages.data();
+	create.pVertexInputState   = &vertex_input;
+	create.pInputAssemblyState = &input_assembly;
+	create.pViewportState      = &viewport;
+	create.pRasterizationState = &rasterization;
+	create.pMultisampleState   = &multisample;
+	create.pDepthStencilState  = &depth;
+	create.pColorBlendState    = &color_blend;
+	create.pDynamicState       = &dynamic;
+	create.layout              = m_clear_pipeline_layout;
+
+	vk::Pipeline pipeline = nullptr;
+	RequireVulkanSuccess(
+	    m_graphics.device.createGraphicsPipelines(nullptr, 1, &create, nullptr, &pipeline),
+	    "create predicated clear pipeline");
+	m_clear_pipelines.push_back({key, pipeline});
+	return pipeline;
+}
+
+void BlitHelper::PredicatedClear(vk::CommandBuffer command, vk::Format format, uint32_t samples,
+                                 vk::Buffer predicates, uint32_t first, uint32_t keys,
+                                 const std::array<vk::ClearColorValue, 8>& colors,
+                                 vk::Rect2D area) {
+	struct Push {
+		float    colors[8][4];
+		uint32_t first;
+		uint32_t keys;
+	} push {};
+	for (size_t key = 0; key < colors.size(); key++) {
+		std::memcpy(push.colors[key], colors[key].float32.data(), sizeof(push.colors[key]));
+	}
+	push.first = first;
+	push.keys  = keys;
+
+	vk::DescriptorBufferInfo buffer {predicates, 0, VK_WHOLE_SIZE};
+	vk::WriteDescriptorSet   write {};
+	write.dstBinding      = 0;
+	write.descriptorCount = 1;
+	write.descriptorType  = vk::DescriptorType::eStorageBuffer;
+	write.pBufferInfo     = &buffer;
+	command.bindPipeline(vk::PipelineBindPoint::eGraphics, GetClearPipeline({samples, format}));
+	command.pushDescriptorSetKHR(vk::PipelineBindPoint::eGraphics, m_clear_pipeline_layout, 0, 1,
+	                             &write);
+	command.pushConstants(m_clear_pipeline_layout, vk::ShaderStageFlagBits::eFragment, 0,
+	                      sizeof(push), &push);
+	const vk::Viewport viewport {static_cast<float>(area.offset.x),
+	                             static_cast<float>(area.offset.y),
+	                             static_cast<float>(area.extent.width),
+	                             static_cast<float>(area.extent.height),
+	                             0.0f,
+	                             1.0f};
+	command.setViewport(0, 1, &viewport);
+	command.setScissor(0, 1, &area);
+	command.draw(3, 1, 0, 0);
+	// The helper pipeline has static state that invalidates the guest draw's dynamic state.
+	m_scheduler.GetDynamicState().Invalidate();
+}
+
 } // namespace Libs::Graphics
diff --git a/src/graphics/host_gpu/renderer/cache/textureCache.cpp b/src/graphics/host_gpu/renderer/cache/textureCache.cpp
index 2d83130..caf0d2c 100644
--- a/src/graphics/host_gpu/renderer/cache/textureCache.cpp
+++ b/src/graphics/host_gpu/renderer/cache/textureCache.cpp
@@ -1111,6 +1111,44 @@ void TextureCache::MaterializeColorClear(ImageId id, const ImageDesc& desc,
 				CommitGpuWrite(image);
 				return;
 			}
+			// Without usable conditional rendering (the PS4's GPUs hang on it), a fragment
+			// shader applies the key the GPU check found, so the CPU still never waits.
+			// Reading the metadata back instead stalled the GPU each time: 29 times a frame
+			// in Invincible VS's menu, most of its frame time.
+			if (!m_graphics.conditional_rendering_enabled &&
+			    count <= m_graphics.GetPhysicalDeviceProperties().limits.maxFramebufferLayers &&
+			    m_blit_helper.CanPredicatedClear(view.format) &&
+			    (image.backing.usage & vk::ImageUsageFlagBits::eColorAttachment) &&
+			    (m_graphics.GetFormatProperties(view.format).optimalTilingFeatures &
+			     vk::FormatFeatureFlagBits::eColorAttachment) &&
+			    (desc.info.metadata.compression == VideoOutCompression::Uncompressed ||
+			     native_current)) {
+				Common::DebugCounters::Add(Common::DebugCounters::Counter::ColorMetadataChecks);
+				InitializeImage(id);
+				const bool expand = desc.type != BindingType::VideoOut;
+				const auto [buffer, offset] =
+				    m_buffer_cache.ObtainBuffer(viewed.address, viewed.size, expand);
+				const auto predicates = m_tiler.CheckColorClear(
+				    {buffer->Handle(), offset, viewed.size}, slice_size, count, keys, expand);
+				for (uint32_t slice = 0; slice < count && expand; slice++) {
+					m_buffer_cache.MarkColorMetadataChecked(run(slice), mip.size, keys);
+				}
+				std::array<vk::ClearColorValue, TileManager::ColorClearSlots> colors {};
+				for (uint32_t key = 0; key < colors.size(); key++) {
+					colors[key] = clears[key].clearValue.color;
+				}
+				const auto command = m_scheduler.Current().Handle();
+				for (uint32_t slice = 0; slice < count; slice++) {
+					const auto area = BeginColorRendering(image, view.format, view.base_level,
+					                                      image_first + slice, 1, nullptr, command);
+					m_blit_helper.PredicatedClear(command, view.format, image.info.samples,
+					                              predicates, slice * TileManager::ColorClearSlots,
+					                              keys, colors, area);
+					command.endRendering();
+				}
+				CommitGpuWrite(image);
+				return;
+			}
 		}
 		// Finish native metadata writes before reading backing bytes. This can submit the
 		// scheduler, so discovery runs before final draw uploads and never holds the texture
