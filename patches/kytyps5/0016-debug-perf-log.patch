@@ -1054,6 +1056,65 @@ void CommandProcessor::Flip(int handle, int index, int flip_mode, int64_t flip_a
 
 void CommandProcessor::NoteFlipForGc() {
 	auto& gpu = m_renderer.GetGpu();
+	static const bool perf_log = [] {
+		std::FILE* probe = std::fopen("perf-log", "r");
+		if (probe != nullptr) {
+			std::fclose(probe);
+		}
+		return probe != nullptr;
+	}();
+	if (perf_log) {
+		// Every 16 flips: what the GPU thread did, per flip.
+		using Common::DebugCounters::Counter;
+		static uint64_t   perf_flips = 0;
+		static auto       last       = std::chrono::steady_clock::now();
+		static std::array<uint64_t, static_cast<int>(Counter::Count)> counters {};
+		static std::array<uint64_t, Common::PerfTrace::Count>         counts {};
+		static std::array<uint64_t, Common::PerfTrace::Count>         works {};
+		if ((++perf_flips & 15u) == 0u) {
+			const auto now = std::chrono::steady_clock::now();
+			const double seconds = std::chrono::duration<double>(now - last).count();
+			last = now;
+			std::string text = fmt::format("Perf flips {}: {:.2f} fps |", perf_flips, 16.0 / seconds);
+			const auto delta = [](uint64_t& old, uint64_t value) {
+				const auto d = value - old;
+				old          = value;
+				return d;
+			};
+			static constexpr std::pair<Counter, const char*> shown[] = {
+			    {Counter::Draws, "draws"}, {Counter::Dispatches, "dispatches"},
+			    {Counter::QueueSubmits, "submits"}, {Counter::GpuWaits, "gpu-waits"},
+			    {Counter::GpuWaitNs, "gpu-wait-ms"}, {Counter::GpuFaults, "faults"},
+			    {Counter::ShadersCompiled, "shaders"}, {Counter::PipelinesCreated, "pipelines"},
+			    {Counter::PipelineCreateNs, "pipeline-ms"},
+			    {Counter::TextureUploadBytes, "tex-up-MB"}, {Counter::TextureDownloadBytes, "tex-down-MB"},
+			    {Counter::ColorMetadataReadbacks, "meta-readbacks"},
+			    {Counter::ColorMetadataReadbackNs, "meta-readback-ms"},
+			    {Counter::ColorMetadataChecks, "meta-checks"},
+			    {Counter::BufferUploadBytes, "buf-up-MB"}, {Counter::BufferDownloadBytes, "buf-down-MB"},
+			    {Counter::GpuThreadBusyNs, "gpu-thread-busy-ms"}};
+			for (const auto& [counter, name]: shown) {
+				auto value = delta(counters[static_cast<int>(counter)],
+				                   Common::DebugCounters::Get(counter));
+				if (std::string_view(name).ends_with("-ms")) {
+					value /= 1000000u;
+				} else if (std::string_view(name).ends_with("-MB")) {
+					value >>= 20u;
+				}
+				text += fmt::format(" {} {:.1f}", name, static_cast<double>(value) / 16.0);
+			}
+			text += " | emulator work per flip:";
+			for (int site = 0; site < Common::PerfTrace::Count; site++) {
+				const auto n = delta(counts[site], Common::PerfTrace::g_count[site].load());
+				const auto w = delta(works[site], Common::PerfTrace::g_work[site].load());
+				if (n != 0) {
+					text += fmt::format(" {} {:.1f} (work {:.0f})", Common::PerfTrace::Names[site],
+					                    static_cast<double>(n) / 16.0, static_cast<double>(w) / 16.0);
+				}
+			}
+			Log::WriteToConsoleAndLog(text + "\n");
+		}
+	}
 	if (GraphicContext::GpuMemoryLogEnabled()) {
 		static uint64_t   flips = 0;
 		static const auto start = std::chrono::steady_clock::now();
