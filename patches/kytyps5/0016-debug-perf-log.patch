From: Chokri Hammedi <52697989+blue0x1@users.noreply.github.com>
Subject: [PATCH] debug: log per-flip GPU work with a perf-log file

With a file named perf-log in the working folder, every 16 flips the log gets
the frame rate, the performance counters per flip, and how often each place
where the emulator records its own GPU work (tiling, image copies, buffer
copies) ran. Not for a release.

diff --git a/src/common/perfTrace.h b/src/common/perfTrace.h
new file mode 100644
index 00000000..cc00c524
--- /dev/null
+++ b/src/common/perfTrace.h
@@ -0,0 +1,49 @@
+#ifndef EMULATOR_INCLUDE_EMULATOR_COMMON_PERFTRACE_H_
+#define EMULATOR_INCLUDE_EMULATOR_COMMON_PERFTRACE_H_
+
+// Debug: counts the GPU work the emulator records besides the game's own draws.
+#include <array>
+#include <atomic>
+#include <cstdint>
+
+namespace Common::PerfTrace {
+
+enum Site : int {
+	GameDispatch,
+	TilerConvert,
+	TilerRows,
+	TilerColor,
+	TilerClearCheck,
+	ImageUpload,
+	ImageDownload,
+	ImageCopy,
+	ImageCopyMips,
+	ImageResolve,
+	ImageViaBufferDown,
+	ImageViaBufferUp,
+	ImageCopyOther,
+	DrawFeedbackCopy,
+	BufferStagingCopy,
+	BufferDownload,
+	BufferCopy,
+	ClearColor,
+	Count
+};
+
+inline constexpr std::array<const char*, Count> Names {
+    "game-dispatch", "tiler-convert", "tiler-rows", "tiler-color", "tiler-clear-check",
+    "image-upload", "image-download", "image-copy", "image-copy-mips", "image-resolve",
+    "image-via-buffer-down", "image-via-buffer-up", "image-copy-other", "draw-feedback-copy",
+    "buffer-staging-copy", "buffer-download", "buffer-copy", "clear-color"};
+
+inline std::array<std::atomic<uint64_t>, Count> g_count {};
+inline std::array<std::atomic<uint64_t>, Count> g_work {};
+
+inline void Add(Site site, uint64_t work = 0) noexcept {
+	g_count[site].fetch_add(1, std::memory_order_relaxed);
+	g_work[site].fetch_add(work, std::memory_order_relaxed);
+}
+
+} // namespace Common::PerfTrace
+
+#endif /* EMULATOR_INCLUDE_EMULATOR_COMMON_PERFTRACE_H_ */
