 Buffer::~Buffer() {
+	if (m_sparse_page != 0) {
+		m_graphics->device.destroyBuffer(m_buffer, nullptr);
+		for (auto* page: m_sparse_pages) {
+			if (page != nullptr) {
+				vmaFreeMemory(m_graphics->allocator, page);
+			}
+		}
+		return;
+	}
 	if (m_buffer != nullptr) {
 		vmaDestroyBuffer(m_graphics->allocator, m_buffer, m_allocation);
 	}
 }
 
+void Buffer::MakeResident(uint64_t offset, uint64_t size) {
+	if (m_sparse_page == 0 || size == 0) {
+		return;
+	}
+	EXIT_IF(offset > m_size || size > m_size - offset);
+	auto&      graphics = *m_graphics;
+	const auto first    = offset / m_sparse_page;
+	const auto last     = (offset + size - 1) / m_sparse_page;
+	std::vector<vk::SparseMemoryBind> binds;
+	for (auto page = first; page <= last; page++) {
+		if (m_sparse_pages[page] != nullptr) {
+			continue;
+		}
+		// Host-visible device memory (the PS4's GPUs share the system's memory) is zeroed
+		// before it is bound, so work already recorded never reads garbage from it.
+		VkMemoryRequirements requirements {};
+		requirements.size           = m_sparse_page;
+		requirements.alignment      = m_sparse_page;
+		requirements.memoryTypeBits = m_sparse_type_bits;
+		VmaAllocationCreateInfo create {};
+		create.flags          = VMA_ALLOCATION_CREATE_MAPPED_BIT;
+		create.usage          = VMA_MEMORY_USAGE_UNKNOWN;
+		create.requiredFlags  = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT;
+		create.preferredFlags = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
+		VmaAllocation     allocation = nullptr;
+		VmaAllocationInfo info {};
+		const auto        result = static_cast<vk::Result>(
+		    vmaAllocateMemory(graphics.allocator, &requirements, &create, &allocation, &info));
+		EXIT_NOT_IMPLEMENTED(result != vk::Result::eSuccess || info.pMappedData == nullptr);
+		std::memset(info.pMappedData, 0, static_cast<size_t>(m_sparse_page));
+		vmaFlushAllocation(graphics.allocator, allocation, 0, VK_WHOLE_SIZE);
+		m_sparse_pages[page] = allocation;
+		binds.push_back(vk::SparseMemoryBind {.resourceOffset = page * m_sparse_page,
+		                                      .size           = m_sparse_page,
+		                                      .memory         = info.deviceMemory,
+		                                      .memoryOffset   = info.offset});
+	}
+	if (binds.empty()) {
+		return;
+	}
+	const vk::SparseBufferMemoryBindInfo buffer_bind {
+	    .buffer = m_buffer, .bindCount = static_cast<uint32_t>(binds.size()), .pBinds = binds.data()};
+	vk::BindSparseInfo bind {};
+	bind.bufferBindCount = 1;
+	bind.pBufferBinds    = &buffer_bind;
+	const vk::FenceCreateInfo fence_info {};
+	vk::Fence                 fence = nullptr;
+	EXIT_NOT_IMPLEMENTED(graphics.device.createFence(&fence_info, nullptr, &fence) !=
+	                     vk::Result::eSuccess);
+	{
+		Common::LockGuard lock(graphics.queue_mutex);
+		EXIT_NOT_IMPLEMENTED(graphics.queue.bindSparse(1, &bind, fence) != vk::Result::eSuccess);
+	}
+	EXIT_NOT_IMPLEMENTED(graphics.device.waitForFences(1, &fence, VK_TRUE, UINT64_MAX) !=
+	                     vk::Result::eSuccess);
+	graphics.device.destroyFence(fence, nullptr);
+}
