 	     graphics.occlusion_query_precise_enabled ? "true" : "false");
+	// Sparse residency buffers keep the BDA page table (768 MB of mostly zeros) to the parts in
+	// use. Unbound parts must read as zero, so they need residencyNonResidentStrict.
+	{
+		uint32_t family_count = 0;
+		physical_device.getQueueFamilyProperties(&family_count, nullptr);
+		std::vector<vk::QueueFamilyProperties> families(family_count);
+		physical_device.getQueueFamilyProperties(&family_count, families.data());
+		vk::PhysicalDeviceProperties sparse_properties {};
+		physical_device.getProperties(&sparse_properties);
+		graphics.sparse_buffer_enabled =
+		    supported2.features.sparseBinding && supported2.features.sparseResidencyBuffer &&
+		    sparse_properties.sparseProperties.residencyNonResidentStrict &&
+		    queue_family < family_count &&
+		    static_cast<bool>(families[queue_family].queueFlags & vk::QueueFlagBits::eSparseBinding) &&
+		    std::getenv("KYTY_NO_SPARSE_PAGETABLE") == nullptr;
+		device_features.sparseBinding         = graphics.sparse_buffer_enabled;
+		device_features.sparseResidencyBuffer = graphics.sparse_buffer_enabled;
+		LOGF("Vulkan sparse residency buffers: %s\n", graphics.sparse_buffer_enabled ? "true" : "false");
+	}
 	device_features.shaderInt64 = VK_TRUE;
 	device_features.shaderFloat64 =
 	    supported2.features.shaderFloat64 && float_controls.shaderSignedZeroInfNanPreserveFloat64;
