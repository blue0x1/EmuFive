+// EmuFive: a new GPU-shared chunk moves 32 MB of guest memory into GTT, where it stays pinned for
+// the rest of the game. Games that keep streaming (Invincible VS: 3 GB at load, 4 GB after 6
+// minutes) then fill the GTT and RAM, and the next submit fails ("Not enough memory for command
+// submission"). No new chunk is made once the GTT or the free RAM gets low; later buffers use the
+// normal path. KYTY_GPU_SHARED_RESERVE_MB sets the GTT room kept free (default 1536 MB).
+static uint64_t ReadSysValue(const char* path) {
+	unsigned long long value = 0;
+	if (std::FILE* f = std::fopen(path, "r"); f != nullptr) {
+		if (std::fscanf(f, "%llu", &value) != 1) {
+			value = 0;
+		}
+		std::fclose(f);
+	}
+	return value;
+}
+
+static uint64_t MemAvailableBytes() {
+	uint64_t value = 0;
+	if (std::FILE* f = std::fopen("/proc/meminfo", "r"); f != nullptr) {
+		char               name[64] {};
+		unsigned long long kb = 0;
+		while (std::fscanf(f, "%63s %llu kB\n", name, &kb) == 2) {
+			if (std::strcmp(name, "MemAvailable:") == 0) {
+				value = kb * 1024;
+				break;
+			}
+		}
+		std::fclose(f);
+	}
+	return value;
+}
+
+static bool GpuSharedRoomLeft(uint64_t chunk_size, std::string* why) {
+	static const uint64_t reserve = [] {
+		const char* value = std::getenv("KYTY_GPU_SHARED_RESERVE_MB");
+		const auto  mb    = value != nullptr ? std::strtoull(value, nullptr, 10) : 1536ull;
+		return static_cast<uint64_t>(mb) * MiB;
+	}();
+	const auto gtt_total = ReadSysValue("/sys/class/drm/card0/device/mem_info_gtt_total");
+	const auto gtt_used  = ReadSysValue("/sys/class/drm/card0/device/mem_info_gtt_used");
+	if (gtt_total != 0 && gtt_used + chunk_size + reserve > gtt_total) {
+		*why = fmt::format("GTT {} of {} MB used", gtt_used >> 20u, gtt_total >> 20u);
+		return false;
+	}
+	const auto available = MemAvailableBytes();
+	if (available != 0 && available < chunk_size + 1024 * MiB) {
+		*why = fmt::format("{} MB of RAM free", available >> 20u);
+		return false;
+	}
+	return true;
+}
