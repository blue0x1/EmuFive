From: EmuFive <blue0x1>
Date: 2026-11-25
Subject: [PATCH 0045] shader: smooth interpolation when the GPU has no fragment barycentrics

The PS4 GPU (GCN2) has no VK_KHR_fragment_shader_barycentric. Pixel inputs that
KytyPS5 reads per vertex (FP16 interpolation, interpolation parameters, mixed
flat/smooth inputs) then fall back to the hardware's smooth interpolation: the
interpolated value stands for P0 and the P10/P20 deltas are zero.

---
diff --git a/src/graphics/host_gpu/renderer/pipeline/shaderResourceBarrier.cpp b/src/graphics/host_gpu/renderer/pipeline/shaderResourceBarrier.cpp
index 7c14dacbb7d94eea8e23e613897df01ee1e4a584..5533e595417a9a64998b0737fcbba5c72c22a20b 100644
--- a/src/graphics/host_gpu/renderer/pipeline/shaderResourceBarrier.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/shaderResourceBarrier.cpp
@@ -11,6 +11,7 @@ namespace Libs::Graphics {
 
 namespace {
 bool g_mesh_programs_run_as_compute = false;
+bool g_fragment_shader_barycentric  = false;
 } // namespace
 
 void SetMeshProgramsRunAsCompute(bool value) {
@@ -21,6 +22,14 @@ bool MeshProgramsRunAsCompute() {
 	return g_mesh_programs_run_as_compute;
 }
 
+void SetFragmentShaderBarycentric(bool value) {
+	g_fragment_shader_barycentric = value;
+}
+
+bool FragmentShaderBarycentric() {
+	return g_fragment_shader_barycentric;
+}
+
 vk::ShaderStageFlagBits NativeShaderStage(ShaderType stage) {
 	switch (stage) {
 		case ShaderType::Local:
