From: Chokri Hammedi <52697989+blue0x1@users.noreply.github.com>
Subject: [PATCH] shader: cheaper half-float min/max, med3 and lane swizzles

When the host min/max is trusted (AMD), build V_MED3_F16/F32 from four
NMin/NMax ops instead of the ~50-instruction exact path, and skip the
signaling-NaN fix-up after V_PK_MIN/MAX_F16, which AMD min/max already
do. Read the source lane's exec bit for DS_SWIZZLE/DS_BPERMUTE from one
ballot instead of a second cross-lane shuffle.
---
diff --git a/src/graphics/shader/recompiler/backend/spirv/spirvEmitterAluHelpers.cpp b/src/graphics/shader/recompiler/backend/spirv/spirvEmitterAluHelpers.cpp
index dd1ad9f6..86999082 100644
--- a/src/graphics/shader/recompiler/backend/spirv/spirvEmitterAluHelpers.cpp
+++ b/src/graphics/shader/recompiler/backend/spirv/spirvEmitterAluHelpers.cpp
@@ -124,6 +124,14 @@ uint32_t EmitMinMaxF32Value(EmitterState& state, uint32_t lhs, uint32_t rhs, boo
 }
 
 uint32_t EmitFPMedTri32(EmitterState& state, uint32_t a, uint32_t b, uint32_t c) {
+	if (state.profile.native_float_min_max) {
+		// With the host's NMin/NMax trusted for V_MIN/V_MAX, med3 is max(min(a, b), min(max(a, b), c)).
+		// The exact path below costs about 50 instructions, and shaders that sort or clamp with
+		// med3 use hundreds of them.
+		const auto low  = EmitMinMaxF32Value(state, a, b, false);
+		const auto high = EmitMinMaxF32Value(state, a, b, true);
+		return EmitMinMaxF32Value(state, low, EmitMinMaxF32Value(state, high, c, false), true);
+	}
 	const auto a_bits = EmitBitcastF32ToU32(state, a);
 	const auto b_bits = EmitBitcastF32ToU32(state, b);
 	const auto c_bits = EmitBitcastF32ToU32(state, c);
diff --git a/src/graphics/shader/recompiler/backend/spirv/spirvEmitterMemory.cpp b/src/graphics/shader/recompiler/backend/spirv/spirvEmitterMemory.cpp
index 5b9f45a7..272f50df 100644
--- a/src/graphics/shader/recompiler/backend/spirv/spirvEmitterMemory.cpp
+++ b/src/graphics/shader/recompiler/backend/spirv/spirvEmitterMemory.cpp
@@ -22,11 +22,12 @@ uint32_t EmitDsMaskedLaneRead(EmitterState& state, uint32_t source, uint32_t tar
 	const auto shuffled = state.builder.AllocateId();
 	state.builder.AddFunction(spv::OpGroupNonUniformShuffle, TypeU32(state), shuffled,
 	                          ConstantU32(state, spv::ScopeSubgroup), source, target);
-	const auto source_exec = state.builder.AllocateId();
-	state.builder.AddFunction(spv::OpGroupNonUniformShuffle, TypeBool(state), source_exec,
-	                          ConstantU32(state, spv::ScopeSubgroup), exec, target);
-	const auto source_active =
-	    AndCondition(state, source_exec, EmitSubgroupLaneActiveBool(state, target));
+	// A ballot of exec holds exactly the lanes that are active and have exec set, so one scalar
+	// ballot replaces a second cross-lane shuffle for the exec bit plus a ballot of active lanes.
+	const auto exec_ballot = state.builder.AllocateId();
+	state.builder.AddFunction(spv::OpGroupNonUniformBallot, TypeU32Vector(state, 4), exec_ballot,
+	                          ConstantU32(state, spv::ScopeSubgroup), exec);
+	const auto source_active = EmitBallotLaneActiveBool(state, exec_ballot, target);
 	return Select(state, TypeU32(state), source_active, shuffled, ConstantU32(state, 0));
 }
 
diff --git a/src/graphics/shader/recompiler/frontend/translate/Translate.h b/src/graphics/shader/recompiler/frontend/translate/Translate.h
