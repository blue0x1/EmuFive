+// EmuFive: runs on the priority thread after this end-of-pipe's label was published. A label
+// that went to the GPU thread is not in guest memory yet, and a guest woken by the interrupt
+// before it lands reads the old value and waits again. With no more GPU work coming it then waits
+// for good (Invincible VS: "GameThread timed out waiting for RenderThread"). Such an interrupt
+// goes through the GPU thread too, whose commands run in order, after the label.
+static void TriggerInterruptAfterLabels(RenderContext& renderer, int event_id, uint32_t context_id) {
+	if (g_gpu_thread_labels.load(std::memory_order_acquire) != 0) {
+		static std::atomic_bool noted {false};
+		if (!noted.exchange(true)) {
+			Log::WriteToConsoleAndLog("GPU interrupt sent after a label written by the GPU thread\n");
+		}
+		const bool sent = renderer.GetGpu().TrySendCommand(
+		    [&renderer, event_id, context_id] { renderer.TriggerInterrupt(event_id, context_id); });
+		if (sent) {
+			return;
+		}
+	}
+	renderer.TriggerInterrupt(event_id, context_id);
+}
