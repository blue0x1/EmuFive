+		if (!MemoryAddress(context, instruction, operands[0], address)) {
 			return false;
 		}
 		FlushCacheLine(address, operands[0].mem.segment);
+	} else if ((instruction.mnemonic == ZYDIS_MNEMONIC_RDRAND ||
+	            instruction.mnemonic == ZYDIS_MNEMONIC_RDSEED) &&
+	           operands[0].type == ZYDIS_OPERAND_TYPE_REGISTER) {
+		if (!WriteGpr(context, operands[0].reg.value, RandomNumber())) {
+			return false;
+		}
+		SetCarryOnly(context, true);
+	} else if (instruction.mnemonic == ZYDIS_MNEMONIC_CLZERO) {
+		// Zeroes the 64-byte cache line that rAX points into (EAX with an address-size prefix).
+		if ((instruction.attributes & (ZYDIS_ATTRIB_HAS_SEGMENT_FS | ZYDIS_ATTRIB_HAS_SEGMENT_GS)) != 0) {
+			return false;
+		}
+		uint64_t address = static_cast<uint64_t>(context.Gpr(0));
+		if (instruction.address_width == 32) {
+			address = static_cast<uint32_t>(address);
+		}
+		std::memset(reinterpret_cast<void*>(address & ~uint64_t {63}), 0, 64);
+	} else if (instruction.mnemonic == ZYDIS_MNEMONIC_RDPRU) {
+		// ECX 0 is MPERF and 1 is APERF: both count at the TSC rate here (the CPU at its base
+		// clock), so their ratio is 1. Other registers read as 0 with CF clear.
+		const auto selector = static_cast<uint32_t>(context.Gpr(1));
+		const uint64_t value = selector <= 1 ? __rdtsc() : 0;
+		context.Gpr(0) = static_cast<uint32_t>(value);
+		context.Gpr(2) = static_cast<uint32_t>(value >> 32u);
+		SetCarryOnly(context, selector <= 1);
+#if KYTY_PLATFORM != KYTY_PLATFORM_WINDOWS && !defined(__APPLE__)
+	} else if ((instruction.mnemonic == ZYDIS_MNEMONIC_RDFSBASE ||
+	            instruction.mnemonic == ZYDIS_MNEMONIC_RDGSBASE) &&
+	           operands[0].type == ZYDIS_OPERAND_TYPE_REGISTER) {
+		// The thread's FS or GS base, the value the instruction gives on a CPU that has it.
+		uint64_t base = 0;
+		const int code = instruction.mnemonic == ZYDIS_MNEMONIC_RDFSBASE ? ARCH_GET_FS : ARCH_GET_GS;
+		if (syscall(SYS_arch_prctl, code, &base) != 0 || !WriteGpr(context, operands[0].reg.value, base)) {
+			return false;
+		}
+#endif
 	} else {
 		return false;
 	}
