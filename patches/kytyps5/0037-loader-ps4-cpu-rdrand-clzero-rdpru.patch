+// RDRAND and RDSEED: numbers from a random seed and a counter, mixed with SplitMix64. Fine for
+// what games use them for (seeds, IDs); not a source for cryptographic keys.
+static uint64_t RandomNumber() {
+	static std::atomic<uint64_t> seed {0};
+	static std::atomic<uint64_t> counter {0};
+	uint64_t                     base = seed.load(std::memory_order_relaxed);
+	if (base == 0) {
+		uint64_t fresh = __rdtsc() ^ reinterpret_cast<uintptr_t>(&base);
+#if KYTY_PLATFORM != KYTY_PLATFORM_WINDOWS && !defined(__APPLE__)
+		uint64_t random = 0;
+		if (syscall(SYS_getrandom, &random, sizeof(random), 1 /* GRND_NONBLOCK */) == sizeof(random)) {
+			fresh ^= random;
+		}
+#endif
+		fresh |= 1u;
+		// The first thread's seed is kept.
+		base = seed.compare_exchange_strong(base, fresh) ? fresh : base;
+	}
+	uint64_t z = base + (counter.fetch_add(1, std::memory_order_relaxed) + 1) * 0x9e3779b97f4a7c15ull;
+	z = (z ^ (z >> 30u)) * 0xbf58476d1ce4e5b9ull;
+	z = (z ^ (z >> 27u)) * 0x94d049bb133111ebull;
+	return z ^ (z >> 31u);
+}
+
+// Writes a result the way a general-purpose register write does: a 32-bit write clears the upper
+// half, a 16-bit or 8-bit write keeps the rest.
+static bool WriteGpr(Context& context, ZydisRegister reg, uint64_t value) {
+	const auto reg_class = ZydisRegisterGetClass(reg);
+	const auto index     = ZydisRegisterGetId(reg);
+	if (index < 0 || index >= 16) {
+		return false;
+	}
+	auto&          target = context.Gpr(static_cast<uint8_t>(index));
+	const uint64_t old    = static_cast<uint64_t>(target);
+	switch (reg_class) {
+		case ZYDIS_REGCLASS_GPR64: target = value; break;
+		case ZYDIS_REGCLASS_GPR32: target = static_cast<uint32_t>(value); break;
+		case ZYDIS_REGCLASS_GPR16: target = (old & ~0xffffull) | (value & 0xffffu); break;
+		default: return false;
+	}
+	return true;
+}
+
+// CF set or clear, and OF, SF, ZF, AF and PF clear (RDRAND, RDSEED and RDPRU).
+static void SetCarryOnly(Context& context, bool carry) {
+	constexpr uint64_t status = 0x8d5u; // OF SF ZF AF PF CF
+	context.SetFlags((context.Flags() & ~status) | (carry ? 1u : 0u));
+}
+
+static bool MemoryAddress(const Context& context, const ZydisDecodedInstruction& instruction,
+                          const ZydisDecodedOperand& operand, uint64_t& address) {
+	ZydisRegisterContext registers {};
+	for (uint8_t i = 0; i < 16; ++i) {
+		const auto value                         = static_cast<uint64_t>(context.Gpr(i));
+		registers.values[ZYDIS_REGISTER_RAX + i] = value;
+		registers.values[ZYDIS_REGISTER_EAX + i] = static_cast<uint32_t>(value);
+	}
+	return ZYAN_SUCCESS(
+	    ZydisCalcAbsoluteAddressEx(&instruction, &operand, context.Rip(), &registers, &address));
+}
+
 static bool TryEmulateCpuExtensions(Context& context) {
 	ZydisDecoder            decoder {};
 	ZydisDecodedInstruction instruction {};
