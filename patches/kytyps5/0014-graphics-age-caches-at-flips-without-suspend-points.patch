From: Chokri Hammedi <52697989+blue0x1@users.noreply.github.com>
Subject: [PATCH] graphics: age the caches at flips when a game has no suspend points

The texture, buffer and image-heap caches free what has not been used for a
number of frames, and a frame was counted only at a guest suspend point.
Invincible VS (PPSA30568) reaches almost none: in a two-minute run the
caches aged less than 64 frames, so nothing was ever freed and the PS4 Pro's
GPU ran out of memory in the opening.

A flip now marks the frame boundary when no suspend point came since the
previous flip, and the caches age once the command list holding that flip is
done. Games with a suspend point every frame are unchanged.

diff --git a/src/graphics/guest_gpu/command_processor/commandProcessor.h b/src/graphics/guest_gpu/command_processor/commandProcessor.h
index 3cc4b2dc97b6d3228c9fd8766dfa4a949556ab0a..f728d43d3dd5171f9ef08736865ad1d6218b1911 100644
--- a/src/graphics/guest_gpu/command_processor/commandProcessor.h
+++ b/src/graphics/guest_gpu/command_processor/commandProcessor.h
@@ -91,6 +91,8 @@ public:
 	void WriteBackImages();
 	void Flip(int handle, int index, int flip_mode, int64_t flip_arg);
 	void PrepareCpuFlip(uint64_t request_id);
+	// Lets the GPU thread age the caches at this flip when the game has no suspend points.
+	void NoteFlipForGc();
 	void DispatchDirect(uint32_t thread_group_x, uint32_t thread_group_y, uint32_t thread_group_z,
 	                    uint32_t mode);
 	void DispatchIndirect(uint64_t args_addr, uint32_t mode);
diff --git a/src/graphics/guest_gpu/graphicsRun.cpp b/src/graphics/guest_gpu/graphicsRun.cpp
index 70df7ad8f2bf62e6c3a9a0dabe8c75366be02787..adc958574684506097c7e498edc391f1230c19c4 100644
--- a/src/graphics/guest_gpu/graphicsRun.cpp
+++ b/src/graphics/guest_gpu/graphicsRun.cpp
@@ -530,6 +530,8 @@ bool GuestGpu::Process(Submission& submission) {
 		case SubmissionType::SuspendPoint:
 			// Age caches at the frame boundary, not once per command list.
 			m_renderer.RunGarbageCollector();
+			m_suspend_since_flip = true;
+			m_flip_gc_pending    = false;
 			cp.BufferFlush();
 			cp.Reset();
 			// Like completion labels, the point has executed once the CP has submitted every
@@ -538,6 +540,14 @@ bool GuestGpu::Process(Submission& submission) {
 			break;
 	}
 
+	// Without suspend points (Invincible VS has almost none) the caches never aged, so nothing
+	// was ever freed and the GPU ran out of memory. A flip then marks the frame boundary, and
+	// the caches age once the command list holding it is done.
+	if (m_flip_gc_pending && complete && submission.type != SubmissionType::SuspendPoint) {
+		m_flip_gc_pending = false;
+		m_renderer.RunGarbageCollector();
+	}
+
 	return complete;
 }
 
@@ -1081,6 +1091,7 @@ void CommandProcessor::Flip(int handle, int index, int flip_mode, int64_t flip_a
 	}
 	m_renderer.GetOcclusionQueries().Publish();
 
+	NoteFlipForGc();
 	auto& command = CurrentBuffer();
 	auto  request = Sync::PrepareVideoOutFlip(command, handle, index, flip_mode, flip_arg);
 	GetScheduler().DeferPriorityOperation(
@@ -1088,7 +1099,16 @@ void CommandProcessor::Flip(int handle, int index, int flip_mode, int64_t flip_a
 	GetScheduler().Flush();
 }
 
+void CommandProcessor::NoteFlipForGc() {
+	auto& gpu = m_renderer.GetGpu();
+	if (!gpu.m_suspend_since_flip) {
+		gpu.m_flip_gc_pending = true;
+	}
+	gpu.m_suspend_since_flip = false;
+}
+
 void CommandProcessor::PrepareCpuFlip(uint64_t request_id) {
+	NoteFlipForGc();
 	auto& command = CurrentBuffer();
 	m_renderer.GetVideoOut().PrepareFlip(request_id, command);
 	GetScheduler().DeferPriorityOperation(
diff --git a/src/graphics/guest_gpu/graphicsRun.h b/src/graphics/guest_gpu/graphicsRun.h
index 45ed587a53b448289ca09e637b09e28f90c619fb..a1f2e35fe511c4588ad5fde65b6dcc824397f2bd 100644
--- a/src/graphics/guest_gpu/graphicsRun.h
+++ b/src/graphics/guest_gpu/graphicsRun.h
@@ -88,6 +88,9 @@ private:
 	std::array<std::unique_ptr<CommandProcessor>, ComputeQueueCount> m_compute_cp;
 
 	std::atomic_int m_done_num = 0;
+	// Games that never reach a suspend point age the caches once per flip instead (GPU thread).
+	bool            m_suspend_since_flip = false;
+	bool            m_flip_gc_pending    = false;
 	std::jthread    m_thread;
 
 	friend class CommandProcessor;
