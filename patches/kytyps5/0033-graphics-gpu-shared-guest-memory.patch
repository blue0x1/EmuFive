+void BufferCache::WaitDirectWrites(uint64_t vaddr, uint64_t size) {
+	static const bool all = std::getenv("KYTY_GPU_SHARED_WAIT_ALL") != nullptr;
+	if (all) {
+		// Shaders also write guest memory by address, which no binding records.
+		const auto* owner = m_page_table.Find(vaddr >> PageTable::kPageBits);
+		if (owner == nullptr || !*owner || !m_slot_buffers[*owner].IsDirect()) {
+			return;
+		}
+	} else if (!IsDirectPending(vaddr, size)) {
+		return;
+	}
+	const auto tick = m_scheduler.CurrentTick();
+	if (m_direct_wait_tick == tick) {
+		return;
+	}
+	Common::PerfTrace::Add(Common::PerfTrace::BufferDownload, 0);
+	m_scheduler.Wait(tick);
+	m_direct_wait_tick = m_scheduler.CurrentTick();
+	m_direct_pending   = {};
+}
+
+void BufferCache::InitDirectMemory() {
+	if (!m_graphics.gpu_shared_memory_enabled) {
+		return;
+	}
+	// Probe the page size and memory types of an aliased sparse buffer.
+	vk::BufferCreateInfo info {};
+	info.size  = 64 * MiB;
+	info.usage = AllFlags | vk::BufferUsageFlagBits::eShaderDeviceAddress;
+	info.flags = vk::BufferCreateFlagBits::eSparseBinding | vk::BufferCreateFlagBits::eSparseResidency |
+	             vk::BufferCreateFlagBits::eSparseAliased;
+	vk::Buffer probe = nullptr;
+	if (m_graphics.device.createBuffer(&info, nullptr, &probe) != vk::Result::eSuccess) {
+		Log::WriteToConsoleAndLog("GPU-shared memory: off (no aliased sparse buffer)\n");
+		return;
+	}
+	vk::MemoryRequirements requirements {};
+	m_graphics.device.getBufferMemoryRequirements(probe, &requirements);
+	m_graphics.device.destroyBuffer(probe, nullptr);
+	const auto& types  = m_graphics.physical_device_memory_properties;
+	const auto  wanted = vk::MemoryPropertyFlagBits::eHostVisible |
+	                    vk::MemoryPropertyFlagBits::eHostCoherent |
+	                    vk::MemoryPropertyFlagBits::eHostCached;
+	for (uint32_t i = 0; i < types.memoryTypeCount; i++) {
+		const auto flags = types.memoryTypes[i].propertyFlags;
+		if ((requirements.memoryTypeBits & (1u << i)) != 0 && (flags & wanted) == wanted &&
+		    !(flags & vk::MemoryPropertyFlagBits::eDeviceLocal)) {
+			m_direct_type = i;
+			m_direct_page = requirements.alignment;
+			break;
+		}
+	}
+	const auto chunk = LibKernel::Memory::GpuSharedChunkSize();
+	if (m_direct_page == 0 || chunk % m_direct_page != 0) {
+		m_direct_page = 0;
+		Log::WriteToConsoleAndLog(fmt::format(
+		    "GPU-shared memory: off (no cached host memory type in 0x{:x})\n",
+		    requirements.memoryTypeBits));
+		return;
+	}
+	g_direct_cache = this;
+	Log::WriteToConsoleAndLog(fmt::format("GPU-shared memory: on, type {}, page {} KB\n",
+	                                      m_direct_type, m_direct_page >> 10u));
+}
+
+vk::DeviceMemory BufferCache::DirectChunk(uint64_t chunk) {
+	if (const auto it = m_direct_chunks.find(chunk); it != m_direct_chunks.end()) {
+		return it->second;
+	}
+	if (m_direct_failed) {
+		return nullptr;
+	}
+	const auto&                    dispatcher = VULKAN_HPP_DEFAULT_DISPATCHER;
+	const auto                     chunk_size = LibKernel::Memory::GpuSharedChunkSize();
+	VkExportMemoryAllocateInfo     export_info {VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO, nullptr,
+                                            VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT};
+	VkMemoryAllocateInfo allocate {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, &export_info, chunk_size,
+	                               m_direct_type};
+	VkDeviceMemory       memory = VK_NULL_HANDLE;
+	const VkDevice       device = m_graphics.device;
+	int                  fd     = -1;
+	VkMemoryGetFdInfoKHR fd_info {VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR, nullptr, VK_NULL_HANDLE,
+	                              VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT};
+	bool ok = dispatcher.vkAllocateMemory(device, &allocate, nullptr, &memory) == VK_SUCCESS;
+	if (ok) {
+		fd_info.memory = memory;
+		ok = dispatcher.vkGetMemoryFdKHR(device, &fd_info, &fd) == VK_SUCCESS && fd >= 0;
+	}
+	bool busy = false;
+	if (ok) {
+		ok = LibKernel::Memory::PromoteBackingChunk(
+		    chunk, fd,
+		    [this](const LibKernel::Memory::RemappedRange& range) {
+			    m_page_manager.RestoreWriteAccess(range.vaddr, range.size);
+		    },
+		    &busy);
+	}
+	if (!ok) {
+		if (fd >= 0) {
+			close(fd);
+		}
+		if (memory != VK_NULL_HANDLE) {
+			dispatcher.vkFreeMemory(device, memory, nullptr);
+		}
+		if (busy) {
+			// A guest memory operation is running; this buffer stays a normal one, a later one
+			// moves the chunk.
+			return nullptr;
+		}
+		Log::WriteToConsoleAndLog(fmt::format(
+		    "GPU-shared memory: chunk {} failed after {} chunks; no more direct buffers\n", chunk,
+		    m_direct_chunks.size()));
+		m_direct_failed = true;
+		return nullptr;
+	}
+	m_direct_chunks.emplace(chunk, vk::DeviceMemory(memory));
+	if ((m_direct_chunks.size() & 15u) == 1u) {
+		Log::WriteToConsoleAndLog(fmt::format("GPU-shared memory: {} chunks ({} MB)\n",
+		                                      m_direct_chunks.size(),
+		                                      (m_direct_chunks.size() * chunk_size) >> 20u));
+	}
+	return vk::DeviceMemory(memory);
+}
+
+bool BufferCache::PrepareDirect(uint64_t vaddr, uint64_t size, std::vector<DirectBind>* binds) {
+	constexpr uint64_t MaxDirectSize = 2048 * MiB;
+	uint64_t           backing       = 0;
+	if (size > MaxDirectSize || !LibKernel::Memory::GetLinearBacking(vaddr, size, &backing) ||
+	    (vaddr - backing) % m_direct_page != 0) {
+		return false;
+	}
+	const auto chunk_size = LibKernel::Memory::GpuSharedChunkSize();
+	for (uint64_t done = 0; done < size;) {
+		const auto offset   = backing + done;
+		const auto chunk    = offset / chunk_size;
+		const auto in_chunk = offset - chunk * chunk_size;
+		const auto bytes    = std::min(size - done, chunk_size - in_chunk);
+		const auto memory   = DirectChunk(chunk);
+		if (!memory) {
+			binds->clear();
+			return false;
+		}
+		binds->push_back({done, bytes, memory, in_chunk});
+		done += bytes;
+	}
+	return true;
+}
+
+void BufferCache::NoteDirectWrite(uint64_t vaddr, uint64_t size) {
+	m_direct_pending.Add(vaddr, size);
+	m_direct_pending_tick = m_scheduler.CurrentTick();
+}
+
+bool BufferCache::IsDirectPending(uint64_t vaddr, uint64_t size) {
+	if (m_direct_pending.Empty()) {
+		return false;
+	}
+	if (m_scheduler.IsFree(m_direct_pending_tick)) {
+		m_direct_pending = {};
+		return false;
+	}
+	return m_direct_pending.Intersects(vaddr, size);
+}
