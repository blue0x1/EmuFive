+// EmuFive GPU-shared memory: labels the guest sees only when the GPU is done. The command
+// processor, which runs ahead of the GPU in order, reads them at once, as before.
+static std::mutex                             g_early_labels_mutex;
+static std::unordered_map<uint64_t, uint64_t> g_early_labels;
+
+static void NoteEarlyLabel(void* address, uint64_t value) {
+	std::lock_guard lock(g_early_labels_mutex);
+	g_early_labels[reinterpret_cast<uint64_t>(address)] = value;
+}
+
+static void PublishEarlyLabel(void* address, uint64_t value, uint64_t size) {
+	std::lock_guard lock(g_early_labels_mutex);
+	std::memcpy(address, &value, size);
+	const auto it = g_early_labels.find(reinterpret_cast<uint64_t>(address));
+	if (it != g_early_labels.end() && it->second == value) {
+		g_early_labels.erase(it);
+	}
+}
+
+template <typename T>
+static T ReadLabel(const T* addr) {
+	std::lock_guard lock(g_early_labels_mutex);
+	const auto      it = g_early_labels.find(reinterpret_cast<uint64_t>(addr));
+	return it != g_early_labels.end() ? static_cast<T>(it->second) : *addr;
+}
