+	// Gives write access back to remapped pages that no watcher protects.
+	void RestoreWriteAccess(uint64_t vaddr, uint64_t size) {
+		const auto begin = Common::AlignDown(vaddr, PAGE_SIZE);
+		const auto end   = Common::AlignUp(vaddr + size, PAGE_SIZE);
+		for (auto chunk_begin = begin; chunk_begin < end;) {
+			const auto chunk_end   = std::min(end, Common::AlignUp(chunk_begin + 1, REGION_SIZE));
+			const auto region_base = Common::AlignDown(chunk_begin, REGION_SIZE);
+			auto*      region      = FindRegion(chunk_begin);
+			if (region == nullptr) {
+				Protect(chunk_begin, chunk_end - chunk_begin, Common::VirtualMemory::Mode::ReadWrite);
+				chunk_begin = chunk_end;
+				continue;
+			}
+			SpinGuard lock(region->lock);
+			auto      run_begin = chunk_begin;
+			auto      run_perms = region->pages[(chunk_begin - region_base) / PAGE_SIZE].Perms();
+			for (auto page = chunk_begin;; page += PAGE_SIZE) {
+				const bool last  = page == chunk_end;
+				const auto perms = last ? run_perms
+				                        : region->pages[(page - region_base) / PAGE_SIZE].Perms();
+				if (last || perms != run_perms) {
+					if (run_perms != Common::VirtualMemory::Mode::Read) {
+						Protect(run_begin, page - run_begin, run_perms);
+					}
+					if (last) {
+						break;
+					}
+					run_begin = page;
+					run_perms = perms;
+				}
+			}
+			chunk_begin = chunk_end;
+		}
+	}
+
 	std::unique_ptr<std::atomic<Region*>[]> regions;
 	std::vector<std::unique_ptr<Region>>    region_storage;
 	std::mutex                              region_mutex;
@@ -295,6 +330,10 @@ void PageManager::UpdatePageWatchers(uint64_t vaddr, uint64_t size) {
 	m_impl->UpdatePageWatchers<track, is_read>(vaddr, size);
 }
 
+void PageManager::RestoreWriteAccess(uint64_t vaddr, uint64_t size) {
+	m_impl->RestoreWriteAccess(vaddr, size);
+}
