[Unit]
Description=Pair PlayStation controllers over Bluetooth (hold SHARE + PS)
After=bluetooth.service
Requires=bluetooth.service

[Service]
ExecStart=/opt/ps5-on-ps4/bin/ps5-pad-pair
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
