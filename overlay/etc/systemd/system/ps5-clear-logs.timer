# Clears the game logs every 24 hours (the PS4 has no cron; a systemd timer does the same job).
[Unit]
Description=Clear the game logs every 24 hours

[Timer]
OnBootSec=24h
OnUnitActiveSec=24h
Persistent=true

[Install]
WantedBy=timers.target
