#!/bin/sh
# Copyright (C) 2026 Chokri Hammedi (blue0x1) <https://github.com/blue0x1>
# The X session, with no keyboard needed:
#   - The home screen (ps5-home) lists the games from the USB drive, the PS4
#     drive and a PC's shared folder. Picking one runs it in KytyPS5
#     (ps5-launch), full screen; when the game ends, the home screen comes
#     back, with the reason if it stopped with an error.
#   - The PS button during a game opens the quick menu (ps5-guide): Resume,
#     Home (the game waits, paused), Close game, controller, sound, power.
#     PS + Square or Share takes a screenshot.
#   - Power off and Restart in the home screen do that.
#   - With PS5_GAME set in /etc/ps5-on-ps4.conf, that game runs straight away
#     instead, and PS5_POWEROFF_ON_EXIT decides what happens when it ends.
PS5_GAME=
PS5_KYTY_OPTIONS=
PS5_POWEROFF_ON_EXIT=yes
[ -f /etc/ps5-on-ps4.conf ] && . /etc/ps5-on-ps4.conf

BIN=/opt/ps5-on-ps4/bin
HOME_SCREEN=$BIN/ps5-home
USB=/media/ps5-usb
LOG="$HOME/kytyps5.log" # this run; the run before is kytyps5.log.1
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
CLOSED="$RUNTIME/ps5-game-closed"   # written by ps5-guide: closed, poweroff or reboot
TERM_UI="xterm -fullscreen -bg black -fg white -fa DejaVuSansMono -fs 16"

# KytyPS5 needs sparse resources, which RADV only offers on the PS4 GPU with
# this switch.
export RADV_EXPERIMENTAL=sparse
# Full-screen SDL windows (home screen, KytyPS5) stay shown when another window
# takes the focus (the screenshot notice); this window manager cannot show a
# hidden one again.
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0

# Shows a message full screen for some seconds (only if the home screen fails).
message() {  # seconds text
    $TERM_UI -e sh -c 'printf "%b\n" "$2"; sleep "$1"' sh "$1" "$2"
}

poweroff() {
    "$BIN/ps5-backdrop" show poweroff
    sudo -n /usr/bin/systemctl poweroff
    exit 0
}

reboot() {
    "$BIN/ps5-backdrop" show reboot
    sudo -n "$BIN/ps5-admin" reboot
    exit 0
}

# Runs one game; sets $rc, $reason and $closed (how the quick menu ended it).
run_game() {  # path
    [ -f "$LOG" ] && mv -f "$LOG" "$LOG.1"
    rm -f "$CLOSED"
    # shellcheck disable=SC2086
    python3 "$BIN/ps5-launch" "$1" $PS5_KYTY_OPTIONS > "$LOG" 2>&1 &
    wait $!
    rc=$?
    rm -f "$RUNTIME/ps5-game.json"
    closed=""
    [ -f "$CLOSED" ] && closed="$(cat "$CLOSED")" && rm -f "$CLOSED"
    reason=""
    if [ $rc -ne 0 ] && [ -z "$closed" ]; then
        reason="$(grep -A2 -- '--- .*Error ---' "$LOG" | tail -n 2 | tr '\n' ' ')"
        [ -n "$reason" ] || reason="$(tail -n 3 "$LOG" | tr '\n' ' ')"
    fi
    case "$closed" in
        poweroff) poweroff ;;
        reboot) reboot ;;
    esac
}

xset s off -dpms 2>/dev/null
# The EmuFive screen behind every window, seen while a game closes, the home screen starts
# again or the PS4 turns off (instead of black): a dark color now, the picture once drawn.
xsetroot -solid "#0c0a1c" 2>/dev/null
"$BIN/ps5-backdrop" render > "$HOME/.ps5-backdrop.log" 2>&1 &
# Kiosk window manager: every window full screen, no title bars.
matchbox-window-manager -use_titlebar no -use_cursor no &
# The PS button and screenshots.
python3 "$BIN/ps5-guide" > "$HOME/.ps5-guide.log" 2>&1 &

# A fixed game (PS5_GAME): run it; the home screen is not used. (The home
# screen needs no wait: it finds a drive whenever it is mounted.)
if [ -n "$PS5_GAME" ]; then
    # Give a drive plugged in at boot a few seconds to mount.
    i=0; while [ $i -lt 10 ] && ! grep -q " $USB " /proc/mounts; do sleep 1; i=$((i + 1)); done
    while :; do
        run_game "$PS5_GAME"
        if [ $rc -eq 0 ] || [ -n "$closed" ]; then
            [ "$PS5_POWEROFF_ON_EXIT" = yes ] && poweroff
            continue
        fi
        message 20 "KytyPS5 stopped (exit code $rc):\n\n$reason\n\nStarting again in 20 seconds. The log is $LOG."
    done
fi

note=""
failures=0
while :; do
    choice="$(python3 "$HOME_SCREEN" ${note:+--message "$note"})"
    status=$?
    note=""
    case "$choice" in
    "PLAY "*)
        failures=0
        game="${choice#PLAY }"
        while [ -n "$game" ]; do
            run_game "$game"
            game=""
            if [ $rc -ne 0 ] && [ -z "$closed" ]; then
                note="The game stopped (error code $rc). $reason The log is ~/kytyps5.log."
            fi
            # Another game was started from the home screen while this one was paused (Home in
            # the PS button menu): it comes straight after.
            case "$closed" in
                play:*) game="${closed#play:}" ;;
            esac
        done
        ;;
    BROWSER)
        # Internet: the web browser; the home screen comes back when it closes (PS button).
        failures=0
        python3 "$BIN/ps5-browser" > "$HOME/.ps5-browser.log" 2>&1
        ;;
    POWEROFF)
        poweroff
        ;;
    REBOOT)
        reboot
        ;;
    RELOAD)
        # A live update asked the home screen to start again (SIGUSR1), or a setting did (the
        # menu language: the screen behind the windows is drawn again in it).
        failures=0
        "$BIN/ps5-backdrop" render > "$HOME/.ps5-backdrop.log" 2>&1 &
        ;;
    *)
        # The home screen itself failed: say so, and try again; turn off after 3 times.
        failures=$((failures + 1))
        if [ $failures -ge 3 ]; then
            message 60 "The home screen could not start (exit code $status).\n\nThe log is ~/.ps5-session.log. The PS4 turns off in a minute."
            poweroff
        fi
        message 10 "The home screen stopped (exit code $status). Starting it again..."
        ;;
    esac
done
