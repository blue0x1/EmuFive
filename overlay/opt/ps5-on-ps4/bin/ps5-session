#!/bin/sh
# Copyright (C) 2026 Chokri Hammedi (blue0x1) <https://github.com/blue0x1>
# The X session: finds a PS5 game on the USB drive and runs it in KytyPS5, full
# screen. When the emulator exits, the PS4 turns off (see /etc/ps5-on-ps4.conf).
PS5_GAME=
PS5_KYTY_OPTIONS=
PS5_POWEROFF_ON_EXIT=yes
[ -f /etc/ps5-on-ps4.conf ] && . /etc/ps5-on-ps4.conf

KYTY=/opt/kytyps5/kyty_emulator
GAMES=/media/ps5-usb/PS5
LOG="$HOME/kytyps5.log"
TERM_UI="xterm -fullscreen -bg black -fg white -fa DejaVuSansMono -fs 16"

# KytyPS5 needs sparse resources, which RADV only offers on the PS4 GPU with
# this switch.
export RADV_EXPERIMENTAL=sparse

message() {  # text shown full screen until Enter is pressed
    $TERM_UI -e sh -c 'printf "%b\n\nPress Enter to continue." "$1"; read x' sh "$1"
}

xset s off -dpms 2>/dev/null
# Kiosk window manager: every window full screen, no title bars.
matchbox-window-manager -use_titlebar no -use_cursor no &

# Give a drive plugged in at boot a few seconds to mount.
i=0; while [ $i -lt 10 ] && ! grep -q " /media/ps5-usb " /proc/mounts; do sleep 1; i=$((i + 1)); done

# The game: PS5_GAME if set, otherwise the first game folder (with eboot.bin)
# or ZArchive (.zar) in the USB drive's PS5 folder.
game="$PS5_GAME"
if [ -z "$game" ] && [ -d "$GAMES" ]; then
    game="$(find "$GAMES" -maxdepth 3 \( -name eboot.bin -o -name '*.zar' \) 2>/dev/null | sort | head -n 1)"
    case "$game" in */eboot.bin) game="${game%/eboot.bin}" ;; esac
fi

if [ -z "$game" ]; then
    message "PS5 on PS4: no game found.\n\nPut a PS5 game folder (with eboot.bin) or a .zar dump in the PS5 folder\nof a USB drive, or set PS5_GAME in /etc/ps5-on-ps4.conf.\n\nLog in on tty2 (Ctrl+Alt+F2) for a shell."
else
    # shellcheck disable=SC2086
    "$KYTY" --game "$game" --fullscreen --hide-cursor $PS5_KYTY_OPTIONS > "$LOG" 2>&1
    rc=$?
    if [ $rc -ne 0 ]; then
        message "KytyPS5 stopped (exit code $rc). Last lines of $LOG:\n\n$(tail -n 15 "$LOG")"
    fi
fi

if [ "$PS5_POWEROFF_ON_EXIT" = yes ]; then
    sudo -n /usr/bin/systemctl poweroff
fi
