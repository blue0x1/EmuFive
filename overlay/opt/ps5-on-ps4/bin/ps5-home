    def set_automatic(self, on):
        h = self.home
        h.push(Busy(h, "Turning automatic time on…" if on else "Turning automatic time off…",
                    lambda: system.set_time_automatic(on),
                    after=lambda ok, msg: (h.poll.forget("ntp"),
                                           None if ok else h.push(Dialog(h, msg or "Could not set it.")))))

    def toggle_clock(self):
        self.home.settings.set(clock_24h=not self.home.settings["clock_24h"])
        self.home.sounds.play("move")

    def pick_region(self):
        h = self.home
        zones = system.timezones()
        main = ("Africa", "America", "Antarctica", "Arctic", "Asia", "Atlantic", "Australia", "Europe",
                "Indian", "Pacific")
        regions = sorted({z.split("/")[0] for z in zones if "/" in z and z.split("/")[0] in main}) + ["UTC"]

        def pick_zone(zone):
            if zone is None:
                return
            h.push(Busy(h, f"Setting the time zone to {zone}…", lambda: system.set_timezone(zone),
                        after=lambda ok, msg: (h.poll.forget("zone"),
                                               None if ok else h.push(Dialog(h, msg or "Could not set it.")))))

        def pick(region):
            if region == "UTC":
                pick_zone("UTC")
                return
            cities = [(z.split("/", 1)[1].replace("_", " "), z) for z in zones if z.startswith(region + "/")]
            h.push(Picker(h, region, cities, system.current_timezone(), pick_zone))

        current = system.current_timezone().split("/")[0]
        h.push(Picker(h, "Time zone: region", [(r, r) for r in regions], current, pick))

