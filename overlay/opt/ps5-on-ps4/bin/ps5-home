#!/usr/bin/env python3
# Copyright (C) 2026 Chokri Hammedi (blue0x1) <https://github.com/blue0x1>
# The PS5 on PS4 home screen: the PS5 games as a row of tiles over each game's
# own art, your profile, Wi-Fi with an on-screen keyboard, Settings, the PS
# button's quick menu, and power. Everything works with a controller, and it is
# drawn at the TV's own resolution. The games come from:
#   - the PS5 folder of the USB drive (/media/ps5-usb/PS5),
#   - /user/home/PS5 on the PS4's own drive, put there with GoldHEN FTP
#     (read-only at /media/ps4-drive, by ps5-ps4-drive),
#   - a shared folder on a PC, Windows or Linux (Samba), set in Settings and
#     opened with smbnetfs, since the PS4 kernel has no SMB client.
#
# It prints what to do and exits, so the emulator gets all the memory:
#   PLAY <game folder>     start this game
#   POWEROFF / REBOOT      turn the PS4 off / restart it
#   RELOAD                 start the home screen again (after SIGUSR1, from a live update,
#                          or a setting it reads only at the start)
# With --quick-menu GAME (from ps5-guide, while that game is paused) it shows
# only the quick menu and prints RESUME, HOME, CLOSE, POWEROFF or REBOOT.
# With --suspended GAME (Home in that menu) it is the whole home screen while the
# game waits, paused: RESUME goes back to it, and PLAY another game, after asking,
# closes it first.
#
#   ps5-home [--games DIR] [--ps4-games DIR] [--pc-test DIR] [--message TEXT]
#            [--size WxH] [--windowed] [--dry-run-network] [--quick-menu GAME]
#            [--suspended GAME]

import argparse
import hashlib
import math
import os
import queue
import random
import signal
import sys
import threading
import time
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from ps5 import about, i18n, store, system, ui  # noqa: E402

# The Appearance settings decide the colors, so they are applied before the colors are imported
# (the home screen starts again when they change).
SETTINGS = store.Settings()
ui.apply_theme(SETTINGS["theme"], SETTINGS["accent"])
i18n.set_language(SETTINGS["menu_language"])
from ps5.ui import (ACCENT, ART_SOFT, ART_TEXT, BACK, BAD, DIALOG, DIM, DOWN, GOLD, GOOD,  # noqa: E402
                    GUIDE, INK, KEY, KEY_ON, LEFT, OK, OPTIONS, PAGE_DOWN, PAGE_UP, PANEL, PANEL_LINE,
                    RIGHT, ROW_ON, SOFT, SQUARE, TRIANGLE, UP, WHITE, px)

pygame = ui.pygame

BG_W, BG_H = 1400, 788           # Backgrounds are a little larger than the screen, to drift.
TILE_SIZES = {"small": (84, 124), "medium": (104, 156), "large": (128, 190)}   # Normal, selected.
TILE_SEL = 190                   # The largest tile: icons are loaded at least twice this big.
TILE_GAP = 18
ROW_X, ROW_Y = 64, 112
REOPEN = os.path.expanduser("~/.cache/ps5-on-ps4/reopen")    # Settings page to show after a restart.
PROFILE_CHOSEN = os.path.join(system.RUNTIME, "ps5-profile-chosen")   # "Who's playing?" was shown.
AVATAR_CACHE = os.path.expanduser("~/.cache/ps5-on-ps4/avatars")
DICEBEAR_STYLES = ["adventurer", "avataaars", "big-smile", "bottts", "croodles", "fun-emoji", "lorelei",
                   "micah", "miniavs", "notionists", "open-peeps", "personas", "pixel-art", "thumbs"]
SOURCE_COLORS = {"USB": (88, 150, 255), "PS4": (64, 64, 76), "PC": (46, 170, 120)}


def clock_text(h24, seconds=False):
    if h24:
        return time.strftime("%H:%M:%S" if seconds else "%H:%M")
    return time.strftime("%I:%M:%S %p" if seconds else "%I:%M %p").lstrip("0")


def ease(current, target, rate, dt):
    return current + (target - current) * min(1.0, rate * dt)


def ease_out(t):
    return 1 - (1 - t) ** 3


# --------------------------------------------------------------------------------------------
# Game pictures: icons for every game, backgrounds only for the few games near the selection
# (they are large at the TV's resolution). Loaded in a background thread; turned into the
# screen's pixel format in the main thread.

def readability_shade(w, h):
    """Dark on the left and at the bottom, where the text is."""
    shade = pygame.Surface((w, h), pygame.SRCALPHA)
    for x in range(w):
        a = int(230 * max(0.0, 1.0 - x / (w * 0.88)) ** 1.1)
        pygame.draw.line(shade, (8, 7, 20, a), (x, 0), (x, h))
    bottom = pygame.Surface((w, h), pygame.SRCALPHA)
    for y in range(h):
        a = int(150 * max(0.0, (y - h * 0.55) / (h * 0.45)) ** 1.6)
        pygame.draw.line(bottom, (8, 7, 20, a), (0, y), (w, y))
    shade.blit(bottom, (0, 0))
    top = max(1, h * 90 // 788)
    band = pygame.Surface((w, top), pygame.SRCALPHA)
    for y in range(top):
        pygame.draw.line(band, (8, 7, 20, int(120 * (1 - y / top))), (0, y), (w, y))
    shade.blit(band, (0, 0))
    return shade


def prepare(game):
    """Picture fields on a system.Game (kept on the object, so a game keeps them)."""
    if not hasattr(game, "icon"):
        game.icon = None
        game.raw_icon = None
        game.icon_loaded = False
        game.color = (60, 52, 137)
        game.backgrounds = None      # None: not loaded.
        game.raw_backgrounds = None
        game.tiles = {}
    return game


class ArtLoader:
    KEEP = 5      # Games whose backgrounds stay in memory.

    def __init__(self):
        self.queue = queue.Queue()
        self.shade = None
        self.size = (px(BG_W), px(BG_H))
        self.loaded = []          # Games with backgrounds, oldest first.
        threading.Thread(target=self._work, daemon=True).start()

    def want(self, game, backgrounds):
        self.queue.put((game, backgrounds))

    def _work(self):
        while True:
            game, backgrounds = self.queue.get()
            try:
                self._load(game, backgrounds)
            except Exception:  # A broken picture must not stop the menu.
                game.icon_loaded = True
                if backgrounds and game.backgrounds is None and game.raw_backgrounds is None:
                    game.raw_backgrounds = []

    def _load(self, game, backgrounds):
        sys_dir = os.path.join(game.path, "sce_sys")
        if not game.icon_loaded:
            icon = None
            try:
                icon = pygame.image.load(os.path.join(sys_dir, "icon0.png"))
            except (pygame.error, FileNotFoundError, OSError):
                pass
            if icon is not None:
                tiny = pygame.transform.smoothscale(icon, (1, 1))
                game.color = tuple(tiny.get_at((0, 0))[:3])
                side = min(icon.get_width(), max(256, px(TILE_SEL) * 2))
                game.raw_icon = pygame.transform.smoothscale(icon, (side, side))
            game.icon_loaded = True
        if not backgrounds or game.backgrounds is not None or game.raw_backgrounds is not None:
            return
        if self.shade is None:
            self.shade = readability_shade(*self.size)
        result = []
        for name in ("pic0.png", "pic1.png"):
            try:
                picture = pygame.image.load(os.path.join(sys_dir, name))
            except (pygame.error, FileNotFoundError, OSError):
                continue
            result.append(pygame.transform.smoothscale(picture, self.size))
        if not result:
            if game.raw_icon is not None:
                small = pygame.transform.smoothscale(game.raw_icon, (16, 9))
                result.append(pygame.transform.smoothscale(small, self.size))
            else:
                plain = pygame.Surface(self.size)
                plain.fill(game.color)
                result.append(plain)
            veil = pygame.Surface(self.size, pygame.SRCALPHA)
            veil.fill((0, 0, 0, 110))
            result[0].blit(veil, (0, 0))
        for background in result:
            background.blit(self.shade, (0, 0))
        game.raw_backgrounds = result

    def finish(self, game, keep):
        """Main thread: converts what was loaded; drops backgrounds of games far away."""
        if game.raw_icon is not None and game.icon is None:
            game.icon = game.raw_icon.convert_alpha()
        if game.raw_backgrounds is not None and game.backgrounds is None:
            game.backgrounds = [b.convert() for b in game.raw_backgrounds]
            game.raw_backgrounds = None
            if game in self.loaded:
                self.loaded.remove(game)
            self.loaded.append(game)
            while len(self.loaded) > self.KEEP:
                old = next((g for g in self.loaded if g not in keep), None)
                if old is None:
                    break
                self.loaded.remove(old)
                old.backgrounds = None


def tile_image(game, size_px, shape="rounded"):
    size_px = max(8, size_px - size_px % 4)
    tile = game.tiles.get((size_px, shape))
    if tile is None:
        if shape == "circle":
            tile = ui.circle_image(game.icon, size_px)
        else:
            tile = ui.rounded_image(game.icon, size_px, px(14 if shape == "rounded" else 3))
        game.tiles[(size_px, shape)] = tile
    return tile


# --------------------------------------------------------------------------------------------
# Values from slow commands, refreshed in the background while a screen shows them.

class Poller:
    def __init__(self):
        self.values = {}
        self.busy = set()
        self.lock = threading.Lock()

    def get(self, key, fn, max_age=3.0, default=None):
        now = time.monotonic()
        with self.lock:
            entry = self.values.get(key)
            stale = entry is None or now - entry[0] > max_age
            if stale and key not in self.busy:
                self.busy.add(key)
                threading.Thread(target=self._run, args=(key, fn), daemon=True).start()
        return entry[1] if entry is not None and entry[1] is not None else default

    def _run(self, key, fn):
        try:
            value = fn()
        except Exception:
            value = None
        with self.lock:
            self.values[key] = (time.monotonic(), value)
            self.busy.discard(key)

    def put(self, key, value):
        with self.lock:
            self.values[key] = (time.monotonic(), value)

    def forget(self, key):
        with self.lock:
            self.values.pop(key, None)


# --------------------------------------------------------------------------------------------
# Modals: everything shown over the home screen. The top one gets the input.

class Modal:
    covers = False        # Draws the whole screen (the home screen is not drawn below).

    def __init__(self, home):
        self.home = home
        self.appear = 0.0
        self.closed = False

    def act(self, action):
        pass

    def update(self, dt):
        self.appear = min(1.0, self.appear + dt / 0.18)

    def draw(self, c):
        pass

    def hints(self):
        return [("circle", "Back")]

    def close(self):
        self.closed = True

    def typed(self, chunk):
        pass


class Dialog(Modal):
    """A message with buttons: [(label, callback)]."""

    def __init__(self, home, message, buttons=None, title=None):
        super().__init__(home)
        self.message = message
        self.title = title
        self.buttons = buttons or [("OK", None)]
        self.selected = 0

    def act(self, action):
        h = self.home
        if action in (LEFT, RIGHT) and len(self.buttons) > 1:
            self.selected = (self.selected + (1 if action == RIGHT else -1)) % len(self.buttons)
            h.sounds.play("move")
        elif action == OK:
            h.sounds.play("select")
            self.close()
            callback = self.buttons[self.selected][1]
            if callback:
                callback()
        elif action == BACK:
            h.sounds.play("back")
            self.close()
            if len(self.buttons) == 1 and self.buttons[0][1]:
                self.buttons[0][1]()

    def draw(self, c):
        a = ease_out(self.appear)
        c.dim(170 * a)
        lines = c.t.wrap(self.message, 21, 560)[:8]
        box_w = 640
        box_h = 150 + len(lines) * 30 + (42 if self.title else 0)
        x = ui.W / 2 - box_w / 2
        y = ui.H / 2 - box_h / 2 + (1 - a) * 20
        c.rect(DIALOG, x, y, box_w, box_h, 20)
        ty = y + 34
        if self.title:
            c.text(self.title, 24, ui.W / 2, ty, WHITE, True, "midtop")
            ty += 42
        for line in lines:
            c.text(line, 21, ui.W / 2, ty, WHITE, False, "midtop")
            ty += 30
        by = y + box_h - 74
        width = 190
        total = len(self.buttons) * width + (len(self.buttons) - 1) * 20
        bx = ui.W / 2 - total / 2
        for i, (label, _) in enumerate(self.buttons):
            on = i == self.selected
            if on:
                c.rect(WHITE, bx, by, width, 48, 24)
            else:
                c.rect(WHITE, bx, by, width, 48, 24, 2)
            c.text(label, 18, bx + width / 2, by + 24, INK if on else WHITE, on, "center")
            bx += width + 20

    def hints(self):
        return [("cross", "Select"), ("circle", "Back")] if len(self.buttons) > 1 else [("cross", "OK")]


class Busy(Modal):
    """Runs `work` (returning (ok, message)) in the background, then shows the message, or calls
    after(ok, message)."""

    def __init__(self, home, text, work, after=None):
        super().__init__(home)
        self.text = text
        self.result = None
        self.after = after

        def run():
            try:
                result = work()
            except Exception as error:
                result = (False, str(error))
            if not isinstance(result, tuple):
                result = (bool(result), "")
            self.result = result

        threading.Thread(target=run, daemon=True).start()

    def update(self, dt):
        super().update(dt)
        if self.result is not None and not self.closed:
            self.close()
            ok, message = self.result
            self.home.sounds.play("select" if ok else "error")
            if self.after:
                self.after(ok, message)
            elif message:
                self.home.push(Dialog(self.home, message))

    def draw(self, c):
        c.dim(160 * ease_out(self.appear))
        box_w, box_h = 560, 130
        x, y = ui.W / 2 - box_w / 2, ui.H / 2 - box_h / 2
        c.rect(DIALOG, x, y, box_w, box_h, 20)
        t = self.home.t
        for i in range(8):
            ang = t * 5 + i * math.pi / 4
            shade = 90 + int(165 * ((i + 1) / 8))
            c.circle((shade, shade, 255), x + 56 + math.cos(ang) * 16, y + box_h / 2 + math.sin(ang) * 16, 3)
        lines = c.t.wrap(self.text, 19, 420)[:2]
        for n, line in enumerate(lines):
            c.text(line, 19, x + 100, y + box_h / 2 - 13 * len(lines) + n * 26, WHITE)

    def hints(self):
        return [(None, "Please wait")]


class KeyboardDialog(Modal):
    """Types one text. on_done(text) returns None to close, or an error to show."""

    def __init__(self, home, title, text="", secret=False, on_done=None, max_length=128, done_label="Done"):
        super().__init__(home)
        self.kb = ui.Keyboard(title, text, secret, done_label, max_length)
        self.on_done = on_done
        home.input.typed.clear()

    def typed(self, chunk):
        self.kb.type(chunk)

    def act(self, action):
        result = self.kb.act(action, self.home.sounds)
        if result == "cancel":
            self.close()
        elif result == "done":
            error = self.on_done(self.kb.text) if self.on_done else None
            if error:
                self.home.sounds.play("error")
                self.kb.status, self.kb.status_good = error, False
            else:
                self.home.sounds.play("select")
                self.close()

    def draw(self, c):
        a = ease_out(self.appear)
        c.dim(170 * a)
        w = 640
        x = ui.W / 2 - w / 2
        y = 70 + (1 - a) * 20
        c.rect(DIALOG, x, y, w, 540, 20)
        self.kb.draw(c, x + 40, y + 36, w - 80, self.home.t)

    def hints(self):
        return [("cross", "Type"), ("square", "Delete"), ("triangle", "Symbols"),
                ("options", self.kb.done_label), ("circle", "Back")]


class Picker(Modal):
    """Choose one from a list: items [(label, value)]; on_pick(value)."""
    ROWS = 9

    def __init__(self, home, title, items, current=None, on_pick=None, subtitle=None):
        super().__init__(home)
        self.title = title
        self.subtitle = subtitle
        self.items = items or [("(none)", None)]
        self.on_pick = on_pick
        self.selected = next((i for i, (_, v) in enumerate(self.items) if v == current), 0)
        self.top = max(0, self.selected - 4)

    def act(self, action):
        h = self.home
        step = {UP: -1, DOWN: 1, PAGE_UP: -8, PAGE_DOWN: 8}.get(action)
        if step:
            new = max(0, min(len(self.items) - 1, self.selected + step))
            if new != self.selected:
                self.selected = new
                h.sounds.play("move")
        elif action == OK:
            h.sounds.play("select")
            self.close()
            if self.on_pick:
                self.on_pick(self.items[self.selected][1])
        elif action == BACK:
            h.sounds.play("back")
            self.close()

    def draw(self, c):
        a = ease_out(self.appear)
        c.dim(170 * a)
        w, rows = 600, self.ROWS
        x = ui.W / 2 - w / 2
        y = 50 + (1 - a) * 20
        c.rect(DIALOG, x, y, w, 610, 20)
        rtl = i18n.rtl()
        tx, anchor = (x + w - 36, "topright") if rtl else (x + 36, "topleft")
        c.text(self.title, 24, tx, y + 30, WHITE, True, anchor)
        ly = y + 80
        if self.subtitle:
            c.text(self.subtitle, 15, tx, y + 64, DIM, False, anchor)
            ly += 14
        if self.selected < self.top:
            self.top = self.selected
        if self.selected >= self.top + rows:
            self.top = self.selected - rows + 1
        for i in range(self.top, min(len(self.items), self.top + rows)):
            on = i == self.selected
            if on:
                c.rect(WHITE, x + 22, ly, w - 44, 50, 12)
            c.text(c.t.fit(self.items[i][0], 19, w - 90), 19, x + w - 40 if rtl else x + 40, ly + 13,
                   INK if on else WHITE, on, "topright" if rtl else "topleft")
            ly += 56
        if len(self.items) > rows:
            bar_h = 500 * rows / len(self.items)
            bar_y = y + 80 + (500 - bar_h) * self.top / max(1, len(self.items) - rows)
            c.rect((80, 76, 140), x + w - 14, bar_y, 4, bar_h, 2)

    def hints(self):
        return [("cross", "Select"), ("l1r1", "Page"), ("circle", "Back")]


# --------------------------------------------------------------------------------------------
# Wi-Fi panel (from the top bar or Settings).

class WifiPanel(Modal):
    WIDTH = 520

    def __init__(self, home):
        super().__init__(home)
        self.selected = 0
        self.status = ""
        self.connecting = None
        home.network.scan()

    def networks(self):
        with self.home.network.lock:
            return list(self.home.network.networks)

    def act(self, action):
        h = self.home
        if self.connecting:
            return
        networks = self.networks()
        if action == BACK:
            h.sounds.play("back")
            self.close()
        elif action == UP and self.selected > 0:
            self.selected -= 1
            h.sounds.play("move")
        elif action == DOWN and self.selected < len(networks) - 1:
            self.selected += 1
            h.sounds.play("move")
        elif action == TRIANGLE:
            h.sounds.play("select")
            h.network.scan()
        elif action == SQUARE and networks:
            ssid = networks[min(self.selected, len(networks) - 1)][0]
            if h.network.is_saved(ssid):
                h.push(Dialog(h, f"Forget {ssid}? Its password will be asked again next time.",
                              [("Forget", lambda: self.forget(ssid)), ("Cancel", None)]))
        elif action == OK and networks:
            ssid, _, secured, in_use = networks[min(self.selected, len(networks) - 1)]
            if in_use:
                self.status = f"Already connected to {ssid}."
                return
            h.sounds.play("select")
            if not secured or h.network.is_saved(ssid):
                self.start(ssid, None)
            else:
                self.ask_password(ssid)

    def ask_password(self, ssid):
        self.home.push(KeyboardDialog(self.home, f"Password for {ssid}", secret=True, done_label="Connect",
                                      on_done=lambda text: self.password(ssid, text), max_length=63))

    def password(self, ssid, text):
        if len(text) < 8:
            return "A Wi-Fi password has at least 8 characters."
        self.start(ssid, text)
        return None

    def forget(self, ssid):
        ok, err = self.home.network.forget(ssid)
        self.status = f"{ssid} forgotten." if ok else (err or f"Could not forget {ssid}.")

    def start(self, ssid, password):
        self.connecting = ssid
        self.status = ""
        self.home.network.connect(ssid, password)

    def update(self, dt):
        super().update(dt)
        try:
            ok, message = self.home.network.results.get_nowait()
        except queue.Empty:
            return
        ssid = self.connecting
        self.connecting = None
        if ok:
            self.home.sounds.play("select")
            self.home.toast(message)
            self.close()
        else:
            self.home.sounds.play("error")
            self.status = message
            if ssid and "password" in message.lower():
                self.ask_password(ssid)

    def draw(self, c):
        h = self.home
        width = self.WIDTH
        slide = ease_out(self.appear)
        left = ui.W - width * slide
        c.dim(150 * slide)
        c.rect(PANEL, left, 0, width, ui.H)
        c.line(PANEL_LINE, left, 0, left, ui.H, 1)
        x = left + 40
        c.text("Wi-Fi", 30, x, 40, WHITE, True)
        with h.network.lock:
            state, ssid = h.network.state, h.network.ssid
        status = f"Connected to {ssid}" if state == "connected" else \
            "Connecting…" if state == "connecting" else "Not connected"
        if state == "unavailable":
            status = "No Wi-Fi device found"
        c.text(status, 16, x, 84, SOFT)
        networks = self.networks()
        y = 130
        if h.network.scanning and not networks:
            c.text("Searching for networks…", 18, x, y + 10, SOFT)
        elif not networks:
            c.text("No networks found.", 18, x, y + 10, SOFT)
        first = max(0, self.selected - 7)
        for i, (name, strength, secured, in_use) in enumerate(networks[first:first + 9], start=first):
            rx, rw = x - 14, width - 52
            on = i == self.selected
            if on:
                c.rect(WHITE, rx, y, rw, 52, 12)
            ink = INK if on else WHITE
            bars = 3 if strength >= 67 else 2 if strength >= 34 else 1
            ui.draw_wifi(c, rx + 26, y + 36, ink, bars + 1)
            c.text(c.t.fit(name, 18, rw - 140, in_use), 18, rx + 56, y + 8, ink, in_use or on)
            saved = h.network.is_saved(name)
            detail = "Connected" if in_use else ("Saved" if saved else ("Secured" if secured else "Open"))
            c.text(detail, 13, rx + 56, y + 31, ui.mix(INK, WHITE, 0.4) if on else GOOD if (in_use or saved) else SOFT)
            if secured:
                ui.draw_lock(c, rx + rw - 30, y + 22, ink if on else SOFT)
            y += 58
        if self.connecting:
            dots = "." * (1 + int(h.t * 3) % 3)
            c.text(f"Connecting to {self.connecting}{dots}", 17, x, ui.H - 96, WHITE)
        elif self.status:
            for n, line in enumerate(c.t.wrap(self.status, 16, width - 80)[:2]):
                c.text(line, 16, x, ui.H - 104 + n * 22, BAD)

    def hints(self):
        networks = self.networks()
        hints = [("cross", "Connect"), ("triangle", "Search again")]
        if networks and self.home.network.is_saved(networks[min(self.selected, len(networks) - 1)][0]):
            hints.append(("square", "Forget"))
        return hints + [("circle", "Back")]


# --------------------------------------------------------------------------------------------
# Rows: the lines of Settings, the quick menu and a game's menu.

class Row:
    """kind: header, info, button, action, toggle, slider, choice."""

    def __init__(self, kind, label, value=None, ok=None, left=None, right=None, color=None, picture=None):
        self.kind = kind
        self.label = label
        self.value = value
        self.ok = ok
        self.left = left
        self.right = right
        self.color = color
        self.picture = picture     # A surface shown at the right (an avatar).

    @property
    def selectable(self):
        return self.kind not in ("header", "info")

    def height(self):
        return 34 if self.kind == "header" else 56 if self.kind == "action" else 46


def draw_rows(c, rows, selected, x, y, width, bottom, focused, top_index=0):
    """With a right-to-left menu language (Arabic) the labels are on the right and the values and
    switches on the left."""
    rtl = i18n.rtl()
    for i in range(top_index, len(rows)):
        row = rows[i]
        height = row.height()
        if y + height > bottom:
            break
        on = focused and i == selected
        if row.kind == "header":
            if rtl:
                c.text(row.label, 14, x + width, y + 12, DIM, True, "topright")
            else:
                c.text(i18n.upper(row.label), 14, x, y + 12, DIM, True)
        elif row.kind == "action":
            label_w = max(200, c.t.width(row.label, 18, True) + 60)
            bx = x + width - label_w + 4 if rtl else x - 4
            if on:
                c.rect(WHITE, bx, y + 4, label_w, 46, 23)
            elif row.ok is None:
                c.rect(KEY, bx, y + 4, label_w, 46, 23)
            else:
                c.rect(KEY_ON, bx, y + 4, label_w, 46, 23)
            ink = INK if on else SOFT if row.ok is None else WHITE
            c.text(row.label, 18, bx + label_w / 2, y + 27, ink, True, "center")
            if row.value:
                value = c.t.fit(str(row.value), 15, width - label_w - 30)
                if rtl:
                    c.text(value, 15, bx - 16, y + 17, row.color or SOFT, False, "topright")
                else:
                    c.text(value, 15, x + label_w + 16, y + 17, row.color or SOFT)
        else:
            if on:
                c.rect(WHITE, x - 14, y, width + 28, 44, 12)
            fg = INK if on else WHITE                   # Text on the row.
            fg_soft = ui.mix(INK, WHITE, 0.35) if on else SOFT
            if row.kind == "info" and row.value is None:
                # A note: wraps over two lines if needed.
                lines = c.t.wrap(row.label, 15, width)[:2]
                for n, line in enumerate(lines):
                    c.text(line, 15, x + width - 2 if rtl else x + 2, y + (13 if len(lines) == 1 else 3 + n * 20),
                           row.color or DIM, False, "topright" if rtl else "topleft")
                y += height + 4
                continue
            label_color = fg if row.kind != "info" else SOFT
            label = c.t.fit(row.label, 17, width * 0.55)
            if rtl:
                label_w = c.text(label, 17, x + width - 2, y + 11, label_color, on, "topright")
            else:
                label_w = c.text(label, 17, x + 2, y + 11, label_color, on)
            room = width - label_w - 30
            if rtl:
                draw_row_value_rtl(c, row, on, x + 2, y, room, fg_soft)
                y += height + 4
                continue
            rx = x + width - 2
            if row.kind == "toggle":
                on_value = bool(row.value)
                c.rect(GOOD if on_value else (KEY if not on else ui.mix(INK, WHITE, 0.6)), rx - 50, y + 10, 50, 24, 12)
                c.circle(INK if on and not on_value else (255, 255, 255), rx - 12 if on_value else rx - 38, y + 22, 9)
            elif row.kind == "slider":
                value = row.value if row.value is not None else 0
                bar_w = max(60, min(220, room - 70))
                track = ui.mix(INK, WHITE, 0.7) if on else KEY
                c.rect(track, rx - bar_w - 56, y + 19, bar_w, 6, 3)
                c.rect(ACCENT, rx - bar_w - 56, y + 19, max(1, bar_w * value / 100), 6, 3)
                c.circle(INK if on else WHITE, rx - bar_w - 56 + bar_w * value / 100, y + 22, 8)
                c.text(f"{value}%", 16, rx, y + 12, fg_soft, False, "topright")
            elif row.kind == "choice":
                text = c.t.fit(str(row.value), 16, room - 40)
                c.text(text, 16, rx - 20, y + 12, fg_soft, on, "topright")
                if on:
                    tw = c.t.width(text, 16, True)
                    c.text("‹", 20, rx - 32 - tw, y + 8, INK, True, "topright")
                    c.text("›", 20, rx, y + 8, INK, True, "topright")
            elif row.picture is not None:
                c.blit(row.picture, rx, y + 22, "midright")
            elif row.value is not None:
                text = c.t.fit(str(row.value), 16, room)
                c.text(text, 16, rx, y + 12, fg_soft if on else row.color or (SOFT if row.kind != "info" else WHITE),
                       False, "topright")
        y += height + 4
    return y


def draw_row_value_rtl(c, row, on, lx, y, room, fg_soft):
    """The value or switch of a row at its left end (right-to-left menus)."""
    if row.kind == "toggle":
        on_value = bool(row.value)
        c.rect(GOOD if on_value else (KEY if not on else ui.mix(INK, WHITE, 0.6)), lx, y + 10, 50, 24, 12)
        c.circle(INK if on and not on_value else (255, 255, 255), lx + 38 if on_value else lx + 12, y + 22, 9)
    elif row.kind == "slider":
        value = row.value if row.value is not None else 0
        bar_w = max(60, min(220, room - 70))
        track = ui.mix(INK, WHITE, 0.7) if on else KEY
        c.text(f"{value}%", 16, lx, y + 12, fg_soft)
        c.rect(track, lx + 56, y + 19, bar_w, 6, 3)
        c.rect(ACCENT, lx + 56, y + 19, max(1, bar_w * value / 100), 6, 3)
        c.circle(INK if on else WHITE, lx + 56 + bar_w * value / 100, y + 22, 8)
    elif row.kind == "choice":
        text = c.t.fit(str(row.value), 16, room - 40)
        c.text(text, 16, lx + 20, y + 12, fg_soft, on)
        if on:
            tw = c.t.width(text, 16, True)
            c.text("‹", 20, lx, y + 8, INK, True)
            c.text("›", 20, lx + 32 + tw, y + 8, INK, True)
    elif row.picture is not None:
        c.blit(row.picture, lx, y + 22, "midleft")
    elif row.value is not None:
        text = c.t.fit(str(row.value), 16, room)
        c.text(text, 16, lx, y + 12, fg_soft if on else row.color or (SOFT if row.kind != "info" else WHITE))


def move_selection(rows, selected, step):
    """The next selectable row from `selected` in the direction of `step`, or `selected`."""
    i = selected
    while True:
        i += step
        if i < 0 or i >= len(rows):
            return selected
        if rows[i].selectable:
            return i


def first_selectable(rows):
    return next((i for i, r in enumerate(rows) if r.selectable), 0)


class RowList(Modal):
    """A modal made of rows: keeps the selection on selectable rows and handles moving."""

    def __init__(self, home):
        super().__init__(home)
        self.row = 0

    def rows(self):
        return []

    def current(self, rows):
        if self.row >= len(rows) or not rows[self.row].selectable:
            self.row = first_selectable(rows)
        return rows[self.row] if rows else None

    def act_rows(self, action):
        """Moves and runs rows; returns True when the action was used."""
        h = self.home
        rows = self.rows()
        row = self.current(rows)
        if action in (UP, DOWN, PAGE_UP, PAGE_DOWN):
            step = -1 if action in (UP, PAGE_UP) else 1
            new = self.row
            for _ in range(1 if action in (UP, DOWN) else 5):
                new = move_selection(rows, new, step)
            if new != self.row:
                self.row = new
                h.sounds.play("move")
            return True
        if action == LEFT and row is not None and row.left:
            row.left()
            return True
        if action == RIGHT and row is not None and row.right:
            row.right()
            return True
        if action == OK:
            if row is not None and row.ok:
                h.sounds.play("select")
                row.ok()
            else:
                h.sounds.play("error")
            return True
        return False


# --------------------------------------------------------------------------------------------
# Settings (full screen): categories on the left, their settings on the right.

class SettingsScreen(RowList):
    covers = True
    CATEGORIES = ["Profile", "Appearance", "Network", "Games from PC", "Sound", "Controllers", "Storage",
                  "Games", "Saves", "Power", "Date and time", "System", "Advanced", "About"]
    category_step = 38

    def __init__(self, home, category=0, focus="categories"):
        super().__init__(home)
        self.category = category
        self.focus = focus
        self.top = 0
        self.backdrop = None

    # Rows of each category ------------------------------------------------------------------

    def rows(self):
        name = self.CATEGORIES[self.category]
        return getattr(self, "rows_" + name.lower().replace(" ", "_"))()

    def rows_profile(self):
        h = self.home
        profiles = h.profiles.all()
        rows = [
            Row("button", "Name", h.settings["name"], ok=self.edit_name),
            Row("button", "Avatar", ok=lambda: h.push(AvatarPicker(h)), picture=h.avatar(36)),
            Row("info", "Your name and avatar are shown on the home screen. Games get your name as the "
                        "player name."),
            Row("header", "Profiles"),
        ]
        if len(profiles) > 1:
            rows.append(Row("action", "Switch profile", ok=lambda: h.push(ProfilePicker(h))))
        rows.append(Row("action", "Add a profile", ok=lambda: add_profile(h)) if len(profiles) < store.MAX_PROFILES
                    else Row("info", "Up to 8 profiles."))
        if len(profiles) > 1:
            rows.append(Row("action", "Delete this profile", ok=self.delete_profile))
        rows.append(Row("info", "Each profile has its own saves, trophies and play time."))
        return rows

    def delete_profile(self):
        h = self.home
        current = h.profiles.current()

        def delete():
            h.profiles.remove(current["id"], h.settings)
            h.switch_profile(h.profiles.current_id)
            h.toast(f"{current['name']} deleted.")

        h.push(Dialog(h, f"Delete {current['name']}? Their saves, trophies and play time are deleted.",
                      [("Delete", delete), ("Cancel", None)]))

    def edit_name(self):
        h = self.home

        def done(text):
            text = text.strip()
            if not text:
                return "Type a name."
            h.set_profile(name=text)
            return None

        h.push(KeyboardDialog(h, "Your name (up to 16 letters)", h.settings["name"], on_done=done, max_length=16))

    # Appearance ------------------------------------------------------------------------------

    def setting_choice(self, label, key, options, reload=False, after=None):
        """A row that cycles through options [(value, text)] with Left/Right, or picks with X."""
        h = self.home
        values = [v for v, _ in options]
        current = h.settings[key]
        text = dict(options).get(current, str(current))

        def set_value(value):
            if value is None or value == h.settings[key]:
                return
            h.settings.set(**{key: value})
            h.sounds.play("move")
            if after:
                after()
            if reload:
                h.request_reload(self.category)

        def step(n):
            index = values.index(current) if current in values else 0
            set_value(values[(index + n) % len(values)])

        return Row("choice", label, text, ok=lambda: h.push(Picker(h, label, [(t, v) for v, t in options], current,
                                                                   set_value)),
                   left=lambda: step(-1), right=lambda: step(1))

    def setting_toggle(self, label, key, after=None):
        h = self.home

        def flip():
            h.settings.set(**{key: not h.settings[key]})
            if after:
                after()

        return Row("toggle", label, h.settings[key], ok=flip)

    def setting_slider(self, label, key, step, low=0, high=100, after=None):
        h = self.home

        def change(n):
            value = max(low, min(high, h.settings[key] + n))
            if value != h.settings[key]:
                h.settings.set(**{key: value})
                h.sounds.play("move")
                if after:
                    after()

        return Row("slider", label, int(round((h.settings[key] - low) * 100 / max(1, high - low))),
                   left=lambda: change(-step), right=lambda: change(step))

    def rows_appearance(self):
        h = self.home
        return [
            Row("header", "Colors"),
            self.setting_choice("Accent color", "accent", [(k, v[0]) for k, v in ui.ACCENTS.items()], reload=True),
            self.setting_choice("Theme", "theme", list(ui.THEMES.items()), reload=True),
            Row("header", "Background"),
            Row("choice", "Background", {"art": "The game's own art", "gradient": "Soft gradient",
                                         "solid": "Solid color", "picture": "Your picture"}.get(
                h.settings["background"], "The game's own art"), ok=self.pick_background,
                left=lambda: self.cycle_background(-1), right=lambda: self.cycle_background(1)),
            self.setting_slider("Background dim", "dim", 10, 0, 80),
            Row("header", "Floating orbs"),
            self.setting_toggle("Floating orbs", "orbs"),
            self.setting_choice("Amount", "orb_amount", [("few", "Few"), ("normal", "Normal"), ("many", "Many")],
                                after=h.make_particles),
            self.setting_choice("Speed", "orb_speed", [("slow", "Slow"), ("normal", "Normal"), ("fast", "Fast")]),
            self.setting_choice("Color", "orb_color", [("white", "White"), ("accent", "Accent color"),
                                                        ("gold", "Gold")]),
            Row("header", "Motion"),
            self.setting_choice("Animations", "animations", [("full", "Full"), ("reduced", "Reduced"),
                                                              ("off", "Off")]),
            Row("header", "Game tiles"),
            self.setting_choice("Tile size", "tile_size", [("small", "Small"), ("medium", "Medium"),
                                                            ("large", "Large")], reload=True),
            self.setting_choice("Tile shape", "tile_shape", [("rounded", "Rounded"), ("square", "Square"),
                                                              ("circle", "Circle")]),
            self.setting_toggle("Source labels (USB, PS4, PC)", "source_labels"),
            Row("header", "Text"),
            self.setting_choice("Text size", "text_size", [(v, f"{v}%") for v in (90, 100, 110, 120, 130)],
                                reload=True),
            self.setting_choice("Font", "font", list(ui.FONTS.items()), reload=True),
            Row("header", "Clock"),
            self.setting_toggle("Show the date", "clock_date"),
            self.setting_toggle("Show seconds", "clock_seconds"),
            Row("header", "Top bar"),
            self.setting_toggle("Name", "show_name"),
            self.setting_toggle("Avatar", "show_avatar"),
            self.setting_toggle("Controller battery", "show_battery"),
            self.setting_toggle("IP address", "show_ip"),
            Row("header", "Sounds and feel"),
            self.setting_toggle("Menu sounds", "sounds", after=h.make_sounds),
            self.setting_slider("Menu sound volume", "sound_volume", 10, 0, 100, after=h.make_sounds),
            self.setting_choice("Sound style", "sound_style", list(ui.SOUND_STYLES.items()), after=h.make_sounds),
            self.setting_toggle("Rumble when moving", "rumble", after=h.make_input),
            Row("header", "Screen"),
            self.setting_toggle("Button hints at the bottom", "hints"),
            self.setting_choice("Screen edges (overscan)", "overscan",
                                [(v, "Full screen" if not v else f"{v}% smaller") for v in (0, 2, 4, 6, 8, 10)],
                                reload=True),
            self.setting_choice("Screensaver", "screensaver_minutes",
                                [(0, "Off"), (5, "After 5 minutes"), (10, "After 10 minutes"),
                                 (30, "After 30 minutes")]),
            self.setting_choice("Screensaver style", "screensaver_mode",
                                [("dim", "Dim the screen"), ("slideshow", "Slideshow of your games")]),
        ]

    BACKGROUNDS = ["art", "gradient", "solid", "picture"]

    def cycle_background(self, step):
        h = self.home
        order = ["art", "gradient", "solid"] + (["picture"] if os.path.exists(store.BACKGROUND_FILE) else [])
        current = h.settings["background"]
        index = order.index(current) if current in order else 0
        h.settings.set(background=order[(index + step) % len(order)])
        h.static_bg = None
        h.sounds.play("move")

    def pick_background(self):
        h = self.home
        items = [("The game's own art", "art"), ("Soft gradient", "gradient"), ("Solid color", "solid")]
        if os.path.exists(store.BACKGROUND_FILE):
            items.append(("Your picture (saved)", "picture"))
        items.append(("Choose a picture from the USB drive…", "usb"))

        def chosen(value):
            if value == "usb":
                self.pick_usb_picture()
            elif value:
                h.settings.set(background=value)
                h.static_bg = None

        h.push(Picker(h, "Background", items, h.settings["background"], chosen))

    def pick_usb_picture(self):
        h = self.home
        pictures = []
        for folder in (system.USB_MOUNT, os.path.join(system.USB_MOUNT, "PS5-wallpapers")):
            try:
                for name in sorted(os.listdir(folder), key=str.lower):
                    if name.lower().endswith((".png", ".jpg", ".jpeg")):
                        pictures.append((name, os.path.join(folder, name)))
            except OSError:
                pass
        if not pictures:
            h.push(Dialog(h, "No pictures found. Put a PNG or JPG picture at the top of the USB drive or in a "
                             "PS5-wallpapers folder on it."))
            return

        def use(path):
            if path is None:
                return
            try:
                picture = pygame.image.load(path)
                os.makedirs(store.CONFIG_DIR, exist_ok=True)
                pygame.image.save(picture, store.BACKGROUND_FILE)
            except (pygame.error, OSError):
                h.push(Dialog(h, "That picture could not be read."))
                return
            h.settings.set(background="picture")
            h.static_bg = None
            h.toast("Background changed")

        h.push(Picker(h, "Pictures on the USB drive", pictures, None, use,
                      "It is copied to the PS4, so the USB drive can be unplugged after."))

    def rows_network(self):
        h = self.home
        with h.network.lock:
            state, ssid, ethernet = h.network.state, h.network.ssid, h.network.ethernet
            saved = sorted(h.network.saved_names)
        wifi = ssid if state == "connected" else ("Connecting…" if state == "connecting" else
                                                    "No Wi-Fi device" if state == "unavailable" else "Not connected")
        addresses = h.poll.get("ip", system.ip_addresses, 3.0, [])
        rows = [Row("button", "Wi-Fi", wifi, ok=lambda: h.push(WifiPanel(h))),
                Row("info", "Network cable", {"connected": "Connected", "disconnected": "Not connected"}.get(
                    ethernet, "Not connected"))]
        for interface, address in addresses:
            kind = "Wi-Fi" if interface.startswith(("mlan", "wl")) else \
                "cable" if interface.startswith(("eth", "en")) else interface
            rows.append(Row("info", f"IP address ({kind})", address))
        rows.append(Row("header", "Saved Wi-Fi networks"))
        if not saved:
            rows.append(Row("info", "None yet. Networks you join are remembered."))
        for name in saved:
            rows.append(Row("button", name, "Forget", ok=lambda n=name: h.push(Dialog(
                h, f"Forget {n}? Its password will be asked again next time.",
                [("Forget", lambda: h.network.forget(n)), ("Cancel", None)]))))
        return rows

    def rows_games_from_pc(self):
        h = self.home
        s = h.pc.get()
        state, message, count = h.pc.status()
        status = {"off": "Off", "connecting": "Connecting…",
                  "connected": f"Connected  ·  {count} game" + ("s" if count != 1 else "")}.get(state, message)
        return [
            Row("toggle", "Use games from PC", s["enabled"], ok=self.toggle_pc),
            Row("button", "PC address", s["address"] or "Not set", ok=lambda: self.edit_pc("address", "PC address")),
            Row("button", "Shared folder", s["share"] or "Not set", ok=lambda: self.edit_pc("share", "Shared folder")),
            Row("button", "Username", s["user"] or "None (guest)", ok=lambda: self.edit_pc("user", "Username")),
            Row("button", "Password", "•" * min(12, len(s["password"])) if s["password"] else "None",
                ok=lambda: self.edit_pc("password", "Password", True)),
            Row("action", "Connect", status, ok=self.connect_pc,
                color=GOOD if state == "connected" else BAD if state == "error" else SOFT),
            Row("info", "Windows or Linux (Samba) shares. Leave Username and Password blank for a guest share."),
        ]

    def toggle_pc(self):
        h = self.home
        h.pc.save(enabled=not h.pc.get()["enabled"])
        h.pc.connect()

    def connect_pc(self):
        self.home.pc.save(enabled=True)
        self.home.pc.connect()

    def edit_pc(self, key, title, secret=False):
        h = self.home

        def done(text):
            h.pc.save(**{key: text if key == "password" else text.strip()})
            return None

        h.push(KeyboardDialog(h, title, h.pc.get()[key], secret=secret, on_done=done))

    def rows_sound(self):
        h = self.home
        outputs = h.poll.get("outputs", system.sound_outputs, 2.0, [])
        volume = h.poll.get("volume", system.sound_volume, 2.0)
        current = next((name for _, name, default in outputs if default), "None")
        return [
            Row("choice", "Output", current, ok=lambda: h.push(Picker(
                h, "Sound output", [(name, node) for node, name, _ in outputs],
                next((n for n, _, d in outputs if d), None), self.set_output)),
                left=lambda: self.cycle_output(outputs, -1), right=lambda: self.cycle_output(outputs, 1)),
            Row("slider", "Volume", volume if volume is not None else 0,
                left=lambda: change_volume(h, -5), right=lambda: change_volume(h, 5)),
            Row("action", "Test sound", ok=lambda: h.sounds.play("test")),
            Row("info", "The TV is used first, also when a controller on a cable has its own headphone jack."),
        ] + self.rows_headphones()

    def rows_headphones(self):
        h = self.home
        paired = h.poll.get("headphones", system.headphones, 3.0, [])
        rows = [Row("header", "Bluetooth headphones")]
        if not paired:
            rows.append(Row("info", "None paired yet."))
        for d in paired:
            rows.append(Row("button", d["name"], "Connected" if d["connected"] else "Not connected",
                            ok=lambda d=d: self.headphones_menu(d), color=GOOD if d["connected"] else None))
        rows.append(Row("action", "Pair headphones", ok=self.pair_headphones))
        rows.append(Row("info", "Sound moves to the headphones when they connect, and back to the TV after."))
        return rows

    def after_headphones(self, ok, message):
        h = self.home
        for key in ("headphones", "outputs", "volume"):
            h.poll.forget(key)
        h.push(Dialog(h, message))

    def headphones_menu(self, d):
        h = self.home
        if d["connected"]:
            first = ("Disconnect", lambda: h.push(Busy(h, f"Disconnecting {d['name']}…",
                                                       lambda: system.disconnect_headphones(d["mac"]),
                                                       after=self.after_headphones)))
        else:
            first = ("Connect", lambda: h.push(Busy(h, f"Connecting {d['name']}…",
                                                    lambda: system.connect_headphones(d["mac"]),
                                                    after=self.after_headphones)))
        h.push(Dialog(h, d["name"], [first, ("Forget", lambda: h.push(Busy(
            h, f"Forgetting {d['name']}…", lambda: system.forget_headphones(d["mac"]),
            after=self.after_headphones)))]))

    def pair_headphones(self):
        h = self.home

        def found(ok, devices):
            if not devices:
                h.push(Dialog(h, "No headphones found. Put them in pairing mode (often: hold the power "
                                 "button until a light blinks) and try again."))
                return
            h.push(Picker(h, "Headphones found", [(d["name"], d["mac"]) for d in devices], None, pick))

        def pick(mac):
            if mac is None:
                return
            h.push(Busy(h, "Pairing and connecting…", lambda: system.pair_headphones(mac),
                        after=self.after_headphones))

        h.push(Busy(h, "Put your headphones in pairing mode. Looking for them for 12 seconds…",
                    lambda: (True, system.find_headphones(12)), after=found))

    def set_output(self, node):
        if node is not None:
            system.set_sound_output(node)
        self.home.poll.forget("outputs")
        self.home.poll.forget("volume")

    def cycle_output(self, outputs, step):
        if not outputs:
            return
        index = next((i for i, (_, _, d) in enumerate(outputs) if d), 0)
        self.set_output(outputs[(index + step) % len(outputs)][0])
        self.home.sounds.play("move")

    def rows_controllers(self):
        h = self.home
        connected = h.poll.get("controllers", system.controllers, 1.0, [])
        paired = h.poll.get("paired", system.paired_controllers, 3.0, [])
        rows = [Row("header", "Connected")]
        if not connected:
            rows.append(Row("info", "No controller connected."))
        for pad in connected:
            rows.append(Row("info", pad["name"], pad_status(pad)))
        rows.append(Row("header", "Paired over Bluetooth"))
        if not paired:
            rows.append(Row("info", "None. Pair one below."))
        for mac, name, is_connected in paired:
            rows.append(Row("button", f"{name}  ({mac[-5:]})" + ("  ·  connected" if is_connected else ""),
                            "Forget", ok=lambda m=mac: h.push(Dialog(
                                h, "Forget this controller? To use it over Bluetooth again, pair it again.",
                                [("Forget", lambda: self.forget_pad(m)), ("Cancel", None)]))))
        rows.append(Row("action", "Pair a new controller", ok=self.pair))
        rows.append(Row("info", "A paired controller reconnects with its PS button, and stays connected over "
                                "Bluetooth while you do not use it."))
        rows += [
            Row("header", "Controller settings"),
            self.setting_choice("Light bar color", "lightbar", [(k, v[0]) for k, v in store.LIGHTBAR_COLORS.items()],
                                after=h.apply_lightbar),
            self.setting_choice("Light bar brightness", "lightbar_brightness",
                                [(v, f"{v}%") for v in (25, 50, 75, 100)], after=h.apply_lightbar),
            self.setting_toggle("Vibration", "vibration_on", after=h.make_input),
        ]
        if h.settings["vibration_on"]:
            rows.append(self.setting_slider("Vibration strength", "vibration", 10, 0, 100, after=h.make_input))
        rows += [
            self.setting_toggle("Controller microphone", "controller_mic", after=h.apply_mic),
            Row("info", "The microphone works when the controller is on a USB cable."),
            self.setting_choice("Button layout", "swap_buttons", [(False, "Standard (X to choose)"),
                                                                   (True, "X and O swapped (O to choose)")],
                                after=h.make_input),
            Row("action", "Test the controller", ok=lambda: h.push(ControllerTest(h))),
            Row("info", "Games get the light bar color, vibration and button layout the next time they start."),
        ]
        return rows

    def forget_pad(self, mac):
        h = self.home
        h.push(Busy(h, "Forgetting the controller…", lambda: (system.forget_controller(mac), "")))
        h.poll.forget("paired")

    def pair(self):
        h = self.home
        if not system.pair_mode():
            h.push(Dialog(h, "Could not start looking for controllers."))
            return
        h.push(Dialog(h, "Hold SHARE and PS on a DualShock 4 (Create and PS on a DualSense) until the light "
                         "bar blinks quickly. The PS4 looks for it for 60 seconds.", title="Pair a controller"))

    def rows_storage(self):
        h = self.home
        info = h.poll.get("storage", self.storage_info, 3.0, {})
        rows = [Row("header", "USB drive")]
        if info.get("usb"):
            free, total = info["usb"]
            rows.append(Row("info", info.get("usb_label") or "USB drive",
                            f"{system.size_text(free)} free of {system.size_text(total)}"))
            rows.append(Row("action", "Eject the USB drive", ok=lambda: h.push(Busy(
                h, "Ejecting the USB drive…", system.eject_usb,
                after=lambda ok, msg: (h.poll.forget("storage"), h.push(Dialog(h, msg)))))))
        else:
            rows.append(Row("info", "No USB drive plugged in."))
        rows.append(Row("header", "PS4 drive"))
        if info.get("ps4"):
            free, total = info["ps4"]
            rows.append(Row("info", "Free space", f"{system.size_text(free)} of {system.size_text(total)}"))
            rows.append(Row("info", "Game folder", system.PS4_GAMES_SHOWN))
            rows.append(Row("info", "Games there", str(sum(1 for g in h.all_games if g.source == "PS4"))))
            rows.append(Row("info", "Copy games there with GoldHEN FTP from your PC."))
        else:
            rows.append(Row("info", "Not open: this system was started from a USB drive."))
        rows.append(Row("header", "PC share"))
        state, message, count = h.pc.status()
        games = f"{count} game" + ("s" if count != 1 else "")
        rows.append(Row("info", "Status", {"off": "Off", "connecting": "Connecting…",
                                           "connected": f"Connected, {games}"}.get(state, message)))
        return rows

    def storage_info(self):
        info = {}
        if system.mounted(system.USB_MOUNT):
            info["usb"] = system.space(system.USB_MOUNT)
            info["usb_label"] = system.usb_label()
        folder = os.path.dirname(self.home.args.ps4_games)
        if os.path.isdir(folder):
            info["ps4"] = system.space(folder)
        return info

