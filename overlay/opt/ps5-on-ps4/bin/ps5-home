            now = time.strftime("%d %b %Y  %H:%M" if h.settings["clock_24h"] else "%d %b %Y  %I:%M %p")
            rows.append(Row("button", "Date and time", now, ok=lambda: h.push(DateTimeEditor(h))))
            rows.append(Row("info", "Set by hand. It is kept until you turn Set automatically on again."))
        rows += [
