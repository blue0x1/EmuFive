    def reset_all(self):
        h = self.home
        system.reset_settings()
        h.request_reload(self.category)

    def rows_advanced(self):
        h = self.home
        ssh = h.poll.get("ssh", system.ssh_enabled, 3.0)
        default = h.poll.get("default_password", system.password_is_default, 30.0)
        addresses = h.poll.get("ip", system.ip_addresses, 3.0, [])
        rows = [Row("button", "Change the ps5 password", ok=self.change_password),
                Row("toggle", "SSH login", bool(ssh), ok=self.toggle_ssh)]
        if ssh and addresses:
            rows.append(Row("info", "Connect with", f"ssh ps5@{addresses[0][1]}"))
        if default:
            rows.append(Row("info", "The password is still the default one (ps5). Change it before using SSH.",
                            color=BAD))
        rows.append(Row("info", "The ps5 password is for SSH and sudo. Your profile name is separate."))
        return rows

    def change_password(self, then=None):
        h = self.home
        answers = {}

        def current(text):
            if not text:
                return "Type the current password."
            answers["current"] = text
            h.push(KeyboardDialog(h, "New password", secret=True, on_done=new))
            return None

        def new(text):
            if len(text) < 6:
                return "Use at least 6 characters."
            if text == "ps5":
                return "Choose another password than the default one."
            answers["new"] = text
            h.push(KeyboardDialog(h, "New password again", secret=True, on_done=again))
            return None

        def again(text):
            if text != answers.get("new"):
                return "The two new passwords are not the same."

            def after(ok, message):
                h.poll.forget("default_password")
                h.push(Dialog(h, message))
                if ok and then:
                    then()

            h.push(Busy(h, "Changing the password…",
                        lambda: system.change_password(answers["current"], answers["new"]), after=after))
            return None

        h.push(KeyboardDialog(h, "Current password", secret=True, on_done=current))

    def toggle_ssh(self):
        h = self.home
        on = not h.poll.get("ssh", system.ssh_enabled, 3.0)

        def apply():
            h.push(Busy(h, "Turning SSH on…" if on else "Turning SSH off…", lambda: system.set_ssh(on),
                        after=lambda ok, msg: (h.poll.forget("ssh"),
                                               None if ok else h.push(Dialog(h, msg or "Could not change SSH.")))))

        if on and system.password_is_default():
            h.push(Dialog(h, "The ps5 password is still the default one, which anyone can look up. Set your "
                             "own password first, then SSH turns on.",
                          [("Change it", lambda: self.change_password(then=apply)), ("Cancel", None)]))
        else:
            apply()

    def rows_about(self):
        h = self.home
        return [Row("action", "Open About", ok=lambda: h.push(AboutPage(h))),
                Row("info", "PS5 on PS4, by Chokri Hammedi (blue0x1). github.com/blue0x1"),
                Row("info", "The credits of everything it is built with.")]

    # Input and drawing ------------------------------------------------------------------------

    def act(self, action):
        h = self.home
        if self.focus == "categories":
            if action in (UP, DOWN):
                new = max(0, min(len(self.CATEGORIES) - 1, self.category + (1 if action == DOWN else -1)))
                if new != self.category:
                    self.category = new
                    self.row = 0
                    self.top = 0
                    h.sounds.play("move")
            elif action in (RIGHT, OK):
                rows = self.rows()
                if any(r.selectable for r in rows):
                    self.focus = "rows"
                    self.row = first_selectable(rows)
                    h.sounds.play("move")
            elif action in (BACK, GUIDE):
                h.sounds.play("back")
                self.close()
            return
        row = self.current(self.rows())
        if action == BACK or (action == LEFT and (row is None or row.left is None)):
            self.focus = "categories"
            h.sounds.play("back")
            return
        self.act_rows(action)

    def draw(self, c):
        if self.backdrop is None or self.backdrop.get_size() != c.s.get_size():
            w, ht = c.s.get_size()
            self.backdrop = pygame.Surface((w, ht))
            top, bottom = ui.mix(ui.BACKDROP, PANEL, 0.6), ui.BACKDROP
            for y in range(ht):
                pygame.draw.line(self.backdrop, ui.mix(top, bottom, y / ht), (0, y), (w, y))
            pygame.draw.rect(self.backdrop, ui.mix(ui.BACKDROP, PANEL, 0.35), pygame.Rect(0, 0, px(392), ht))
            pygame.draw.line(self.backdrop, PANEL_LINE, (px(392), 0), (px(392), ht), max(1, px(1)))
        c.s.blit(self.backdrop, (0, 0))
        a = ease_out(self.appear)
        rtl = i18n.rtl()
        if rtl:
            c.text("Settings", 30, 346, 36 - (1 - a) * 10, WHITE, True, "topright")
        else:
            c.text("Settings", 30, 64, 36 - (1 - a) * 10, WHITE, True)
        y = 88
        for i, name in enumerate(self.CATEGORIES):
            on = i == self.category
            focused = on and self.focus == "categories"
            if on:
                c.rect(WHITE if focused else ROW_ON, 48, y, 316, 38, 12)
            color = INK if focused else WHITE if on else SOFT
            if rtl:
                c.text(name, 18, 346, y + 8, color, on, "topright")
            else:
                c.text(name, 18, 66, y + 8, color, on)
            y += self.category_step
        x, width = 440, ui.W - 440 - 64
        if rtl:
            c.text(self.CATEGORIES[self.category], 26, x + width, 44, WHITE, True, "topright")
        else:
            c.text(self.CATEGORIES[self.category], 26, x, 44, WHITE, True)
        rows = self.rows()
        if self.focus == "rows":
            self.current(rows)
            if self.row < self.top:
                self.top = self.row
            while self.top < self.row and self.row_bottom(rows, self.top, self.row) > ui.H - 80:
                self.top += 1
        else:
            self.top = 0
        draw_rows(c, rows, self.row, x, 100, width, ui.H - 70, self.focus == "rows", self.top)
        if self.top > 0:
            c.text("▲", 14, x if rtl else x + width, 82, DIM, False, "topleft" if rtl else "topright")

    @staticmethod
    def row_bottom(rows, top, index):
        y = 100
        for i in range(top, index + 1):
            y += rows[i].height() + 4
        return y

    def hints(self):
        if self.focus == "categories":
            return [("cross", "Open"), ("circle", "Back")]
        row = self.current(self.rows())
        hints = [("cross", "Select")]
        if row is not None and (row.left or row.right):
            hints.append((None, "Left / Right: change"))
        return hints + [("circle", "Back")]


def pad_status(pad):
    battery = "" if pad["battery"] is None else f"  ·  {pad['battery']}%" + (" charging" if pad["charging"] else "")
    return pad["connection"] + battery


def change_volume(h, step):
    volume = h.poll.get("volume", system.sound_volume, 2.0) or 0
    new = max(0, min(100, volume + step))
    system.set_sound_volume(new)
    h.poll.put("volume", new)
    h.sounds.play("move")


# --------------------------------------------------------------------------------------------
# Avatar picker: built-in avatars (drawn here, work offline), cartoon avatars from DiceBear and
# photos from Lorem Picsum (both free, no key, only with internet).

class AvatarPicker(Modal):
    TABS = ["Built-in", "Cartoon", "Photos"]
    COLS = 6

    def __init__(self, home):
        super().__init__(home)
        self.tab = 0
        self.focus = "grid"
        self.index = 0
        self.images = {}          # (tab, n) -> Surface
        self.raw = {}             # (tab, n) -> Surface, "loading" or "error"
        self.seeds = {1: self.new_seeds(1), 2: self.new_seeds(2)}
        self.lock = threading.Lock()
        self.size = px(108)

    @staticmethod
    def new_seeds(tab):
        return [f"{random.choice(DICEBEAR_STYLES)}:{random.randrange(10 ** 9)}" if tab == 1
                else str(random.randrange(10 ** 9)) for _ in range(12)]

    def url(self, tab, n):
        seed = self.seeds[tab][n]
        if tab == 1:
            style, value = seed.split(":")
            return (f"https://api.dicebear.com/9.x/{style}/png?seed={value}&size=256"
                    "&backgroundColor=b6e3f4,c0aede,d1d4f9,ffd5dc,ffdfbf&backgroundType=gradientLinear")
        return f"https://picsum.photos/seed/{seed}/256/256"

    def cache_path(self, tab, n):
        return os.path.join(AVATAR_CACHE, hashlib.sha1(self.url(tab, n).encode()).hexdigest() + ".png")

    def load(self, tab, n):
        key = (tab, n)
        with self.lock:
            if key in self.raw:
                return
            self.raw[key] = "loading"
        url, path = self.url(tab, n), self.cache_path(tab, n)

        def work():
            try:
                if not os.path.exists(path):
                    os.makedirs(AVATAR_CACHE, exist_ok=True)
                    request = urllib.request.Request(url, headers={"User-Agent": "ps5-on-ps4"})
                    with urllib.request.urlopen(request, timeout=12) as reply:
                        data = reply.read(3_000_000)
                    with open(path + ".part", "wb") as f:
                        f.write(data)
                    os.replace(path + ".part", path)
                surface = pygame.image.load(path)
                with self.lock:
                    self.raw[key] = surface
            except Exception:
                with self.lock:
                    self.raw[key] = "error"

        threading.Thread(target=work, daemon=True).start()

    def image(self, tab, n):
        key = (tab, n)
        if key in self.images:
            return self.images[key]
        if tab == 0:
            self.images[key] = ui.builtin_avatar(n, self.size)
            return self.images[key]
        self.load(tab, n)
        with self.lock:
            raw = self.raw.get(key)
        if isinstance(raw, pygame.Surface):
            self.images[key] = ui.circle_image(raw, self.size)
            return self.images[key]
        return raw

    def act(self, action):
        h = self.home
        if action == BACK:
            h.sounds.play("back")
            self.close()
        elif action in (PAGE_UP, PAGE_DOWN) or (self.focus == "tabs" and action in (LEFT, RIGHT)):
            self.tab = (self.tab + (-1 if action in (PAGE_UP, LEFT) else 1)) % len(self.TABS)
            h.sounds.play("move")
        elif self.focus == "tabs":
            if action in (DOWN, OK):
                self.focus = "grid"
                h.sounds.play("move")
        elif action == UP:
            if self.index >= self.COLS:
                self.index -= self.COLS
            else:
                self.focus = "tabs"
            h.sounds.play("move")
        elif action == DOWN and self.index < self.COLS:
            self.index += self.COLS
            h.sounds.play("move")
        elif action in (LEFT, RIGHT):
            self.index = (self.index + (1 if action == RIGHT else -1)) % 12
            h.sounds.play("move")
        elif action == TRIANGLE and self.tab > 0:
            self.seeds[self.tab] = self.new_seeds(self.tab)
            for n in range(12):
                self.images.pop((self.tab, n), None)
                with self.lock:
                    self.raw.pop((self.tab, n), None)
            h.sounds.play("select")
        elif action == OK:
            self.choose()

    def choose(self):
        h = self.home
        if self.tab == 0:
            h.set_profile(avatar=f"builtin:{self.index}")
        else:
            path = self.cache_path(self.tab, self.index)
            if not isinstance(self.image(self.tab, self.index), pygame.Surface) or not os.path.exists(path):
                h.sounds.play("error")
                return
            try:
                with open(path, "rb") as f:
                    data = f.read()
                os.makedirs(store.CONFIG_DIR, mode=0o700, exist_ok=True)
                target = store.avatar_file(h.profiles.current_id)
                with open(target + ".new", "wb") as f:
                    f.write(data)
                os.replace(target + ".new", target)
            except OSError:
                h.sounds.play("error")
                return
            h.set_profile(avatar="file")
        h.avatar_cache.clear()
        h.sounds.play("select")
        h.toast("Avatar changed")
        self.close()

    def draw(self, c):
        h = self.home
        a = ease_out(self.appear)
        c.dim(180 * a)
        w, ht = 940, 560
        x, y = ui.W / 2 - w / 2, ui.H / 2 - ht / 2 + (1 - a) * 20
        c.rect(DIALOG, x, y, w, ht, 20)
        c.text("Choose an avatar", 24, x + 40, y + 30, WHITE, True)
        tx = x + 40
        for i, name in enumerate(self.TABS):
            on = i == self.tab
            tw = c.t.width(name, 17, True) + 40
            c.rect((WHITE if self.focus == "tabs" else KEY_ON) if on else KEY, tx, y + 78, tw, 38, 19)
            c.text(name, 17, tx + tw / 2, y + 97, INK if on and self.focus == "tabs" else WHITE, True, "center")
            tx += tw + 12
        if self.tab > 0 and not h.network.online():
            c.text("Connect to the internet to see these avatars.", 19, x + w / 2, y + ht / 2, SOFT, False,
                   "center")
            return
        cell = 140
        gx = x + (w - self.COLS * cell) / 2
        gy = y + 140
        for n in range(12):
            col, row = n % self.COLS, n // self.COLS
            cx, cy = gx + col * cell + cell / 2, gy + row * (cell + 20) + cell / 2
            image = self.image(self.tab, n)
            if isinstance(image, pygame.Surface):
                c.blit(image, cx, cy, "center")
            elif image == "error":
                c.circle(KEY, cx, cy, 54)
                c.text("!", 26, cx, cy, BAD, True, "center")
            else:
                c.circle(KEY, cx, cy, 54)
                ang = h.t * 4 + n
                c.circle(SOFT, cx + math.cos(ang) * 18, cy + math.sin(ang) * 18, 4)
            if self.focus == "grid" and n == self.index:
                c.circle(WHITE, cx, cy, 60, 2 + 1.5 * (1 + math.sin(h.t * 4)))
        source = {1: "Cartoon avatars by DiceBear (dicebear.com)", 2: "Photos from Lorem Picsum (picsum.photos)"}
        if self.tab in source:
            c.text(source[self.tab], 14, x + 40, y + ht - 40, DIM)

    def hints(self):
        hints = [("cross", "Choose"), ("l1r1", "Tabs")]
        if self.tab > 0:
            hints.append(("triangle", "More"))
        return hints + [("circle", "Back")]


