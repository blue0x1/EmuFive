    def step_language(self, step):
        h = self.home
        h.settings.set(console_language=(h.settings["console_language"] + step) % len(store.LANGUAGES))
        h.sounds.play("move")

    def rows_play_time(self):
        h = self.home
        rows = []
        played = []
        for g in h.all_games:
            entry = h.games_store.get(g.key)
            if entry.get("play_seconds"):
                played.append((entry["play_seconds"], g, entry))
        for seconds, g, entry in sorted(played, key=lambda x: -x[0]):
            when = time.strftime("%d %b %Y", time.localtime(entry["last_played"])) if entry.get("last_played") else ""
            rows.append(Row("info", g.title, system.play_time_text(seconds) + (f"  ·  last {when}" if when else "")))
        if not rows:
            rows.append(Row("info", "No play time yet: it is counted from now on."))
        return rows

    def pick_trophies(self):
        h = self.home
        games = [g for g in h.all_games if os.path.isdir(os.path.join(g.path, "sce_sys", "trophy2"))]
        if not games:
            h.push(Dialog(h, "None of your games has trophies."))
            return
        h.push(Picker(h, "Trophies", [(g.title, g) for g in games], None,
                      lambda g: g is not None and h.push(TrophyList(h, g))))

    def toggle_sort(self):
        h = self.home
        h.settings.set(sort="name" if h.settings["sort"] == "recent" else "recent")
        h.sounds.play("move")

    def rows_saves(self):
