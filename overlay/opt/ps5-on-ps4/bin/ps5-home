            self.home.sounds.play("back")
            self.close()

    def draw(self, c):
        self.art.draw(c, self.home.t, self.home.network.online())

    def hints(self):
        return [("circle", "Back")]


# --------------------------------------------------------------------------------------------
# The game log, on screen.

class LogViewer(Modal):
    covers = True
    LINES = 24

    def __init__(self, home):
        super().__init__(home)
        self.lines = system.read_log(600) or ["The game log is empty: no game has run yet."]
        self.wrapped = None
        self.top = 0

    def act(self, action):
        h = self.home
        step = {UP: -1, DOWN: 1, PAGE_UP: -20, PAGE_DOWN: 20}.get(action)
        if step and self.wrapped:
            self.top = max(0, min(max(0, len(self.wrapped) - self.LINES), self.top + step))
        elif action == SQUARE:
            h.push(Busy(h, "Copying logs to the USB drive…", system.copy_logs_to_usb))
        elif action == BACK:
            h.sounds.play("back")
            self.close()

    def draw(self, c):
        c.s.fill((10, 9, 24))
        c.text("Game log", 26, 64, 36, WHITE, True)
        c.text("~/kytyps5.log", 15, 64, 74, DIM)
        if self.wrapped is None:
            self.wrapped = []
            for line in self.lines:
                self.wrapped += c.t.wrap(line, 14, ui.W - 140) or [""]
            self.top = max(0, len(self.wrapped) - self.LINES)
        y = 110
        for line in self.wrapped[self.top:self.top + self.LINES]:
            c.text(line, 14, 64, y, SOFT)
            y += 22

    def hints(self):
        return [("l1r1", "Page"), ("square", "Copy logs to USB"), ("circle", "Back")]


# --------------------------------------------------------------------------------------------
# A game's menu (OPTIONS on a tile): favorite, hide, its KytyPS5 options.

class GameMenu(RowList):
    WIDTH = 560

    def __init__(self, home, game):
        super().__init__(home)
        self.game = game

    def rows(self):
        h, g = self.home, self.game
        entry = h.games_store.get(g.key)
        running = h.is_running(g)
        rows = [Row("action", "Resume" if running else "Play", ok=lambda: (self.close(), h.open_game(g)))]
        if running:
            rows.append(Row("action", "Close the game", ok=lambda: h.push(Dialog(
                h, f"Close {g.title}? What the game has not saved is lost.",
                [("Close", lambda: h.finish("CLOSE")), ("Cancel", None)]))))
        if os.path.isdir(os.path.join(g.path, "sce_sys", "trophy2")):
            rows.append(Row("action", "Trophies", ok=lambda: h.push(TrophyList(h, g))))
        rows.append(Row("info", "Play time", system.play_time_text(entry.get("play_seconds", 0))))
        rows += [Row("toggle", "Favorite", entry.get("favorite", False), ok=lambda: self.flip("favorite")),
                Row("toggle", "Hide from the home screen", entry.get("hidden", False),
                    ok=lambda: self.flip("hidden")),
                Row("header", "Game settings")]
        for key, label, _ in store.GAME_OPTIONS:
            rows.append(Row("toggle", label, entry.get(key, False), ok=lambda k=key: self.flip(k)))
        rows.append(Row("info", "Game settings are used the next time the game starts."))
        return rows

    def flip(self, key):
        h, g = self.home, self.game
        entry = h.games_store.get(g.key)
        h.games_store.update(g.key, **{key: not entry.get(key, False)})
        h.games_changed = True

    def act(self, action):
        if action in (BACK, OPTIONS):
            self.home.sounds.play("back")
            self.close()
        else:
            self.act_rows(action)

    def draw(self, c):
        slide = ease_out(self.appear)
        left = ui.W - self.WIDTH * slide
        c.dim(150 * slide)
        c.rect(PANEL, left, 0, self.WIDTH, ui.H)
        c.line(PANEL_LINE, left, 0, left, ui.H, 1)
        x = left + 40
        y = 40
        rtl = i18n.rtl()
        tx, anchor = (left + self.WIDTH - 40, "topright") if rtl else (x, "topleft")
        for line in c.t.wrap(self.game.title, 26, self.WIDTH - 80, True)[:2]:
            c.text(line, 26, tx, y, WHITE, True, anchor)
            y += 34
        c.text(self.game.source_name, 15, tx, y + 4, SOFT, False, anchor)
        rows = self.rows()
        self.current(rows)
        draw_rows(c, rows, self.row, x, y + 40, self.WIDTH - 80, ui.H - 60, True)

    def hints(self):
        return [("cross", "Select"), ("circle", "Back")]


# --------------------------------------------------------------------------------------------
# The quick menu (PS button): during a game (over it, paused) or on the home screen.

class QuickMenu(RowList):
    WIDTH = 470

    def __init__(self, home, in_game, title=""):
        super().__init__(home)
        self.in_game = in_game
        self.title = title

    def rows(self):
        h = self.home
        rows = []
        if self.in_game:
            rows.append(Row("action", "Resume the game", ok=lambda: h.finish("RESUME")))
            rows.append(Row("action", "Home", ok=lambda: h.finish("HOME")))
            rows.append(Row("action", "Close the game", ok=lambda: h.push(Dialog(
                h, f"Close {self.title or 'the game'}? What the game has not saved is lost.",
                [("Close", lambda: h.finish("CLOSE")), ("Cancel", None)]))))
        else:
            rows.append(Row("action", "Settings", ok=lambda: (self.close(), h.push(SettingsScreen(h)))))
            if len(h.profiles.all()) > 1:
                rows.append(Row("action", "Switch profile", ok=lambda: (self.close(), h.push(ProfilePicker(h)))))
        volume = h.poll.get("volume", system.sound_volume, 2.0)
        rows.append(Row("slider", "Volume", volume if volume is not None else 0,
                        left=lambda: change_volume(h, -5), right=lambda: change_volume(h, 5)))
        rows.append(Row("header", "Controllers"))
        pads = h.poll.get("controllers", system.controllers, 1.0, [])
        if not pads:
            rows.append(Row("info", "No controller found."))
        for pad in pads:
            rows.append(Row("info", pad["name"], pad_status(pad)))
        rows.append(Row("header", "Power"))
        closing = " The game is closed first." if self.in_game else ""
        rows.append(Row("button", "Restart the PS4", ok=lambda: h.push(Dialog(
            h, "Restart the PS4?" + closing, [("Restart", lambda: h.finish("REBOOT")), ("Cancel", None)]))))
        rows.append(Row("button", "Turn off the PS4", ok=lambda: h.push(Dialog(
            h, "Turn off the PS4?" + closing, [("Turn off", lambda: h.finish("POWEROFF")), ("Cancel", None)]))))
        return rows

    def act(self, action):
        h = self.home
        if action in (BACK, GUIDE):
            h.sounds.play("back")
            if self.in_game:
                h.finish("RESUME")
            else:
                self.close()
        else:
            self.act_rows(action)

    def draw(self, c):
        h = self.home
        slide = ease_out(self.appear)
        left = -self.WIDTH * (1 - slide)
        c.dim(140 * slide)
        c.rect(PANEL, left, 0, self.WIDTH, ui.H)
        c.line(PANEL_LINE, left + self.WIDTH, 0, left + self.WIDTH, ui.H, 1)
        x = left + 40
        right = left + self.WIDTH - 40
        rtl = i18n.rtl()
        if rtl:
            c.text("Quick menu", 28, right, 40, WHITE, True, "topright")
            c.text(clock_text(h.settings["clock_24h"]), 18, x, 46, WHITE, True)
        else:
            c.text("Quick menu", 28, x, 40, WHITE, True)
            c.text(clock_text(h.settings["clock_24h"]), 18, right, 46, WHITE, True, "topright")
        top = 100
        if self.in_game and self.title:
            title = c.t.fit(self.title, 16, self.WIDTH - 140)
            if rtl:
                c.text(title, 16, right, 84, SOFT, False, "topright")
                c.text("PAUSED", 13, x, 86, (255, 205, 90), True)
            else:
                c.text(title, 16, x, 84, SOFT)
                c.text("PAUSED", 13, right, 86, (255, 205, 90), True, "topright")
            top = 124
        rows = self.rows()
        self.current(rows)
        draw_rows(c, rows, self.row, x, top, self.WIDTH - 80, ui.H - 60, True)

    def hints(self):
        return [("cross", "Select"), ("ps", "Resume" if self.in_game else "Close"), ("circle", "Back")]


# --------------------------------------------------------------------------------------------
# Date and time by hand: Left / Right choose a part, Up / Down change it, X saves.

class DateTimeEditor(Modal):
    FIELDS = ("day", "month", "year", "hour", "minute")

    def __init__(self, home):
        super().__init__(home)
        import datetime
        now = datetime.datetime.now()
        self.values = {"day": now.day, "month": now.month, "year": now.year, "hour": now.hour,
                       "minute": now.minute}
        self.field = 0

    def days(self):
        import calendar
        return calendar.monthrange(self.values["year"], self.values["month"])[1]

    def change(self, step):
        v = self.values
        name = self.FIELDS[self.field]
        low, high = {"day": (1, self.days()), "month": (1, 12), "year": (2024, 2099), "hour": (0, 23),
                     "minute": (0, 59)}[name]
        v[name] = low + (v[name] - low + step) % (high - low + 1)
        v["day"] = min(v["day"], self.days())

    def act(self, action):
        h = self.home
        if action in (LEFT, RIGHT):
            self.field = (self.field + (1 if action == RIGHT else -1)) % len(self.FIELDS)
            h.sounds.play("move")
        elif action in (UP, DOWN):
            self.change(1 if action == UP else -1)
            h.sounds.play("move")
        elif action == OK:
            import datetime
            when = datetime.datetime(*(self.values[k] for k in ("year", "month", "day", "hour", "minute")))
            h.sounds.play("select")
            self.close()
            h.push(Busy(h, "Setting the date and time…", lambda: system.set_time(when),
                        after=lambda ok, msg: (h.poll.forget("ntp"),
                                               h.toast("Date and time saved") if ok else
                                               h.push(Dialog(h, msg or "Could not set it.")))))
        elif action == BACK:
            h.sounds.play("back")
            self.close()

    def draw(self, c):
        a = ease_out(self.appear)
        c.dim(170 * a)
        w, ht = 760, 330
        x, y = ui.W / 2 - w / 2, ui.H / 2 - ht / 2 + (1 - a) * 20
        c.rect(DIALOG, x, y, w, ht, 20)
        c.text("Date and time", 26, ui.W / 2, y + 30, WHITE, True, "midtop")
        labels = {"day": "Day", "month": "Month", "year": "Year", "hour": "Hour", "minute": "Minute"}
        widths = {"day": 96, "month": 96, "year": 140, "hour": 96, "minute": 96}
        gap = 22
        total = sum(widths.values()) + gap * (len(self.FIELDS) - 1) + 40
        bx = ui.W / 2 - total / 2
        for i, name in enumerate(self.FIELDS):
            if name == "hour":
                bx += 40          # Space between the date and the time.
            on = i == self.field
            bw = widths[name]
            c.text(labels[name], 15, bx + bw / 2, y + 88, SOFT, False, "midtop")
            c.rect(WHITE if on else KEY, bx, y + 130, bw, 90, 16)
            value = f"{self.values[name]:04d}" if name == "year" else f"{self.values[name]:02d}"
            c.text(value, 40, bx + bw / 2, y + 175, INK if on else WHITE, True, "center")
            if on:
                mx = bx + bw / 2           # Up and down arrows, drawn (the fonts have no arrows).
                c.polygon(WHITE, [(mx, y + 112), (mx - 9, y + 123), (mx + 9, y + 123)])
                c.polygon(WHITE, [(mx, y + 238), (mx - 9, y + 227), (mx + 9, y + 227)])
            bx += bw + gap

    def hints(self):
        return [("cross", "Save"), (None, "Up / Down: change"), (None, "Left / Right: next"), ("circle", "Cancel")]


# --------------------------------------------------------------------------------------------
# Profiles: "Who's playing?" (at the start with more than one profile, and Switch profile).

def add_profile(h):
    def done(text):
        text = text.strip()
        if not text:
            return "Type a name."
        count = len(h.profiles.all())
        new_id = h.profiles.add(text, f"builtin:{count % ui.BUILTIN_AVATARS}")
        if new_id is None:
            return "Up to 8 profiles."
        h.switch_profile(new_id)
        return None

    h.push(KeyboardDialog(h, "Name of the new profile", "", on_done=done, max_length=16))


class ProfilePicker(Modal):
    covers = True
    SIZE, GAP = 150, 54

    def __init__(self, home):
        super().__init__(home)
        self.items = home.profiles.all()
        ids = [p["id"] for p in self.items]
        self.index = ids.index(home.profiles.current_id) if home.profiles.current_id in ids else 0

    def count(self):
        return len(self.items) + (1 if len(self.items) < store.MAX_PROFILES else 0)

    def act(self, action):
        h = self.home
        if action in (LEFT, RIGHT):
            step = -1 if action == LEFT else 1
            if i18n.rtl():
                step = -step
            new = max(0, min(self.count() - 1, self.index + step))
            if new != self.index:
                self.index = new
                h.sounds.play("move")
        elif action == OK:
            h.sounds.play("select")
            self.close()
            if self.index < len(self.items):
                if self.items[self.index]["id"] != h.profiles.current_id:
                    h.switch_profile(self.items[self.index]["id"])
            else:
                add_profile(h)
        elif action in (BACK, GUIDE):
            h.sounds.play("back")
            self.close()

    def draw(self, c):
        h = self.home
        c.s.fill(ui.BACKDROP)
        a = ease_out(self.appear)
        c.text("Who's playing?", 34, ui.W / 2, 150 - (1 - a) * 12, WHITE, True, "midtop")
        n = self.count()
        total = n * self.SIZE + (n - 1) * self.GAP
        order = list(range(n))
        if i18n.rtl():
            order.reverse()
        for slot, i in enumerate(order):
            x = ui.W / 2 - total / 2 + slot * (self.SIZE + self.GAP)
            y = 270
            on = i == self.index
            if on:
                c.circle(WHITE, x + self.SIZE / 2, y + self.SIZE / 2, self.SIZE / 2 + 8, 4)
            if i < len(self.items):
                profile = self.items[i]
                c.blit(h.avatar(self.SIZE, profile), x, y)
                name = c.t.fit(profile["name"], 20, self.SIZE + self.GAP - 10, on)
            else:
                c.circle(KEY, x + self.SIZE / 2, y + self.SIZE / 2, self.SIZE / 2)
                c.line(WHITE, x + self.SIZE / 2 - 24, y + self.SIZE / 2, x + self.SIZE / 2 + 24, y + self.SIZE / 2, 4)
                c.line(WHITE, x + self.SIZE / 2, y + self.SIZE / 2 - 24, x + self.SIZE / 2, y + self.SIZE / 2 + 24, 4)
                name = c.t.fit("Add a profile", 20, self.SIZE + self.GAP - 10, on)
            c.text(name, 20, x + self.SIZE / 2, y + self.SIZE + 26, WHITE if on else SOFT, on, "midtop")

    def hints(self):
        return [("cross", "Choose"), ("circle", "Back")]


# --------------------------------------------------------------------------------------------
# Trophies of one game (full screen).

GRADE_COLORS = {"platinum": ((230, 236, 255), (150, 160, 200)), "gold": ((255, 215, 90), (200, 140, 30)),
                "silver": ((225, 228, 235), (140, 145, 160)), "bronze": ((235, 160, 100), (150, 85, 40))}


def draw_cup(c, x, y, size, grade, earned=True):
    light, dark = GRADE_COLORS.get(grade, GRADE_COLORS["bronze"])
    if not earned:
        light, dark = ui.mix(light, (90, 90, 100), 0.7), ui.mix(dark, (60, 60, 70), 0.7)
    s = size
    c.polygon(dark, [(x - s * 0.42, y - s * 0.45), (x + s * 0.42, y - s * 0.45), (x + s * 0.3, y + s * 0.05),
                     (x - s * 0.3, y + s * 0.05)])
    c.polygon(light, [(x - s * 0.36, y - s * 0.45), (x + s * 0.2, y - s * 0.45), (x + s * 0.12, y),
                      (x - s * 0.26, y)])
    c.rect(dark, x - s * 0.06, y + s * 0.05, s * 0.12, s * 0.2)
    c.rect(light, x - s * 0.28, y + s * 0.25, s * 0.56, s * 0.12, 2)


class TrophyList(Modal):
    covers = True
    VISIBLE = 6

    def __init__(self, home, game):
        super().__init__(home)
        self.game = game
        self.title = game.title
        self.trophies = None
        self.icons = {}
        self.top = 0
        self.row = 0

        def load():
            title, items = system.trophies(game.path, game.title_id, home.settings["console_language"],
                                           home.profiles.current_id)
            for t in items:
                if t["icon"]:
                    try:
                        import io
                        picture = pygame.image.load(io.BytesIO(t["icon"]))
                        self.icons[t["id"]] = pygame.transform.smoothscale(picture, (px(60), px(60)))
                    except pygame.error:
                        pass
            self.title = title or game.title
            self.trophies = items

        threading.Thread(target=load, daemon=True).start()

    def act(self, action):
        h = self.home
        items = self.trophies or []
        step = {UP: -1, DOWN: 1, PAGE_UP: -6, PAGE_DOWN: 6}.get(action)
        if step and items:
            self.row = max(0, min(len(items) - 1, self.row + step))
            h.sounds.play("move")
        elif action in (BACK, OK):
            h.sounds.play("back")
            self.close()

    def draw(self, c):
        c.s.fill(ui.BACKDROP)
        c.text(c.t.fit(self.title, 28, ui.W - 500, True), 28, 64, 36, WHITE, True)
        if self.trophies is None:
            c.text("Reading the trophies…", 18, 64, 110, SOFT)
            return
        items = self.trophies
        earned = [t for t in items if t["earned"]]
        percent = int(round(100 * len(earned) / max(1, len(items))))
        c.text(f"{len(earned)} of {len(items)} trophies  ·  {percent}%", 16, 64, 82, SOFT)
        c.rect(KEY, 64, 112, 520, 8, 4)
        c.rect(ACCENT, 64, 112, max(1, 520 * percent / 100), 8, 4)
        x = ui.W - 64
        for grade in ("bronze", "silver", "gold", "platinum"):
            total = sum(1 for t in items if t["grade"] == grade)
            if not total:
                continue
            got = sum(1 for t in items if t["grade"] == grade and t["earned"])
            w = c.text(f"{got}/{total}", 16, x, 70, WHITE, True, "topright")
            draw_cup(c, x - w - 18, 80, 26, grade, got > 0)
            x -= w + 64
        if self.row < self.top:
            self.top = self.row
        if self.row >= self.top + self.VISIBLE:
            self.top = self.row - self.VISIBLE + 1
        y = 140
        for i in range(self.top, min(len(items), self.top + self.VISIBLE)):
            t = items[i]
            on = i == self.row
            c.rect(WHITE if on else PANEL, 64, y, ui.W - 128, 74, 14)
            fg, soft = (INK, ui.mix(INK, WHITE, 0.35)) if on else (WHITE, SOFT)
            secret = t["hidden"] and not t["earned"]
            icon = self.icons.get(t["id"])
            if icon is not None and not secret:
                if not t["earned"]:
                    icon = icon.copy()
                    icon.fill((90, 90, 90), special_flags=pygame.BLEND_RGB_MULT)
                c.blit(icon, 76, y + 7)
            else:
                c.rect(KEY, 76, y + 7, 60, 60, 8)
                c.text("?", 26, 106, y + 37, SOFT, True, "center")
            name = "Hidden trophy" if secret else t["name"]
            detail = "Keep playing to find out." if secret else t["detail"]
            c.text(c.t.fit(name, 19, ui.W - 480, True), 19, 154, y + 12, fg, True)
            c.text(c.t.fit(detail, 15, ui.W - 480), 15, 154, y + 42, soft)
            draw_cup(c, ui.W - 110, y + 36, 32, t["grade"], t["earned"])
            when = t["when"].strftime("%d %b %Y") if t["earned"] and t["when"] else ("Earned" if t["earned"] else "")
            c.text(when, 14, ui.W - 140, y + 29, soft, False, "topright")
            y += 80

    def hints(self):
        return [("l1r1", "Page"), ("circle", "Back")]


# --------------------------------------------------------------------------------------------
# Controller test: every button and stick, live.

class ControllerTest(Modal):
    covers = True

    def __init__(self, home):
        super().__init__(home)
        self.back_at = 0.0

    def act(self, action):
        h = self.home
        if action == GUIDE:
            self.close()
        elif action == BACK:
            if h.t - self.back_at < 1.0:
                h.sounds.play("back")
                self.close()
            self.back_at = h.t

    def draw(self, c):
        h = self.home
        c.s.fill(ui.BACKDROP)
        c.text("Controller test", 28, 64, 36, WHITE, True)
        pads = list(h.input.pads.values())
        if not pads:
            c.text("No controller found.", 19, 64, 100, SOFT)
            return
        pad = pads[0]
        B = pygame

        # Reads that cannot fail: a button or stick the controller (or pygame) does not know reads
        # as not pressed.
        def button(b):
            try:
                return bool(pad.get_button(b))
            except (pygame.error, AttributeError, TypeError, ValueError):
                return False

        def axis(a):
            try:
                return pad.get_axis(a) / 32767
            except (pygame.error, AttributeError, TypeError, ValueError):
                return 0.0

        c.text("Press every button and move the sticks. Press O twice (or PS) to go back.", 16, 64, 82, SOFT)
        cx, cy = ui.W / 2, 400
        body = ui.mix(PANEL, WHITE, 0.08)
        c.rect(body, cx - 330, cy - 150, 660, 250, 110)
        c.circle(body, cx - 240, cy + 90, 110)
        c.circle(body, cx + 240, cy + 90, 110)
        lit, idle = ACCENT, KEY

        def dot(x, y, r, on, label=""):
            c.circle(lit if on else idle, x, y, r)
            if label:
                c.text(label, 13, x, y, WHITE if on else SOFT, True, "center")

        for shape, b, x, y in (("triangle", B.CONTROLLER_BUTTON_Y, 220, -70),
                               ("circle", B.CONTROLLER_BUTTON_B, 270, -20),
                               ("cross", B.CONTROLLER_BUTTON_A, 220, 30), ("square", B.CONTROLLER_BUTTON_X, 170, -20)):
            on = button(b)
            dot(cx + x, cy + y, 22, on)
            # The symbols are drawn: the fonts have no PlayStation shapes.
            mark, bx, by = WHITE if on else SOFT, cx + x, cy + y
            if shape == "triangle":
                c.polygon(mark, [(bx, by - 10), (bx + 10, by + 7), (bx - 10, by + 7)], 2)
            elif shape == "circle":
                c.circle(mark, bx, by, 9, 2)
            elif shape == "cross":
                c.line(mark, bx - 8, by - 8, bx + 8, by + 8, 2)
                c.line(mark, bx - 8, by + 8, bx + 8, by - 8, 2)
            else:
                c.rect(mark, bx - 8, by - 8, 16, 16, 0, 2)
        for b, x, y in ((B.CONTROLLER_BUTTON_DPAD_UP, -220, -70), (B.CONTROLLER_BUTTON_DPAD_DOWN, -220, 30),
                        (B.CONTROLLER_BUTTON_DPAD_LEFT, -270, -20), (B.CONTROLLER_BUTTON_DPAD_RIGHT, -170, -20)):
            c.rect(lit if button(b) else idle, cx + x - 18, cy + y - 18, 36, 36, 6)
        for side, ax, ay, b in ((-1, B.CONTROLLER_AXIS_LEFTX, B.CONTROLLER_AXIS_LEFTY, B.CONTROLLER_BUTTON_LEFTSTICK),
                                (1, B.CONTROLLER_AXIS_RIGHTX, B.CONTROLLER_AXIS_RIGHTY, B.CONTROLLER_BUTTON_RIGHTSTICK)):
            sx, sy = cx + side * 95, cy + 60
            c.circle(idle, sx, sy, 46)
            c.circle(PANEL_LINE, sx, sy, 46, 2)
            c.circle(lit if button(b) else WHITE, sx + axis(ax) * 30, sy + axis(ay) * 30, 18)
            c.text(f"{axis(ax):+.2f}  {axis(ay):+.2f}", 13, sx, sy + 58, SOFT, False, "midtop")
        for side, b, t, label in ((-1, B.CONTROLLER_BUTTON_LEFTSHOULDER, B.CONTROLLER_AXIS_TRIGGERLEFT, "L"),
                                  (1, B.CONTROLLER_BUTTON_RIGHTSHOULDER, B.CONTROLLER_AXIS_TRIGGERRIGHT, "R")):
            x = cx + side * 220
            c.rect(lit if button(b) else idle, x - 60, cy - 190, 120, 26, 10)
            c.text(label + "1", 13, x, cy - 177, WHITE, True, "center")
            level = max(0.0, axis(t))
            c.rect(idle, x - 60, cy - 236, 120, 34, 10)
            c.rect(lit, x - 60, cy - 236, 120 * level, 34, 10)
            c.text(f"{label}2  {int(level * 100)}%", 13, x, cy - 219, WHITE, True, "center")
        touchpad = getattr(B, "CONTROLLER_BUTTON_TOUCHPAD", 20)     # pygame 2.6 has no name for it.
        c.rect(lit if button(touchpad) else idle, cx - 90, cy - 130, 180, 90, 12)
        c.text("Touchpad", 13, cx, cy - 85, SOFT, False, "center")
        dot(cx - 140, cy - 110, 14, button(B.CONTROLLER_BUTTON_BACK), "")
        c.text("SHARE", 11, cx - 140, cy - 88, SOFT, True, "midtop")
        dot(cx + 140, cy - 110, 14, button(B.CONTROLLER_BUTTON_START), "")
        c.text("OPTIONS", 11, cx + 140, cy - 88, SOFT, True, "midtop")
        dot(cx, cy + 20, 18, button(B.CONTROLLER_BUTTON_GUIDE), "PS")

    def hints(self):
        return [("circle", "Twice: Back")]


# --------------------------------------------------------------------------------------------
# Media: the screenshots, on the home screen's Media tab, and a full-screen viewer.

class MediaView:
    COLS = 4
    THUMB_W, THUMB_H = 268, 151

    def __init__(self, home):
        self.home = home
        self.paths = []
        self.index = 0
        self.top_row = 0
        self.thumbs = {}
        self.loading = set()
        self.lock = threading.Lock()
        self.scanned = -10.0

    def refresh(self):
        h = self.home
        if h.t - self.scanned > 3.0:
            self.scanned = h.t
            self.paths = system.screenshots()
            self.index = min(self.index, max(0, len(self.paths) - 1))

    def thumb(self, path):
        with self.lock:
            if path in self.thumbs:
                return self.thumbs[path]
            if path in self.loading:
                return None
            self.loading.add(path)

        def work():
            try:
                picture = pygame.image.load(path)
                small = pygame.transform.smoothscale(picture, (px(self.THUMB_W), px(self.THUMB_H)))
            except (pygame.error, OSError):
                small = False
            with self.lock:
                self.thumbs[path] = small
                self.loading.discard(path)

        threading.Thread(target=work, daemon=True).start()
        return None

    def act(self, action):
        h = self.home
        if action == UP:
            if self.index >= self.COLS:
                self.index -= self.COLS
                h.sounds.play("move")
            else:
                h.focus = "wifi"
                h.sounds.play("move")
            return
        if not self.paths:
            return
        if action == DOWN and self.index + self.COLS < len(self.paths):
            self.index += self.COLS
        elif action == LEFT and self.index > 0:
            self.index -= 1
        elif action == RIGHT and self.index < len(self.paths) - 1:
            self.index += 1
        elif action == OK:
            h.sounds.play("select")
            h.push(MediaViewer(h, self))
            return
        else:
            return
        h.sounds.play("move")

    def draw(self, c):
        self.refresh()
        h = self.home
        y0 = ROW_Y
        if not self.paths:
            c.text("No screenshots yet", 40, ROW_X, y0 + 40, ART_TEXT, True, shadow=True)
            c.text("Press PS + Square, or Share, to take one, in a game too.", 18, ROW_X + 2, y0 + 100,
                   ART_SOFT, shadow=True)
            c.text("They are saved in PS5-screenshots on the USB drive.", 18, ROW_X + 2, y0 + 128, ART_SOFT, shadow=True)
            return
        c.text(f"Screenshots  ·  {len(self.paths)}", 18, ROW_X, y0 - 6, ART_SOFT, True, shadow=True)
        row = self.index // self.COLS
        if row < self.top_row:
            self.top_row = row
        if row > self.top_row + 2:
            self.top_row = row - 2
        gap = 22
        for n in range(self.top_row * self.COLS, min(len(self.paths), (self.top_row + 3) * self.COLS)):
            col, r = n % self.COLS, n // self.COLS - self.top_row
            x = ROW_X + col * (self.THUMB_W + gap)
            y = y0 + 26 + r * (self.THUMB_H + 46)
            thumb = self.thumb(self.paths[n])
            if thumb:
                c.blit(thumb, x, y)
            else:
                c.rect(KEY, x, y, self.THUMB_W, self.THUMB_H, 10)
            if n == self.index and h.focus == "tiles" and not h.modals:
                c.rect(ART_TEXT, x - 5, y - 5, self.THUMB_W + 10, self.THUMB_H + 10, 12, 3)
            name = os.path.basename(os.path.dirname(self.paths[n]))
            c.text(c.t.fit(name, 13, self.THUMB_W), 13, x, y + self.THUMB_H + 8, ART_SOFT, shadow=True)


class MediaViewer(Modal):
    covers = True

    def __init__(self, home, media):
        super().__init__(home)
        self.media = media
        self.picture = None
        self.loaded_for = None

    def path(self):
        paths = self.media.paths
        return paths[self.media.index] if paths and self.media.index < len(paths) else None

    def act(self, action):
        h = self.home
        m = self.media
        if action in (BACK, OK):
            h.sounds.play("back")
            self.close()
        elif action == LEFT and m.index > 0:
            m.index -= 1
            h.sounds.play("move")
        elif action == RIGHT and m.index < len(m.paths) - 1:
            m.index += 1
            h.sounds.play("move")
        elif action == SQUARE and self.path():
            path = self.path()

            def delete():
                system.delete_screenshot(path)
                m.scanned = -10.0
                m.refresh()
                if not m.paths:
                    self.close()

            h.push(Dialog(h, "Delete this screenshot? It cannot be brought back.",
                          [("Delete", delete), ("Cancel", None)]))

    def draw(self, c):
        c.s.fill((0, 0, 0))
        path = self.path()
        if path is None:
            return
        if self.loaded_for != path:
            try:
                picture = pygame.image.load(path)
                w, hgt = c.s.get_size()
                scale = min(w / picture.get_width(), hgt / picture.get_height())
                self.picture = pygame.transform.smoothscale(
                    picture, (int(picture.get_width() * scale), int(picture.get_height() * scale)))
            except (pygame.error, OSError):
                self.picture = None
            self.loaded_for = path
        if self.picture is not None:
            c.s.blit(self.picture, self.picture.get_rect(center=c.s.get_rect().center))
        name = os.path.basename(os.path.dirname(path))
        when = os.path.splitext(os.path.basename(path))[0]
        c.rect((0, 0, 0, 150), 0, 0, ui.W, 64)
        c.text(f"{name}  ·  {when}", 16, 40, 22, (255, 255, 255))
        c.text(f"{self.media.index + 1} / {len(self.media.paths)}", 16, ui.W - 40, 22, (255, 255, 255), False,
               "topright")

    def hints(self):
        return [(None, "Left / Right: next"), ("square", "Delete"), ("circle", "Back")]


# --------------------------------------------------------------------------------------------
# The app.

ORB_COUNTS = {"few": 14, "normal": 34, "many": 60}
ORB_SPEEDS = {"slow": 0.5, "normal": 1.0, "fast": 1.8}


class Home:
    def __init__(self, args):
        self.args = args
        self.settings = SETTINGS
        size = None
        if args.size:
            w, _, ht = args.size.partition("x")
            size = (int(w), int(ht))
        self.overscan = self.settings["overscan"]
        self.real_screen, self.screen = ui.init_display(size, args.windowed or size is not None, self.overscan)
        pygame.display.set_caption("PS5 on PS4")
        pygame.mouse.set_visible(False)
        pygame.key.set_repeat(320, 70)
        pygame.key.start_text_input()
        self.text = ui.Text(self.settings["font"], self.settings["text_size"] / 100)
        self.c = ui.Canvas(self.screen, self.text)
        self.make_sounds()
        self.input = ui.Input()
        self.make_input()
        self.profiles = store.Profiles(self.settings)
        current = self.profiles.current()
        if (self.settings["name"], self.settings["avatar"]) != (current["name"], current["avatar"]):
            self.settings.set(name=current["name"], avatar=current["avatar"])
        self.games_store = store.Games(current["id"])
        self.poll = Poller()
        self.quick = args.quick_menu is not None
        self.running_path = args.suspended            # The paused game (Home in the PS button menu).
        self.network = system.Network(args.dry_run_network or self.quick)
        self.pc = system.PcShare(args.pc_test) if not self.quick else None
        self.art = ArtLoader()
        self.clock = pygame.time.Clock()
        self.t = 0.0
        self.result = None
        self.fade_out = None
        self.modals = []
        self.avatar_cache = {}
        self.toast_text = None
        self.toast_until = 0.0
        self.idle_warned = False

        self.all_games = []
        self.games = []
        self.entries = {}
        self.game_signature = None
        self.games_changed = False
        self.selected = 0
        self.focus = "tiles"     # tiles, wifi, settings
        self.tab = "games"       # games, media
        self.media = MediaView(self)
        self.tile_small, self.tile_big = TILE_SIZES.get(self.settings["tile_size"], TILE_SIZES["medium"])
        self.info_y = ROW_Y + self.tile_big + 74
        self.row_offset = 0.0
        self.tile_sizes = []
        self.info_alpha = 0.0
        self.bg_current = None
        self.bg_previous = None
        self.bg_mix = 1.0
        self.bg_switch_at = 0.0
        self.bg_index = 0
        self.static_bg = None     # The background when it is not the game's art (cached).
        self.particles = []
        self.make_particles()
        self.next_scan = 0.0
        self.quick_game = None
        self.saver_on = False
        self.saver_next = 0.0
        self.saver_index = -1

        if self.quick:
            self.quick_game = prepare(system.Game(args.quick_menu))
            self.art.want(self.quick_game, True)
            self.modals.append(QuickMenu(self, True, self.quick_game.title))
            return
        self.refresh_games(force=True)
        self.apply_lightbar()
        self.apply_mic()
        if args.message:
            self.push(Dialog(self, args.message))
        # Settings that restart the home screen (theme, text...) come back to the same page.
        try:
            with open(REOPEN) as f:
                category = int(f.read().strip())
            os.remove(REOPEN)
            self.push(SettingsScreen(self, category, focus="rows"))
        except (OSError, ValueError):
            pass
        # At the start of the session, with more than one profile: "Who's playing?"
        if not self.running_path and not self.modals and len(self.profiles.all()) > 1 \
                and not os.path.exists(PROFILE_CHOSEN):
            self.push(ProfilePicker(self))
        try:
            with open(PROFILE_CHOSEN, "w"):
                pass
        except OSError:
            pass

    # Helpers -----------------------------------------------------------------------------------

    def push(self, modal):
        self.modals.append(modal)

    def toast(self, text, seconds=4.0):
        self.toast_text, self.toast_until = text, self.t + seconds

    def finish(self, result):
        if self.result is None:
            self.result = result
            self.fade_out = 1.0 if self.settings["animations"] == "off" else 0.0

    def request_reload(self, category):
        """Starts the home screen again (for settings it reads only at the start), on this page."""
        try:
            os.makedirs(os.path.dirname(REOPEN), exist_ok=True)
            with open(REOPEN, "w") as f:
                f.write(f"{category}\n")
        except OSError:
            pass
        self.finish("RELOAD")

    def make_sounds(self):
        s = self.settings
        self.sounds = ui.Sounds(s["sound_style"], s["sound_volume"], s["sounds"])

    def make_input(self):
        """The controller settings, kept on the same Input (it holds the open controllers)."""
        s = self.settings
        self.input.swap = s["swap_buttons"]
        self.input.rumble_on = s["rumble"]
        self.input.strength = store.vibration(s) / 100

    def apply_lightbar(self):
        threading.Thread(target=system.set_lightbar, args=(store.lightbar_rgb(self.settings),), daemon=True).start()

    def apply_mic(self):
        threading.Thread(target=system.set_controller_mic, args=(self.settings["controller_mic"],),
                         daemon=True).start()

    def make_particles(self):
        count = ORB_COUNTS.get(self.settings["orb_amount"], 34)
        self.particles = [ui.new_particle(True) for _ in range(count)]

    def avatar(self, size, profile=None):
        """A profile's picture (the current one's by default) as a circle `size` units wide."""
        profile = profile or {"id": self.profiles.current_id, "avatar": self.settings["avatar"]}
        choice = profile["avatar"]
        key = (profile["id"], choice, size)
        surface = self.avatar_cache.get(key)
        if surface is None:
            if choice == "file":
                try:
                    surface = ui.circle_image(pygame.image.load(store.avatar_file(profile["id"])), px(size))
                except (pygame.error, OSError):
                    surface = None
            if surface is None:
                try:
                    index = int(choice.split(":")[1]) if choice.startswith("builtin:") else 0
                except (ValueError, IndexError):
                    index = 0
                surface = ui.builtin_avatar(index, px(size))
            self.avatar_cache[key] = surface
        return surface

    def switch_profile(self, profile_id):
        self.profiles.switch(profile_id, self.settings)
        self.games_store = store.Games(profile_id)
        self.avatar_cache.clear()
        self.games_changed = True
        self.toast(f"Welcome, {self.settings['name']}", 3.0)

    def set_profile(self, **changes):
        """Name or picture of the current profile."""
        self.settings.set(**changes)
        self.profiles.update(self.profiles.current_id, **changes)
        self.avatar_cache.clear()

    def play(self, game):
        self.games_store.played(game.key)
        self.sounds.play("select")
        self.finish("PLAY " + game.path)

    def is_running(self, game):
        return self.running_path is not None and game.path == self.running_path

    def open_game(self, game):
        """Play, or back to the paused game; another game asks to close the paused one first."""
        if self.is_running(game):
            self.sounds.play("select")
            self.finish("RESUME")
        elif self.running_path is not None:
            running = next((g.title for g in self.all_games if g.path == self.running_path), "the game")
            self.sounds.play("select")
            self.push(Dialog(self, f"Close {running} and start {game.title}? What {running} has not saved "
                                   "is lost.", [("Close and start", lambda: self.play(game)), ("Cancel", None)]))
        else:
            self.play(game)

    # Games -------------------------------------------------------------------------------------

    def refresh_games(self, force=False):
        found = [(p, "USB", "USB drive") for p in system.find_games(self.args.games)]
        found += [(p, "PS4", "PS4 drive") for p in system.find_games(self.args.ps4_games)]
        with self.pc.lock:
            pc_games = list(self.pc.games)
        signature = (tuple(f[0] for f in found) + tuple(g.path for g in pc_games),
                     self.settings["sort"], self.settings["show_hidden"])
        if not force and signature == self.game_signature and not self.games_changed:
            return
        self.game_signature = signature
        self.games_changed = False
        current = self.games[self.selected].path if self.games and self.selected < len(self.games) else None
        # A stand-in for the paused game (made while its drive or share was not listed yet) gives
        # way to the real one.
        known = {g.path: g for g in self.all_games if not getattr(g, "stand_in", False)}
        all_games = [known.get(p) or system.Game(p, source, name) for p, source, name in found]
        all_games += [known.get(g.path) or g for g in pc_games]
        if self.running_path and not any(g.path == self.running_path for g in all_games):
            stand_in = next((g for g in self.all_games if g.path == self.running_path), None)
            if stand_in is None:
                stand_in = system.Game(self.running_path)
                stand_in.stand_in = True
            all_games.append(stand_in)
        for g in all_games:
            prepare(g)
            if not g.icon_loaded:
                self.art.want(g, False)
        self.all_games = all_games
        show_hidden = self.settings["show_hidden"]
        entries = {g.path: self.games_store.get(g.key) for g in all_games}
        visible = [g for g in all_games if show_hidden or not entries[g.path].get("hidden") or self.is_running(g)]
        recent = self.settings["sort"] == "recent"
        visible.sort(key=lambda g: (not self.is_running(g),
                                    not entries[g.path].get("favorite", False),
                                    -entries[g.path].get("last_played", 0) if recent else 0,
                                    g.title.lower()))
        self.games = visible
        self.entries = entries
        if current is None and self.running_path:
            current = self.running_path
        self.selected = next((i for i, g in enumerate(self.games) if g.path == current), 0)
        self.tile_sizes = [float(self.tile_small)] * (len(self.games) + 1)
        self.select(self.selected, sound=False)

    def items(self):
        return len(self.games) + 1  # The last tile is Power.

    def on_power(self):
        return self.selected >= len(self.games)

    def current_game(self):
        return None if self.on_power() or not self.games else self.games[self.selected]

    def select(self, index, sound=True):
        index = max(0, min(self.items() - 1, index))
        if sound and index != self.selected:
            self.sounds.play("move")
            self.input.rumble()
        self.selected = index
        self.info_alpha = 1.0 if self.settings["animations"] == "off" else 0.0
        self.bg_index = 0
        self.bg_switch_at = self.t + 12.0
        for i in (index, index - 1, index + 1):
            if 0 <= i < len(self.games):
                self.art.want(self.games[i], True)
        self.set_background(self.current_background(), animate=True)

    def current_background(self):
        game = self.quick_game if self.quick else self.current_game()
        if game is None or not game.backgrounds:
            return None
        return game.backgrounds[self.bg_index % len(game.backgrounds)]

    def set_background(self, surface, animate):
        if surface is self.bg_current:
            return
        animate = animate and self.settings["animations"] != "off"
        self.bg_previous = self.bg_current if animate else None
        self.bg_current = surface
        self.bg_mix = 0.0 if animate else 1.0

    # Actions -----------------------------------------------------------------------------------

    def act(self, action):
        if self.modals:
            self.modals[-1].act(action)
            return
        if action == GUIDE:
            self.sounds.play("select")
            if self.running_path is not None:
                self.finish("RESUME")           # Back to the paused game.
            else:
                self.push(QuickMenu(self, False))
            return
        if action in (PAGE_UP, PAGE_DOWN):
            tab = "games" if action == PAGE_UP else "media"
            if tab != self.tab:
                self.tab = tab
                self.focus = "tiles"
                self.sounds.play("move")
            return
        if self.focus in ("wifi", "settings"):
            if action in (DOWN, BACK):
                self.focus = "tiles"
                self.sounds.play("move")
            elif action == LEFT and self.focus == "wifi":
                self.focus = "settings"
                self.sounds.play("move")
            elif action == RIGHT and self.focus == "settings":
                self.focus = "wifi"
                self.sounds.play("move")
            elif action == OK:
                self.sounds.play("select")
                self.push(WifiPanel(self) if self.focus == "wifi" else SettingsScreen(self))
            return
        if self.tab == "media":
            self.media.act(action)
            return
        if action == LEFT:
            self.select(self.selected - 1)
        elif action == RIGHT:
            self.select(self.selected + 1)
        elif action == UP:
            self.focus = "wifi"
            self.sounds.play("move")
        elif action == OPTIONS and self.current_game() is not None:
            self.sounds.play("select")
            self.push(GameMenu(self, self.current_game()))
        elif action == OK:
            if self.on_power():
                self.sounds.play("select")
                closing = " The paused game is closed first." if self.running_path else ""
                self.push(Dialog(self, "Turn off the PS4?" + closing,
                                 [("Turn off", lambda: self.finish("POWEROFF")),
                                  ("Restart", lambda: self.finish("REBOOT"))]))
            else:
                self.open_game(self.games[self.selected])

    # Frame -------------------------------------------------------------------------------------

    def update(self, dt):
        self.t += dt
        motion = self.settings["animations"]
        if not self.quick and self.t >= self.next_scan:
            self.next_scan = self.t + 3.0
            self.refresh_games()
        if self.input.typed:
            if self.modals:
                for chunk in self.input.typed:
                    self.modals[-1].typed(chunk)
            self.input.typed.clear()
        for modal in list(self.modals):
            modal.update(dt)
            if motion == "off":
                modal.appear = 1.0
        self.modals = [m for m in self.modals if not m.closed]
        if self.quick and not self.modals and self.result is None:
            self.finish("RESUME")
        if self.games_changed and not self.quick:
            self.refresh_games()

        keep = set()
        for i in (self.selected - 1, self.selected, self.selected + 1):
            if 0 <= i < len(self.games):
                keep.add(self.games[i])
        if self.saver_on and 0 <= self.saver_index < len(self.games):
            keep.add(self.games[self.saver_index])
        pending = self.all_games + ([self.quick_game] if self.quick else [])
        if self.quick:
            keep.add(self.quick_game)
        for g in pending:
            if (g.raw_icon is not None and g.icon is None) or g.raw_backgrounds is not None:
                self.art.finish(g, keep)

        self.update_screensaver()
        if not self.saver_on:
            game = self.quick_game if self.quick else self.current_game()
            if game is not None and game.backgrounds and self.bg_current is None:
                self.set_background(self.current_background(), animate=True)
            if game is not None and game.backgrounds and len(game.backgrounds) > 1 and self.t >= self.bg_switch_at:
                self.bg_index += 1
                self.set_background(self.current_background(), animate=True)
                self.bg_switch_at = self.t + 12.0
        self.bg_mix = min(1.0, self.bg_mix + dt / (0.7 if motion == "full" else 0.3))

        step = self.tile_small + TILE_GAP
        target = max(0, self.selected - 2) * step
        rate = 1000 if motion == "off" else 12
        self.row_offset = ease(self.row_offset, target, rate, dt)
        for i in range(len(self.tile_sizes)):
            want = self.tile_small
            if i == self.selected:
                want = self.tile_big if self.focus == "tiles" else self.tile_small + 18
            self.tile_sizes[i] = ease(self.tile_sizes[i], want, 1000 if motion == "off" else 14, dt)
        self.info_alpha = min(1.0, self.info_alpha + dt / (0.35 if motion == "full" else 0.15))

        if self.settings["orbs"] and motion != "off":
            speed = ORB_SPEEDS.get(self.settings["orb_speed"], 1.0)
            for p in self.particles:
                p[1] -= p[2] * dt * speed
                if motion == "full":
                    p[0] += math.sin(self.t * 0.6 + p[4]) * 6 * dt * speed
                if p[1] < ui.H * 0.18:
                    p[:] = ui.new_particle()
        if self.fade_out is not None:
            self.fade_out += dt / 0.45

        # Turn off when not used (home screen only, not while a game waits).
        minutes = self.settings["auto_off_minutes"]
        if minutes and not self.quick and self.running_path is None and self.result is None:
            left = minutes * 60 - (time.monotonic() - self.input.last_input)
            if left <= 60 and not self.idle_warned:
                self.idle_warned = True
                self.toast("The PS4 turns off in a minute. Press any button to keep it on.", 60)
            if left <= 0:
                self.finish("POWEROFF")

    def update_screensaver(self):
        minutes = self.settings["screensaver_minutes"]
        idle = time.monotonic() - self.input.last_input
        if not self.saver_on:
            if minutes and not self.quick and self.result is None and idle >= minutes * 60:
                self.saver_on = True
                self.saver_next = self.t
                self.saver_index = self.selected - 1
            return
        if self.settings["screensaver_mode"] != "slideshow" or not self.games:
            return
        if self.t >= self.saver_next:
            self.saver_index = (self.saver_index + 1) % len(self.games)
            self.saver_next = self.t + 9.0
            self.art.want(self.games[self.saver_index], True)
            self.art.want(self.games[(self.saver_index + 1) % len(self.games)], True)
        game = self.games[self.saver_index % len(self.games)]
        if game.backgrounds:
            self.set_background(game.backgrounds[0], animate=True)

    def wake(self):
        """Any button ends the screensaver (and does nothing else)."""
        self.saver_on = False
        self.bg_index = 0
        self.set_background(self.current_background(), animate=True)

    def draw(self):
        c = self.c
        if self.overscan:
            self.real_screen.fill((0, 0, 0))
        if self.saver_on:
            self.draw_screensaver(c)
            return
        cover = max((i for i, m in enumerate(self.modals) if m.covers), default=-1)
        if cover < 0:
            self.draw_home(c)
        for modal in self.modals[max(0, cover):]:
            modal.draw(c)
        if self.settings["hints"]:
            if self.modals:
                ui.draw_hints(c, self.modals[-1].hints())
            else:
                ui.draw_hints(c, self.home_hints(), soft=ART_SOFT, dim=ART_SOFT)
        if self.toast_text and self.t < self.toast_until:
            width = c.t.width(self.toast_text, 18) + 48
            c.rect(DIALOG, ui.W / 2 - width / 2, 24, width, 48, 24)
            c.rect(ACCENT, ui.W / 2 - width / 2, 24, width, 48, 24, 2)
            c.text(self.toast_text, 18, ui.W / 2, 48, WHITE, False, "center")
        if self.fade_out is not None:
            c.dim(255 * min(1.0, self.fade_out), (0, 0, 0))

    def draw_screensaver(self, c):
        if self.settings["screensaver_mode"] == "slideshow" and self.games:
            self.draw_background(c, orbs=False)
            game = self.games[self.saver_index % len(self.games)]
            c.text(c.t.fit(game.title, 30, ui.W - 200, True), 30, ROW_X, ui.H - 110, ART_TEXT, True, shadow=True)
            c.text(clock_text(self.settings["clock_24h"]), 20, ui.W - 64, ui.H - 100, ART_TEXT, True, "topright",
                   shadow=True)
            return
        # Dim: almost black, with the clock moving slowly so nothing stays in one place.
        c.s.fill((0, 0, 0))
        x = ui.W / 2 + math.sin(self.t * 0.05) * ui.W * 0.3
        y = ui.H / 2 + math.sin(self.t * 0.037 + 1) * ui.H * 0.3
        c.text(clock_text(self.settings["clock_24h"]), 40, x, y, (90, 90, 100), True, "center")

    def make_static_background(self):
        """The background for the gradient, solid and picture choices (screen size, made once)."""
        w, h = self.screen.get_size()
        choice = self.settings["background"]
        surface = None
        if choice == "picture":
            try:
                picture = pygame.image.load(store.BACKGROUND_FILE)
                scale = max(w / picture.get_width(), h / picture.get_height())
                picture = pygame.transform.smoothscale(
                    picture, (int(picture.get_width() * scale) + 1, int(picture.get_height() * scale) + 1))
                surface = pygame.Surface((w, h))
                surface.blit(picture, picture.get_rect(center=(w // 2, h // 2)))
                surface.blit(readability_shade(w, h), (0, 0))
            except (pygame.error, OSError):
                surface = None
        if surface is None and choice in ("gradient", "picture"):
            # Dark at the bottom left, the accent color glowing at the top right.
            small = pygame.Surface((32, 18))
            base = ui.mix(ACCENT, (6, 6, 14), 0.86)
            glow = ui.mix(ACCENT, (6, 6, 14), 0.45)
            for y in range(18):
                for x in range(32):
                    t = max(0.0, min(1.0, (x / 31) * 0.6 + (1 - y / 17) * 0.6 - 0.25))
                    small.set_at((x, y), ui.mix(base, glow, t * t))
            surface = pygame.transform.smoothscale(small, (w, h))
        if surface is None:
            surface = pygame.Surface((w, h))
            surface.fill(ui.mix(ACCENT, (8, 8, 16), 0.82))
        self.static_bg = surface.convert()

    def draw_background(self, c, orbs=True):
        s = self.settings
        use_art = s["background"] == "art" or self.quick or self.saver_on
        if not use_art:
            if self.static_bg is None:
                self.make_static_background()
            c.s.blit(self.static_bg, (0, 0))
        else:
            c.s.fill(ui.mix(ACCENT, (6, 6, 14), 0.86))
            drift_x = drift_y = 0.0
            if s["animations"] == "full":
                drift_x = px(max(0.0, BG_W - ui.W)) * (0.5 + 0.5 * math.sin(self.t * 0.045))
                drift_y = px(BG_H - ui.H) * (0.5 + 0.5 * math.sin(self.t * 0.031 + 1.0))
            else:
                drift_x, drift_y = px(max(0.0, BG_W - ui.W)) / 2, px(BG_H - ui.H) / 2
            if self.bg_previous is not None and self.bg_mix < 1.0:
                c.s.blit(self.bg_previous, (-drift_x, -drift_y))
            if self.bg_current is not None:
                if self.bg_mix < 1.0:
                    self.bg_current.set_alpha(int(255 * self.bg_mix))
                    c.s.blit(self.bg_current, (-drift_x, -drift_y))
                    self.bg_current.set_alpha(None)
                else:
                    c.s.blit(self.bg_current, (-drift_x, -drift_y))
            elif self.bg_previous is not None and self.bg_mix < 1.0:
                c.dim(255 * self.bg_mix, ui.mix(ACCENT, (6, 6, 14), 0.86))
        if s["dim"]:
            c.dim(255 * s["dim"] / 100, (0, 0, 0))
        if orbs and s["orbs"]:
            color = s["orb_color"]
            pulse = s["animations"] != "off"
            for x, y, _, size, phase in self.particles:
                glow = (math.sin(self.t * 1.3 + phase) + 1) / 2 if pulse else 0.5
                if color == "accent":
                    rgb = ui.mix(ACCENT, (255, 255, 255), 0.2 + 0.4 * glow)
                elif color == "gold":
                    rgb = ui.mix((200, 140, 40), (255, 225, 140), glow)
                else:
                    g = int(110 + 90 * (glow * 2 - 1))
                    rgb = (g, g, min(255, g + 40))
                c.circle(rgb, x, y, size)

    def draw_home(self, c):
        self.draw_background(c)
        if self.quick:
            c.dim(80)
            return
        self.draw_top_bar(c)
        if self.tab == "media":
            self.media.draw(c)
            return
        self.draw_tiles(c)
        self.draw_info(c)

    def draw_top_bar(self, c):
        s = self.settings
        x = ROW_X
        if s["show_avatar"]:
            c.blit(self.avatar(40), x, 24)
            x += 52
        if s["show_name"]:
            x += c.text(c.t.fit(s["name"], 19, 300, True), 19, x, 33, ART_TEXT, True, shadow=True) + 36
        # The tabs: Games and Media (L1 / R1).
        for tab, label in (("games", "Games"), ("media", "Media")):
            on = self.tab == tab
            width = c.text(label, 19, x, 33, ART_TEXT if on else ART_SOFT, on, shadow=True)
            if on:
                c.rect(ART_TEXT, x, 60, width, 3, 2)
            x += width + 28

        right = ui.W - 56
        clock = clock_text(s["clock_24h"], s["clock_seconds"])
        clock_w = c.text(clock, 20, right, 33 if not s["clock_date"] else 24, ART_TEXT, True, "topright",
                         shadow=True)
        if s["clock_date"]:
            date = time.strftime("%a %d %b")
            clock_w = max(clock_w, c.text(date, 13, right, 50, ART_SOFT, False, "topright", shadow=True))
        x = right - clock_w
        with self.network.lock:
            state, ssid, ethernet = self.network.state, self.network.ssid, self.network.ethernet
        bars = 3 if state == "connected" else 1 if state == "connecting" else 0
        wifi_x = x - 40
        focus_home = not self.modals
        if self.focus == "wifi" and focus_home:
            c.circle(ART_TEXT, wifi_x, 44, 22, 2)
            label = ssid if state == "connected" else ("Network cable" if ethernet == "connected" else
                                                       "Wi-Fi: not connected")
            self.tip(c, wifi_x, label)
        ui.draw_wifi(c, wifi_x, 54, ART_TEXT, bars)
        pads = self.poll.get("controllers", system.controllers, 2.0, [])
        pad_x = wifi_x - 50
        ui.draw_pad(c, pad_x, 44, ART_TEXT if (self.input.pad_count() or pads) else ART_SOFT)
        if s["show_battery"]:
            bluetooth = next((p for p in pads if p["connection"] == "Bluetooth" and p["battery"] is not None), None)
            if bluetooth is not None:
                ui.draw_battery(c, pad_x - 12, 56, bluetooth["battery"], ART_SOFT, bluetooth["charging"])
        gear_x = pad_x - 50
        if self.focus == "settings" and focus_home:
            c.circle(ART_TEXT, gear_x, 44, 22, 2)
            self.tip(c, gear_x, "Settings")
        ui.draw_gear(c, gear_x, 44, ART_TEXT)
        if s["show_ip"]:
            addresses = self.poll.get("ip", system.ip_addresses, 10.0, [])
            if addresses:
                c.text(addresses[0][1], 15, gear_x - 34, 36, ART_SOFT, False, "topright", shadow=True)

    def tip(self, c, x, label):
        width = c.t.width(label, 14) + 24
        left = min(x - width / 2, ui.W - 16 - width)
        c.rect(DIALOG, left, 74, width, 26, 13)
        c.text(label, 14, left + width / 2, 87, WHITE, False, "center")

    def tile_shape(self, c, color, x, y, size, width=0, grow=0):
        """A filled (or outlined) tile-shaped area, `grow` units larger on each side."""
        shape = self.settings["tile_shape"]
        if shape == "circle":
            c.circle(color, x + size / 2, y + size / 2, size / 2 + grow, width)
        else:
            radius = (14 if shape == "rounded" else 3) + (grow and 4)
            c.rect(color, x - grow, y - grow, size + 2 * grow, size + 2 * grow, radius, width)

    def draw_tiles(self, c):
        x = ROW_X - self.row_offset
        shape = self.settings["tile_shape"]
        pulse_on = self.settings["animations"] == "full"
        for i in range(self.items()):
            size = self.tile_sizes[i] if i < len(self.tile_sizes) else self.tile_small
            if x + size > -20 and x < ui.W + 20:
                selected = i == self.selected and self.focus == "tiles" and not self.modals
                if i < len(self.games):
                    game = self.games[i]
                    if game.icon is not None:
                        c.blit(tile_image(game, px(size), shape), x, ROW_Y)
                    elif shape == "circle":
                        self.tile_shape(c, game.color, x, ROW_Y, size)
                        lines = c.t.wrap(game.title, 14, size * 0.68)[:3]
                        top = ROW_Y + size / 2 - len(lines) * 9
                        for n, line in enumerate(lines):
                            c.text(line, 14, x + size / 2, top + n * 18 + 9, (255, 255, 255), False, "center")
                    else:
                        self.tile_shape(c, game.color, x, ROW_Y, size)
                        for n, line in enumerate(c.t.wrap(game.title, 14, size - 24)[:3]):
                            c.text(line, 14, x + 12, ROW_Y + 12 + n * 18, (255, 255, 255))
                    entry = self.entries.get(game.path, {})
                    if entry.get("hidden"):
                        self.tile_shape(c, (0, 0, 0, 150), x, ROW_Y, size)
                        c.text("Hidden", 13, x + size / 2, ROW_Y + size / 2, (255, 255, 255), True, "center")
                    if self.is_running(game):
                        label = "RUNNING"
                        width = c.t.width(label, 11, True) + 16
                        c.rect(ACCENT, x + size / 2 - width / 2, ROW_Y + size - 30, width, 20, 10)
                        c.text(label, 11, x + size / 2, ROW_Y + size - 20, (255, 255, 255), True, "center")
                    elif self.settings["source_labels"]:
                        self.draw_badge(c, game.source, x, ROW_Y + size, size if shape == "circle" else None)
                    if entry.get("favorite"):
                        c.circle((14, 12, 34), x + size - 16, ROW_Y + 16, 13)
                        ui.draw_star(c, x + size - 16, ROW_Y + 16, 10, GOLD)
                else:
                    self.tile_shape(c, (44, 44, 52), x, ROW_Y, size)
                    ui.draw_power(c, x + size / 2, ROW_Y + size / 2, size / 5, (255, 255, 255),
                                  3 if size < 130 else 4)
                if selected:
                    thick = 3.5 + (1.5 * math.sin(self.t * 4) if pulse_on else 0)
                    self.tile_shape(c, ART_TEXT, x, ROW_Y, size, max(2, int(thick)), 5)
            x += size + TILE_GAP

    def draw_badge(self, c, source, x, bottom, centered_in=None):
        width = c.t.width(source, 12, True) + 14
        if centered_in:
            x = x + centered_in / 2 - width / 2 - 6       # Circle tiles: at the bottom middle.
        c.rect((14, 12, 34), x + 5, bottom - 27, width + 2, 22, 11)
        c.rect(SOURCE_COLORS.get(source, (64, 64, 76)), x + 6, bottom - 26, width, 20, 10)
        c.text(source, 12, x + 6 + width / 2, bottom - 16, (255, 255, 255), True, "center")

    def draw_info(self, c):
        a = self.info_alpha
        y = self.info_y + (1 - a) * 14
        game = self.current_game()
        layer = None
        target = c
        if a < 1.0:
            # Fading in: draw into a transparent layer, then put it on with its alpha.
            layer = pygame.Surface(c.s.get_size(), pygame.SRCALPHA)
            target = ui.Canvas(layer, c.t)
        if not self.games and self.on_power():
            title, sub, button = "No games yet", "", None
        elif self.on_power():
            title, sub, button = "Power", "Turn off or restart the PS4", "Power"
        else:
            title, sub = game.title, game.subtitle()
            button = "Resume" if self.is_running(game) else "Play"
            seconds = self.entries.get(game.path, {}).get("play_seconds", 0)
            if seconds >= 60:
                sub = "  ·  ".join(p for p in (sub, "Played " + system.play_time_text(seconds)) if p)
        ty = y
        grow = self.settings["text_size"] / 100      # Lines are further apart with larger text.
        for line in target.t.wrap(title, 44, 640, True)[:2]:
            target.text(line, 44, ROW_X, ty, ART_TEXT, True, shadow=True)
            ty += 54 * grow
        if sub or game is not None:
            sx = ROW_X + 2
            if sub:
                sx += target.text(sub, 17, sx, ty + 6, ART_SOFT, shadow=True) + 16
            if game is not None and self.settings["source_labels"]:
                name = target.t.fit(game.source_name, 15, 420, True)
                width = target.t.width(name, 15, True) + 26
                target.rect(SOURCE_COLORS.get(game.source, (64, 64, 76)), sx, ty + 4, width, 26, 13)
                target.text(name, 15, sx + width / 2, ty + 17, (255, 255, 255), True, "center")
            ty += 34 * grow
        if not self.games and self.on_power():
            for line in ("Put PS5 game folders in one of these places:",
                         "  •  the PS5 folder of a USB drive",
                         f"  •  {system.PS4_GAMES_SHOWN} on the PS4, with GoldHEN FTP",
                         "  •  a shared folder on a PC (Settings, at the top)",
                         "They show up here by themselves."):
                target.text(line, 17, ROW_X + 2, ty + 6, ART_SOFT, shadow=True)
                ty += 28
        if button:
            by = ty + 24
            width = max(170, target.t.width(button, 20, True) + 70)
            if self.focus == "tiles" and not self.modals and self.settings["animations"] == "full":
                ring = (math.sin(self.t * 2.6) + 1) / 2
                grow = 16 * ring
                target.rect((255, 255, 255, int(120 * (1 - ring))), ROW_X - grow / 2, by - grow / 2,
                            width + grow, 48 + grow, 30, 2)
            target.rect((255, 255, 255), ROW_X, by, width, 48, 24)
            target.text(button, 20, ROW_X + width / 2, by + 24, (20, 18, 30), True, "center")
        if layer is not None:
            layer.set_alpha(int(255 * a))
            c.s.blit(layer, (0, 0))

    def home_hints(self):
        if self.quick:
            return []
        back = ("ps", "Back to the game") if self.running_path else ("ps", "Quick menu")
        if self.focus == "wifi":
            return [("cross", "Wi-Fi"), (None, "Left: Settings"), ("circle", "Back")]
        if self.focus == "settings":
            return [("cross", "Settings"), (None, "Right: Wi-Fi"), ("circle", "Back")]
        if self.tab == "media":
            hints = [("cross", "View")] if self.media.paths else []
            return hints + [("l1r1", "Games"), back]
        game = self.current_game()
        if self.on_power():
            hints = [("cross", "Select")]
        else:
            hints = [("cross", "Resume" if game is not None and self.is_running(game) else "Play")]
        if game is not None:
            hints.append(("options", "Options"))
        return hints + [("l1r1", "Media"), back, (None, "Up: Wi-Fi and Settings")]

    def run(self):
        last = time.monotonic()
        self.input.last_input = last
        reload_requested = []
        signal.signal(signal.SIGUSR1, lambda *_: reload_requested.append(True))
        while True:
            if reload_requested and self.result is None:
                self.finish("RELOAD")       # A live update: ps5-session starts the home screen again.
            now = time.monotonic()
            dt = min(0.1, now - last)
            last = now
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    return None
                for action in self.input.handle(event, now):
                    if self.idle_warned:
                        self.idle_warned = False
                        self.toast_until = 0
                    if self.saver_on:
                        self.wake()
                        continue
                    if self.fade_out is None:
                        self.act(action)
            for action in self.input.repeats(now):
                if self.fade_out is None and not self.saver_on:
                    self.act(action)
            self.update(dt)
            self.draw()
            pygame.display.flip()
            if self.fade_out is not None and self.fade_out >= 1.0:
                return self.result
            self.clock.tick(60)


def main():
    parser = argparse.ArgumentParser(description="PS5 on PS4 home screen")
    parser.add_argument("--games", default=system.USB_GAMES, help="the USB drive's folder of PS5 games")
    parser.add_argument("--ps4-games", default=system.PS4_GAMES, help="the PS4 drive's folder of PS5 games")
    parser.add_argument("--pc-test", default=None, metavar="DIR",
                        help="for testing: DIR stands for the mounted PC shares (no smbnetfs)")
    parser.add_argument("--message", default=None, help="a message to show first (after an error)")
    parser.add_argument("--size", default=None, help="for testing: a window of this size, like 1920x1080")
    parser.add_argument("--windowed", action="store_true", help="a window instead of full screen")
    parser.add_argument("--dry-run-network", action="store_true",
                        help="look up Wi-Fi but never change it (for testing)")
    parser.add_argument("--quick-menu", default=None, metavar="GAME",
                        help="only the quick menu, over this paused game (from ps5-guide)")
    parser.add_argument("--suspended", default=None, metavar="GAME",
                        help="the home screen while this game waits, paused (from ps5-guide)")
    args = parser.parse_args()
    result = Home(args).run()
    pygame.quit()
    if result:
        print(result, flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
