def gif_frames(source, folder):
    """Splits a GIF into square PNG frames in `folder` (replaced only when it worked). True if done."""
    import shutil
    part = folder + ".part"
    shutil.rmtree(part, ignore_errors=True)
    os.makedirs(part, exist_ok=True)
    side = ANIM_SIDE
    code, _, _ = system.run(["ffmpeg", "-v", "error", "-i", source, "-vf",
                             f"fps={ANIM_FPS},scale={side}:{side}:force_original_aspect_ratio=increase,"
                             f"crop={side}:{side},format=rgba",
                             "-frames:v", str(ANIM_FRAMES), os.path.join(part, "%03d.png")], timeout=60)
    if code != 0 or not os.listdir(part):
        shutil.rmtree(part, ignore_errors=True)
        return False
    shutil.rmtree(folder, ignore_errors=True)
    os.replace(part, folder)
    return True


def avatar_disc(surface, size_px):
    """A picture as a round avatar on a soft disc in the accent color (a GIF's see-through parts
    show the disc). Opaque, so a new frame drawn over the last one leaves nothing behind."""
    surface = surface.convert_alpha()       # A GIF's first frame has a palette (and maybe a see-through color).
    disc = pygame.Surface((size_px, size_px), pygame.SRCALPHA)
    pygame.draw.circle(disc, ui.mix(ui.ACCENT, (24, 24, 34), 0.55), (size_px // 2, size_px // 2), size_px // 2)
    see_through = surface.get_at((0, 0))[3] < 128
    if see_through:                 # A sticker (an emoji): whole, smaller, on the disc.
        inner = max(1, int(size_px * 0.74))
        picture = pygame.transform.smoothscale(surface, (inner, inner))
        disc.blit(picture, ((size_px - inner) // 2, (size_px - inner) // 2))
    else:
        disc.blit(ui.circle_image(surface, size_px), (0, 0))
    disc.blit(ui.circle_mask(size_px), (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
    return disc


def own_pictures(home):
    """The player's pictures and GIFs: on the USB drive and in the PC's shared folder (at the top
    and in PICTURE_FOLDERS), at most 48, none over 20 MB."""
    roots = []
    if system.mounted(system.USB_MOUNT):
        roots.append(system.USB_MOUNT)
    pc = getattr(home, "pc", None)
    if pc is not None and pc.status()[0] == "connected":
        s = pc.get()
        if s.get("address") and s.get("share"):
            roots.append(os.path.join(pc.mount, s["address"], *s["share"].split("/")))
    found = []
    for root in roots:
        for sub in PICTURE_FOLDERS:
            folder = os.path.join(root, sub)
            try:
                names = sorted(os.listdir(folder))
            except OSError:
                continue
            for n in names:
                path = os.path.join(folder, n)
                try:
                    if n.lower().endswith(PICTURE_TYPES) and not n.startswith(".") \
                            and os.path.getsize(path) <= 20_000_000:
                        found.append(path)
                except OSError:
                    pass
    return found[:48]


SOURCE_COLORS = {"USB": (88, 150, 255), "PS4": (64, 64, 76), "PC": (46, 170, 120)}


def clock_text(h24, seconds=False):
    if h24:
        return time.strftime("%H:%M:%S" if seconds else "%H:%M")
    return time.strftime("%I:%M:%S %p" if seconds else "%I:%M %p").lstrip("0")


def ease(current, target, rate, dt):
    return current + (target - current) * min(1.0, rate * dt)


def ease_out(t):
    return 1 - (1 - t) ** 3


def ease_in_out(t):
    return t * t * (3 - 2 * t)


# --------------------------------------------------------------------------------------------
# Game pictures: icons for every game, backgrounds only for the few games near the selection
# (they are large at the TV's resolution). Loaded in a background thread; turned into the
# screen's pixel format in the main thread.

# --------------------------------------------------------------------------------------------
# Aurora: soft light in the picture's own colors, baked into each background once.

def surface_palette(surface):
    """Two colors of a picture: its most vivid one (for light and borders) and a deep one."""
    import colorsys
    small = pygame.transform.smoothscale(surface, (24, 14))
    pixels = [small.get_at((x, y))[:3] for y in range(14) for x in range(24)]
    avg = tuple(sum(p[i] for p in pixels) // len(pixels) for i in range(3))

    def vividness(p):
        h, sat, v = colorsys.rgb_to_hsv(*(c / 255 for c in p))
        return sat * v

    vivid = max(pixels, key=vividness)
    if vividness(vivid) < 0.15:                 # A grey picture: a light grey of its own.
        vivid = ui.mix(avg, (255, 255, 255), 0.4)
    deep = ui.mix(avg, (0, 0, 0), 0.6)
    return tuple(int(c) for c in vivid), tuple(int(c) for c in deep)


def h_gradient(w, h, c1, c2):
    """A left-to-right gradient (colors with alpha allowed)."""
    two = pygame.Surface((2, 1), pygame.SRCALPHA)
    two.set_at((0, 0), c1 if len(c1) == 4 else c1 + (255,))
    two.set_at((1, 0), c2 if len(c2) == 4 else c2 + (255,))
    return pygame.transform.smoothscale(two, (max(2, w), max(1, h)))


def soft_blur(surface, amount=8):
    w, h = surface.get_size()
    small = pygame.transform.smoothscale(surface, (max(1, w // amount), max(1, h // amount)))
    return pygame.transform.smoothscale(small, (w, h))


def aurora_shade(w, h):
    """Darker toward the bottom (tiles and card) and at the very top (the top bar)."""
    shade = pygame.Surface((w, h), pygame.SRCALPHA)
    for y in range(h):
        t = y / max(1, h - 1)
        a = int(55 + 170 * t ** 1.35)
        pygame.draw.line(shade, (5, 4, 12, a), (0, y), (w, y))
    top = max(1, h // 9)
    band = pygame.Surface((w, top), pygame.SRCALPHA)
    for y in range(top):
        pygame.draw.line(band, (5, 4, 12, int(110 * (1 - y / top))), (0, y), (w, y))
    shade.blit(band, (0, 0))
    return shade


def aurora_light(w, h, vivid):
    """Ribbons of light and a glow in the picture's colors, on black, to add to a background."""
    layer = pygame.Surface((w, h))
    layer.fill((0, 0, 0))
    k = h / 1080
    for n, (color, phase) in enumerate(((vivid, 0.0), (CHAMPAGNE, 1.7), ((255, 140, 70), 3.1))):
        points = [(x, h * 0.28 + 90 * k * math.sin(x / (260 * k) + phase) + n * 40 * k)
                  for x in range(-40, w + 60, 20)]
        for width, strength in ((60, 0.10), (26, 0.16), (8, 0.35)):
            pygame.draw.lines(layer, tuple(int(c * strength) for c in color), False, points,
                              max(1, int(width * k)))
    glow = pygame.Surface((w, h))
    glow.fill((0, 0, 0))
    cx, cy, r = int(w * 0.78), int(h * 0.2), int(h * 0.4)
    for i in range(r, 0, -max(2, r // 90)):
        strength = (1 - i / r) ** 2.2 * 0.15
        pygame.draw.circle(glow, tuple(int(c * strength) for c in vivid), (cx, cy), i)
    layer.blit(glow, (0, 0), special_flags=pygame.BLEND_RGB_ADD)
    return soft_blur(layer, 6)


def aurora_background(surface, vivid):
    """`surface` (a background) with the Aurora shade and light."""
    w, h = surface.get_size()
    surface.blit(aurora_shade(w, h), (0, 0))
    surface.blit(aurora_light(w, h, vivid), (0, 0), special_flags=pygame.BLEND_RGB_ADD)
    return surface


GLOWS = {}


def glow_sprite(radius, color):
    """A round soft light (black is none) to add with BLEND_RGB_ADD."""
    key = (radius, color)
    sprite = GLOWS.get(key)
    if sprite is None:
        sprite = pygame.Surface((radius * 2, radius * 2))
        sprite.fill((0, 0, 0))
        for i in range(radius, 0, -max(2, radius // 60)):
            strength = (1 - i / radius) ** 2 * 0.42
            pygame.draw.circle(sprite, tuple(int(c * strength) for c in color), (radius, radius), i)
        sprite = soft_blur(sprite, 4)
        GLOWS[key] = sprite
    return sprite


BORDERS = {}


def gradient_border(w, h, radius, c1, c2, width):
    """A rounded rectangle outline running from c1 (left) to c2 (right)."""
    key = (w, h, radius, c1, c2, width)
    border = BORDERS.get(key)
    if border is None:
        border = h_gradient(w, h, c1, c2)
        border.blit(ui.round_mask(w, h, radius, width), (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
        if len(BORDERS) > 60:
            BORDERS.clear()
        BORDERS[key] = border
    return border


def tilted(image, amount):
    """A fake 3D turn: the far side is shorter (amount 0.12: 12% shorter)."""
    w, h = image.get_size()
    big = pygame.transform.smoothscale(image, (w * 2, h * 2))     # Twice the size: smooth edges.
    out = pygame.Surface((w * 2, h * 2), pygame.SRCALPHA)
    out.fill((255, 255, 255, 0))
    for x in range(w * 2):
        exact = h * 2 * (1 - amount * (x / (w * 2)))
        nh = max(1, int(exact))
        col = pygame.transform.smoothscale(big.subsurface((x, 0, 1, h * 2)), (1, nh))
        out.blit(col, (x, (h * 2 - nh) // 2))
    return pygame.transform.smoothscale(out, (w, h))


def reflection(image, strength=60):
    """The image upside down, fading out, for a reflection under it."""
    w, h = image.get_size()
    flipped = pygame.transform.flip(image, False, True).copy()
    fade = pygame.Surface((1, 2), pygame.SRCALPHA)
    fade.set_at((0, 0), (255, 255, 255, strength))
    fade.set_at((0, 1), (255, 255, 255, 0))
    flipped.blit(pygame.transform.smoothscale(fade, (w, h)), (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
    return flipped


def prepare(game):
    """Picture fields on a system.Game (kept on the object, so a game keeps them)."""
    if not hasattr(game, "icon"):
        game.icon = None
        game.raw_icon = None
        game.icon_loaded = False
        game.color = (60, 52, 137)
        game.backgrounds = None      # None: not loaded.
        game.raw_backgrounds = None
        game.tiles = {}
        game.palette = None          # (vivid, deep) of its art, for the Aurora light.
    return game


class ArtLoader:
    KEEP = 5      # Games whose backgrounds stay in memory.

    def __init__(self):
        self.queue = queue.Queue()
        self.shade = None
        self.size = (px(BG_W), px(BG_H))
        self.loaded = []          # Games with backgrounds, oldest first.
        threading.Thread(target=self._work, daemon=True).start()

    def want(self, game, backgrounds):
        self.queue.put((game, backgrounds))

    def _work(self):
        while True:
            game, backgrounds = self.queue.get()
            try:
                self._load(game, backgrounds)
            except Exception:  # A broken picture must not stop the menu.
                game.icon_loaded = True
                if backgrounds and game.backgrounds is None and game.raw_backgrounds is None:
                    game.raw_backgrounds = []

    def _load(self, game, backgrounds):
        sys_dir = game.sys_dir
        if not game.icon_loaded:
            icon = None
            try:
                cover = system.cover_file(game.title_id)   # The player's own cover (Settings > Saves).
                if cover is None and game.zar:
                    system.zar.extract(game.path, ["icon0.png"])
                icon = pygame.image.load(cover or os.path.join(sys_dir, "icon0.png"))
            except (pygame.error, FileNotFoundError, OSError, ValueError):
                pass
            if icon is not None:
                tiny = pygame.transform.smoothscale(icon, (1, 1))
                game.color = tuple(tiny.get_at((0, 0))[:3])
                side = min(icon.get_width(), max(256, px(TILE_SEL) * 2))
                game.raw_icon = pygame.transform.smoothscale(icon, (side, side))
            game.icon_loaded = True
        if not backgrounds or game.backgrounds is not None or game.raw_backgrounds is not None:
            return
        result = []
        if game.zar:
            try:
                system.zar.extract(game.path, ["pic0.png", "pic1.png"])
            except (OSError, ValueError):
                pass
        for name in ("pic0.png", "pic1.png"):
            try:
                picture = pygame.image.load(os.path.join(sys_dir, name))
            except (pygame.error, FileNotFoundError, OSError):
                continue
            result.append(pygame.transform.smoothscale(picture, self.size))
        if not result:
            if game.raw_icon is not None:
                small = pygame.transform.smoothscale(game.raw_icon, (16, 9))
                result.append(pygame.transform.smoothscale(small, self.size))
            else:
                plain = pygame.Surface(self.size)
                plain.fill(game.color)
                result.append(plain)
            veil = pygame.Surface(self.size, pygame.SRCALPHA)
            veil.fill((0, 0, 0, 110))
            result[0].blit(veil, (0, 0))
        game.palette = surface_palette(result[0])
        if self.shade is None:
            self.shade = aurora_shade(*self.size)
        light = aurora_light(self.size[0], self.size[1], game.palette[0])
        for background in result:
            background.blit(self.shade, (0, 0))
            background.blit(light, (0, 0), special_flags=pygame.BLEND_RGB_ADD)
        game.raw_backgrounds = result

    def finish(self, game, keep):
        """Main thread: converts what was loaded; drops backgrounds of games far away."""
        if game.raw_icon is not None and game.icon is None:
            game.icon = game.raw_icon.convert_alpha()
        if game.raw_backgrounds is not None and game.backgrounds is None:
            game.backgrounds = [b.convert() for b in game.raw_backgrounds]
            game.raw_backgrounds = None
            if game in self.loaded:
                self.loaded.remove(game)
            self.loaded.append(game)
            while len(self.loaded) > self.KEEP:
                old = next((g for g in self.loaded if g not in keep), None)
                if old is None:
                    break
                self.loaded.remove(old)
                old.backgrounds = None


def tile_image(game, size_px, shape="rounded"):
    size_px = max(8, size_px - size_px % 4)
    tile = game.tiles.get((size_px, shape))
    if tile is None:
        if shape == "circle":
            tile = ui.circle_image(game.icon, size_px)
        else:
            tile = ui.rounded_image(game.icon, size_px, px(14 if shape == "rounded" else 3))
        game.tiles[(size_px, shape)] = tile
    return tile


# --------------------------------------------------------------------------------------------
# Values from slow commands, refreshed in the background while a screen shows them.

class Poller:
    def __init__(self):
        self.values = {}
        self.busy = set()
        self.lock = threading.Lock()

    def get(self, key, fn, max_age=3.0, default=None):
        now = time.monotonic()
        with self.lock:
            entry = self.values.get(key)
            stale = entry is None or now - entry[0] > max_age
            if stale and key not in self.busy:
                self.busy.add(key)
                threading.Thread(target=self._run, args=(key, fn), daemon=True).start()
        return entry[1] if entry is not None and entry[1] is not None else default

    def _run(self, key, fn):
        try:
            value = fn()
        except Exception:
            value = None
        with self.lock:
            self.values[key] = (time.monotonic(), value)
            self.busy.discard(key)

    def put(self, key, value):
        with self.lock:
            self.values[key] = (time.monotonic(), value)

    def forget(self, key):
        with self.lock:
            self.values.pop(key, None)


# --------------------------------------------------------------------------------------------
# Modals: everything shown over the home screen. The top one gets the input.

class Modal:
    covers = False        # Draws the whole screen (the home screen is not drawn below).

    def __init__(self, home):
        self.home = home
        self.appear = 0.0
        self.closed = False

    def act(self, action):
        pass

    def update(self, dt):
        self.appear = min(1.0, self.appear + dt / 0.18)

    def draw(self, c):
        pass

    def hints(self):
        return [("circle", "Back")]

    def close(self):
        self.closed = True

    def typed(self, chunk):
        pass


class Dialog(Modal):
    """A message with buttons: [(label, callback)]."""

    def __init__(self, home, message, buttons=None, title=None):
        super().__init__(home)
        self.message = message
        self.title = title
        self.buttons = buttons or [("OK", None)]
        self.selected = 0

    def act(self, action):
        h = self.home
        if action in (LEFT, RIGHT) and len(self.buttons) > 1:
            self.selected = (self.selected + (1 if action == RIGHT else -1)) % len(self.buttons)
            h.sounds.play("move")
        elif action == OK:
            h.sounds.play("select")
            self.close()
            callback = self.buttons[self.selected][1]
            if callback:
                callback()
        elif action == BACK:
            h.sounds.play("back")
            self.close()
            if len(self.buttons) == 1 and self.buttons[0][1]:
                self.buttons[0][1]()

    def draw(self, c):
        lines = c.t.wrap(self.message, 21, 560)[:8]
        box_w = 660
        box_h = 156 + len(lines) * 30 + (46 if self.title else 0)
        x, y = draw_luxe_card(c, box_w, box_h, self.appear)
        c.rect(ui.ACCENT, ui.W / 2 - 22, y + 18, 44, 3, 1)
        ty = y + 40
        if self.title:
            c.text(self.title, 24, ui.W / 2, ty, WHITE, True, "midtop")
            ty += 46
        for line in lines:
            c.text(line, 21, ui.W / 2, ty, SOFT if self.title else WHITE, False, "midtop")
            ty += 30
        by = y + box_h - 76
        width = 200
        total = len(self.buttons) * width + (len(self.buttons) - 1) * 18
        bx = ui.W / 2 - total / 2
        for i, (label, _) in enumerate(self.buttons):
            draw_luxe_button(c, label, bx, by, width, 50, i == self.selected)
            bx += width + 18

    def hints(self):
        return [("cross", "Select"), ("circle", "Back")] if len(self.buttons) > 1 else [("cross", "OK")]


def draw_luxe_card(c, w, h, appear):
    """A centered card in the luxe look over the dimmed screen: near black, a soft glow of the
    accent behind it and a thin accent edge. Returns its top left."""
    a = ease_out(appear)
    c.dim(175 * a)
    x, y = ui.W / 2 - w / 2, ui.H / 2 - h / 2 + (1 - a) * 14
    glow = glow_sprite(px(w * 0.55), ui.mix((0, 0, 0), ui.ACCENT, 0.55))
    c.s.blit(glow, glow.get_rect(center=(px(ui.W / 2), px(y + h / 2))), special_flags=pygame.BLEND_RGB_ADD)
    c.rect(LUXE_CARD, x, y, w, h, 22)
    c.rect(luxe_line(), x, y, w, h, 22, 1)
    return x, y


def draw_luxe_button(c, label, x, y, w, h, on):
    """A pill button: the accent filled when focused, else dark with a thin accent edge."""
    if on:
        c.rect(ui.ACCENT, x, y, w, h, h / 2)
    else:
        c.rect(LUXE_INK + (170,), x, y, w, h, h / 2)
        c.rect(luxe_line(), x, y, w, h, h / 2, 1)
    c.text(c.t.fit(label, 18, w - 24, on), 18, x + w / 2, y + h / 2, LUXE_INK if on else WHITE, on, "center")


def draw_spinner(c, x, y, r, t):
    """A ring with an accent arc running round it."""
    c.circle(luxe_line(), x, y, r, 3)
    start = -(t * 4.0) % (2 * math.pi)
    c.arc(ui.ACCENT, x - r, y - r, 2 * r, 2 * r, start, start + 1.9, 4)


class Busy(Modal):
    """Runs `work` (returning (ok, message)) in the background, then shows the message, or calls
    after(ok, message)."""

    def __init__(self, home, text, work, after=None):
        super().__init__(home)
        self.text = text
        self.result = None
        self.after = after

        def run():
            try:
                result = work()
            except Exception as error:
                result = (False, str(error))
            if not isinstance(result, tuple):
                result = (bool(result), "")
            self.result = result

        threading.Thread(target=run, daemon=True).start()

    def update(self, dt):
        super().update(dt)
        if self.result is not None and not self.closed:
            self.close()
            ok, message = self.result
            self.home.sounds.play("select" if ok else "error")
            if self.after:
                self.after(ok, message)
            elif message:
                self.home.push(Dialog(self.home, message))

    def draw(self, c):
        box_w = 600
        lines = c.t.wrap(self.text, 20, box_w - 150, True)[:2]
        block = 22 + 28 * len(lines)
        box_h = block + 64
        x, y = draw_luxe_card(c, box_w, box_h, self.appear)
        draw_spinner(c, x + 66, y + box_h / 2, 22, self.home.t)
        top = y + (box_h - block) / 2
        c.text(i18n.translate("Please wait").upper(), 12, x + 116, top, ui.ACCENT, True)
        for n, line in enumerate(lines):
            c.text(line, 20, x + 116, top + 20 + n * 28, WHITE, True)

    def hints(self):
        return [(None, "Please wait")]


class UpdateProgress(Modal):
    """An EmuFive update or roll back (bin/ps5-update, started by ps5-admin as root): its progress,
    then what comes next: the home screen starts again, or the PS4 restarts (Now or Later)."""

    BUSY = ("checking", "downloading", "installing", "testing", "restoring")

    def __init__(self, home, action, category):
        super().__init__(home)
        self.action = action          # update or rollback
        self.category = category
        self.started = time.time()
        self.status = {}
        self.next_read = 0.0
        self.launch = None

        def run():
            ok, message = system.update_admin(action)
            self.launch = (ok, message)

        threading.Thread(target=run, daemon=True).start()

    def act(self, action):
        pass                          # It cannot be stopped halfway.

    def update(self, dt):
        super().update(dt)
        if self.closed:
            return
        h = self.home
        if self.launch is not None and not self.launch[0]:
            self.finish_with(Dialog(h, self.launch[1] or "The update did not start."))
            return
        if h.t < self.next_read:
            return
        self.next_read = h.t + 0.3
        status = update.status()
        if status.get("time", 0) < self.started - 1:
            if time.time() - self.started > 20:
                self.finish_with(Dialog(h, "The update did not start."))
            return
        self.status = status
        state = status.get("state")
        if state == "failed":
            h.sounds.play("error")
            message = status.get("message") or "The update could not be installed."
            if self.action == "update":
                message += " Nothing was changed."
            self.finish_with(Dialog(h, message))
        elif state == "done":
            h.sounds.play("select")
            version = status.get("version", "")
            if status.get("latest"):
                self.finish_with(Dialog(h, "EmuFive is up to date."))
                h.poll.forget("update_check")
                return
            text = (f"Rolled back to EmuFive {version}." if self.action == "rollback"
                    else f"EmuFive {version} is installed.")
            reload = lambda: h.request_reload(self.category)      # noqa: E731
            if status.get("restart"):
                self.finish_with(Dialog(h, text + " Restart the PS4 now to finish?",
                                        [("Restart now", lambda: h.finish("REBOOT")), ("Later", reload)]))
            else:
                self.finish_with(Dialog(h, text, [("OK", reload)]))

    def finish_with(self, dialog):
        self.close()
        self.home.push(dialog)

    def draw(self, c):
        c.dim(170 * ease_out(self.appear))
        st = self.status
        state, version = st.get("state", "checking"), st.get("version", "")
        if self.action == "rollback":
            text = f"Rolling back to EmuFive {version}…" if version else "Rolling back…"
        elif state == "downloading":
            text = f"Downloading EmuFive {version}…"
        elif state == "installing":
            text = f"Installing EmuFive {version}…"
        elif state == "testing":
            text = "Testing the new version…"
        elif state == "restoring":
            text = "Putting the old files back…"
        else:
            text = "Checking for updates…"
        accent, line = ui.ACCENT, luxe_line()
        box_w, box_h = 720, 300
        x, y = draw_luxe_card(c, box_w, box_h, self.appear)
        x0 = x + 50
        # The EmuFive mark: the spinner while it works.
        draw_spinner(c, x0 + 26, y + 66, 26, self.home.t)
        label = "Roll back" if self.action == "rollback" else "System update"
        c.text(i18n.translate(label).upper(), 13, x0 + 76, y + 40, accent, True)
        c.text(c.t.fit(text, 24, box_w - 160, True), 24, x0 + 76, y + 60, WHITE, True)
        if st.get("count", 1) > 1:
            c.text(f"Update {st.get('index', 1)} of {st.get('count')}", 14, x + box_w - 50, y + 42, SOFT, False,
                   "topright")
        # The steps, the current one lit.
        steps = (["checking", "downloading", "installing", "testing"] if self.action != "rollback"
                 else ["restoring"])
        names = {"checking": "Check", "downloading": "Download", "installing": "Install", "testing": "Test",
                 "restoring": "Restore"}
        now = steps.index(state) if state in steps else (len(steps) - 1 if state == "restoring" else 0)
        if len(steps) > 1:
            sx, sw = x0, (box_w - 100) / (len(steps) - 1)
            sy = y + 146
            c.line(line, sx, sy, sx + sw * (len(steps) - 1), sy, 2)
            c.line(accent, sx, sy, sx + sw * now, sy, 2)
            for i, step in enumerate(steps):
                px_ = sx + i * sw
                done, current = i < now, i == now
                c.circle(LUXE_CARD, px_, sy, 11)
                c.circle(accent if (done or current) else line, px_, sy, 8 if current else 6, 0 if done or current else 2)
                if current:
                    c.circle(accent, px_, sy, 13, 1)
                anchor = "midtop" if 0 < i < len(steps) - 1 else ("topleft" if i == 0 else "topright")
                tx = px_ - 8 if i == 0 else px_ + 8 if i == len(steps) - 1 else px_
                c.text(i18n.translate(names[step]), 14, tx, sy + 20, WHITE if current else SOFT, current, anchor)
        # The bar.
        bar_x, bar_y, bar_w = x0, y + 226, box_w - 100
        c.rect(line, bar_x, bar_y, bar_w, 6, 3)
        if state == "downloading":
            part = max(0.0, min(1.0, st.get("percent", 0) / 100))
            if part > 0:
                c.rect(accent, bar_x, bar_y, max(6, bar_w * part), 6, 3)
            c.text(f"{st.get('percent', 0)}%", 15, bar_x + bar_w, bar_y + 16, WHITE, True, "topright")
        else:
            # Moving: a short light that runs along the bar.
            run = (self.home.t * 0.6) % 1.0
            c.rect(accent, bar_x + (bar_w - 140) * run, bar_y, 140, 6, 3)
        c.text("Do not turn off the PS4.", 14, bar_x, bar_y + 16, SOFT)

    def hints(self):
        return [(None, "Please wait")]


class KeyboardDialog(Modal):
    """Types one text. on_done(text) returns None to close, or an error to show."""

    def __init__(self, home, title, text="", secret=False, on_done=None, max_length=128, done_label="Done"):
        super().__init__(home)
        self.kb = ui.Keyboard(title, text, secret, done_label, max_length)
        self.on_done = on_done
        home.input.typed.clear()

    def typed(self, chunk):
        self.kb.type(chunk)

    def act(self, action):
        result = self.kb.act(action, self.home.sounds)
        if result == "cancel":
            self.close()
        elif result == "done":
            error = self.on_done(self.kb.text) if self.on_done else None
            if error:
                self.home.sounds.play("error")
                self.kb.status, self.kb.status_good = error, False
            else:
                self.home.sounds.play("select")
                self.close()

    def draw(self, c):
        w = 660
        x, y = draw_luxe_card(c, w, 470, self.appear)
        c.rect(ui.ACCENT, x + 40, y + 20, 36, 3, 1)
        self.kb.draw(c, x + 50, y + 40, w - 100, self.home.t)

    def hints(self):
        return [("cross", "Type"), ("square", "Delete"), ("triangle", "Symbols"), ("l1", "Space"),
                ("r1", "Shift"), ("options", self.kb.done_label), ("circle", "Back")]


class Picker(Modal):
    """Choose one from a list: items [(label, value)]; on_pick(value)."""
    ROWS = 9

    def __init__(self, home, title, items, current=None, on_pick=None, subtitle=None):
        super().__init__(home)
        self.title = title
        self.subtitle = subtitle
        self.items = items or [("(none)", None)]
        self.on_pick = on_pick
        self.selected = next((i for i, (_, v) in enumerate(self.items) if v == current), 0)
        self.top = max(0, self.selected - 4)

    def act(self, action):
        h = self.home
        step = {UP: -1, DOWN: 1, PAGE_UP: -8, PAGE_DOWN: 8}.get(action)
        if step:
            new = max(0, min(len(self.items) - 1, self.selected + step))
            if new != self.selected:
                self.selected = new
                h.sounds.play("move")
        elif action == OK:
            h.sounds.play("select")
            self.close()
            if self.on_pick:
                self.on_pick(self.items[self.selected][1])
        elif action == BACK:
            h.sounds.play("back")
            self.close()

    def draw(self, c):
        w, rows = 600, self.ROWS
        x, y = draw_luxe_card(c, w, 610, self.appear)
        rtl = i18n.rtl()
        tx, anchor = (x + w - 36, "topright") if rtl else (x + 36, "topleft")
        c.rect(ui.ACCENT, tx - (36 if rtl else 0), y + 20, 36, 3, 1)
        c.text(self.title, 24, tx, y + 30, WHITE, True, anchor)
        ly = y + 80
        if self.subtitle:
            c.text(self.subtitle, 15, tx, y + 64, DIM, False, anchor)
            ly += 14
        if self.selected < self.top:
            self.top = self.selected
        if self.selected >= self.top + rows:
            self.top = self.selected - rows + 1
        for i in range(self.top, min(len(self.items), self.top + rows)):
            on = i == self.selected
            if on:
                c.rect(ui.ACCENT + (30,), x + 22, ly, w - 44, 50, 8)
                c.rect(ui.ACCENT, x + w - 25 if rtl else x + 22, ly + 8, 3, 34, 1)
            c.text(c.t.fit(self.items[i][0], 19, w - 90), 19, x + w - 40 if rtl else x + 40, ly + 13,
                   WHITE if on else SOFT, on, "topright" if rtl else "topleft")
            ly += 56
        if len(self.items) > rows:
            bar_h = 500 * rows / len(self.items)
            bar_y = y + 80 + (500 - bar_h) * self.top / max(1, len(self.items) - rows)
            c.rect(ui.ACCENT, x + w - 14, bar_y, 3, bar_h, 2)

    def hints(self):
        return [("cross", "Select"), ("l1r1", "Page"), ("circle", "Back")]


# --------------------------------------------------------------------------------------------
# Wi-Fi panel (from the top bar or Settings).

class WifiPanel(Modal):
    WIDTH = 520

    def __init__(self, home):
        super().__init__(home)
        self.selected = 0
        self.status = ""
        self.connecting = None
        home.network.scan()

    def networks(self):
        with self.home.network.lock:
            return list(self.home.network.networks)

    def act(self, action):
        h = self.home
        if self.connecting:
            return
        networks = self.networks()
        if action == BACK:
            h.sounds.play("back")
            self.close()
        elif action == UP and self.selected > 0:
            self.selected -= 1
            h.sounds.play("move")
        elif action == DOWN and self.selected < len(networks) - 1:
            self.selected += 1
            h.sounds.play("move")
        elif action == TRIANGLE:
            h.sounds.play("select")
            h.network.scan()
        elif action == SQUARE and networks:
            ssid = networks[min(self.selected, len(networks) - 1)][0]
            if h.network.is_saved(ssid):
                h.push(Dialog(h, f"Forget {ssid}? Its password will be asked again next time.",
                              [("Forget", lambda: self.forget(ssid)), ("Cancel", None)]))
        elif action == OK and networks:
            ssid, _, secured, in_use = networks[min(self.selected, len(networks) - 1)]
            if in_use:
                self.status = f"Already connected to {ssid}."
                return
            h.sounds.play("select")
            if not secured or h.network.is_saved(ssid):
                self.start(ssid, None)
            else:
                self.ask_password(ssid)

    def ask_password(self, ssid):
        self.home.push(KeyboardDialog(self.home, f"Password for {ssid}", secret=True, done_label="Connect",
                                      on_done=lambda text: self.password(ssid, text), max_length=63))

    def password(self, ssid, text):
        if len(text) < 8:
            return "A Wi-Fi password has at least 8 characters."
        self.start(ssid, text)
        return None

    def forget(self, ssid):
        ok, err = self.home.network.forget(ssid)
        self.status = f"{ssid} forgotten." if ok else (err or f"Could not forget {ssid}.")

    def start(self, ssid, password):
        self.connecting = ssid
        self.status = ""
        self.home.network.connect(ssid, password)

    def update(self, dt):
        super().update(dt)
        try:
            ok, message = self.home.network.results.get_nowait()
        except queue.Empty:
            return
        ssid = self.connecting
        self.connecting = None
        if ok:
            self.home.sounds.play("select")
            self.home.toast(message)
            self.close()
        else:
            self.home.sounds.play("error")
            self.status = message
            if ssid and "password" in message.lower():
                self.ask_password(ssid)

    def draw(self, c):
        h = self.home
        width = self.WIDTH
        slide = ease_out(self.appear)
        left = ui.W - width * slide
        c.dim(150 * slide)
        c.rect(PANEL, left, 0, width, ui.H)
        c.line(PANEL_LINE, left, 0, left, ui.H, 1)
        x = left + 40
        c.text("Wi-Fi", 30, x, 40, WHITE, True)
        with h.network.lock:
            state, ssid = h.network.state, h.network.ssid
        status = f"Connected to {ssid}" if state == "connected" else \
            "Connecting…" if state == "connecting" else "Not connected"
        if state == "unavailable":
            status = "No Wi-Fi device found"
        c.text(status, 16, x, 84, SOFT)
        networks = self.networks()
        y = 130
        if h.network.scanning and not networks:
            c.text("Searching for networks…", 18, x, y + 10, SOFT)
        elif not networks:
            c.text("No networks found.", 18, x, y + 10, SOFT)
        first = max(0, self.selected - 7)
        for i, (name, strength, secured, in_use) in enumerate(networks[first:first + 9], start=first):
            rx, rw = x - 14, width - 52
            on = i == self.selected
            if on:
                c.rect(WHITE, rx, y, rw, 52, 12)
            ink = INK if on else WHITE
            bars = 3 if strength >= 67 else 2 if strength >= 34 else 1
            ui.draw_wifi(c, rx + 26, y + 36, ink, bars + 1)
            c.text(c.t.fit(name, 18, rw - 140, in_use), 18, rx + 56, y + 8, ink, in_use or on)
            saved = h.network.is_saved(name)
            detail = "Connected" if in_use else ("Saved" if saved else ("Secured" if secured else "Open"))
            c.text(detail, 13, rx + 56, y + 31, ui.mix(INK, WHITE, 0.4) if on else GOOD if (in_use or saved) else SOFT)
            if secured:
                ui.draw_lock(c, rx + rw - 30, y + 22, ink if on else SOFT)
            y += 58
        if self.connecting:
            dots = "." * (1 + int(h.t * 3) % 3)
            c.text(f"Connecting to {self.connecting}{dots}", 17, x, ui.H - 96, WHITE)
        elif self.status:
            for n, line in enumerate(c.t.wrap(self.status, 16, width - 80)[:2]):
                c.text(line, 16, x, ui.H - 104 + n * 22, BAD)

    def hints(self):
        networks = self.networks()
        hints = [("cross", "Connect"), ("triangle", "Search again")]
        if networks and self.home.network.is_saved(networks[min(self.selected, len(networks) - 1)][0]):
            hints.append(("square", "Forget"))
        return hints + [("circle", "Back")]


# --------------------------------------------------------------------------------------------
# Rows: the lines of Settings, the quick menu and a game's menu.

class Row:
    """kind: header, info, button, action, toggle, slider, choice."""

    def __init__(self, kind, label, value=None, ok=None, left=None, right=None, color=None, picture=None):
        self.kind = kind
        self.label = label
        self.value = value
        self.ok = ok
        self.left = left
        self.right = right
        self.color = color
        self.picture = picture     # A surface shown at the right (an avatar).

    @property
    def selectable(self):
        return self.kind not in ("header", "info")

    def height(self):
        return 34 if self.kind == "header" else 56 if self.kind == "action" else 46


def draw_rows(c, rows, selected, x, y, width, bottom, focused, top_index=0):
    """With a right-to-left menu language (Arabic) the labels are on the right and the values and
    switches on the left."""
    rtl = i18n.rtl()
    for i in range(top_index, len(rows)):
        row = rows[i]
        height = row.height()
        if y + height > bottom:
            break
        on = focused and i == selected
        if row.kind == "header":
            if rtl:
                c.text(row.label, 13, x + width, y + 12, ui.ACCENT, True, "topright")
            else:
                c.text(i18n.upper(row.label), 13, x, y + 12, ui.ACCENT, True)
        elif row.kind == "action":
            label_w = max(200, c.t.width(row.label, 18, True) + 60)
            bx = x + width - label_w + 4 if rtl else x - 4
            if on:
                c.rect(ui.ACCENT, bx, y + 4, label_w, 46, 23)
            else:
                c.rect(LUXE_INK + (170,), bx, y + 4, label_w, 46, 23)
                c.rect(luxe_line() if row.ok is None else ui.ACCENT, bx, y + 4, label_w, 46, 23, 1)
            ink = LUXE_INK if on else SOFT if row.ok is None else WHITE
            c.text(row.label, 18, bx + label_w / 2, y + 27, ink, True, "center")
            if row.value:
                value = c.t.fit(str(row.value), 15, width - label_w - 30)
                if rtl:
                    c.text(value, 15, bx - 16, y + 17, row.color or SOFT, False, "topright")
                else:
                    c.text(value, 15, x + label_w + 16, y + 17, row.color or SOFT)
        else:
            if on:
                c.rect(ui.ACCENT + (30,), x - 14, y, width + 28, 44, 6)
                c.rect(ui.ACCENT, x + width + 11 if rtl else x - 14, y + 7, 3, 30, 1)
            fg = WHITE                                  # Text on the row.
            fg_soft = WHITE if on else SOFT
            if row.kind == "info" and row.value is None:
                # A note: wraps over two lines if needed.
                lines = c.t.wrap(row.label, 15, width)[:2]
                for n, line in enumerate(lines):
                    c.text(line, 15, x + width - 2 if rtl else x + 2, y + (13 if len(lines) == 1 else 3 + n * 20),
                           row.color or DIM, False, "topright" if rtl else "topleft")
                y += height + 4
                continue
            label_color = fg if row.kind != "info" else SOFT
            label = c.t.fit(row.label, 17, width * 0.55)
            if rtl:
                label_w = c.text(label, 17, x + width - 2, y + 11, label_color, on, "topright")
            else:
                label_w = c.text(label, 17, x + 2, y + 11, label_color, on)
            room = width - label_w - 30
            if rtl:
                draw_row_value_rtl(c, row, on, x + 2, y, room, fg_soft)
                y += height + 4
                continue
            rx = x + width - 2
            if row.kind == "toggle":
                on_value = bool(row.value)
                c.rect(GOOD if on_value else (KEY if not on else ui.mix(KEY, WHITE, 0.25)), rx - 50, y + 10, 50, 24, 12)
                c.circle((255, 255, 255), rx - 12 if on_value else rx - 38, y + 22, 9)
            elif row.kind == "slider":
                value = row.value if row.value is not None else 0
                bar_w = max(60, min(220, room - 70))
                track = ui.mix(KEY, WHITE, 0.25) if on else KEY
                c.rect(track, rx - bar_w - 56, y + 19, bar_w, 6, 3)
                c.rect(ui.ACCENT, rx - bar_w - 56, y + 19, max(1, bar_w * value / 100), 6, 3)
                c.circle(WHITE, rx - bar_w - 56 + bar_w * value / 100, y + 22, 8)
                c.text(f"{value}%", 16, rx, y + 12, fg_soft, False, "topright")
            elif row.kind == "choice":
                text = c.t.fit(str(row.value), 16, room - 40)
                c.text(text, 16, rx - 20, y + 12, fg_soft, on, "topright")
                if on:
                    tw = c.t.width(text, 16, True)
                    c.text("‹", 20, rx - 32 - tw, y + 8, ui.ACCENT, True, "topright")
                    c.text("›", 20, rx, y + 8, ui.ACCENT, True, "topright")
            elif row.picture is not None:
                c.blit(row.picture, rx, y + 22, "midright")
            elif row.value is not None:
                text = c.t.fit(str(row.value), 16, room)
                c.text(text, 16, rx, y + 12, fg_soft if on else row.color or (SOFT if row.kind != "info" else WHITE),
                       False, "topright")
        y += height + 4
    return y


def draw_row_value_rtl(c, row, on, lx, y, room, fg_soft):
    """The value or switch of a row at its left end (right-to-left menus)."""
    if row.kind == "toggle":
        on_value = bool(row.value)
        c.rect(GOOD if on_value else (KEY if not on else ui.mix(KEY, WHITE, 0.25)), lx, y + 10, 50, 24, 12)
        c.circle((255, 255, 255), lx + 38 if on_value else lx + 12, y + 22, 9)
    elif row.kind == "slider":
        value = row.value if row.value is not None else 0
        bar_w = max(60, min(220, room - 70))
        track = ui.mix(KEY, WHITE, 0.25) if on else KEY
        c.text(f"{value}%", 16, lx, y + 12, fg_soft)
        c.rect(track, lx + 56, y + 19, bar_w, 6, 3)
        c.rect(ui.ACCENT, lx + 56, y + 19, max(1, bar_w * value / 100), 6, 3)
        c.circle(WHITE, lx + 56 + bar_w * value / 100, y + 22, 8)
    elif row.kind == "choice":
        text = c.t.fit(str(row.value), 16, room - 40)
        c.text(text, 16, lx + 20, y + 12, fg_soft, on)
        if on:
            tw = c.t.width(text, 16, True)
            c.text("‹", 20, lx, y + 8, ui.ACCENT, True)
            c.text("›", 20, lx + 32 + tw, y + 8, ui.ACCENT, True)
    elif row.picture is not None:
        c.blit(row.picture, lx, y + 22, "midleft")
    elif row.value is not None:
        text = c.t.fit(str(row.value), 16, room)
        c.text(text, 16, lx, y + 12, fg_soft if on else row.color or (SOFT if row.kind != "info" else WHITE))


# Settings rows as floating glass cards (Settings design "floating cards").

CARD_GAP = 10


def card_height(row):
    if row.kind == "header":
        return 34
    if row.kind == "info" and row.value is None:
        return 46
    return 56 if row.kind == "action" else 60


def draw_card_rows(c, rows, selected, x, y, width, bottom, focused, top_index, accent, home):
    """Rows as glass cards; the chosen one tinted and edged in `accent`."""
    rtl = i18n.rtl()
    for i in range(top_index, len(rows)):
        row = rows[i]
        height = card_height(row)
        if y + height > bottom:
            break
        on = focused and i == selected
        if row.kind == "header":
            if rtl:
                c.text(row.label, 13, x + width, y + 14, accent, True, "topright")
            else:
                c.text(i18n.upper(row.label), 13, x, y + 14, accent, True)
        elif row.kind == "info" and row.value is None:
            lines = c.t.wrap(row.label, 15, width)[:2]
            for n, line in enumerate(lines):
                c.text(line, 15, x + width - 2 if rtl else x + 2, y + (14 if len(lines) == 1 else 4 + n * 20),
                       row.color or SOFT, False, "topright" if rtl else "topleft")
        elif row.kind == "action":
            label_w = max(220, c.t.width(row.label, 18, True) + 64)
            bx = x + width - label_w if rtl else x
            if on:
                home.play_button(c, bx, y + 6, row.label, accent, True, label_w)
            else:
                c.rect(WHITE + (26 if row.ok else 12,), bx, y + 6, label_w, 44, 22)
                c.rect(WHITE + (70,), bx, y + 6, label_w, 44, 22, 1)
                c.text(row.label, 18, bx + label_w / 2, y + 28, WHITE if row.ok else SOFT, True, "center")
            if row.value:
                value = c.t.fit(str(row.value), 15, width - label_w - 30)
                if rtl:
                    c.text(value, 15, bx - 16, y + 19, row.color or SOFT, False, "topright")
                else:
                    c.text(value, 15, x + label_w + 16, y + 19, row.color or SOFT)
        else:
            card_h = height - 2
            c.rect(accent + (34,) if on else WHITE + (10,), x - 18, y, width + 36, card_h, 14)
            if on:
                border = gradient_border(px(width + 36), px(card_h), px(14), ui.mix(accent, WHITE, 0.45), accent,
                                         max(1, px(1.5)))
                c.s.blit(border, (px(x - 18), px(y)))
                c.rect(accent, x + width + 15 if rtl else x - 18, y + 12, 3, card_h - 24, 1)
            dy = (card_h - 44) / 2
            draw_card_content(c, row, on, x, y + dy, width, accent, rtl, home)
        y += height + CARD_GAP
    return y


def draw_card_content(c, row, on, x, y, width, accent, rtl, home):
    label_color = WHITE if row.kind != "info" else SOFT
    label = c.t.fit(row.label, 17, width * 0.55)
    if rtl:
        label_w = c.text(label, 17, x + width - 2, y + 11, label_color, on, "topright")
    else:
        label_w = c.text(label, 17, x + 2, y + 11, label_color, on)
    room = width - label_w - 30
    if row.kind == "choice" and row.label == "Accent color":
        current = home.settings["accent"]
        keys = list(ui.ACCENTS)
        for n, key in enumerate(keys):
            cx = (x + 20 + n * 30) if rtl else (x + width - 20 - (len(keys) - 1 - n) * 30)
            c.circle(ui.ACCENTS[key][1], cx, y + 22, 10)
            if key == current:
                c.circle(WHITE, cx, y + 22, 14, 2)
        return
    if rtl:
        draw_row_value_rtl(c, row, on, x + 2, y, room, SOFT)
        return
    rx = x + width - 2
    if row.kind == "toggle":
        on_value = bool(row.value)
        c.rect(accent if on_value else WHITE + (50,), rx - 50, y + 10, 50, 24, 12)
        c.circle((255, 255, 255), rx - 12 if on_value else rx - 38, y + 22, 9)
    elif row.kind == "slider":
        value = row.value if row.value is not None else 0
        bar_w = max(60, min(220, room - 70))
        c.rect(WHITE + (50,), rx - bar_w - 56, y + 19, bar_w, 6, 3)
        c.rect(accent, rx - bar_w - 56, y + 19, max(1, bar_w * value / 100), 6, 3)
        c.circle((255, 255, 255), rx - bar_w - 56 + bar_w * value / 100, y + 22, 9)
        c.text(f"{value}%", 16, rx, y + 12, SOFT, False, "topright")
    elif row.kind == "choice":
        text = c.t.fit(str(row.value), 16, room - 40)
        c.text(text, 16, rx - 20, y + 12, WHITE if on else SOFT, on, "topright")
        if on:
            tw = c.t.width(text, 16, True)
            c.text("‹", 20, rx - 32 - tw, y + 8, accent, True, "topright")
            c.text("›", 20, rx, y + 8, accent, True, "topright")
    elif row.picture is not None:
        c.blit(row.picture, rx, y + 22, "midright")
    elif row.value is not None:
        text = c.t.fit(str(row.value), 16, room)
        c.text(text, 16, rx, y + 12, row.color or (SOFT if row.kind != "info" else WHITE), False, "topright")


def category_icon(c, name, x, y, color, r=11):
    """A small drawn icon for a Settings category."""
    if name == "Profile":
        c.circle(color, x, y - r * 0.35, r * 0.42, 2)
        c.arc(color, x - r * 0.8, y + r * 0.15, r * 1.6, r * 1.4, 0.1, 3.04, 2)
    elif name == "Appearance":
        c.circle(color, x, y, r, 2)
        for dx, dy in ((-0.4, -0.3), (0.35, -0.35), (0.0, 0.42)):
            c.circle(color, x + dx * r, y + dy * r, r * 0.17)
    elif name == "Network":
        ui.draw_wifi(c, x, y + r * 0.6, color, 3)
    elif name == "Games from PC":
        c.rect(color, x - r, y - r * 0.75, r * 2, r * 1.35, 3, 2)
        c.line(color, x - r * 0.45, y + r * 0.95, x + r * 0.45, y + r * 0.95, 2)
    elif name == "Sound":
        c.polygon(color, [(x - r, y - r * 0.35), (x - r * 0.45, y - r * 0.35), (x + r * 0.1, y - r * 0.85),
                          (x + r * 0.1, y + r * 0.85), (x - r * 0.45, y + r * 0.35), (x - r, y + r * 0.35)])
        c.arc(color, x - r * 0.2, y - r * 0.6, r * 1.2, r * 1.2, -1.0, 1.0, 2)
    elif name == "Controllers":
        ui.draw_pad(c, x, y, color)
    elif name == "Storage":
        c.rect(color, x - r, y - r * 0.8, r * 2, r * 1.6, 4, 2)
        c.line(color, x - r, y, x + r, y, 2)
        c.circle(color, x + r * 0.55, y + r * 0.42, 2)
    elif name == "Games":
        for dx in (-1, 1):
            for dy in (-1, 1):
                c.rect(color, x + dx * r * 0.5 - r * 0.38, y + dy * r * 0.5 - r * 0.38, r * 0.76, r * 0.76, 2, 2)
    elif name == "Saves":
        c.rect(color, x - r * 0.85, y - r * 0.85, r * 1.7, r * 1.7, 3, 2)
        c.rect(color, x - r * 0.4, y - r * 0.85, r * 0.8, r * 0.6, 1, 2)
    elif name == "Power":
        ui.draw_power(c, x, y, r * 0.85, color, 2)
    elif name == "Date and time":
        c.circle(color, x, y, r, 2)
        c.line(color, x, y, x, y - r * 0.6, 2)
        c.line(color, x, y, x + r * 0.45, y + r * 0.2, 2)
    elif name == "System":
        c.rect(color, x - r * 0.65, y - r * 0.65, r * 1.3, r * 1.3, 3, 2)
        for k in (-0.35, 0.35):
            c.line(color, x + k * r, y - r, x + k * r, y - r * 0.65, 2)
            c.line(color, x + k * r, y + r * 0.65, x + k * r, y + r, 2)
    elif name == "Advanced":
        ui.draw_gear(c, x, y, color, r * 0.8)
    else:   # About
        c.circle(color, x, y, r, 2)
        c.circle(color, x, y - r * 0.4, 1.6)
        c.line(color, x, y - r * 0.1, x, y + r * 0.5, 2)


def move_selection(rows, selected, step):
    """The next selectable row from `selected` in the direction of `step`, or `selected`."""
    i = selected
    while True:
        i += step
        if i < 0 or i >= len(rows):
            return selected
        if rows[i].selectable:
            return i


def first_selectable(rows):
    return next((i for i, r in enumerate(rows) if r.selectable), 0)


class RowList(Modal):
    """A modal made of rows: keeps the selection on selectable rows and handles moving."""

    def __init__(self, home):
        super().__init__(home)
        self.row = 0
        self.top = 0
        self.chosen = None       # (row, label) last seen: the selection follows its row when rows
                                 # above it come or go (a status that changes).

    def scroll(self, rows, y, bottom):
        """The first row to draw from `y`, so the chosen row fits above `bottom` (rows that do not fit
        are reached by scrolling). On the last choice, the notes after it show too."""
        last = self.row
        if not any(r.selectable for r in rows[self.row + 1:]):
            last = len(rows) - 1
        top = min(self.top, self.row)
        while top < self.row and y + sum(rows[i].height() + 4 for i in range(top, last + 1)) > bottom:
            top += 1
        self.top = top
        return top

    def rows(self):
        return []

    def current(self, rows):
        if self.chosen and self.chosen[0] == self.row and (
                self.row >= len(rows) or rows[self.row].label != self.chosen[1]):
            same = [i for i, r in enumerate(rows) if r.selectable and r.label == self.chosen[1]]
            if same:
                self.row = min(same, key=lambda i: abs(i - self.row))
        if self.row >= len(rows) or not rows[self.row].selectable:
            self.row = first_selectable(rows)
        self.chosen = (self.row, rows[self.row].label) if rows else None
        return rows[self.row] if rows else None

    def act_rows(self, action):
        """Moves and runs rows; returns True when the action was used."""
        h = self.home
        rows = self.rows()
        row = self.current(rows)
        if action in (UP, DOWN, PAGE_UP, PAGE_DOWN):
            step = -1 if action in (UP, PAGE_UP) else 1
            new = self.row
            for _ in range(1 if action in (UP, DOWN) else 5):
                new = move_selection(rows, new, step)
            if new != self.row:
                self.row = new
                h.sounds.play("move")
            return True
        if action == LEFT and row is not None and row.left:
            row.left()
            return True
        if action == RIGHT and row is not None and row.right:
            row.right()
            return True
        if action == OK:
            if row is not None and row.ok:
                h.sounds.play("select")
                row.ok()
            else:
                h.sounds.play("error")
            return True
        return False


# --------------------------------------------------------------------------------------------
# Settings (full screen): categories on the left, their settings on the right.

class SettingsScreen(RowList):
    covers = True
    CATEGORIES = ["Profile", "Appearance", "Network", "Games from PC", "Sound", "Controllers", "Storage",
                  "Games", "Saves", "Power", "Date and time", "System", "Advanced", "About"]
    category_step = 38

    def __init__(self, home, category=0, focus="categories"):
        super().__init__(home)
        self.category = category
        self.focus = focus
        self.top = 0
        self.update_checking = False

    # Rows of each category ------------------------------------------------------------------

    def rows(self):
        name = self.CATEGORIES[self.category]
        return getattr(self, "rows_" + name.lower().replace(" ", "_"))()

    def rows_profile(self):
        h = self.home
        profiles = h.profiles.all()
        rows = [
            Row("button", "Name", h.settings["name"], ok=self.edit_name),
            Row("button", "Avatar", ok=lambda: h.push(AvatarPicker(h)), picture=h.avatar(36, still=True)),
            Row("info", "Your name and avatar are shown on the home screen. Games get your name as the "
                        "player name."),
            Row("header", "Profiles"),
        ]
        if len(profiles) > 1:
            rows.append(Row("action", "Switch profile", ok=lambda: h.push(ProfilePicker(h))))
        rows.append(Row("action", "Add a profile", ok=lambda: add_profile(h)) if len(profiles) < store.MAX_PROFILES
                    else Row("info", "Up to 8 profiles."))
        if len(profiles) > 1:
            rows.append(Row("action", "Delete this profile", ok=self.delete_profile))
        rows.append(Row("info", "Each profile has its own saves, trophies and play time."))
        return rows

    def delete_profile(self):
        h = self.home
        current = h.profiles.current()

        def delete():
            h.profiles.remove(current["id"], h.settings)
            h.switch_profile(h.profiles.current_id)
            h.toast(f"{current['name']} deleted.")

        h.push(Dialog(h, f"Delete {current['name']}? Their saves, trophies and play time are deleted.",
                      [("Delete", delete), ("Cancel", None)]))

    def edit_name(self):
        h = self.home

        def done(text):
            text = text.strip()
            if not text:
                return "Type a name."
            h.set_profile(name=text)
            return None

        h.push(KeyboardDialog(h, "Your name (up to 16 letters)", h.settings["name"], on_done=done, max_length=16))

    # Appearance ------------------------------------------------------------------------------

    def setting_choice(self, label, key, options, reload=False, after=None):
        """A row that cycles through options [(value, text)] with Left/Right, or picks with X."""
        h = self.home
        values = [v for v, _ in options]
        current = h.settings[key]
        text = dict(options).get(current, str(current))

        def set_value(value):
            if value is None or value == h.settings[key]:
                return
            h.settings.set(**{key: value})
            h.sounds.play("move")
            if after:
                after()
            if reload:
                h.request_reload(self.category)

        def step(n):
            index = values.index(current) if current in values else 0
            set_value(values[(index + n) % len(values)])

        return Row("choice", label, text, ok=lambda: h.push(Picker(h, label, [(t, v) for v, t in options], current,
                                                                   set_value)),
                   left=lambda: step(-1), right=lambda: step(1))

    def setting_toggle(self, label, key, after=None):
        h = self.home

        def flip():
            h.settings.set(**{key: not h.settings[key]})
            if after:
                after()

        return Row("toggle", label, h.settings[key], ok=flip)

    def setting_slider(self, label, key, step, low=0, high=100, after=None):
        h = self.home

        def change(n):
            value = max(low, min(high, h.settings[key] + n))
            if value != h.settings[key]:
                h.settings.set(**{key: value})
                h.sounds.play("move")
                if after:
                    after()

        return Row("slider", label, int(round((h.settings[key] - low) * 100 / max(1, high - low))),
                   left=lambda: change(-step), right=lambda: change(step))

    def rows_appearance(self):
        h = self.home
        return [
            Row("header", "Home screen"),
            self.setting_choice("Layout", "home_layout", [("ps5", "PS5 (tiles at the top)"),
                                                          ("aurora", "Aurora (legacy, card at the right)")], reload=True),
            Row("header", "Colors"),
            self.setting_choice("Accent color", "accent", [(k, v[0]) for k, v in ui.ACCENTS.items()], reload=True),
            self.setting_choice("Theme", "theme", list(ui.THEMES.items()), reload=True),
            Row("header", "Background"),
            Row("choice", "Background", {"art": "The game's own art", "gradient": "Soft gradient",
                                         "solid": "Solid color", "picture": "Your picture"}.get(
                h.settings["background"], "The game's own art"), ok=self.pick_background,
                left=lambda: self.cycle_background(-1), right=lambda: self.cycle_background(1)),
            self.setting_slider("Background dim", "dim", 10, 0, 80),
            Row("header", "Floating orbs"),
            self.setting_toggle("Floating orbs", "orbs"),
            self.setting_choice("Amount", "orb_amount", [("few", "Few"), ("normal", "Normal"), ("many", "Many")],
                                after=h.make_particles),
            self.setting_choice("Speed", "orb_speed", [("slow", "Slow"), ("normal", "Normal"), ("fast", "Fast")]),
            self.setting_choice("Color", "orb_color", [("white", "White"), ("accent", "Accent color"),
                                                        ("gold", "Gold")]),
            Row("header", "Motion"),
            self.setting_choice("Animations", "animations", [("full", "Full"), ("reduced", "Reduced"),
                                                              ("off", "Off")]),
            self.setting_choice("Cover change", "cover_transition",
                                [("fade", "Crossfade"), ("slide", "Slide"), ("zoom", "Zoom"),
                                 ("wipe", "Soft wipe"), ("dark", "Dip to dark"), ("parallax", "Parallax"),
                                 ("blinds", "Blinds"), ("doors", "Doors"), ("push", "Push up"),
                                 ("iris", "Iris"), ("pixelate", "Pixelate")]),
            Row("header", "Game tiles"),
            self.setting_choice("Tile size", "tile_size", [("small", "Small"), ("medium", "Medium"),
                                                            ("large", "Large")], reload=True),
            self.setting_choice("Tile shape", "tile_shape", [("rounded", "Rounded"), ("square", "Square"),
                                                              ("circle", "Circle")]),
            self.setting_toggle("Source labels (USB, PS4, PC)", "tile_badges"),
            self.setting_toggle("Compatibility badges", "show_compat_badges"),
            Row("header", "Text"),
            self.setting_choice("Text size", "text_size", [(v, f"{v}%") for v in (90, 100, 110, 120, 130)],
                                reload=True),
            self.setting_choice("Font", "font", list(ui.FONTS.items()), reload=True),
            Row("header", "Clock"),
            self.setting_toggle("Show the date", "clock_date"),
            self.setting_toggle("Show seconds", "clock_seconds"),
            Row("header", "Top bar"),
            self.setting_toggle("Name", "show_name"),
            self.setting_toggle("Avatar", "show_avatar"),
            self.setting_toggle("Animated avatar", "avatar_motion"),
            self.setting_toggle("Controller battery", "show_battery"),
            self.setting_toggle("IP address", "show_ip"),
            Row("header", "Sounds and feel"),
            self.setting_toggle("Menu sounds", "sounds", after=h.make_sounds),
            self.setting_slider("Menu sound volume", "sound_volume", 10, 0, 100, after=h.make_sounds),
            self.setting_choice("Sound style", "sound_style", list(ui.SOUND_STYLES.items()), after=h.make_sounds),
            self.setting_toggle("Rumble when moving", "rumble", after=h.make_input),
            Row("header", "Screen"),
            self.setting_toggle("Button hints at the bottom", "hints"),
            self.setting_choice("Screen edges (overscan)", "overscan",
                                [(v, "Full screen" if not v else f"{v}% smaller") for v in (0, 2, 4, 6, 8, 10)],
                                reload=True),
            self.setting_choice("Screensaver", "screensaver_minutes",
                                [(0, "Off"), (5, "After 5 minutes"), (10, "After 10 minutes"),
                                 (30, "After 30 minutes")]),
            self.setting_choice("Screensaver style", "screensaver_mode",
                                [("dim", "Dim the screen"), ("slideshow", "Slideshow of your games")]),
        ]

    BACKGROUNDS = ["art", "gradient", "solid", "picture"]

    def cycle_background(self, step):
        h = self.home
        order = ["art", "gradient", "solid"] + (["picture"] if os.path.exists(store.BACKGROUND_FILE) else [])
        current = h.settings["background"]
        index = order.index(current) if current in order else 0
        h.settings.set(background=order[(index + step) % len(order)])
        h.static_bg = None
        h.sounds.play("move")

    def pick_background(self):
        h = self.home
        items = [("The game's own art", "art"), ("Soft gradient", "gradient"), ("Solid color", "solid")]
        if os.path.exists(store.BACKGROUND_FILE):
            items.append(("Your picture (saved)", "picture"))
        items.append(("Choose a picture from the USB drive…", "usb"))

        def chosen(value):
            if value == "usb":
                self.pick_usb_picture()
            elif value:
                h.settings.set(background=value)
                h.static_bg = None

        h.push(Picker(h, "Background", items, h.settings["background"], chosen))

    def pick_usb_picture(self):
        h = self.home
        pictures = []
        for folder in (system.USB_MOUNT, os.path.join(system.USB_MOUNT, "PS5-wallpapers")):
            try:
                for name in sorted(os.listdir(folder), key=str.lower):
                    if name.lower().endswith((".png", ".jpg", ".jpeg")):
                        pictures.append((name, os.path.join(folder, name)))
            except OSError:
                pass
        if not pictures:
            h.push(Dialog(h, "No pictures found. Put a PNG or JPG picture at the top of the USB drive or in a "
                             "PS5-wallpapers folder on it."))
            return

        def use(path):
            if path is None:
                return
            try:
                picture = pygame.image.load(path)
                os.makedirs(store.CONFIG_DIR, exist_ok=True)
                pygame.image.save(picture, store.BACKGROUND_FILE)
            except (pygame.error, OSError):
                h.push(Dialog(h, "That picture could not be read."))
                return
            h.settings.set(background="picture")
            h.static_bg = None
            h.toast("Background changed")

        h.push(Picker(h, "Pictures on the USB drive", pictures, None, use,
                      "It is copied to the PS4, so the USB drive can be unplugged after."))

    def rows_network(self):
        h = self.home
        with h.network.lock:
            state, ssid, ethernet = h.network.state, h.network.ssid, h.network.ethernet
            saved = sorted(h.network.saved_names)
        wifi = ssid if state == "connected" else ("Connecting…" if state == "connecting" else
                                                    "No Wi-Fi device" if state == "unavailable" else "Not connected")
        addresses = h.poll.get("ip", system.ip_addresses, 3.0, [])
        rows = [Row("button", "Wi-Fi", wifi, ok=lambda: h.push(WifiPanel(h))),
                Row("info", "Network cable", {"connected": "Connected", "disconnected": "Not connected"}.get(
                    ethernet, "Not connected"))]
        for interface, address in addresses:
            kind = "Wi-Fi" if interface.startswith(("mlan", "wl")) else \
                "cable" if interface.startswith(("eth", "en")) else interface
            rows.append(Row("info", f"IP address ({kind})", address))
        rows.append(Row("header", "Saved Wi-Fi networks"))
        if not saved:
            rows.append(Row("info", "None yet. Networks you join are remembered."))
        for name in saved:
            rows.append(Row("button", name, "Forget", ok=lambda n=name: h.push(Dialog(
                h, f"Forget {n}? Its password will be asked again next time.",
                [("Forget", lambda: h.network.forget(n)), ("Cancel", None)]))))
        return rows

    def rows_games_from_pc(self):
        h = self.home
        s = h.pc.get()
        state, message, count = h.pc.status()
        status = {"off": "Off", "connecting": "Connecting…",
                  "connected": f"Connected  ·  {count} game" + ("s" if count != 1 else "")}.get(state, message)
        return [
            Row("toggle", "Use games from PC", s["enabled"], ok=self.toggle_pc),
            Row("button", "PC address", s["address"] or "Not set", ok=lambda: self.edit_pc("address", "PC address")),
            Row("button", "Shared folder", s["share"] or "Not set", ok=lambda: self.edit_pc("share", "Shared folder")),
            Row("button", "Username", s["user"] or "None (guest)", ok=lambda: self.edit_pc("user", "Username")),
            Row("button", "Password", "•" * min(12, len(s["password"])) if s["password"] else "None",
                ok=lambda: self.edit_pc("password", "Password", True)),
            Row("action", "Connect", status, ok=self.connect_pc,
                color=GOOD if state == "connected" else BAD if state == "error" else SOFT),
            Row("info", "Windows or Linux (Samba) shares. Leave Username and Password blank for a guest share."),
        ]

    def toggle_pc(self):
        h = self.home
        h.pc.save(enabled=not h.pc.get()["enabled"])
        h.pc.connect()

    def connect_pc(self):
        self.home.pc.save(enabled=True)
        self.home.pc.connect()

    def edit_pc(self, key, title, secret=False):
        h = self.home

        def done(text):
            h.pc.save(**{key: text if key == "password" else text.strip()})
            return None

        h.push(KeyboardDialog(h, title, h.pc.get()[key], secret=secret, on_done=done))

    def rows_sound(self):
        h = self.home
        outputs = h.poll.get("outputs", system.sound_outputs, 2.0, [])
        volume = h.poll.get("volume", system.sound_volume, 2.0)
        current = next((name for _, name, default in outputs if default), "None")
        return [
            Row("choice", "Output", current, ok=lambda: h.push(Picker(
                h, "Sound output", [(name, node) for node, name, _ in outputs],
                next((n for n, _, d in outputs if d), None), self.set_output)),
                left=lambda: self.cycle_output(outputs, -1), right=lambda: self.cycle_output(outputs, 1)),
            Row("slider", "Volume", volume if volume is not None else 0,
                left=lambda: change_volume(h, -5), right=lambda: change_volume(h, 5)),
            Row("action", "Test sound", ok=lambda: h.sounds.play("test")),
            Row("info", "The TV is used first, also when a controller on a cable has its own headphone jack."),
        ] + self.rows_headphones()

    def rows_headphones(self):
        h = self.home
        paired = h.poll.get("headphones", system.headphones, 3.0, [])
        rows = [Row("header", "Bluetooth headphones")]
        if not paired:
            rows.append(Row("info", "None paired yet."))
        for d in paired:
            rows.append(Row("button", d["name"], "Connected" if d["connected"] else "Not connected",
                            ok=lambda d=d: self.headphones_menu(d), color=GOOD if d["connected"] else None))
        rows.append(Row("action", "Pair headphones", ok=self.pair_headphones))
        rows.append(Row("info", "Sound moves to the headphones when they connect, and back to the TV after."))
        return rows

    def after_headphones(self, ok, message):
        h = self.home
        for key in ("headphones", "outputs", "volume"):
            h.poll.forget(key)
        h.push(Dialog(h, message))

    def headphones_menu(self, d):
        h = self.home
        if d["connected"]:
            first = ("Disconnect", lambda: h.push(Busy(h, f"Disconnecting {d['name']}…",
                                                       lambda: system.disconnect_headphones(d["mac"]),
                                                       after=self.after_headphones)))
        else:
            first = ("Connect", lambda: h.push(Busy(h, f"Connecting {d['name']}…",
                                                    lambda: system.connect_headphones(d["mac"]),
                                                    after=self.after_headphones)))
        h.push(Dialog(h, d["name"], [first, ("Forget", lambda: h.push(Busy(
            h, f"Forgetting {d['name']}…", lambda: system.forget_headphones(d["mac"]),
            after=self.after_headphones)))]))

    def pair_headphones(self):
        h = self.home

        def found(ok, devices):
            if not devices:
                h.push(Dialog(h, "No headphones found. Put them in pairing mode (often: hold the power "
                                 "button until a light blinks) and try again."))
                return
            h.push(Picker(h, "Headphones found", [(d["name"], d["mac"]) for d in devices], None, pick))

        def pick(mac):
            if mac is None:
                return
            h.push(Busy(h, "Pairing and connecting…", lambda: system.pair_headphones(mac),
                        after=self.after_headphones))

        h.push(Busy(h, "Put your headphones in pairing mode. Looking for them for 12 seconds…",
                    lambda: (True, system.find_headphones(12)), after=found))

    def set_output(self, node):
        if node is not None:
            system.set_sound_output(node)
        self.home.poll.forget("outputs")
        self.home.poll.forget("volume")

    def cycle_output(self, outputs, step):
        if not outputs:
            return
        index = next((i for i, (_, _, d) in enumerate(outputs) if d), 0)
        self.set_output(outputs[(index + step) % len(outputs)][0])
        self.home.sounds.play("move")

    def rows_controllers(self):
        h = self.home
        connected = h.poll.get("controllers", system.controllers, 1.0, [])
        paired = h.poll.get("paired", system.paired_controllers, 3.0, [])
        rows = [Row("header", "Connected")]
        if not connected:
            rows.append(Row("info", "No controller connected."))
        for pad in connected:
            rows.append(Row("info", pad["name"], pad_status(pad)))
        rows.append(Row("header", "Paired over Bluetooth"))
        if not paired:
            rows.append(Row("info", "None. Pair one below."))
        for mac, name, is_connected in paired:
            rows.append(Row("button", f"{name}  ({mac[-5:]})" + ("  ·  connected" if is_connected else ""),
                            "Forget", ok=lambda m=mac: h.push(Dialog(
                                h, "Forget this controller? To use it over Bluetooth again, pair it again.",
                                [("Forget", lambda: self.forget_pad(m)), ("Cancel", None)]))))
        rows.append(Row("action", "Pair a new controller", ok=self.pair))
        rows.append(Row("info", "A paired controller reconnects with its PS button, and stays connected over "
                                "Bluetooth while you do not use it."))
        rows += [
            Row("header", "Controller settings"),
            self.setting_choice("Light bar color", "lightbar", [(k, v[0]) for k, v in store.LIGHTBAR_COLORS.items()],
                                after=h.apply_lightbar),
            self.setting_choice("Light bar brightness", "lightbar_brightness",
                                [(v, f"{v}%") for v in (25, 50, 75, 100)], after=h.apply_lightbar),
            self.setting_toggle("Vibration", "vibration_on", after=h.make_input),
        ]
        if h.settings["vibration_on"]:
            rows.append(self.setting_slider("Vibration strength", "vibration", 10, 0, 100, after=h.make_input))
        rows += [
            self.setting_toggle("Controller microphone", "controller_mic", after=h.apply_mic),
            Row("info", "The microphone works when the controller is on a USB cable."),
            self.setting_choice("Button layout", "swap_buttons", [(False, "Standard (X to choose)"),
                                                                   (True, "X and O swapped (O to choose)")],
                                after=h.make_input),
            Row("action", "Test the controller", ok=lambda: h.push(ControllerTest(h))),
            Row("info", "Games get the light bar color, vibration and button layout the next time they start."),
        ]
        return rows

    def forget_pad(self, mac):
        h = self.home
        h.push(Busy(h, "Forgetting the controller…", lambda: (system.forget_controller(mac), "")))
        h.poll.forget("paired")

    def pair(self):
        h = self.home
        if not system.pair_mode():
            h.push(Dialog(h, "Could not start looking for controllers."))
            return
        h.push(Dialog(h, "Hold SHARE and PS on a DualShock 4 (Create and PS on a DualSense) until the light "
                         "bar blinks quickly. The PS4 looks for it for 60 seconds.", title="Pair a controller"))

    def rows_storage(self):
        h = self.home
        info = h.poll.get("storage", self.storage_info, 3.0, {})
        rows = [Row("header", "USB drive")]
        if info.get("usb"):
            free, total = info["usb"]
            rows.append(Row("info", info.get("usb_label") or "USB drive",
                            f"{system.size_text(free)} free of {system.size_text(total)}"))
            rows.append(Row("action", "Eject the USB drive", ok=lambda: h.push(Busy(
                h, "Ejecting the USB drive…", system.eject_usb,
                after=lambda ok, msg: (h.poll.forget("storage"), h.push(Dialog(h, msg)))))))
        else:
            rows.append(Row("info", "No USB drive plugged in."))
        rows.append(Row("header", "PS4 drive"))
        if info.get("ps4"):
            free, total = info["ps4"]
            rows.append(Row("info", "Free space", f"{system.size_text(free)} of {system.size_text(total)}"))
            rows.append(Row("info", "Game folder", system.PS4_GAMES_SHOWN))
            rows.append(Row("info", "Games there", str(sum(1 for g in h.all_games if g.source == "PS4"))))
            rows.append(Row("info", "Copy games there with GoldHEN FTP from your PC."))
        else:
            rows.append(Row("info", "Not open: this system was started from a USB drive."))
        rows.append(Row("header", "Videos"))
        rows.append(self.setting_choice("Save videos to", "video_location",
                                        [("internal", "PS4 (~/Videos)"), ("usb", "USB drive (PS5-videos)")]))
        rows.append(self.setting_choice("Video quality", "video_quality",
                                        [(k, v[0]) for k, v in store.VIDEO_QUALITIES.items()]))
        rows.append(Row("info", "PS + Triangle starts and stops a video, in a game too. Without a USB drive "
                                "videos are saved on the PS4."))
        rows.append(Row("header", "PC share"))
        state, message, count = h.pc.status()
        games = f"{count} game" + ("s" if count != 1 else "")
        rows.append(Row("info", "Status", {"off": "Off", "connecting": "Connecting…",
                                           "connected": f"Connected, {games}"}.get(state, message)))
        return rows

    def storage_info(self):
        info = {}
        if system.mounted(system.USB_MOUNT):
            info["usb"] = system.space(system.USB_MOUNT)
            info["usb_label"] = system.usb_label()
        folder = os.path.dirname(self.home.args.ps4_games)
        if os.path.isdir(folder):
            info["ps4"] = system.space(folder)
        return info

    def rows_games(self):
        h = self.home
        sort = h.settings["sort"]
        return [
            Row("choice", "Order", "Recently played" if sort == "recent" else "Name",
                ok=self.toggle_sort, left=self.toggle_sort, right=self.toggle_sort),
            Row("toggle", "Show hidden games", h.settings["show_hidden"],
                ok=lambda: h.settings.set(show_hidden=not h.settings["show_hidden"])),
            Row("toggle", "Show FPS counter in games", h.settings["fps_counter"],
                ok=lambda: h.settings.set(fps_counter=not h.settings["fps_counter"])),
            Row("info", "The FPS counter shows the game's frames per second in the bottom-left corner. "
                        "It is used from the next game you start."),
            Row("toggle", "GPU-shared game memory", h.settings["gpu_shared_memory"],
                ok=lambda: h.settings.set(gpu_shared_memory=not h.settings["gpu_shared_memory"])),
            Row("info", "Games keep their memory where the GPU reads and writes it, so less is copied. "
                        "Much faster in 3D games like Teardown. Turn it off if a game hangs or runs out of memory. "
                        "It is used from the next game you start."),
            self.setting_toggle("GPU submit thread", "gpu_submit_thread"),
            Row("info", "Sends the game's work to the GPU from a second CPU core, so the core that "
                        "prepares the work has more time. Faster in 3D games. Turn it off if a game hangs "
                        "or flickers."),
            self.setting_toggle("Fewer memory traps", "fewer_memory_traps"),
            Row("info", "Small game data that changes every frame is copied for the GPU instead of being "
                        "watched for changes, so the CPU stops less often. Turn it off if a game shows "
                        "wrong or flickering graphics."),
            Row("info", "Press OPTIONS on a game to turn these two on or off for that game only. "
                        "Teardown runs faster with both off, so they start off for it."),
            self.setting_toggle("Cheat manager", "cheats", after=lambda: h.refresh_games(force=True)),
            Row("info", "Adds a Cheats tile to the home screen, to turn on cheats for your games. "
                        "Cheats can break saves and online play, so back up your saves first."),
            Row("info", "Press OPTIONS on a game for favorites, hiding it and its own settings."),
            Row("info", "Favorites come first and have a star."),
            Row("header", "For all games"),
            self.setting_toggle("Keep compiled shaders", "default_shader_cache"),
            self.setting_toggle("Performance overlay", "default_perf_overlay"),
            self.setting_toggle("Render at 1920x1080", "default_full_hd"),
            self.setting_toggle("Tell the game the TV is 1080p", "default_output_1080p"),
            Row("info", "Games draw for a 1080p TV instead of 4K: much less work for the PS4's GPU, "
                        "so heavy 3D games run faster. The picture is a little softer."),
            self.setting_toggle("FSR 1 upscaling", "default_fsr"),
            Row("info", "AMD FSR 1 enlarges a game picture that is smaller than the TV, with sharper "
                        "edges than plain scaling. Use it with the 1080p setting on a 4K TV."),
            self.setting_toggle("Simulated PSN sign-in", "default_emulate_psn"),
            Row("info", "Answers a game's PSN sign-in checks as if you were signed in. Some games stop at "
                        "the start without it. Nothing is sent to PSN."),
            Row("choice", "Game language", store.LANGUAGES[h.settings["console_language"]]
                if 0 <= h.settings["console_language"] < len(store.LANGUAGES) else "English (US)",
                ok=lambda: h.push(Picker(h, "Game language", [(n, i) for i, n in enumerate(store.LANGUAGES)],
                                         h.settings["console_language"],
                                         lambda v: v is not None and h.settings.set(console_language=v))),
                left=lambda: self.step_language(-1), right=lambda: self.step_language(1)),
            self.setting_toggle("HDR (on HDR TVs)", "hdr"),
            self.setting_choice("Frame pacing", "present_mode", list(store.PRESENT_MODES.items())),
            Row("info", "These are used from the next game you start. A game's own settings (OPTIONS) add to them."),
            Row("header", "Trophies"),
            Row("action", "Trophies", ok=self.pick_trophies),
            Row("header", "Play time"),
        ] + self.rows_play_time()

    def step_language(self, step):
        h = self.home
        h.settings.set(console_language=(h.settings["console_language"] + step) % len(store.LANGUAGES))
        h.sounds.play("move")

    def rows_play_time(self):
        h = self.home
        rows = []
        played = []
        for g in h.all_games:
            entry = h.games_store.get(g.key)
            if entry.get("play_seconds"):
                played.append((entry["play_seconds"], g, entry))
        for seconds, g, entry in sorted(played, key=lambda x: -x[0]):
            when = time.strftime("%d %b %Y", time.localtime(entry["last_played"])) if entry.get("last_played") else ""
            # Buttons with nothing to do, so the list scrolls down to them (info rows are skipped).
            rows.append(Row("button", g.title, system.play_time_text(seconds) + (f"  ·  last {when}" if when else "")))
        if not rows:
            rows.append(Row("button", "No play time yet: it is counted from now on."))
        return rows

    def pick_trophies(self):
        h = self.home
        games = [g for g in h.all_games if os.path.isdir(os.path.join(g.path, "sce_sys", "trophy2"))]
        if not games:
            h.push(Dialog(h, "None of your games has trophies."))
            return
        h.push(Picker(h, "Trophies", [(g.title, g) for g in games], None,
                      lambda g: g is not None and h.push(TrophyList(h, g))))

    def toggle_sort(self):
        h = self.home
        h.settings.set(sort="name" if h.settings["sort"] == "recent" else "recent")
        h.sounds.play("move")

    def rows_saves(self):
        h = self.home
        backups = h.poll.get("backups", system.save_backups, 4.0, [])
        usb = system.mounted(system.USB_MOUNT)
        rows = [Row("info", "Game saves", "Saves and trophies of all profiles"),
                Row("action", "Back up saves to USB", None if usb else "Plug in a USB drive first",
                    ok=self.backup if usb else None),
                Row("button", "Restore saves from USB", f"{len(backups)} backups" if backups else "None",
                    ok=self.restore if backups else None)]
        if backups:
            rows.append(Row("info", "Last backup", backups[0]))
        rows.append(Row("info", "Backups go in the PS5-saves folder of the USB drive."))
        rows.append(self.setting_toggle("Back up saves when a game closes", "auto_backup_saves"))
        rows.append(Row("info", "With a USB drive plugged in, the saves are copied to it each time a game "
                                "closes. The newest 5 of these backups are kept."))
        rows.append(Row("header", "Compiled shaders"))
        rows.append(Row("action", "Export all compiled shaders to USB", None if usb else "Plug in a USB drive first",
                        ok=self.export_all_shaders if usb else None))
        rows.append(Row("action", "Import all compiled shaders from USB", None if usb else "Plug in a USB drive first",
                        ok=self.import_all_shaders if usb else None))
        rows.append(Row("info", "Games load faster the first time with shaders from another PS4 of the same model "
                                "and EmuFive version. They go in the PS5-shaders folder of the USB drive."))
        rows.append(Row("header", "Covers"))
        rows.append(Row("action", "Import covers from USB", None if usb else "Plug in a USB drive first",
                        ok=self.import_covers if usb else None))
        if os.path.isdir(system.COVERS_DIR):
            rows.append(Row("action", "Remove your own covers", ok=self.remove_covers))
        rows.append(Row("info", "Put pictures named by title ID (like PPSA09076.png or .jpg) in a PS5-covers "
                                "folder on the USB drive. They replace the game's own picture."))
        return rows

    def export_all_shaders(self):
        h = self.home
        h.push(Busy(h, "Copying shaders to the USB drive…", system.export_all_shaders))

    def import_all_shaders(self):
        h = self.home

        def work():
            ok, message, titles = system.import_all_shaders()
            # The shader store is only read with "Keep compiled shaders".
            for g in h.all_games:
                if g.title_id in titles:
                    h.games_store.update(g.key, shader_cache=True)
            if titles:
                h.games_changed = True
            return ok, message

        h.push(Dialog(h, "Import the compiled shaders of every game in PS5-shaders on the USB drive? "
                         "Keep compiled shaders is turned on for those games.",
                      [("Import", lambda: h.push(Busy(h, "Copying shaders from the USB drive…", work))),
                       ("Cancel", None)]))

    def import_covers(self):
        h = self.home
        h.push(Busy(h, "Copying covers from the USB drive…", system.import_covers,
                    lambda ok, message: (self.reload_pictures(), h.push(Dialog(h, message)))))

    def reload_pictures(self):
        """Every game's pictures are loaded again (prepare() starts them over)."""
        h = self.home
        for g in h.all_games:
            if hasattr(g, "icon"):
                del g.icon
        h.refresh_games(force=True)

    def remove_covers(self):
        h = self.home
        ok, message = system.remove_covers()
        self.reload_pictures()
        h.push(Dialog(h, message))

    def backup(self):
        h = self.home
        h.push(Busy(h, "Backing up saves to the USB drive…", system.backup_saves))
        h.poll.forget("backups")

    def restore(self):
        h = self.home
        backups = system.save_backups()

        def pick(name):
            if name is None:
                return
            h.push(Dialog(h, f"Restore the saves from {name}? The saves on the PS4 now are kept "
                             "as .before-restore folders.",
                          [("Restore", lambda: h.push(Busy(h, "Restoring saves…",
                                                           lambda: system.restore_saves(name)))),
                           ("Cancel", None)]))

        h.push(Picker(h, "Restore saves", [(n, n) for n in backups], None, pick))

    def rows_power(self):
        h = self.home
        minutes = h.settings["auto_off_minutes"]
        label = "Never" if not minutes else f"After {minutes} minutes" if minutes < 60 else \
            f"After {minutes // 60} hour" + ("s" if minutes >= 120 else "")
        return [
            Row("action", "Restart", ok=lambda: h.push(Dialog(h, "Restart the PS4?",
                                                              [("Restart", lambda: h.finish("REBOOT")),
                                                               ("Cancel", None)]))),
            Row("action", "Power off", ok=lambda: h.push(Dialog(h, "Turn off the PS4?",
                                                                [("Turn off", lambda: h.finish("POWEROFF")),
                                                                 ("Cancel", None)]))),
            Row("choice", "Turn off when not used", label, ok=lambda: self.cycle_off(1),
                left=lambda: self.cycle_off(-1), right=lambda: self.cycle_off(1)),
            Row("info", "Only on the home screen, never during a game."),
        ]

    def cycle_off(self, step):
        h = self.home
        options = [0, 30, 60, 120]
        current = h.settings["auto_off_minutes"]
        index = options.index(current) if current in options else 0
        h.settings.set(auto_off_minutes=options[(index + step) % len(options)])
        h.idle_warned = False
        h.sounds.play("move")

    def rows_date_and_time(self):
        h = self.home
        zone = h.poll.get("zone", system.current_timezone, 5.0, "UTC")
        automatic = h.poll.get("ntp", system.time_automatic, 5.0, True)
        rows = [
            Row("toggle", "Set automatically", automatic, ok=lambda: self.set_automatic(not automatic)),
        ]
        if automatic:
            rows.append(Row("info", "The time itself is set from the internet."))
        else:
            now = time.strftime("%d %b %Y  %H:%M" if h.settings["clock_24h"] else "%d %b %Y  %I:%M %p")
            rows.append(Row("button", "Date and time", now, ok=lambda: h.push(DateTimeEditor(h))))
            rows.append(Row("info", "Set by hand. It is kept until you turn Set automatically on again."))
        rows += [
            Row("button", "Time zone", zone, ok=self.pick_region),
            Row("choice", "Clock", "24-hour" if h.settings["clock_24h"] else "12-hour",
                ok=self.toggle_clock, left=self.toggle_clock, right=self.toggle_clock),
        ]
        return rows

    def set_automatic(self, on):
        h = self.home
        h.push(Busy(h, "Turning automatic time on…" if on else "Turning automatic time off…",
                    lambda: system.set_time_automatic(on),
                    after=lambda ok, msg: (h.poll.forget("ntp"),
                                           None if ok else h.push(Dialog(h, msg or "Could not set it.")))))

    def toggle_clock(self):
        self.home.settings.set(clock_24h=not self.home.settings["clock_24h"])
        self.home.sounds.play("move")

    def pick_region(self):
        h = self.home
        zones = system.timezones()
        main = ("Africa", "America", "Antarctica", "Arctic", "Asia", "Atlantic", "Australia", "Europe",
                "Indian", "Pacific")
        regions = sorted({z.split("/")[0] for z in zones if "/" in z and z.split("/")[0] in main}) + ["UTC"]

        def pick_zone(zone):
            if zone is None:
                return
            h.push(Busy(h, f"Setting the time zone to {zone}…", lambda: system.set_timezone(zone),
                        after=lambda ok, msg: (h.poll.forget("zone"),
                                               None if ok else h.push(Dialog(h, msg or "Could not set it.")))))

        def pick(region):
            if region == "UTC":
                pick_zone("UTC")
                return
            cities = [(z.split("/", 1)[1].replace("_", " "), z) for z in zones if z.startswith(region + "/")]
            h.push(Picker(h, region, cities, system.current_timezone(), pick_zone))

        current = system.current_timezone().split("/")[0]
        h.push(Picker(h, "Time zone: region", [(r, r) for r in regions], current, pick))

    def rows_system(self):
        h = self.home
        info = h.poll.get("sysinfo", system.system_info, 5.0, [])
        rows = [self.setting_choice("Menu language", "menu_language", list(i18n.LANGUAGES.items()), reload=True)]
        rows += [Row("info", label, value) for label, value in info]
        rows += self.rows_software_update()
        sensors = h.poll.get("sensors", system.sensors, 2.0, {})
        rows.append(Row("header", "Temperature and load"))
        if "console" in sensors:
            rows.append(Row("info", "Console temperature", f"{sensors['console']:.0f} °C"))
        if "cpu" in sensors:
            rows.append(Row("info", "CPU temperature", f"{sensors['cpu']:.0f} °C"))
        if "fan" in sensors:
            rows.append(Row("info", "Fan", f"{sensors['fan']} rpm"))
        rows.append(Row("info", "CPU load", f"{sensors['load']}%" if "load" in sensors else "measuring…"))
        rows.append(Row("header", "Settings"))
        rows.append(Row("action", "Back up settings to USB", ok=lambda: h.push(Busy(
            h, "Backing up settings to the USB drive…", system.backup_settings))))
        rows.append(Row("action", "Reset all settings", ok=lambda: h.push(Dialog(
            h, "Put all settings back to their defaults? Your games, saves, play time, favorites and Wi-Fi "
               "networks are kept.", [("Reset", self.reset_all), ("Cancel", None)]))))
        rows.append(Row("header", "Logs"))
        rows.append(Row("action", "View the game log", ok=lambda: h.push(LogViewer(h))))
        rows.append(Row("action", "Copy logs to USB", ok=lambda: h.push(Busy(
            h, "Copying logs to the USB drive…", system.copy_logs_to_usb))))
        return rows

    def rows_software_update(self):
        """EmuFive updates (lib/ps5/update.py): the status, Update, Check now, Roll back."""
        h = self.home
        rows = [Row("header", "Software update")]
        status = h.poll.get("update_status", update.status, 1.0, {})
        busy = status.get("state") in UpdateProgress.BUSY and time.time() - status.get("time", 0) < 600
        if busy:
            rows.append(Row("action", "An update is running", ok=lambda: h.push(UpdateProgress(h, "watch", self.category))))
            return rows
        if status.get("state") == "done" and status.get("restart") and not status.get("latest"):
            rows.append(Row("action", "Restart the PS4 to finish the update", ok=lambda: h.push(Dialog(
                h, "Restart the PS4 now?", [("Restart", lambda: h.finish("REBOOT")), ("Cancel", None)]))))
        check = h.poll.get("update_check", update.check, 6 * 3600, None)
        if self.update_checking or check is None:
            rows.append(Row("info", "Status", "Checking…"))
        elif check["error"]:
            rows.append(Row("info", "Status", "Could not check (offline?)"))
        elif check["newest"]:
            rows.append(Row("info", "Status", f"Update available: {check['newest']}", color=GOOD))
            rows.append(Row("action", f"Update to EmuFive {check['newest']}", ok=lambda: self.start_update(check)))
        elif check.get("unpacked"):
            rows.append(Row("info", "Status", f"{check['unpacked']} is out"))
        else:
            rows.append(Row("info", "Status", "Up to date"))
        if check and check.get("unpacked"):
            rows.append(Row("info", f"EmuFive {check['unpacked']} is out, but its release has no update files yet "
                                    f"(emufive-{check['unpacked']}.tar and its .sha256), so it cannot be installed."))
        rows.append(Row("action", "Check for updates", ok=self.check_updates))
        back = h.poll.get("update_backup", update.backup_info, 5.0, None)
        if back:
            rows.append(Row("action", f"Roll back to EmuFive {back['from']}", ok=lambda: h.push(Dialog(
                h, f"Put back EmuFive {back['from']}? The home screen starts again.",
                [("Roll back", lambda: self.run_update("rollback")), ("Cancel", None)]))))
        rows.append(Row("info", "Updates come from github.com/" + update.REPO + ". Your games, saves and "
                        "settings are kept."))
        return rows

    def check_updates(self):
        """Checks again; the page keeps the last result (and the selection) until the new one."""
        h = self.home
        if self.update_checking:
            return
        self.update_checking = True

        def run():
            result = update.check()
            h.poll.put("update_check", result)
            self.update_checking = False
            if result["error"]:
                h.toast("Could not check (offline?)")
            elif result["newest"]:
                h.toast(f"Update available: {result['newest']}")
            elif result.get("unpacked"):
                h.toast(f"{result['unpacked']} is out")
            else:
                h.toast("EmuFive is up to date.")

        threading.Thread(target=run, daemon=True).start()

    def start_update(self, check):
        h = self.home
        if h.running_path:
            h.push(Dialog(h, "Close the paused game first, then update."))
            return
        count = check.get("count", 1)
        if count > 1:
            text = (f"Update EmuFive {check['installed']} to {check['newest']}? {count} updates are installed "
                    "in turn. The home screen starts again when it is done.")
        else:
            text = f"Update EmuFive {check['installed']} to {check['newest']}? The home screen starts again when it is done."
        h.push(Dialog(h, text,
                      [("Update", lambda: self.run_update("update")), ("Cancel", None)]))

    def run_update(self, action):
        h = self.home
        h.poll.forget("update_backup")
        h.push(UpdateProgress(h, action, self.category))

    def reset_all(self):
        h = self.home
        system.reset_settings()
        h.request_reload(self.category)

    def rows_advanced(self):
        h = self.home
        ssh = h.poll.get("ssh", system.ssh_enabled, 3.0)
        default = h.poll.get("default_password", system.password_is_default, 30.0)
        addresses = h.poll.get("ip", system.ip_addresses, 3.0, [])
        rows = [Row("button", "Change the ps5 password", ok=self.change_password),
                Row("toggle", "SSH login", bool(ssh), ok=self.toggle_ssh)]
        if ssh and addresses:
            rows.append(Row("info", "Connect with", f"ssh ps5@{addresses[0][1]}"))
        if default:
            rows.append(Row("info", "The password is still the default one (ps5). Change it before using SSH.",
                            color=BAD))
        rows.append(Row("info", "The ps5 password is for SSH and sudo. Your profile name is separate."))
        return rows

    def change_password(self, then=None):
        h = self.home
        answers = {}

        def current(text):
            if not text:
                return "Type the current password."
            answers["current"] = text
            h.push(KeyboardDialog(h, "New password", secret=True, on_done=new))
            return None

        def new(text):
            if len(text) < 6:
                return "Use at least 6 characters."
            if text == "ps5":
                return "Choose another password than the default one."
            answers["new"] = text
            h.push(KeyboardDialog(h, "New password again", secret=True, on_done=again))
            return None

        def again(text):
            if text != answers.get("new"):
                return "The two new passwords are not the same."

            def after(ok, message):
                h.poll.forget("default_password")
                h.push(Dialog(h, message))
                if ok and then:
                    then()

            h.push(Busy(h, "Changing the password…",
                        lambda: system.change_password(answers["current"], answers["new"]), after=after))
            return None

        h.push(KeyboardDialog(h, "Current password", secret=True, on_done=current))

    def toggle_ssh(self):
        h = self.home
        on = not h.poll.get("ssh", system.ssh_enabled, 3.0)

        def apply():
            h.push(Busy(h, "Turning SSH on…" if on else "Turning SSH off…", lambda: system.set_ssh(on),
                        after=lambda ok, msg: (h.poll.forget("ssh"),
                                               None if ok else h.push(Dialog(h, msg or "Could not change SSH.")))))

        if on and system.password_is_default():
            h.push(Dialog(h, "The ps5 password is still the default one, which anyone can look up. Set your "
                             "own password first, then SSH turns on.",
                          [("Change it", lambda: self.change_password(then=apply)), ("Cancel", None)]))
        else:
            apply()

    def rows_about(self):
        h = self.home
        return [Row("action", "Open About", ok=lambda: h.push(AboutPage(h))),
                Row("info", "EmuFive, by Chokri Hammedi (blue0x1). github.com/blue0x1"),
                Row("info", "The credits of everything it is built with.")]

    # Input and drawing ------------------------------------------------------------------------

    def act(self, action):
        h = self.home
        if self.focus == "categories":
            if action in (UP, DOWN):
                new = max(0, min(len(self.CATEGORIES) - 1, self.category + (1 if action == DOWN else -1)))
                if new != self.category:
                    self.category = new
                    self.row = 0
                    self.chosen = None
                    self.top = 0
                    h.sounds.play("move")
            elif action in (RIGHT, OK):
                rows = self.rows()
                if any(r.selectable for r in rows):
                    self.focus = "rows"
                    self.row = first_selectable(rows)
                    h.sounds.play("move")
            elif action in (BACK, GUIDE):
                h.sounds.play("back")
                self.close()
            return
        row = self.current(self.rows())
        if action == BACK or (action == LEFT and (row is None or row.left is None)):
            self.focus = "categories"
            h.sounds.play("back")
            return
        self.act_rows(action)

    SUBTITLES = {
        "Profile": "Your name, avatar and profiles", "Appearance": "Make the home screen yours",
        "Network": "Wi-Fi and network cable", "Games from PC": "A shared folder on your PC",
        "Sound": "The TV and headphones", "Controllers": "Light bar, vibration and pairing",
        "Storage": "USB drive and PS4 drive", "Games": "Settings for all games",
        "Saves": "Back up and restore game saves", "Power": "Restart and turn off",
        "Date and time": "Clock and time zone", "System": "Language, temperature, logs",
        "Advanced": "Password and SSH", "About": "Versions and credits",
    }
    RAIL_STEP = 70
    ROWS_X = 167

    def draw(self, c):
        """Drawn again only when something on it changes; otherwise the kept picture is shown."""
        h = self.home
        rows = self.rows()
        key = None
        if self.appear >= 1.0:
            key = (self.category, self.focus, self.row, self.top, c.s.get_size(),
                   tuple((r.kind, r.label, str(r.value), id(r.picture)) for r in rows),
                   tuple(sorted(h.settings.data.items())), id(h.bg_current), id(h.static_bg))
        frame = getattr(self, "frame", None)
        if key is None or key != getattr(self, "frame_key", None) or frame is None \
                or frame.get_size() != c.s.get_size():
            if frame is None or frame.get_size() != c.s.get_size():
                self.frame = pygame.Surface(c.s.get_size()).convert()
            self.draw_page(ui.Canvas(self.frame, c.t))
            self.frame_key = key
        c.s.blit(self.frame, (0, 0))

    def draw_page(self, c):
        h = self.home
        size = c.s.get_size()
        vivid = ui.ACCENT
        draw_luxe_cover(c, 170)
        a = ease_out(self.appear)
        rtl = i18n.rtl()
        # The rail: a round icon for each category, scrolled to keep the chosen one in view.
        visible = int((ui.H - 120) // self.RAIL_STEP)
        first = min(max(0, self.category - visible // 2), max(0, len(self.CATEGORIES) - visible))
        rail_x = ui.W - 66 if rtl else 66
        for slot, i in enumerate(range(first, min(len(self.CATEGORIES), first + visible))):
            name = self.CATEGORIES[i]
            on = i == self.category
            focused = on and self.focus == "categories"
            y = 64 + slot * self.RAIL_STEP
            if on:
                light = glow_sprite(px(46), vivid)
                c.s.blit(light, light.get_rect(center=(px(rail_x), px(y))), special_flags=pygame.BLEND_RGB_ADD)
                c.circle(vivid if focused else ui.mix(LUXE_INK, vivid, 0.35), rail_x, y, 22)
            else:
                c.circle(luxe_line(), rail_x, y, 22, 1)
            category_icon(c, name, rail_x, y, LUXE_INK if focused else WHITE, 9)
            c.text(c.t.fit(name, 11, 104), 11, rail_x, y + 27, WHITE if on else SOFT, on, "midtop")
        x = self.ROWS_X
        name = self.CATEGORIES[self.category]
        preview = name == "Appearance"
        width = 573 if preview else ui.W - x - 70
        if rtl:
            x = ui.W - self.ROWS_X - width
            c.text(i18n.upper("Settings"), 12, x + width, 18 - (1 - a) * 10, vivid, True, "topright")
            c.text(name, 30, x + width, 34 - (1 - a) * 10, WHITE, True, "topright")
            c.text(self.SUBTITLES.get(name, ""), 15, x + width, 76, SOFT, False, "topright")
        else:
            c.text(i18n.upper("Settings"), 12, x + 2, 18 - (1 - a) * 10, vivid, True)
            c.text(name, 30, x, 34 - (1 - a) * 10, WHITE, True)
            c.text(self.SUBTITLES.get(name, ""), 15, x + 2, 76, SOFT)
        rows = self.rows()
        if self.focus == "rows":
            self.current(rows)
            if self.row < self.top:
                self.top = self.row
            while self.top < self.row and self.row_bottom(rows, self.top, self.row) > ui.H - 64:
                self.top += 1
        else:
            self.top = 0
        draw_card_rows(c, rows, self.row, x, 112, width, ui.H - 64, self.focus == "rows", self.top, vivid, h)
        if self.top > 0:
            c.text("▲", 14, x + width, 96, SOFT, False, "topright")
        if preview:
            px_ = 1240 - 453 if not rtl else 40
            c.text(i18n.upper("Preview"), 12, px_, 98, vivid, True)
            picture = h.preview(px(453), px(255))
            c.blit(picture, px_, 118)
            border = gradient_border(px(453), px(255), px(16), ui.mix(vivid, WHITE, 0.45), vivid, max(1, px(1.5)))
            c.s.blit(border, (px(px_), px(118)))
            c.text("Changes show here as you make them.", 14, px_, 384, SOFT)

    @staticmethod
    def row_bottom(rows, top, index):
        y = 112
        for i in range(top, index + 1):
            y += card_height(rows[i]) + CARD_GAP
        return y

    def hints(self):
        if self.focus == "categories":
            return [("cross", "Open"), ("circle", "Back")]
        row = self.current(self.rows())
        hints = [("cross", "Select")]
        if row is not None and (row.left or row.right):
            hints.append((None, "Left / Right: change"))
        return hints + [("circle", "Back")]


def pad_status(pad):
    battery = "" if pad["battery"] is None else f"  ·  {pad['battery']}%" + (" charging" if pad["charging"] else "")
    return pad["connection"] + battery


def disconnect_pad(h, mac):
    """Like the PS4's quick menu: the controller turns off; its PS button connects it again."""
    def work():
        ok = system.disconnect_controller(mac)
        h.poll.forget("controllers")
        h.toast("Controller disconnected. Press PS to connect it again." if ok else "Could not disconnect it.")

    threading.Thread(target=work, daemon=True).start()


def change_volume(h, step):
    volume = h.poll.get("volume", system.sound_volume, 2.0) or 0
    new = max(0, min(100, volume + step))
    system.set_sound_volume(new)
    h.poll.put("volume", new)
    h.sounds.play("move")


# --------------------------------------------------------------------------------------------
# Avatar picker: built-in avatars (drawn here, work offline), cartoon avatars from DiceBear and
# photos from Lorem Picsum (both free, no key, only with internet).

# --------------------------------------------------------------------------------------------
# The "luxe" look of the profile, trophy and avatar pages: near black, a cover across the top
# with soft light and thin waves, all in the accent color (Settings, Appearance).

LIGHT = SETTINGS["theme"] == "light"
# The page color, the cards on it and a darker panel: near black, pure black (Midnight) or
# near white (Light). Text on the accent is LUXE_INK too (white in the Light theme).
LUXE_INK, LUXE_CARD, LUXE_PANEL = {
    "light": ((236, 236, 242), (250, 250, 253), (246, 246, 250)),
    "midnight": ((0, 0, 0), (10, 10, 14), (8, 8, 12)),
}.get(SETTINGS["theme"], ((9, 9, 12), (16, 16, 24), (14, 14, 20)))
LUXE_KEY = ui.mix(LUXE_CARD, WHITE, 0.08)     # Keys, empty slots and idle marks on a card.
# The PS5 home over the games' art: white text on a dark shade, or dark text on a light one.
HOME_TEXT, HOME_SOFT = (WHITE, SOFT) if LIGHT else (ART_TEXT, ART_SOFT)
TROPHY_POINTS = {"bronze": 15, "silver": 30, "gold": 90, "platinum": 300}
# Points from one level to the next: 60 up to level 100, then more for each hundred (to 999).
LEVEL_STEPS = [(100, 60), (200, 90), (300, 450), (400, 900), (500, 1350), (600, 1800), (700, 2250),
               (800, 2700), (900, 3150), (999, 3600)]


def trophy_level(grades):
    """(level 1-999, progress to the next 0..1) from the trophies earned, PS5 style."""
    points = sum(TROPHY_POINTS[g] * n for g, n in grades.items() if g in TROPHY_POINTS)
    level = 1
    for upto, step in LEVEL_STEPS:
        while level < upto:
            if points < step:
                return level, points / step
            points -= step
            level += 1
    return 999, 1.0
LUXE_COVERS = {}


def luxe_line():
    """Thin lines and quiet marks: the accent, faint."""
    return ui.mix(LUXE_INK, ui.ACCENT, 0.32)


def draw_luxe_cover(c, height):
    """Fills the screen near black and draws the cover, `height` units tall (made once)."""
    key = (px(ui.W), px(height), ui.ACCENT)
    cover = LUXE_COVERS.get(key)
    if cover is None:
        w, h = key[:2]
        accent = ui.ACCENT
        cover = pygame.Surface((w, h))
        cover.blit(h_gradient(w, h, ui.mix(LUXE_INK, accent, 0.16), ui.mix(LUXE_INK, accent, 0.04)), (0, 0))
        for gx, gy, r, strength in ((0.18, 0.2, 0.55, 0.38), (0.78, 0.05, 0.45, 0.26), (0.55, 0.9, 0.35, 0.16)):
            sprite = glow_sprite(int(w * r), ui.mix((0, 0, 0), accent, strength))
            cover.blit(sprite, sprite.get_rect(center=(int(w * gx), int(h * gy))), special_flags=pygame.BLEND_RGB_ADD)
        lines = pygame.Surface((w, h), pygame.SRCALPHA)
        for k in range(7):                                  # Thin waves, fainter further down.
            base, amp, phase = h * (0.25 + k * 0.09), h * (0.10 + k * 0.012), k * 0.55
            points = [(x, base + amp * math.sin(x / w * 2 * math.pi * 1.2 + phase)
                       + amp * 0.4 * math.sin(x / w * 2 * math.pi * 3.1 + phase * 2))
                      for x in range(0, w + 8, 8)]
            pygame.draw.aalines(lines, accent + (70 - k * 8,), False, points)
        cover.blit(lines, (0, 0))
        fade = pygame.Surface((1, 3), pygame.SRCALPHA)
        for y, a in enumerate((0, 40, 255)):
            fade.set_at((0, y), LUXE_INK + (a,))
        cover.blit(pygame.transform.smoothscale(fade, (w, h)), (0, 0))
        if len(LUXE_COVERS) > 6:
            LUXE_COVERS.clear()
        LUXE_COVERS[key] = cover
    c.s.fill(LUXE_INK)
    c.s.blit(cover, (0, 0))


def draw_luxe_tabs(c, names, chosen, x, y, focused):
    """Tabs as words, the chosen one in the accent and underlined (white while the tabs have
    the focus); returns the x after the last."""
    for i, name in enumerate(names):
        on = i == chosen
        w = c.text(name, 19, x, y, ui.ACCENT if on else SOFT, on)
        if on:
            c.rect(WHITE if focused else ui.ACCENT, x, y + 34, w, 3 if focused else 2, 1)
        x += w + 44
    return x


def draw_game_icon(c, game, x, y, size):
    """A game's icon (its color while the icon is not read yet), `size` units, top left at (x, y)."""
    if game.icon is not None:
        c.blit(tile_image(game, px(size)), x, y)
    else:
        c.rect(getattr(game, "color", None) or ui.KEY, x, y, size, size, 8)


def draw_luxe_header(c, label, title, subtitle, rise, picture=None, icon=None):
    """The top of a luxe page: the cover, a round picture (or a drawn icon) in an accent ring at
    the left, a small label in capitals, the title and a line under it."""
    accent = ui.ACCENT
    draw_luxe_cover(c, 190)
    x0 = 90
    c.circle(LUXE_INK, x0 + 50, 96 - rise, 58)
    c.circle(accent, x0 + 50, 96 - rise, 54, 2)
    if picture is not None:
        c.blit(picture, x0 + 50, 96 - rise, "center")
    elif icon is not None:
        c.circle(ui.mix(LUXE_INK, accent, 0.3), x0 + 50, 96 - rise, 48)
        icon(c, x0 + 50, 96 - rise)
    tx = x0 + 130
    c.text(label.upper(), 13, tx, 48 - rise, accent, True)
    c.text(c.t.fit(title, 32, ui.W - tx - 380, True), 32, tx, 66 - rise, WHITE, True)
    if subtitle:
        c.text(c.t.fit(subtitle, 15, ui.W - tx - 380), 15, tx, 112 - rise, SOFT)


class AvatarPicker(Modal):
    covers = True       # Full screen, in the luxe look (draw_luxe_cover).
    TABS = ["Built-in", "Animated", "My pictures", "Cartoon", "Photos"]
    COLS = 6
    ONLINE = ("Animated", "Cartoon", "Photos")
    PAGED = ("Animated", "My pictures")         # Triangle shows the next 12 (the others: 12 new ones).

    def __init__(self, home):
        super().__init__(home)
        self.tab = 0
        self.focus = "grid"
        self.index = 0
        self.images = {}          # (kind, item) -> Surface
        self.raw = {}             # (kind, item) -> Surface, "loading" or "error"
        self.frames = {}          # (kind, item) -> "working", "ready" or "error" (an animation's frames)
        self.seeds = {"Cartoon": self.new_seeds("Cartoon"), "Photos": self.new_seeds("Photos")}
        self.pages = {"Animated": 0, "My pictures": 0}
        self.gifs = None          # The player's pictures and GIFs (looked for in the background).
        self.lock = threading.Lock()
        self.size = px(108)
        threading.Thread(target=lambda: setattr(self, "gifs", own_pictures(home)), daemon=True).start()

    @property
    def kind(self):
        return self.TABS[self.tab]

    @staticmethod
    def new_seeds(kind):
        return [f"{random.choice(DICEBEAR_STYLES)}:{random.randrange(10 ** 9)}" if kind == "Cartoon"
                else str(random.randrange(10 ** 9)) for _ in range(12)]

    def items(self, kind=None):
        """What the 12 places of a tab show: seeds, emoji codes or GIF paths (fewer at the end)."""
        kind = kind or self.kind
        if kind == "Built-in":
            return list(range(12))
        if kind in self.seeds:
            return self.seeds[kind]
        whole = NOTO_EMOJI if kind == "Animated" else (self.gifs or [])
        page = self.pages[kind]
        return whole[page * 12:page * 12 + 12]

    @staticmethod
    def animated(kind, item):
        """An emoji or a GIF: it moves (split into frames)."""
        return kind == "Animated" or (kind == "My pictures" and item.lower().endswith(".gif"))

    def page_count(self):
        whole = len(NOTO_EMOJI) if self.kind == "Animated" else len(self.gifs or [])
        return max(1, -(-whole // 12))

    def url(self, kind, item):
        if kind == "Cartoon":
            style, value = item.split(":")
            return (f"https://api.dicebear.com/9.x/{style}/png?seed={value}&size=256"
                    "&backgroundColor=b6e3f4,c0aede,d1d4f9,ffd5dc,ffdfbf&backgroundType=gradientLinear")
        if kind == "Animated":
            return NOTO_GIF.format(item)
        return f"https://picsum.photos/seed/{item}/256/256"

    def cache_path(self, kind, item):
        """The picture on the PS4: downloaded into the cache, or the player's own GIF."""
        if kind == "My pictures":
            return item
        ext = ".gif" if kind == "Animated" else ".png"
        return os.path.join(AVATAR_CACHE, hashlib.sha1(self.url(kind, item).encode()).hexdigest() + ext)

    def frames_dir(self, kind, item):
        return os.path.join(AVATAR_CACHE, "frames-" + hashlib.sha1(f"{kind}:{item}".encode()).hexdigest())

    def load(self, kind, item):
        key = (kind, item)
        with self.lock:
            if key in self.raw:
                return
            self.raw[key] = "loading"
        path = self.cache_path(kind, item)

        def work():
            try:
                if not os.path.exists(path):
                    os.makedirs(AVATAR_CACHE, exist_ok=True)
                    request = urllib.request.Request(self.url(kind, item), headers={"User-Agent": "ps5-on-ps4"})
                    with urllib.request.urlopen(request, timeout=12) as reply:
                        data = reply.read(8_000_000)
                    with open(path + ".part", "wb") as f:
                        f.write(data)
                    os.replace(path + ".part", path)
                surface = pygame.image.load(path)       # A GIF: its first frame.
                with self.lock:
                    self.raw[key] = surface
            except Exception:
                with self.lock:
                    self.raw[key] = "error"

        threading.Thread(target=work, daemon=True).start()

    def image(self, kind, item):
        key = (kind, item)
        if key in self.images:
            return self.images[key]
        if kind == "Built-in":
            self.images[key] = ui.builtin_avatar(item, self.size)
            return self.images[key]
        self.load(kind, item)
        with self.lock:
            raw = self.raw.get(key)
        if isinstance(raw, pygame.Surface):
            self.images[key] = avatar_disc(raw, self.size)
            return self.images[key]
        if raw == "error" and kind in self.seeds and item in self.seeds[kind]:
            # A cartoon or photo that did not come: another one takes its place (a few times).
            n = self.seeds[kind].index(item)
            tries = self.__dict__.setdefault("retries", {})
            if tries.get((kind, n), 0) < 5:
                tries[(kind, n)] = tries.get((kind, n), 0) + 1
                self.seeds[kind][n] = self.new_seeds(kind)[0]
                with self.lock:
                    self.raw.pop(key, None)
                return "loading"
        return raw

    def prepare_frames(self, kind, item):
        """Splits the focused GIF into frames (once, in the background), for its preview and to
        choose it. Returns "working", "ready" or "error"."""
        key = (kind, item)
        state = self.frames.get(key)
        if state is not None:
            return state
        folder = self.frames_dir(kind, item)
        if os.path.isdir(folder) and os.listdir(folder):
            self.frames[key] = "ready"
            return "ready"
        with self.lock:
            downloaded = isinstance(self.raw.get(key), pygame.Surface)
        if not downloaded:
            return "working"
        self.frames[key] = "working"

        def work():
            self.frames[key] = "ready" if gif_frames(self.cache_path(kind, item), folder) else "error"

        threading.Thread(target=work, daemon=True).start()
        return "working"

    def act(self, action):
        h = self.home
        count = len(self.items())
        if action == BACK:
            h.sounds.play("back")
            self.close()
        elif action in (PAGE_UP, PAGE_DOWN) or (self.focus == "tabs" and action in (LEFT, RIGHT)):
            self.tab = (self.tab + (-1 if action in (PAGE_UP, LEFT) else 1)) % len(self.TABS)
            self.index = min(self.index, max(0, len(self.items()) - 1))
            h.sounds.play("move")
        elif self.focus == "tabs":
            if action in (DOWN, OK):
                self.focus = "grid"
                h.sounds.play("move")
        elif action == UP:
            if self.index >= self.COLS:
                self.index -= self.COLS
            else:
                self.focus = "tabs"
            h.sounds.play("move")
        elif action == DOWN and self.index + self.COLS < count:
            self.index += self.COLS
            h.sounds.play("move")
        elif action in (LEFT, RIGHT) and count:
            self.index = (self.index + (1 if action == RIGHT else -1)) % count
            h.sounds.play("move")
        elif action == TRIANGLE and self.kind in self.PAGED:
            self.pages[self.kind] = (self.pages[self.kind] + 1) % self.page_count()
            self.index = min(self.index, max(0, len(self.items()) - 1))
            h.sounds.play("select")
        elif action == TRIANGLE and self.kind in self.seeds:
            for item in self.seeds[self.kind]:
                self.images.pop((self.kind, item), None)
                with self.lock:
                    self.raw.pop((self.kind, item), None)
            self.seeds[self.kind] = self.new_seeds(self.kind)
            self.__dict__.get("retries", {}).clear()
            h.sounds.play("select")
        elif action == OK and count:
            self.choose()

    def choose(self):
        import shutil
        h = self.home
        kind = self.kind
        item = self.items()[self.index]
        if kind == "Built-in":
            h.set_profile(avatar=f"builtin:{item}")
        elif self.animated(kind, item):
            if self.prepare_frames(kind, item) != "ready":
                h.sounds.play("error")
                h.toast("Getting it ready: try again in a moment", 3.0, keep=False)
                return
            try:
                folder = self.frames_dir(kind, item)
                os.makedirs(store.CONFIG_DIR, mode=0o700, exist_ok=True)
                target = store.avatar_anim_dir(h.profiles.current_id)
                shutil.rmtree(target + ".new", ignore_errors=True)
                shutil.copytree(folder, target + ".new")
                shutil.rmtree(target, ignore_errors=True)
                os.replace(target + ".new", target)
                still = store.avatar_file(h.profiles.current_id)
                shutil.copyfile(os.path.join(target, sorted(os.listdir(target))[0]), still + ".new")
                os.replace(still + ".new", still)
            except OSError:
                h.sounds.play("error")
                return
            h.set_profile(avatar="anim")
        elif kind == "My pictures":
            # A photo: kept as a square PNG of at most 512 pixels (any size or type on the drive).
            image = self.raw.get((kind, item))
            if not isinstance(image, pygame.Surface):
                h.sounds.play("error")
                return
            try:
                w, hgt = image.get_size()
                side = min(w, hgt)
                square = image.subsurface(pygame.Rect((w - side) // 2, (hgt - side) // 2, side, side))
                square = pygame.transform.smoothscale(square.convert(), (min(512, side),) * 2)
                os.makedirs(store.CONFIG_DIR, mode=0o700, exist_ok=True)
                target = store.avatar_file(h.profiles.current_id)
                pygame.image.save(square, target + ".new.png")
                os.replace(target + ".new.png", target)
            except (pygame.error, OSError, ValueError):
                h.sounds.play("error")
                return
            h.set_profile(avatar="file")
        else:
            path = self.cache_path(kind, item)
            if not isinstance(self.image(kind, item), pygame.Surface) or not os.path.exists(path):
                h.sounds.play("error")
                return
            try:
                with open(path, "rb") as f:
                    data = f.read()
                os.makedirs(store.CONFIG_DIR, mode=0o700, exist_ok=True)
                target = store.avatar_file(h.profiles.current_id)
                with open(target + ".new", "wb") as f:
                    f.write(data)
                os.replace(target + ".new", target)
            except OSError:
                h.sounds.play("error")
                return
            h.set_profile(avatar="file")
        h.avatar_cache.clear()
        h.sounds.play("select")
        h.toast("Avatar changed")
        self.close()

    def draw(self, c):
        h = self.home
        accent = ui.ACCENT
        kind = self.kind
        rise = (1 - ease_out(self.appear)) * 16
        draw_luxe_cover(c, 190)
        x0 = 90
        c.circle(LUXE_INK, x0 + 50, 96 - rise, 58)
        c.circle(accent, x0 + 50, 96 - rise, 54, 2)
        c.blit(h.avatar(96), x0 + 50, 96 - rise, "center")
        tx = x0 + 130
        c.text(i18n.translate("Profile").upper(), 13, tx, 52 - rise, accent, True)
        c.text("Choose an avatar", 32, tx, 70 - rise, WHITE, True)
        y = 186 - rise
        c.line(luxe_line(), x0, y + 36, ui.W - x0, y + 36, 1)
        draw_luxe_tabs(c, self.TABS, self.tab, x0, y, self.focus == "tabs")
        if kind in self.ONLINE and not h.network.online():
            c.text("Connect to the internet to see these avatars.", 19, ui.W / 2, 420, SOFT, False, "center")
            return
        items = self.items()
        if kind == "My pictures" and not items:
            if self.gifs is None:
                draw_spinner(c, ui.W / 2, 420, 18, h.t)
            else:
                c.text("No pictures found", 24, ui.W / 2, 380, WHITE, True, "center")
                for n, line in enumerate(("Put photos (PNG, JPG) or GIFs on a USB drive, at the top or in a folder",
                                          "named Avatars or Pictures, or in the PC's shared folder. GIFs move.")):
                    c.text(line, 16, ui.W / 2, 420 + n * 26, SOFT, False, "center")
            return
        cell = 150
        gx = ui.W / 2 - self.COLS * cell / 2
        gy = 260 - rise
        for n, item in enumerate(items):
            col, row = n % self.COLS, n // self.COLS
            cx, cy = gx + col * cell + cell / 2, gy + row * (cell + 14) + cell / 2
            on = self.focus == "grid" and n == self.index
            if on:
                c.circle(ui.mix(LUXE_INK, accent, 0.25), cx, cy, 66)
            image = self.image(kind, item)
            if on and self.animated(kind, item) and isinstance(image, pygame.Surface) \
                    and self.prepare_frames(kind, item) == "ready":
                # The focused GIF moves.
                frames = h.anim_frames(self.frames_dir(kind, item), self.size)
                if frames:
                    image = frames[int(time.monotonic() * ANIM_FPS) % len(frames)]
            if isinstance(image, pygame.Surface):
                c.blit(image, cx, cy, "center")
            elif image == "error":
                c.circle(ui.mix(LUXE_INK, WHITE, 0.08), cx, cy, 54)
                c.text("!", 26, cx, cy, BAD, True, "center")
            else:
                c.circle(ui.mix(LUXE_INK, WHITE, 0.08), cx, cy, 54)
                ang = h.t * 4 + n
                c.circle(accent, cx + math.cos(ang) * 18, cy + math.sin(ang) * 18, 4)
            if on:
                c.circle(accent, cx, cy, 61, 2 + 1.5 * (1 + math.sin(h.t * 4)))
            else:
                c.circle(luxe_line(), cx, cy, 58, 1)
        if kind in self.PAGED:
            pages = self.page_count()
            if pages > 1:
                c.text(f"{self.pages[kind] + 1} / {pages}", 14, ui.W / 2, ui.H - 52, SOFT, True, "midtop")
        source = {"Animated": "Animated emoji: Noto Emoji by Google (CC BY 4.0)",
                  "Cartoon": "Cartoon avatars by DiceBear (dicebear.com)",
                  "Photos": "Photos from Lorem Picsum (picsum.photos)",
                  "My pictures": "Your photos and GIFs (animated GIFs are supported)"}
        if kind in source:
            c.text(source[kind], 13, ui.W - x0, ui.H - 52, DIM, False, "topright")

    def hints(self):
        hints = [("cross", "Choose"), ("l1r1", "Tabs")]
        if self.kind in self.PAGED:
            if self.page_count() > 1:
                hints.append(("triangle", "Next page"))
        elif self.kind in self.seeds:
            hints.append(("triangle", "More"))
        return hints + [("circle", "Back")]


# --------------------------------------------------------------------------------------------
# The About page (full screen): see lib/ps5/about.py.

class AboutPage(Modal):
    covers = True

    def __init__(self, home):
        super().__init__(home)
        version = system.read_first("/etc/ps5-on-ps4-release") or "unknown"
        kyty = system.read_first("/opt/kytyps5/VERSION").replace("KytyPS5 ", "").split(",")[0] or "unknown"
        self.art = about.AboutArt((version, kyty))

    def act(self, action):
        if action in (BACK, OK, GUIDE):
            self.home.sounds.play("back")
            self.close()

    def author_picture(self, size):
        """The author's GitHub picture (about.AboutArt loads it once), round; None while it loads."""
        art = self.art
        art._load_avatar(self.home.network.online())
        if art.avatar is None:
            return None
        key = (id(art.avatar), size)
        if getattr(self, "picture_key", None) != key:
            picture = pygame.transform.smoothscale(art.avatar.convert_alpha(), (size, size))
            picture.blit(ui.circle_mask(size), (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
            self.picture, self.picture_key = picture, key
        return self.picture

    def draw(self, c):
        accent = ui.ACCENT
        draw_luxe_cover(c, 250)
        rise = (1 - ease_out(self.appear)) * 12
        cx = ui.W / 2
        c.text(i18n.upper("About"), 13, cx, 40 - rise, accent, True, "midtop")
        c.text("EmuFive", 46, cx, 60 - rise, WHITE, True, "midtop")
        c.text("PS5 games on a PS4", 16, cx, 120 - rise, SOFT, False, "midtop")
        c.rect(accent, cx - 22, 152 - rise, 44, 3, 1)
        # The author.
        x0, y0, w = cx - 400, 186 - rise, 800
        c.rect(LUXE_CARD, x0, y0, w, 150, 18)
        c.rect(luxe_line(), x0, y0, w, 150, 18, 1)
        ax, ay = x0 + 96, y0 + 75
        c.circle(LUXE_INK, ax, ay, 56)
        c.circle(accent, ax, ay, 53, 2)
        picture = self.author_picture(px(96))
        if picture is not None:
            c.s.blit(picture, picture.get_rect(center=(px(ax), px(ay))))
        else:
            c.circle(ui.mix(LUXE_INK, accent, 0.3), ax, ay, 48)
            c.text("B", 40, ax, ay, WHITE, True, "center")
        tx = x0 + 180
        c.text(i18n.upper("Created by"), 12, tx, y0 + 30, accent, True)
        c.text("Chokri Hammedi", 28, tx, y0 + 48, WHITE, True)
        c.text("blue0x1   ·   github.com/blue0x1", 16, tx, y0 + 92, SOFT)
        # The credits.
        cy = y0 + 172
        c.text(i18n.upper("Thanks to"), 12, x0 + 4, cy, accent, True)
        for i, (name, what) in enumerate(about.CREDITS):
            col, row = i % 4, i // 4         # 4 columns: 3 rows above the version line.
            x = x0 + 4 + col * (w / 4)
            y = cy + 30 + row * 58
            c.circle(accent, x + 4, y + 11, 3)
            c.text(c.t.fit(name, 17, w / 4 - 26, True), 17, x + 18, y, WHITE, True)
            c.text(c.t.fit(what, 14, w / 4 - 26), 14, x + 18, y + 24, SOFT)
        version, kyty = self.art.versions
        c.line(luxe_line(), x0, 610 - rise, x0 + w, 610 - rise, 1)
        c.text(f"Version {version}   ·   KytyPS5 {kyty}", 13, cx, 624 - rise, DIM, False, "midtop")

    def hints(self):
        return [("circle", "Back")]


# --------------------------------------------------------------------------------------------
# The game log, on screen.

class LogViewer(Modal):
    covers = True
    LINES = 22

    def __init__(self, home):
        super().__init__(home)
        self.lines = system.read_log(600) or ["The game log is empty: no game has run yet."]
        self.wrapped = None
        self.top = 0

    def act(self, action):
        h = self.home
        step = {UP: -1, DOWN: 1, PAGE_UP: -20, PAGE_DOWN: 20}.get(action)
        if step and self.wrapped:
            self.top = max(0, min(max(0, len(self.wrapped) - self.LINES), self.top + step))
        elif action == SQUARE:
            h.push(Busy(h, "Copying logs to the USB drive…", system.copy_logs_to_usb))
        elif action == TRIANGLE:
            h.push(Dialog(h, "Delete the game logs?", [("Delete", self.delete), ("Cancel", None)]))
        elif action == BACK:
            h.sounds.play("back")
            self.close()

    def delete(self):
        ok = system.clear_logs()
        self.home.toast("Logs deleted." if ok else "Could not delete the logs.")
        self.lines = system.read_log(600) or ["The game log is empty: no game has run yet."]
        self.wrapped = None

    def draw(self, c):
        accent = ui.ACCENT
        draw_luxe_cover(c, 160)
        c.text(i18n.upper("System"), 12, 64, 24, accent, True)
        c.text("Game log", 28, 64, 42, WHITE, True)
        c.text("~/kytyps5.log", 15, 66, 86, SOFT)
        box_x, box_y, box_w = 48, 124, ui.W - 96
        box_h = self.LINES * 22 + 28
        c.rect(LUXE_PANEL, box_x, box_y, box_w, box_h, 14)
        c.rect(luxe_line(), box_x, box_y, box_w, box_h, 14, 1)
        if self.wrapped is None:
            self.wrapped = []
            for line in self.lines:
                self.wrapped += c.t.wrap(line, 14, box_w - 70) or [""]
            self.top = max(0, len(self.wrapped) - self.LINES)
        total = len(self.wrapped)
        c.text(f"{min(total, self.top + self.LINES)} / {total}", 13, box_x + box_w, 92, SOFT, False, "topright")
        y = box_y + 14
        for line in self.wrapped[self.top:self.top + self.LINES]:
            low = line.lower()
            color = BAD if ("error" in low or "fail" in low or "crash" in low) else \
                ui.mix(SOFT, accent, 0.5) if "warn" in low else SOFT
            c.text(line, 14, box_x + 24, y, color)
            y += 22
        if total > self.LINES:
            track = box_h - 28
            bar_h = max(24, track * self.LINES / total)
            bar_y = box_y + 14 + (track - bar_h) * self.top / max(1, total - self.LINES)
            c.rect(luxe_line(), box_x + box_w - 14, box_y + 14, 3, track, 2)
            c.rect(accent, box_x + box_w - 14, bar_y, 3, bar_h, 2)

    def hints(self):
        return [("l1r1", "Page"), ("square", "Copy logs to USB"), ("triangle", "Delete logs"),
                ("circle", "Back")]


# --------------------------------------------------------------------------------------------
# A game's menu (OPTIONS on a tile): favorite, hide, its KytyPS5 options.

class GameMenu(RowList):
    WIDTH = 560

    def __init__(self, home, game):
        super().__init__(home)
        self.game = game

    def rows(self):
        h, g = self.home, self.game
        entry = h.games_store.get(g.key)
        running = h.is_running(g)
        rows = [Row("action", "Resume" if running else "Play", ok=lambda: (self.close(), h.open_game(g)))]
        if running:
            rows.append(Row("action", "Close the game", ok=lambda: h.push(Dialog(
                h, f"Close {g.title}? What the game has not saved is lost.",
                [("Close", lambda: h.finish("CLOSE")), ("Cancel", None)]))))
        if os.path.isdir(os.path.join(g.path, "sce_sys", "trophy2")):
            rows.append(Row("action", "Trophies", ok=lambda: h.push(TrophyList(h, g))))
        rows.append(Row("action", "Game info", ok=lambda: h.push(GameInfo(h, g))))
        if not running:
            rows.append(Row("action", "Report a test", ok=lambda: self.ask_report(g)))
            if g.source == "USB":
                rows.append(Row("action", "Copy to the EmuFive disk", ok=lambda: h.push(CopyView(h, g))))
            elif g.source_name == "EmuFive disk":
                rows.append(Row("action", "Delete from the EmuFive disk", ok=lambda: self.ask_delete(g)))
        if h.settings["cheats"] and g.title_id and g.version:
            on = cheats.enabled_count(g.title_id, g.version)
            rows.append(Row("button", "Cheats", f"{on} on" if on else "Off", ok=lambda: h.push(CheatGame(h, g))))
        rows.append(Row("info", "Play time", system.play_time_text(entry.get("play_seconds", 0))))
        if g.title_id and not running:
            here, usb = h.poll.get("shaders " + g.title_id, lambda: system.shader_status(g.title_id), 4.0, (0, 0))
            if here:
                rows.append(Row("action", "Export compiled shaders to USB", system.size_text(here),
                                ok=lambda: self.export_shaders(g)))
            if usb:
                rows.append(Row("action", "Import compiled shaders from USB", system.size_text(usb),
                                ok=lambda: self.import_shaders(g)))
        rows += [Row("toggle", "Favorite", entry.get("favorite", False), ok=lambda: self.flip("favorite")),
                Row("toggle", "Hide from the home screen", entry.get("hidden", False),
                    ok=lambda: self.flip("hidden")),
                Row("header", "Game settings")]
        for key, label, _ in store.GAME_OPTIONS:
            rows.append(Row("toggle", label, entry.get(key, False), ok=lambda k=key: self.flip(k)))
        for key, label, _ in store.SPEED_OPTIONS:
            rows.append(Row("toggle", label, h.games_store.speed(g.key, g.title_id, h.settings, key),
                            ok=lambda k=key: self.flip_speed(k)))
        rows.append(Row("info", "Game settings are used the next time the game starts."))
        return rows

    def ask_delete(self, g):
        h = self.home

        def delete():
            def work():
                system.delete_local_game(g.path)
                return True, f"{g.title} was deleted from the EmuFive disk."

            def after(ok, message):
                h.refresh_games(force=True)
                h.push(Dialog(h, message))

            self.close()
            h.push(Busy(h, "Deleting…", work, after))

        h.push(Dialog(h, f"Delete {g.title} from the EmuFive disk? Its saves stay.",
                      [("Delete", delete), ("Cancel", None)]))

    def ask_report(self, g):
        h = self.home

        def show(result):
            h.push(ReportView(h, g, result))

        h.push(Dialog(h, f"How did {g.title} run?",
                      [("Works", lambda: show("works")), ("Slow", lambda: show("slow")),
                       ("Doesn't work", lambda: show("broken"))], title="Report a test"))

    def flip_speed(self, key):
        """Stores the game's own choice, the opposite of what it uses now."""
        h, g = self.home, self.game
        h.games_store.update(g.key, **{key: not h.games_store.speed(g.key, g.title_id, h.settings, key)})
        h.games_changed = True

    def export_shaders(self, g):
        h = self.home
        h.push(Busy(h, "Copying shaders to the USB drive…", lambda: system.export_shaders(g.title_id, g.title)))
        h.poll.forget("shaders " + g.title_id)

    def import_shaders(self, g):
        h = self.home

        def work():
            ok, message = system.import_shaders(g.title_id)
            if ok:
                # The shader store is only read with "Keep compiled shaders".
                h.games_store.update(g.key, shader_cache=True)
                h.games_changed = True
            return ok, message

        def go():
            h.push(Busy(h, "Copying shaders from the USB drive…", work))
            h.poll.forget("shaders " + g.title_id)

        h.push(Dialog(h, f"Import the compiled shaders of {g.title} from the USB drive? The game then "
                         "loads faster the first time. Keep compiled shaders is turned on for it.",
                      [("Import", go), ("Cancel", None)]))

    def flip(self, key):
        h, g = self.home, self.game
        entry = h.games_store.get(g.key)
        h.games_store.update(g.key, **{key: not entry.get(key, False)})
        h.games_changed = True

    def act(self, action):
        if action in (BACK, OPTIONS):
            self.home.sounds.play("back")
            self.close()
        else:
            self.act_rows(action)

    def draw(self, c):
        slide = ease_out(self.appear)
        left = ui.W - self.WIDTH * slide
        c.dim(160 * slide)
        accent = ui.ACCENT
        c.rect(LUXE_PANEL, left, 0, self.WIDTH, ui.H)
        glow = glow_sprite(px(self.WIDTH * 0.9), ui.mix((0, 0, 0), accent, 0.22))
        c.s.blit(glow, glow.get_rect(center=(px(left + self.WIDTH * 0.7), 0)), special_flags=pygame.BLEND_RGB_ADD)
        c.line(luxe_line(), left, 0, left, ui.H, 1)
        x = left + 40
        y = 40
        rtl = i18n.rtl()
        tx, anchor = (left + self.WIDTH - 40, "topright") if rtl else (x, "topleft")
        c.rect(accent, tx - (36 if rtl else 0), 26, 36, 3, 1)
        for line in c.t.wrap(self.game.title, 26, self.WIDTH - 80, True)[:2]:
            c.text(line, 26, tx, y, WHITE, True, anchor)
            y += 34
        c.text(self.game.source_name, 15, tx, y + 4, accent if self.game.source_name else SOFT, False, anchor)
        rows = self.rows()
        self.current(rows)
        draw_rows(c, rows, self.row, x, y + 40, self.WIDTH - 80, ui.H - 60, True,
                  self.scroll(rows, y + 40, ui.H - 60))

    def hints(self):
        return [("cross", "Select"), ("circle", "Back")]


class NotificationList(GameMenu):
    """Past notifications, newest first (store.notifications): the ones shown over games
    (ps5-notify: screenshots, clips, trophies...) and on the home screen. From the quick menu."""

    def __init__(self, home):
        super().__init__(home, types.SimpleNamespace(title="Notifications", source_name=""))
        store.mark_notifications_read()

    def rows(self):
        items = store.notifications()
        self.game.source_name = ("1 notification" if len(items) == 1 else f"{len(items)} notifications") if items else ""
        if not items:
            return [Row("info", "No notifications yet.")]
        rows = [Row("action", "Clear all", ok=self.clear)]
        clock24 = self.home.settings["clock_24h"]
        for item in items:
            when = time.strftime("%d %b  %H:%M" if clock24 else "%d %b  %I:%M %p", time.localtime(item.get("time", 0)))
            rows.append(Row("button", item.get("title", ""), when))
            if item.get("text"):
                rows.append(Row("info", item["text"]))
        return rows

    def clear(self):
        store.clear_notifications()
        self.row = 0

    def hints(self):
        return [("circle", "Back")]


class CopyView(Modal):
    """Copies a USB game onto EmuFive's own disk (system.copy_game), with a progress bar; Circle
    cancels. The copy then shows as its own tile (EmuFive disk) and runs without the USB drive."""

    def __init__(self, home, game):
        super().__init__(home)
        self.game = game
        self.done = 0
        self.total = 0
        self.result = None
        self.cancelled = False

        def progress(done, total):
            self.done, self.total = done, total

        def run():
            try:
                system.copy_game(game.path, progress, lambda: self.cancelled)
                self.result = (True, f"{game.title} is on the EmuFive disk now. It runs without the USB drive.")
            except system.CopyCancelled:
                self.result = (False, "The copy was cancelled.")
            except OSError as error:
                self.result = (False, str(error))

        threading.Thread(target=run, daemon=True).start()

    def act(self, action):
        if action == BACK and not self.cancelled:
            self.cancelled = True
            self.home.sounds.play("back")

    def update(self, dt):
        super().update(dt)
        if self.result is not None and not self.closed:
            self.close()
            ok, message = self.result
            self.home.sounds.play("select" if ok else "error")
            self.home.refresh_games(force=True)
            self.home.push(Dialog(self.home, message))

    def draw(self, c):
        c.dim(170 * ease_out(self.appear))
        box_w, box_h = 640, 210
        x, y = ui.W / 2 - box_w / 2, ui.H / 2 - box_h / 2
        c.rect(DIALOG, x, y, box_w, box_h, 20)
        c.text(c.t.fit(self.game.title, 22, box_w - 80, True), 22, x + 40, y + 30, WHITE, True)
        c.text("Cancelling…" if self.cancelled else "Copying to the EmuFive disk…", 17, x + 40, y + 68, SOFT)
        share = self.done / self.total if self.total else 0.0
        c.rect((60, 58, 80), x + 40, y + 112, box_w - 80, 14, 7)
        if share > 0:
            c.rect(ACCENT, x + 40, y + 112, max(14, (box_w - 80) * min(1.0, share)), 14, 7)
        if self.total:
            c.text(f"{system.size_text(self.done)} of {system.size_text(self.total)}  ·  {int(share * 100)}%",
                   16, x + 40, y + 144, WHITE)
        else:
            c.text("Measuring the game…", 16, x + 40, y + 144, WHITE)

    def hints(self):
        return [("circle", "Cancel")]


class GameInfo(GameMenu):
    """A game's details (its param.json) and its size on the drive, from its menu (OPTIONS on the home screen)."""
    WIDTH = 640

    def __init__(self, home, game):
        super().__init__(home, game)
        self.details = system.game_details(game)
        self.size = None            # Bytes, measured in the background (a big game takes a while).
        self.measured = False

        def measure():
            self.size = system.folder_size(game.path)
            self.measured = True

        threading.Thread(target=measure, daemon=True).start()

    def rows(self):
        h = self.home
        entry = h.games_store.get(self.game.key)
        size = (system.size_text(self.size) if self.size is not None else
                "Unknown" if self.measured else "Measuring…")
        rows = [Row("header", "Game info")]
        # Buttons with nothing to do, so a long list scrolls.
        rows += [Row("button", label, value) for label, value in self.details[:2]]
        rows.append(Row("button", "Size", size))
        rows += [Row("button", label, value) for label, value in self.details[2:]]
        tested = compat.lookup(self.game.title_id, self.game.title)
        if tested is not None:
            rows.append(Row("header", "Tested"))
            rows.append(Row("button", compat.LABELS[tested["status"]], tested["result"]))
            rows.append(Row("button", "Tested on", f'{tested["console"]}, EmuFive {tested["version"]}'))
        rows.append(Row("header", "On this PS4"))
        rows.append(Row("button", "Play time", system.play_time_text(entry.get("play_seconds", 0))))
        return rows

    def act(self, action):
        if action in (BACK, OPTIONS, OK):
            self.home.sounds.play("back")
            self.close()
        else:
            self.act_rows(action)

    def hints(self):
        return [("circle", "Back")]


# --------------------------------------------------------------------------------------------
# The cheat manager (the Cheats tile, with Settings > Games > Cheat manager on): the cheat list
# from the HEN Cheats Collection, the games that have cheats, and each game's cheats to turn on.
# The choices are saved at once; ps5-launch gives them to the game the next time it starts.

def update_cheat_list(h, then=None):
    """Downloads the cheat list (Busy), then tells how it went and calls then()."""
    def after(ok, message):
        if ok:
            h.toast(message)
        else:
            h.push(Dialog(h, message))
        if then:
            then()

    h.push(Busy(h, "Downloading the cheat list…", cheats.update_index, after=after))


class CheatManager(Modal):
    """The Cheats tile's page, in the luxe look: the cover, the list's state and an Update
    button; below, your games, each with how many cheats are on (X opens its cheats)."""
    covers = True
    VISIBLE = 5

    def __init__(self, home):
        super().__init__(home)
        self.index = cheats.read_index()
        self.ask_update = not self.index["games"]      # First time: download the list at once.
        self.group = "list"
        self.row = 0
        self.top = 0

    def reload(self):
        self.index = cheats.read_index()

    def games(self):
        """The games on the drives with a title ID and version, each version once, those with
        cheats first: [(game, status, order)]."""
        seen, found = set(), []
        for g in self.home.all_games:
            key = (g.title_id.upper(), g.version)
            if g.title_id and g.version and key not in seen and not getattr(g, "stand_in", False):
                seen.add(key)
                on = cheats.enabled_count(g.title_id, g.version)
                if on:
                    status, order = f"{on} on", 0
                elif cheats.entries(self.index, g.title_id, g.version):
                    status, order = "Cheats", 1
                elif cheats.entries(self.index, g.title_id):
                    status, order = "Other version", 2
                else:
                    status, order = "No cheats", 3
                found.append((g, status, order))
        return sorted(found, key=lambda t: (t[2], t[0].title.lower()))

    def update(self, dt):
        super().update(dt)
        if self.ask_update and not self.closed and self.home.modals and self.home.modals[-1] is self:
            self.ask_update = False
            update_cheat_list(self.home, self.reload)

    def act(self, action):
        h = self.home
        games = self.games()
        if action in (BACK, GUIDE):
            h.sounds.play("back")
            self.close()
        elif action == TRIANGLE or (action == OK and self.group == "button"):
            h.sounds.play("select")
            update_cheat_list(h, self.reload)
        elif action == OK and games:
            h.sounds.play("select")
            h.push(CheatGame(h, games[self.row][0]))
        elif action == UP:
            if self.group == "list" and self.row > 0:
                self.row -= 1
                self.top = min(self.top, self.row)
                h.sounds.play("move")
            elif self.group == "list":
                self.group = "button"
                h.sounds.play("move")
        elif action == DOWN:
            if self.group == "button" and games:
                self.group = "list"
                h.sounds.play("move")
            elif self.group == "list" and self.row < len(games) - 1:
                self.row += 1
                self.top = max(self.top, self.row - self.VISIBLE + 1)
                h.sounds.play("move")

    def draw(self, c):
        accent, line = ui.ACCENT, luxe_line()
        rise = (1 - ease_out(self.appear)) * 16
        games = self.games()
        self.row = min(self.row, max(0, len(games) - 1))
        if self.index["games"]:
            day = time.strftime("%d %b %Y", time.localtime(self.index.get("updated", 0)))
            sub = f"HEN Cheats Collection  ·  {len(self.index['games'])} PS5 games  ·  updated {day}"
        else:
            sub = "The cheat list is not downloaded yet. It needs the internet."
        draw_luxe_header(c, i18n.translate("Cheats"), i18n.translate("Cheats"), sub, rise,
                         icon=lambda c, x, y: ui.draw_wand(c, x, y, 22, WHITE, 3))
        x0 = 90
        # The Update button at the right.
        label = i18n.translate("Update the cheat list")
        on = self.group == "button"
        w = c.t.width(label, 16, True) + 44
        bx = ui.W - x0 - w
        c.rect(accent if on else LUXE_INK + (170,), bx, 74 - rise, w, 42, 21)
        if not on:
            c.rect(accent, bx, 74 - rise, w, 42, 21, 1)
        c.text(label, 16, bx + w / 2, 95 - rise, LUXE_INK if on else WHITE, True, "center")
        # Your games.
        y = 200 - rise
        c.text(i18n.translate("Your games").upper(), 13, x0, y, accent, True)
        c.line(line, x0, y + 26, ui.W - x0, y + 26, 1)
        y += 44
        width = ui.W - 2 * x0
        if not games:
            c.text("No games yet. Games with a title ID and version show up here.", 17, ui.W / 2, y + 60,
                   SOFT, False, "midtop")
        for i in range(self.top, min(len(games), self.top + self.VISIBLE)):
            g, status, order = games[i]
            chosen = self.group == "list" and i == self.row
            if chosen:
                c.rect(accent + (26,), x0 - 14, y - 6, width + 28, 62, 6)
                c.rect(accent, x0 - 14, y - 6, 3, 62, 1)
            draw_game_icon(c, g, x0, y, 50)
            c.text(c.t.fit(g.title, 18, width - 330, True), 18, x0 + 68, y + 2, WHITE if order < 3 else SOFT, True)
            c.text(f"{g.title_id}  ·  {g.version}", 13, x0 + 68, y + 29, SOFT)
            shown = i18n.translate(status) if not status.endswith(" on") else status
            color = accent if order == 0 else WHITE if order == 1 else SOFT
            sw = c.t.width(shown, 15, True) + 28
            if order <= 1:
                c.rect(accent + (40,) if order == 0 else WHITE + (20,), x0 + width - sw, y + 11, sw, 28, 14)
            c.text(shown, 15, x0 + width - sw / 2, y + 25, color, order <= 1, "center")
            y += 68
        c.text("Cheats are turned on for each game version and are used the next time the game starts. "
               "Back up your saves first. The cheats come from the HEN Cheats Collection (TeeKay87).",
               12, x0, ui.H - 74, DIM)
        if len(games) > self.VISIBLE:
            c.text(f"{self.row + 1} / {len(games)}", 13, ui.W - x0, 222 - rise, SOFT, False, "topright")

    def hints(self):
        return [("cross", "Select"), ("triangle", "Update"), ("circle", "Back")]


class CheatGame(RowList):
    """One game's cheats: a toggle for each (for the game's version), saved as they change.
    Full screen in the luxe look, under the game's picture and name."""
    covers = True

    def __init__(self, home, game):
        super().__init__(home)
        self.game = game
        self.plan = None
        self.error = None
        self.loading = False
        self.load_list()

    def load_list(self):
        g = self.game
        self.index = cheats.read_index()
        self.files = cheats.entries(self.index, g.title_id, g.version)
        chosen = cheats.choice(g.title_id, g.version)
        names = [f["file"] for f in self.files]
        self.file = chosen.get("file") if chosen.get("file") in names else (names[0] if names else None)
        self.on = set(chosen.get("on", [])) if chosen.get("file") == self.file else set()
        self.load_file()

    def load_file(self):
        self.plan, self.error = None, None
        if not self.file:
            return
        self.loading = True
        name = self.file

        def work():
            plan, error = cheats.load(name)
            if plan is not None and error is None:
                error = cheats.problem(plan)
            if name == self.file:
                self.plan, self.error, self.loading = plan, error, False

        threading.Thread(target=work, daemon=True).start()

    def save(self, live=True):
        g = self.game
        cheats.set_choice(g.title_id, g.version, self.file if self.on else None, sorted(self.on))
        pid = cheats.running_pid(g.path) if live and self.home.settings["cheats"] else None
        if pid is None:
            return
        # The game is running (paused under this menu): change its cheats now.
        h, file, on = self.home, self.file, set(self.on)

        def work():
            ok, message = cheats.apply_live(pid, file, on)
            if message:
                h.toast(i18n.translate(message))

        threading.Thread(target=work, daemon=True).start()

    def live(self):
        return cheats.running_pid(self.game.path) is not None

    def flip(self, name):
        self.on.symmetric_difference_update({name})
        self.save()

    def all_off(self):
        self.on.clear()
        self.save()

    def pick_file(self):
        h = self.home

        def picked(name):
            if name and name != self.file:
                if self.on:
                    self.on = set()
                    self.save()           # The old file's cheats off in a running game.
                self.file = name
                self.save(live=False)
                self.load_file()

        items = [(f"{f['format']}  ·  {f['file'].rsplit('_', 1)[-1].split('.')[0]}", f["file"]) for f in self.files]
        h.push(Picker(h, "Cheat file", items, self.file, picked))

    def rows(self):
        h, g = self.home, self.game
        rows = []
        if not self.index["games"]:
            rows.append(Row("action", "Update the cheat list", ok=lambda: update_cheat_list(h, self.load_list)))
            rows.append(Row("info", "The cheat list is not downloaded yet. It needs the internet."))
            return rows
        if not self.files:
            rows.append(Row("info", f"No cheats for version {g.version} of this game."))
            others = sorted({e["version"] for e in cheats.entries(self.index, g.title_id)})
            if others:
                rows.append(Row("info", f"There are cheats for version {', '.join(others)}. Cheats only work "
                                        "with the version they were made for."))
            rows.append(Row("action", "Update the cheat list", ok=lambda: update_cheat_list(h, self.load_list)))
            return rows
        if len(self.files) > 1:
            current = next(f for f in self.files if f["file"] == self.file)
            rows.append(Row("choice", "Cheat file", f"{current['format']}  ·  "
                            f"{current['file'].rsplit('_', 1)[-1].split('.')[0]}", ok=self.pick_file))
        if self.loading:
            rows.append(Row("info", "Downloading the cheats…"))
            return rows
        if self.plan is None or self.error:
            rows.append(Row("info", self.error or "The cheats could not be read."))
            if self.plan is None:
                rows.append(Row("action", "Try again", ok=self.load_file))
            return rows
        rows.append(Row("header", "Cheats"))
        names = []
        for name in cheats.mod_names(self.plan):
            if name and name not in names:
                names.append(name)
                rows.append(Row("toggle", name, name in self.on, ok=lambda n=name: self.flip(n)))
        if self.on:
            rows.append(Row("action", "Turn all off", ok=self.all_off))
        made = cheats.credits(self.plan)
        if made:
            rows.append(Row("info", f"Made by {made}."))
        if self.live():
            rows.append(Row("info", "The game is running: cheats turn on and off at once. If the game "
                                    "stops working, turn its cheats off."))
        else:
            rows.append(Row("info", "Cheats are used the next time the game starts, and can be turned on "
                                    "and off during the game (PS button). If the game stops working, "
                                    "turn its cheats off."))
        if not h.settings["cheats"]:
            rows.append(Row("info", "The cheat manager is off in Settings > Games, so no cheats are used."))
        return rows

    def act(self, action):
        if action in (BACK, OPTIONS):
            self.home.sounds.play("back")
            self.close()
        else:
            self.act_rows(action)

    def draw(self, c):
        rise = (1 - ease_out(self.appear)) * 16
        draw_luxe_header(c, i18n.translate("Cheats"), self.game.title, self.game.subtitle(), rise,
                         picture=ui.circle_image(self.game.icon, px(96)) if self.game.icon else None,
                         icon=lambda c, x, y: ui.draw_wand(c, x, y, 22, WHITE, 3))
        on = len(self.on)
        if on:
            text = f"{on} on"
            w = c.t.width(text, 15, True) + 30
            c.rect(ui.ACCENT + (40,), ui.W - 90 - w, 80 - rise, w, 30, 15)
            c.text(text, 15, ui.W - 90 - w / 2, 95 - rise, ui.ACCENT, True, "center")
        x0, top = 90, 206 - rise
        rows = self.rows()
        self.current(rows)
        draw_rows(c, rows, self.row, x0, top, ui.W - 2 * x0, ui.H - 70, True, self.scroll(rows, top, ui.H - 70))

    def hints(self):
        return [("cross", "Select"), ("circle", "Back")]


# --------------------------------------------------------------------------------------------
# The quick menu (PS button): during a game (over it, paused) or on the home screen.

class QuickMenu(RowList):
    WIDTH = 470

    def __init__(self, home, in_game, title=""):
        super().__init__(home)
        self.in_game = in_game
        self.title = title

    def rows(self):
        h = self.home
        rows = []
        if self.in_game:
            rows.append(Row("action", "Resume the game", ok=lambda: h.finish("RESUME")))
            rows.append(Row("action", "Home", ok=lambda: h.finish("HOME")))
            if h.game_cheats_page() is not None:
                rows.append(Row("action", "Cheats", ok=lambda: h.push(h.game_cheats_page()())))
            rows.append(Row("action", "Close the game", ok=lambda: h.push(Dialog(
                h, f"Close {self.title or 'the game'}? What the game has not saved is lost.",
                [("Close", lambda: h.finish("CLOSE")), ("Cancel", None)]))))
        else:
            rows.append(Row("action", "Settings", ok=lambda: (self.close(), h.push(SettingsScreen(h)))))
            if len(h.profiles.all()) > 1:
                rows.append(Row("action", "Switch profile", ok=lambda: (self.close(), h.push(ProfilePicker(h)))))
        count = len(store.notifications())
        rows.append(Row("action", "Notifications", str(count) if count else None,
                        ok=lambda: (self.close() if not self.in_game else None, h.push(NotificationList(h)))))
        volume = h.poll.get("volume", system.sound_volume, 2.0)
        rows.append(Row("slider", "Volume", volume if volume is not None else 0,
                        left=lambda: change_volume(h, -5), right=lambda: change_volume(h, 5)))
        rows.append(Row("header", "Controllers"))
        pads = h.poll.get("controllers", system.controllers, 1.0, [])
        if not pads:
            rows.append(Row("info", "No controller found."))
        for pad in pads:
            rows.append(Row("info", pad["name"], pad_status(pad)))
        for pad in pads:
            if pad["connection"] == "Bluetooth":
                mac = pad["mac"]
                label = pad["name"] + ("  ·  " + mac[-5:] if len(pads) > 1 else "")
                rows.append(Row("action", "Disconnect controller", label, ok=lambda m=mac: disconnect_pad(h, m)))
        rows.append(Row("header", "Power"))
        closing = " The game is closed first." if self.in_game else ""
        rows.append(Row("button", "Restart the PS4", ok=lambda: h.push(Dialog(
            h, "Restart the PS4?" + closing, [("Restart", lambda: h.finish("REBOOT")), ("Cancel", None)]))))
        rows.append(Row("button", "Turn off the PS4", ok=lambda: h.push(Dialog(
            h, "Turn off the PS4?" + closing, [("Turn off", lambda: h.finish("POWEROFF")), ("Cancel", None)]))))
        return rows

    def act(self, action):
        h = self.home
        if action in (BACK, GUIDE):
            h.sounds.play("back")
            if self.in_game:
                h.finish("RESUME")
            else:
                self.close()
        else:
            self.act_rows(action)

    def draw(self, c):
        h = self.home
        slide = ease_out(self.appear)
        left = -self.WIDTH * (1 - slide)
        c.dim(140 * slide)
        c.rect(PANEL, left, 0, self.WIDTH, ui.H)
        c.line(PANEL_LINE, left + self.WIDTH, 0, left + self.WIDTH, ui.H, 1)
        x = left + 40
        right = left + self.WIDTH - 40
        rtl = i18n.rtl()
        if rtl:
            c.text("Quick menu", 28, right, 40, WHITE, True, "topright")
            c.text(clock_text(h.settings["clock_24h"]), 18, x, 46, WHITE, True)
        else:
            c.text("Quick menu", 28, x, 40, WHITE, True)
            c.text(clock_text(h.settings["clock_24h"]), 18, right, 46, WHITE, True, "topright")
        top = 100
        if self.in_game and self.title:
            title = c.t.fit(self.title, 16, self.WIDTH - 140)
            if rtl:
                c.text(title, 16, right, 84, SOFT, False, "topright")
                c.text("PAUSED", 13, x, 86, (255, 205, 90), True)
            else:
                c.text(title, 16, x, 84, SOFT)
                c.text("PAUSED", 13, right, 86, (255, 205, 90), True, "topright")
            top = 124
        rows = self.rows()
        self.current(rows)
        draw_rows(c, rows, self.row, x, top, self.WIDTH - 80, ui.H - 60, True, self.scroll(rows, top, ui.H - 60))

    def hints(self):
        return [("cross", "Select"), ("ps", "Resume" if self.in_game else "Close"), ("circle", "Back")]


class CenterPopup(RowList):
    """A small card above one Control Center button: its rows (Sound, Controllers, Power)."""

    def __init__(self, home, center, title, make_rows, x):
        super().__init__(home)
        self.center = center
        self.title = title
        self.make_rows = make_rows
        self.x = x

    def rows(self):
        return self.make_rows()

    def act(self, action):
        h = self.home
        if action == BACK:
            h.sounds.play("back")
            self.close()
        elif action == GUIDE:
            self.close()
            self.center.act(GUIDE)
        else:
            self.act_rows(action)

    def draw(self, c):
        rows = self.rows()
        self.current(rows)
        w = 440
        hgt = 70 + sum(r.height() + 4 for r in rows)
        x = max(40, min(ui.W - 40 - w, self.x - w / 2))
        y = ControlCenter.TOP - 16 - hgt + (1 - ease_out(self.appear)) * 10
        c.rect(LUXE_CARD + (250,), x, y, w, hgt, 18)
        c.rect(luxe_line(), x, y, w, hgt, 18, 1)
        c.text(self.title, 20, x + 26, y + 20, WHITE, True)
        draw_rows(c, rows, self.row, x + 26, y + 60, w - 52, y + hgt, True)

    def hints(self):
        return [("cross", "Select"), ("circle", "Back")]


class ControlCenter(Modal):
    """The PS button menu in the PS5 layout, as a PS5's control center: a dark band across the
    bottom; above, cards for the game (Resume, Home, Close) or the home screen (Profile,
    Settings, Switch profile); below, round buttons (Notifications, Sound, Controllers, Power)
    that open a small card of their own. The Aurora layout keeps the side panel (QuickMenu)."""
    TOP = 400                      # Where the band starts (units).
    BUTTONS = [("Notifications", "bell"), ("Sound", "Sound"), ("Controllers", "Controllers"), ("Power", "Power")]

    def __init__(self, home, in_game, title=""):
        super().__init__(home)
        self.in_game = in_game
        self.title = title
        self.row = "cards"
        self.index = 0
        self.legacy = QuickMenu(home, in_game, title)     # Its rows: sound, controllers, power.

    def cards(self):
        h = self.home
        if self.in_game:
            cards = [("Resume the game", "play", lambda: h.finish("RESUME")),
                     ("Home", "home", lambda: h.finish("HOME")),
                     ("Close the game", "close", lambda: h.push(Dialog(
                         h, f"Close {self.title or 'the game'}? What the game has not saved is lost.",
                         [("Close", lambda: h.finish("CLOSE")), ("Cancel", None)])))]
            if h.game_cheats_page() is not None:
                cards.insert(2, ("Cheats", "wand", lambda: h.push(h.game_cheats_page()())))
            return cards
        cards = [("Profile", "Profile", lambda: (self.close(), h.push(ProfileView(h)))),
                 ("Settings", "gear", lambda: (self.close(), h.push(SettingsScreen(h))))]
        if len(h.profiles.all()) > 1:
            cards.append(("Switch profile", "Profile", lambda: (self.close(), h.push(ProfilePicker(h)))))
        return cards

    def section(self, name):
        """The rows of one button's card, taken from the quick menu's rows."""
        rows = self.legacy.rows()
        if name == "Sound":
            return [r for r in rows if r.label == "Volume"]
        if name == "Power":
            return [r for r in rows if r.label in ("Restart the PS4", "Turn off the PS4")]
        start = next(i for i, r in enumerate(rows) if r.kind == "header" and r.label == "Controllers")
        end = next(i for i, r in enumerate(rows) if r.kind == "header" and r.label == "Power")
        return rows[start + 1:end]

    def act(self, action):
        h = self.home
        count = len(self.cards()) if self.row == "cards" else len(self.BUTTONS)
        if action in (BACK, GUIDE):
            h.sounds.play("back")
            if self.in_game:
                h.finish("RESUME")
            else:
                self.close()
        elif action in (LEFT, RIGHT):
            step = (1 if action == RIGHT else -1) * (-1 if i18n.rtl() else 1)
            if 0 <= self.index + step < count:
                self.index += step
                h.sounds.play("move")
        elif action in (UP, DOWN):
            to = "cards" if action == UP else "buttons"
            if to != self.row:
                self.row = to
                self.index = min(self.index, (len(self.cards()) if to == "cards" else len(self.BUTTONS)) - 1)
                h.sounds.play("move")
        elif action == OK:
            h.sounds.play("select")
            if self.row == "cards":
                self.cards()[self.index][2]()
                return
            name = self.BUTTONS[self.index][0]
            if name == "Notifications":
                if not self.in_game:
                    self.close()
                h.push(NotificationList(h) if self.in_game else ProfileView(h))
                h.poll.forget("unread")
                return
            h.push(CenterPopup(h, self, i18n.translate(name), lambda n=name: self.section(n), self.button_x(self.index)))

    def button_x(self, i):
        return ui.W / 2 - (len(self.BUTTONS) - 1) * 50 + i * 100

    def draw(self, c):
        h = self.home
        a = ease_out(self.appear)
        c.dim(150 * a)
        top = self.TOP + (1 - a) * 40
        band = LUXE_PANEL
        c.rect(band, 0, top, ui.W, ui.H - top)
        c.line(luxe_line(), 0, top, ui.W, top, 1)
        accent = ui.ACCENT
        # The game (or the home screen) at the left, the time at the right.
        x0 = 80
        if self.in_game:
            c.text("PAUSED", 13, x0, top + 26, accent, True)
            c.text(c.t.fit(self.title, 24, 560, True), 24, x0, top + 44, WHITE, True)
        else:
            c.text(i18n.translate("Home").upper(), 13, x0, top + 26, accent, True)
            c.text(c.t.fit(h.settings["name"], 24, 560, True), 24, x0, top + 44, WHITE, True)
        c.text(clock_text(h.settings["clock_24h"]), 24, ui.W - x0, top + 40, WHITE, True, "topright")
        c.text(time.strftime("%a %d %b"), 13, ui.W - x0, top + 26, SOFT, False, "topright")
        # The cards.
        cards = self.cards()
        cw, ch, gap = 250, 92, 16
        cx = x0
        cy = top + 86
        for i, (label, icon, _) in enumerate(cards):
            on = self.row == "cards" and i == self.index
            c.rect(WHITE if on else WHITE + (18,), cx, cy, cw, ch, 14)
            if not on:
                c.rect(WHITE + (40,), cx, cy, cw, ch, 14, 1)
            fg = INK if on else WHITE
            ix, iy = cx + 40, cy + ch / 2
            if icon == "play":
                c.polygon(fg, [(ix - 8, iy - 11), (ix - 8, iy + 11), (ix + 11, iy)])
            elif icon == "home":
                c.polygon(fg, [(ix - 12, iy - 1), (ix, iy - 12), (ix + 12, iy - 1)])
                c.rect(fg, ix - 8, iy - 1, 16, 12, 2)
            elif icon == "close":
                c.line(fg, ix - 9, iy - 9, ix + 9, iy + 9, 3)
                c.line(fg, ix - 9, iy + 9, ix + 9, iy - 9, 3)
            elif icon == "gear":
                ui.draw_gear(c, ix, iy, fg)
            elif icon == "wand":
                ui.draw_wand(c, ix, iy, 22, fg, 3)
            else:
                category_icon(c, icon, ix, iy, fg, 13)
            c.text(c.t.fit(label, 18, cw - 90, True), 18, cx + 74, iy, fg, True, "midleft")
            cx += cw + gap
        # The round buttons.
        by = top + 214
        unread = h.poll.get("unread", store.unread_notifications, 2.0, 0)
        for i, (name, icon) in enumerate(self.BUTTONS):
            bx = self.button_x(i)
            on = self.row == "buttons" and i == self.index
            c.circle(WHITE if on else LUXE_KEY, bx, by, 30)
            fg = INK if on else WHITE
            if icon == "bell":
                ui.draw_bell(c, bx, by - 1, fg)
            else:
                category_icon(c, icon, bx, by, fg, 13)
            if name == "Notifications" and unread:
                c.circle(band, bx + 22, by - 22, 9)
                c.circle(accent, bx + 22, by - 22, 7)
            if on:
                c.text(i18n.translate(name), 15, bx, by + 38, WHITE, True, "midtop")

    def hints(self):
        return [("cross", "Select"), ("ps", "Resume" if self.in_game else "Close"), ("circle", "Back")]


# --------------------------------------------------------------------------------------------
# Date and time by hand: Left / Right choose a part, Up / Down change it, X saves.

class DateTimeEditor(Modal):
    FIELDS = ("day", "month", "year", "hour", "minute")

    def __init__(self, home):
        super().__init__(home)
        import datetime
        now = datetime.datetime.now()
        self.values = {"day": now.day, "month": now.month, "year": now.year, "hour": now.hour,
                       "minute": now.minute}
        self.field = 0

    def days(self):
        import calendar
        return calendar.monthrange(self.values["year"], self.values["month"])[1]

    def change(self, step):
        v = self.values
        name = self.FIELDS[self.field]
        low, high = {"day": (1, self.days()), "month": (1, 12), "year": (2024, 2099), "hour": (0, 23),
                     "minute": (0, 59)}[name]
        v[name] = low + (v[name] - low + step) % (high - low + 1)
        v["day"] = min(v["day"], self.days())

    def act(self, action):
        h = self.home
        if action in (LEFT, RIGHT):
            self.field = (self.field + (1 if action == RIGHT else -1)) % len(self.FIELDS)
            h.sounds.play("move")
        elif action in (UP, DOWN):
            self.change(1 if action == UP else -1)
            h.sounds.play("move")
        elif action == OK:
            import datetime
            when = datetime.datetime(*(self.values[k] for k in ("year", "month", "day", "hour", "minute")))
            h.sounds.play("select")
            self.close()
            h.push(Busy(h, "Setting the date and time…", lambda: system.set_time(when),
                        after=lambda ok, msg: (h.poll.forget("ntp"),
                                               h.toast("Date and time saved") if ok else
                                               h.push(Dialog(h, msg or "Could not set it.")))))
        elif action == BACK:
            h.sounds.play("back")
            self.close()

    def draw(self, c):
        a = ease_out(self.appear)
        c.dim(170 * a)
        w, ht = 760, 330
        x, y = ui.W / 2 - w / 2, ui.H / 2 - ht / 2 + (1 - a) * 20
        c.rect(DIALOG, x, y, w, ht, 20)
        c.text("Date and time", 26, ui.W / 2, y + 30, WHITE, True, "midtop")
        labels = {"day": "Day", "month": "Month", "year": "Year", "hour": "Hour", "minute": "Minute"}
        widths = {"day": 96, "month": 96, "year": 140, "hour": 96, "minute": 96}
        gap = 22
        total = sum(widths.values()) + gap * (len(self.FIELDS) - 1) + 40
        bx = ui.W / 2 - total / 2
        for i, name in enumerate(self.FIELDS):
            if name == "hour":
                bx += 40          # Space between the date and the time.
            on = i == self.field
            bw = widths[name]
            c.text(labels[name], 15, bx + bw / 2, y + 88, SOFT, False, "midtop")
            c.rect(WHITE if on else KEY, bx, y + 130, bw, 90, 16)
            value = f"{self.values[name]:04d}" if name == "year" else f"{self.values[name]:02d}"
            c.text(value, 40, bx + bw / 2, y + 175, INK if on else WHITE, True, "center")
            if on:
                mx = bx + bw / 2           # Up and down arrows, drawn (the fonts have no arrows).
                c.polygon(WHITE, [(mx, y + 112), (mx - 9, y + 123), (mx + 9, y + 123)])
                c.polygon(WHITE, [(mx, y + 238), (mx - 9, y + 227), (mx + 9, y + 227)])
            bx += bw + gap

    def hints(self):
        return [("cross", "Save"), (None, "Up / Down: change"), (None, "Left / Right: next"), ("circle", "Cancel")]


# --------------------------------------------------------------------------------------------
# Profiles: "Who's playing?" (at the start with more than one profile, and Switch profile).

def add_profile(h):
    def done(text):
        text = text.strip()
        if not text:
            return "Type a name."
        count = len(h.profiles.all())
        new_id = h.profiles.add(text, f"builtin:{count % ui.BUILTIN_AVATARS}")
        if new_id is None:
            return "Up to 8 profiles."
        h.switch_profile(new_id)
        return None

    h.push(KeyboardDialog(h, "Name of the new profile", "", on_done=done, max_length=16))


class ProfilePicker(Modal):
    covers = True
    SIZE, GAP = 150, 54

    def __init__(self, home):
        super().__init__(home)
        self.items = home.profiles.all()
        ids = [p["id"] for p in self.items]
        self.index = ids.index(home.profiles.current_id) if home.profiles.current_id in ids else 0

    def count(self):
        return len(self.items) + (1 if len(self.items) < store.MAX_PROFILES else 0)

    def act(self, action):
        h = self.home
        if action in (LEFT, RIGHT):
            step = -1 if action == LEFT else 1
            if i18n.rtl():
                step = -step
            new = max(0, min(self.count() - 1, self.index + step))
            if new != self.index:
                self.index = new
                h.sounds.play("move")
        elif action == OK:
            h.sounds.play("select")
            self.close()
            if self.index < len(self.items):
                if self.items[self.index]["id"] != h.profiles.current_id:
                    h.switch_profile(self.items[self.index]["id"])
            else:
                add_profile(h)
        elif action in (BACK, GUIDE):
            h.sounds.play("back")
            self.close()

    def draw(self, c):
        h = self.home
        draw_luxe_cover(c, 300)
        a = ease_out(self.appear)
        rise = (1 - a) * 12
        accent = ui.ACCENT
        c.text(i18n.translate("Profile").upper(), 13, ui.W / 2, 118 - rise, accent, True, "midtop")
        c.text("Who's playing?", 36, ui.W / 2, 140 - rise, WHITE, True, "midtop")
        c.rect(accent, ui.W / 2 - 22, 196 - rise, 44, 3, 1)
        n = self.count()
        total = n * self.SIZE + (n - 1) * self.GAP
        order = list(range(n))
        if i18n.rtl():
            order.reverse()
        for slot, i in enumerate(order):
            x = ui.W / 2 - total / 2 + slot * (self.SIZE + self.GAP)
            y = 280 - rise
            on = i == self.index
            cx, cy = x + self.SIZE / 2, y + self.SIZE / 2
            if on:
                glow = glow_sprite(px(self.SIZE * 1.3), ui.mix((0, 0, 0), accent, 0.5))
                c.s.blit(glow, glow.get_rect(center=(px(cx), px(cy))), special_flags=pygame.BLEND_RGB_ADD)
            c.circle(LUXE_INK, cx, cy, self.SIZE / 2 + 10)
            c.circle(accent if on else luxe_line(), cx, cy, self.SIZE / 2 + 7, 3 if on else 1)
            if i < len(self.items):
                profile = self.items[i]
                c.blit(h.avatar(self.SIZE, profile), x, y)
                name = c.t.fit(profile["name"], 20, self.SIZE + self.GAP - 10, on)
            else:
                c.circle(LUXE_KEY, cx, cy, self.SIZE / 2)
                col = accent if on else SOFT
                c.line(col, cx - 22, cy, cx + 22, cy, 3)
                c.line(col, cx, cy - 22, cx, cy + 22, 3)
                name = c.t.fit("Add a profile", 20, self.SIZE + self.GAP - 10, on)
            c.text(name, 20, cx, y + self.SIZE + 28, WHITE if on else SOFT, on, "midtop")
            if i < len(self.items) and self.items[i]["id"] == h.profiles.current_id:
                c.circle(accent, cx, y + self.SIZE + 64, 3)

    def hints(self):
        return [("cross", "Choose"), ("circle", "Back")]


class ProfileView(Modal):
    """The avatar in the top bar: the profile's own page, laid out as on a PS5, near black in the
    accent color. A cover across the top (draw_luxe_cover), the avatar
    over its edge, the name and the trophies earned; buttons to change the avatar, switch profile
    and open the settings. Below, tabs: Notifications (a timeline, newest first, Square clears
    them), Games (by last played, with play time) and Trophies (per game)."""
    covers = True
    BUTTONS = ["Change avatar", "Switch profile", "Settings"]
    TABS = ["Notifications", "Games", "Trophies"]
    VISIBLE = 4
    INK = LUXE_INK
    COVER_H = 232

    def __init__(self, home):
        super().__init__(home)
        self.seen = store.read_json(store.NOTIFICATIONS_FILE).get("seen", 0)
        store.mark_notifications_read()
        self.items = store.notifications()
        self.tab = 0
        self.group = "list" if self.items else "buttons"
        self.button = 0
        self.row = 0
        self.top = 0

    # What the tabs list ------------------------------------------------------------------------

    def played_games(self):
        h = self.home
        games = [g for g in h.games if h.entries.get(g.path, {}).get("last_played")]
        return sorted(games, key=lambda g: -h.entries[g.path]["last_played"]) + \
            sorted((g for g in h.games if g not in games), key=lambda g: g.title.lower())

    def trophy_games(self):
        h = self.home
        rows = []
        for g in h.games:
            summary = h.trophy_summary(g)
            if summary:
                rows.append((g, summary))
        return rows

    def lines(self):
        name = self.TABS[self.tab]
        if name == "Notifications":
            return self.items
        if name == "Games":
            return self.played_games()
        return self.trophy_games()

    def totals(self):
        grades = {"platinum": 0, "gold": 0, "silver": 0, "bronze": 0}
        for _, (_, _, counts) in self.trophy_games():
            for g in grades:
                grades[g] += counts.get(g, 0)
        return grades

    # Moving ------------------------------------------------------------------------------------

    def act(self, action):
        h = self.home
        lines = self.lines()
        if action in (BACK, GUIDE):
            h.sounds.play("back")
            self.close()
        elif action in (PAGE_UP, PAGE_DOWN):
            self.set_tab(self.tab + (1 if action == PAGE_DOWN else -1))
        elif action == SQUARE and self.TABS[self.tab] == "Notifications" and self.items:
            h.sounds.play("select")
            store.clear_notifications()
            self.items, self.row, self.top = [], 0, 0
            self.group = "tabs"
        elif action == OK:
            self.choose(lines)
        elif action in (LEFT, RIGHT):
            step = (1 if action == RIGHT else -1) * (-1 if i18n.rtl() else 1)
            if self.group == "buttons" and 0 <= self.button + step < len(self.BUTTONS):
                self.button += step
                h.sounds.play("move")
            elif self.group == "tabs":
                self.set_tab(self.tab + step)
        elif action == UP:
            if self.group == "list" and self.row > 0:
                self.row -= 1
                self.top = min(self.top, self.row)
                h.sounds.play("move")
            elif self.group in ("list", "tabs"):
                self.group = "tabs" if self.group == "list" else "buttons"
                h.sounds.play("move")
        elif action == DOWN:
            if self.group == "buttons":
                self.group = "tabs"
                h.sounds.play("move")
            elif self.group == "tabs" and lines:
                self.group = "list"
                h.sounds.play("move")
            elif self.group == "list" and self.row < len(lines) - 1:
                self.row += 1
                self.top = max(self.top, self.row - self.VISIBLE + 1)
                h.sounds.play("move")

    def set_tab(self, tab):
        if 0 <= tab < len(self.TABS) and tab != self.tab:
            self.tab, self.row, self.top = tab, 0, 0
            if self.group == "list" and not self.lines():
                self.group = "tabs"
            self.home.sounds.play("move")

    def choose(self, lines):
        h = self.home
        if self.group == "buttons":
            h.sounds.play("select")
            name = self.BUTTONS[self.button]
            if name == "Change avatar":
                h.push(AvatarPicker(h))
            else:
                self.close()
                h.push(ProfilePicker(h) if name == "Switch profile" else SettingsScreen(h))
        elif self.group == "list" and self.row < len(lines):
            name = self.TABS[self.tab]
            if name == "Games":
                h.sounds.play("select")
                self.close()
                h.focus = "tiles"
                h.select(h.games.index(lines[self.row]))
            elif name == "Trophies":
                h.sounds.play("select")
                h.push(TrophyList(h, lines[self.row][0]))

    def hints(self):
        hints = [("l1r1", "Tabs")]
        if self.group == "buttons" or (self.group == "list" and self.TABS[self.tab] != "Notifications"):
            hints.insert(0, ("cross", "Select"))
        if self.TABS[self.tab] == "Notifications" and self.items:
            hints.append(("square", "Clear all"))
        return hints + [("circle", "Back")]

    # Drawing -----------------------------------------------------------------------------------

    def when(self, stamp, date_only=False):
        clock24 = self.home.settings["clock_24h"]
        form = "%d %b %Y" if date_only else "%d %b  %H:%M" if clock24 else "%d %b  %I:%M %p"
        return time.strftime(form, time.localtime(stamp))

    @staticmethod
    def hours(seconds):
        return f"{int(seconds // 3600)}h {int(seconds % 3600 // 60)}m" if seconds >= 3600 else f"{int(seconds // 60)}m"

    def draw(self, c):
        h = self.home
        ink, gold, line = LUXE_INK, ui.ACCENT, luxe_line()
        rise = (1 - ease_out(self.appear)) * 16
        draw_luxe_cover(c, self.COVER_H)
        x0 = 90
        # The avatar over the cover's edge, the name, the trophies ---------------------------------
        ax, ay = x0 + 85, self.COVER_H - rise
        c.circle(ink, ax, ay, 98)
        c.circle(gold, ax, ay, 92, 2)
        c.blit(h.avatar(170), ax, ay, "center")
        nx = x0 + 200
        c.text(i18n.translate("Profile").upper(), 13, nx, self.COVER_H - 44 - rise, gold, True)
        name_w = c.text(c.t.fit(h.settings["name"], 40, 420, True), 40, nx, self.COVER_H - 26 - rise, WHITE, True)
        grades = self.totals()
        # The trophy level: a ring filling toward the next level, the number inside.
        level, progress = trophy_level(grades)
        lx, ly = nx + name_w + 46, self.COVER_H - rise
        c.circle(line, lx, ly, 22, 3)
        if progress > 0:
            c.arc(gold, lx - 22, ly - 22, 44, 44, math.pi / 2 - 2 * math.pi * progress, math.pi / 2, 3)
        c.text(str(level), 17 if level < 100 else 14, lx, ly, WHITE, True, "center")
        c.text(i18n.translate("Level").upper(), 10, lx, ly + 28, gold, True, "midtop")
        tx = nx
        ty = self.COVER_H + 44 - rise
        for grade in ("platinum", "gold", "silver", "bronze"):
            draw_cup(c, tx + 10, ty + 12, 22, grade, grades[grade] > 0)
            w = c.text(str(grades[grade]), 18, tx + 28, ty + 1, WHITE if grades[grade] else SOFT, True)
            tx += w + 52
        games = len(h.games)
        played = sum(h.entries.get(g.path, {}).get("play_seconds", 0) for g in h.games)
        c.text(f"{games}  " + i18n.translate("Games") + "   ·   " + self.hours(played) + "  " +
               i18n.translate("Played"), 15, tx + 10, ty + 3, SOFT)
        # The buttons, at the right ---------------------------------------------------------------
        bx = ui.W - x0
        for i in reversed(range(len(self.BUTTONS))):
            label = self.BUTTONS[i]
            on = self.group == "buttons" and i == self.button
            w = c.t.width(label, 16, True) + 40
            bx -= w
            c.rect(gold if on else LUXE_INK + (170,), bx, self.COVER_H - 2 - rise, w, 40, 20)
            if not on:
                c.rect(gold, bx, self.COVER_H - 2 - rise, w, 40, 20, 1)
            c.text(label, 16, bx + w / 2, self.COVER_H + 18 - rise, ink if on else WHITE, True, "center")
            bx -= 12
        # The tabs -----------------------------------------------------------------------------------
        y = self.COVER_H + 104 - rise
        c.line(line, x0, y + 36, ui.W - x0, y + 36, 1)
        draw_luxe_tabs(c, self.TABS, self.tab, x0, y, self.group == "tabs")
        if self.TABS[self.tab] == "Notifications" and self.items:
            fresh = sum(1 for item in self.items if item.get("time", 0) > self.seen)
            text = (i18n.translate("{n} new").format(n=fresh) + "  ·  " if fresh else "") + (
                i18n.translate("1 notification") if len(self.items) == 1 else
                i18n.translate("{n} notifications").format(n=len(self.items)))
            c.text(text, 14, ui.W - x0, y + 4, SOFT, False, "topright")
        # The list ----------------------------------------------------------------------------------
        lines = self.lines()
        y += 56
        if not lines:
            empty = {"Notifications": "No notifications yet.", "Games": "No games here",
                     "Trophies": "No trophies yet."}[self.TABS[self.tab]]
            c.text(empty, 18, ui.W / 2, y + 60, SOFT, False, "midtop")
            return
        name = self.TABS[self.tab]
        width = ui.W - 2 * x0
        for i in range(self.top, min(len(lines), self.top + self.VISIBLE)):
            on = self.group == "list" and i == self.row
            if on:
                c.rect(gold + (24,), x0 - 14, y - 6, width + 28, 58, 6)
                c.rect(gold, x0 - 14, y - 6, 3, 58, 1)
            getattr(self, "line_" + name.lower())(c, lines[i], x0, y, width, on)
            y += 64
        if len(lines) > self.VISIBLE:
            c.text(f"{self.row + 1} / {len(lines)}", 13, ui.W - x0, ui.H - 52, SOFT, False, "topright")

    def line_notifications(self, c, item, x, y, width, on):
        new = item.get("time", 0) > self.seen
        c.circle(ui.ACCENT if (on or new) else luxe_line(), x + 8, y + 22, 5, 0 if (on or new) else 1)
        stamp = self.when(item.get("time", 0)).upper()
        sw = c.text(stamp, 12, x + 30, y + 2, ui.ACCENT, True)
        c.text(c.t.fit(item.get("title", ""), 18, width - sw - 80, True), 18, x + 30 + sw + 20, y - 2, WHITE, True)
        if item.get("text"):
            c.text(c.t.fit(item["text"], 14, width - 40), 14, x + 30, y + 24, SOFT)

    def line_games(self, c, game, x, y, width, on):
        h = self.home
        draw_game_icon(c, game, x, y, 46)
        entry = h.entries.get(game.path, {})
        c.text(c.t.fit(game.title, 18, width - 300, True), 18, x + 64, y + 1, WHITE, True)
        last = entry.get("last_played")
        c.text(i18n.translate("Last played: {game}").format(game=self.when(last, True)) if last
               else i18n.translate("Not played yet"), 14, x + 64, y + 26, SOFT)
        c.text(self.hours(entry.get("play_seconds", 0)), 20, x + width, y + 10, ui.ACCENT, True, "topright")

    def line_trophies(self, c, row, x, y, width, on):
        game, (earned, total, grades) = row
        draw_game_icon(c, game, x, y, 46)
        c.text(c.t.fit(game.title, 18, width - 460, True), 18, x + 64, y + 1, WHITE, True)
        bar_w = 220
        c.rect(luxe_line(), x + 64, y + 32, bar_w, 4, 2)
        c.rect(ui.ACCENT, x + 64, y + 32, max(4, bar_w * earned / max(1, total)), 4, 2)
        c.text(f"{earned} / {total}", 13, x + 64 + bar_w + 14, y + 26, SOFT)
        gx = x + width
        for grade in ("bronze", "silver", "gold", "platinum"):
            w = c.text(str(grades.get(grade, 0)), 16, gx, y + 12, WHITE, True, "topright")
            draw_cup(c, gx - w - 16, y + 22, 18, grade, grades.get(grade, 0) > 0)
            gx -= w + 50


# --------------------------------------------------------------------------------------------
# Trophies of one game (full screen).

GRADE_COLORS = {"platinum": ((230, 236, 255), (150, 160, 200)), "gold": ((255, 215, 90), (200, 140, 30)),
                "silver": ((225, 228, 235), (140, 145, 160)), "bronze": ((235, 160, 100), (150, 85, 40))}


def draw_cup(c, x, y, size, grade, earned=True):
    light, dark = GRADE_COLORS.get(grade, GRADE_COLORS["bronze"])
    if not earned:
        light, dark = ui.mix(light, (90, 90, 100), 0.7), ui.mix(dark, (60, 60, 70), 0.7)
    s = size
    c.polygon(dark, [(x - s * 0.42, y - s * 0.45), (x + s * 0.42, y - s * 0.45), (x + s * 0.3, y + s * 0.05),
                     (x - s * 0.3, y + s * 0.05)])
    c.polygon(light, [(x - s * 0.36, y - s * 0.45), (x + s * 0.2, y - s * 0.45), (x + s * 0.12, y),
                      (x - s * 0.26, y)])
    c.rect(dark, x - s * 0.06, y + s * 0.05, s * 0.12, s * 0.2)
    c.rect(light, x - s * 0.28, y + s * 0.25, s * 0.56, s * 0.12, 2)


class TrophyList(Modal):
    covers = True
    VISIBLE = 6         # Drawn in the luxe look (draw_luxe_cover), like the profile page.

    def __init__(self, home, game):
        super().__init__(home)
        self.game = game
        self.title = game.title
        self.trophies = None
        self.icons = {}
        self.top = 0
        self.row = 0

        def load():
            title, items = system.trophies(game.path, game.title_id, home.settings["console_language"],
                                           home.profiles.current_id)
            for t in items:
                if t["icon"]:
                    try:
                        import io
                        picture = pygame.image.load(io.BytesIO(t["icon"]))
                        self.icons[t["id"]] = pygame.transform.smoothscale(picture, (px(60), px(60)))
                    except pygame.error:
                        pass
            self.title = title or game.title
            self.trophies = items

        threading.Thread(target=load, daemon=True).start()

    def act(self, action):
        h = self.home
        items = self.trophies or []
        step = {UP: -1, DOWN: 1, PAGE_UP: -6, PAGE_DOWN: 6}.get(action)
        if step and items:
            self.row = max(0, min(len(items) - 1, self.row + step))
            h.sounds.play("move")
        elif action in (BACK, GUIDE):           # X on a trophy does nothing (it only shows).
            h.sounds.play("back")
            self.close()

    def draw(self, c):
        accent, line = ui.ACCENT, luxe_line()
        rise = (1 - ease_out(self.appear)) * 16
        draw_luxe_cover(c, 190)
        x0 = 90
        c.circle(LUXE_INK, x0 + 50, 96 - rise, 58)
        c.circle(accent, x0 + 50, 96 - rise, 54, 2)
        c.blit(ui.circle_image(self.game.icon, px(96)), x0 + 50, 96 - rise, "center")
        tx = x0 + 130
        c.text(i18n.translate("Trophies").upper(), 13, tx, 46 - rise, accent, True)
        c.text(c.t.fit(self.title, 32, ui.W - tx - 420, True), 32, tx, 64 - rise, WHITE, True)
        if self.trophies is None:
            c.text("Reading the trophies…", 16, tx, 112 - rise, SOFT)
            return
        items = self.trophies
        earned = [t for t in items if t["earned"]]
        percent = int(round(100 * len(earned) / max(1, len(items))))
        c.rect(line, tx, 118 - rise, 300, 4, 2)
        c.rect(accent, tx, 118 - rise, max(4, 300 * percent / 100), 4, 2)
        c.text(f"{len(earned)} / {len(items)}  ·  {percent}%", 14, tx + 316, 110 - rise, SOFT)
        x = ui.W - x0
        for grade in ("bronze", "silver", "gold", "platinum"):
            total = sum(1 for t in items if t["grade"] == grade)
            if not total:
                continue
            got = sum(1 for t in items if t["grade"] == grade and t["earned"])
            w = c.text(f"{got}/{total}", 17, x, 80 - rise, WHITE if got else SOFT, True, "topright")
            draw_cup(c, x - w - 18, 91 - rise, 26, grade, got > 0)
            x -= w + 64
        if self.row < self.top:
            self.top = self.row
        if self.row >= self.top + self.VISIBLE:
            self.top = self.row - self.VISIBLE + 1
        y = 196 - rise
        width = ui.W - 2 * x0
        for i in range(self.top, min(len(items), self.top + self.VISIBLE)):
            t = items[i]
            on = i == self.row
            if on:
                c.rect(accent + (26,), x0 - 14, y - 4, width + 28, 68, 6)
                c.rect(accent, x0 - 14, y - 4, 3, 68, 1)
            elif i > self.top:
                c.line(line, x0, y - 4, x0 + width, y - 4, 1)
            secret = t["hidden"] and not t["earned"]
            icon = self.icons.get(t["id"])
            if icon is not None and not secret:
                if not t["earned"]:
                    icon = icon.copy()
                    icon.fill((90, 90, 90), special_flags=pygame.BLEND_RGB_MULT)
                c.blit(pygame.transform.smoothscale(icon, (px(52), px(52))), x0, y + 4)
            else:
                c.rect(ui.mix(LUXE_INK, WHITE, 0.08), x0, y + 4, 52, 52, 8)
                c.text("?", 22, x0 + 26, y + 30, SOFT, True, "center")
            name = "Hidden trophy" if secret else t["name"]
            detail = "Keep playing to find out." if secret else t["detail"]
            c.text(c.t.fit(name, 18, width - 360, True), 18, x0 + 72, y + 6, WHITE if t["earned"] or on else SOFT, True)
            c.text(c.t.fit(detail, 14, width - 360), 14, x0 + 72, y + 34, SOFT)
            draw_cup(c, x0 + width - 20, y + 30, 28, t["grade"], t["earned"])
            when = t["when"].strftime("%d %b %Y").upper() if t["earned"] and t["when"] else (
                i18n.translate("Earned").upper() if t["earned"] else "")
            c.text(when, 12, x0 + width - 50, y + 24, accent, True, "topright")
            y += 72

    def hints(self):
        return [("l1r1", "Page"), ("circle", "Back")]


# --------------------------------------------------------------------------------------------
# Controller test: every button and stick, live.

class ControllerTest(Modal):
    covers = True

    def __init__(self, home):
        super().__init__(home)
        self.back_at = 0.0

    def act(self, action):
        h = self.home
        if action == GUIDE:
            self.close()
        elif action == BACK:
            if h.t - self.back_at < 1.0:
                h.sounds.play("back")
                self.close()
            self.back_at = h.t

    def draw(self, c):
        h = self.home
        draw_luxe_cover(c, 160)
        c.text(i18n.upper("Controllers"), 12, 64, 24, ui.ACCENT, True)
        c.text("Controller test", 28, 64, 42, WHITE, True)
        pads = list(h.input.pads.values())
        if not pads:
            c.text("No controller found.", 19, 64, 96, SOFT)
            return
        pad = pads[0]
        B = pygame

        # Reads that cannot fail: a button or stick the controller (or pygame) does not know reads
        # as not pressed.
        def button(b):
            try:
                return bool(pad.get_button(b))
            except (pygame.error, AttributeError, TypeError, ValueError):
                return False

        def axis(a):
            try:
                return pad.get_axis(a) / 32767
            except (pygame.error, AttributeError, TypeError, ValueError):
                return 0.0

        c.text("Press every button and move the sticks. Press O twice (or PS) to go back.", 16, 64, 86, SOFT)
        cx, cy = ui.W / 2, 400
        lit, idle = ui.ACCENT, ui.mix(LUXE_CARD, WHITE, 0.15)
        glow = glow_sprite(px(520), ui.mix((0, 0, 0), lit, 0.35))
        c.s.blit(glow, glow.get_rect(center=(px(cx), px(cy))), special_flags=pygame.BLEND_RGB_ADD)
        edge = luxe_line()
        c.circle(edge, cx - 240, cy + 90, 111)
        c.circle(edge, cx + 240, cy + 90, 111)
        c.rect(edge, cx - 331, cy - 151, 662, 252, 111)
        body = LUXE_CARD
        c.rect(body, cx - 330, cy - 150, 660, 250, 110)
        c.circle(body, cx - 240, cy + 90, 110)
        c.circle(body, cx + 240, cy + 90, 110)

        def dot(x, y, r, on, label=""):
            c.circle(lit if on else idle, x, y, r)
            if label:
                c.text(label, 13, x, y, WHITE if on else SOFT, True, "center")

        for shape, b, x, y in (("triangle", B.CONTROLLER_BUTTON_Y, 220, -70),
                               ("circle", B.CONTROLLER_BUTTON_B, 270, -20),
                               ("cross", B.CONTROLLER_BUTTON_A, 220, 30), ("square", B.CONTROLLER_BUTTON_X, 170, -20)):
            on = button(b)
            dot(cx + x, cy + y, 22, on)
            # The symbols are drawn: the fonts have no PlayStation shapes.
            mark, bx, by = LUXE_INK if on else SOFT, cx + x, cy + y
            if shape == "triangle":
                c.polygon(mark, [(bx, by - 10), (bx + 10, by + 7), (bx - 10, by + 7)], 2)
            elif shape == "circle":
                c.circle(mark, bx, by, 9, 2)
            elif shape == "cross":
                c.line(mark, bx - 8, by - 8, bx + 8, by + 8, 2)
                c.line(mark, bx - 8, by + 8, bx + 8, by - 8, 2)
            else:
                c.rect(mark, bx - 8, by - 8, 16, 16, 0, 2)
        for b, x, y in ((B.CONTROLLER_BUTTON_DPAD_UP, -220, -70), (B.CONTROLLER_BUTTON_DPAD_DOWN, -220, 30),
                        (B.CONTROLLER_BUTTON_DPAD_LEFT, -270, -20), (B.CONTROLLER_BUTTON_DPAD_RIGHT, -170, -20)):
            c.rect(lit if button(b) else idle, cx + x - 18, cy + y - 18, 36, 36, 6)
        for side, ax, ay, b in ((-1, B.CONTROLLER_AXIS_LEFTX, B.CONTROLLER_AXIS_LEFTY, B.CONTROLLER_BUTTON_LEFTSTICK),
                                (1, B.CONTROLLER_AXIS_RIGHTX, B.CONTROLLER_AXIS_RIGHTY, B.CONTROLLER_BUTTON_RIGHTSTICK)):
            sx, sy = cx + side * 95, cy + 60
            c.circle(idle, sx, sy, 46)
            c.circle(edge, sx, sy, 46, 2)
            c.circle(lit if button(b) else WHITE, sx + axis(ax) * 30, sy + axis(ay) * 30, 18)
            c.text(f"{axis(ax):+.2f}  {axis(ay):+.2f}", 13, sx, sy + 58, SOFT, False, "midtop")
        for side, b, t, label in ((-1, B.CONTROLLER_BUTTON_LEFTSHOULDER, B.CONTROLLER_AXIS_TRIGGERLEFT, "L"),
                                  (1, B.CONTROLLER_BUTTON_RIGHTSHOULDER, B.CONTROLLER_AXIS_TRIGGERRIGHT, "R")):
            x = cx + side * 220
            c.rect(lit if button(b) else idle, x - 60, cy - 190, 120, 26, 10)
            c.text(label + "1", 13, x, cy - 177, WHITE, True, "center")
            level = max(0.0, axis(t))
            c.rect(idle, x - 60, cy - 236, 120, 34, 10)
            if level > 0.02:
                c.rect(lit, x - 60, cy - 236, max(20, 120 * level), 34, 10)
            c.text(f"{label}2  {int(level * 100)}%", 13, x, cy - 219, WHITE, True, "center")
        touchpad = getattr(B, "CONTROLLER_BUTTON_TOUCHPAD", 20)     # pygame 2.6 has no name for it.
        c.rect(lit if button(touchpad) else idle, cx - 90, cy - 130, 180, 90, 12)
        c.text("Touchpad", 13, cx, cy - 85, SOFT, False, "center")
        dot(cx - 140, cy - 110, 14, button(B.CONTROLLER_BUTTON_BACK), "")
        c.text("SHARE", 11, cx - 140, cy - 88, SOFT, True, "midtop")
        dot(cx + 140, cy - 110, 14, button(B.CONTROLLER_BUTTON_START), "")
        c.text("OPTIONS", 11, cx + 140, cy - 88, SOFT, True, "midtop")
        dot(cx, cy + 20, 18, button(B.CONTROLLER_BUTTON_GUIDE), "PS")

    def hints(self):
        return [("circle", "Twice: Back")]


# --------------------------------------------------------------------------------------------
# Media: the screenshots and videos, on the home screen's Media tab, and a full-screen viewer.

class GameLibrary(Modal):
    """The Game Library, as on a PS5: every game in a grid (the row on the home screen shows them
    one by one). Tabs for where the games are (L1 / R1: all, PS4 drive, USB drive, PC); Square
    changes the order; X plays, OPTIONS opens the game's options."""
    covers = True
    COLS, TILE, GAP = 6, 150, 34
    FILTERS = [("all", "All games"), ("PS4", "PS4 drive"), ("USB", "USB drive"), ("PC", "PC")]

    def __init__(self, home):
        super().__init__(home)
        self.index = 0
        self.top = 0
        self.filter = 0
        self.on_tabs = False          # Up from the first row: Left / Right change the tab.

    def games(self, filter_=None):
        kind = self.FILTERS[self.filter if filter_ is None else filter_][0]
        return [g for g in self.home.games if kind == "all" or g.source == kind]

    def act(self, action):
        h = self.home
        games = self.games()
        if action == BACK:
            h.sounds.play("back")
            self.close()
            return
        if action == SQUARE:
            h.settings.set(sort="name" if h.settings["sort"] == "recent" else "recent")
            h.refresh_games(force=True)
            self.index = 0
            h.sounds.play("move")
            return
        tab_step = {PAGE_UP: -1, PAGE_DOWN: 1, TRIANGLE: 1}.get(action)
        if self.on_tabs or not games:
            if action in (LEFT, RIGHT):
                tab_step = -1 if action == LEFT else 1
                if i18n.rtl():
                    tab_step = -tab_step
            elif action in (DOWN, OK) and games:
                self.on_tabs = False
                h.sounds.play("move")
                return
        if tab_step:
            self.filter = (self.filter + tab_step) % len(self.FILTERS)
            self.index = 0
            self.top = 0
            self.on_tabs = self.on_tabs or not self.games()
            h.sounds.play("move")
            return
        if self.on_tabs or not games:
            return
        if action == UP and self.index < self.COLS:
            self.on_tabs = True
            h.sounds.play("move")
            return
        self.index = min(self.index, len(games) - 1)
        moved = {LEFT: -1, RIGHT: 1, UP: -self.COLS, DOWN: self.COLS}.get(action)
        if moved is not None:
            target = self.index + moved
            if 0 <= target < len(games) or (action == DOWN and self.index // self.COLS <
                                              (len(games) - 1) // self.COLS):
                self.index = max(0, min(len(games) - 1, target))
                h.sounds.play("move")
        elif action == OK:
            game = games[self.index]
            self.close()
            h.open_game(game)
        elif action == OPTIONS:
            h.sounds.play("select")
            h.push(GameMenu(h, games[self.index]))

    def hints(self):
        order = "Name" if self.home.settings["sort"] == "recent" else "Recently played"
        if self.on_tabs:
            return [(None, "Left / Right: change"), ("cross", "Select"), ("square", "Order: " + order),
                    ("circle", "Back")]
        return [("cross", "Play"), ("options", "Options"), ("l1r1", "Change tab"), ("square", "Order: " + order),
                ("circle", "Back")]

    def draw(self, c):
        h = self.home
        games = self.games()
        self.index = min(self.index, max(0, len(games) - 1))
        icons = sum(1 for g in games if g.icon is not None)
        key = (self.appear >= 1.0, self.index, self.filter, self.on_tabs, h.settings["sort"], len(games), icons,
               c.s.get_size(), ui.ACCENT, len(h.games), bool(h.modals and h.modals[-1] is not self))
        frame = getattr(self, "frame", None)
        if key != getattr(self, "frame_key", None) or frame is None or frame.get_size() != c.s.get_size():
            if frame is None or frame.get_size() != c.s.get_size():
                self.frame = pygame.Surface(c.s.get_size()).convert()
            self.draw_page(ui.Canvas(self.frame, c.t), games)
            self.frame_key = key
        c.s.blit(self.frame, (0, 0))

    def draw_page(self, c, games):
        h = self.home
        accent = ui.ACCENT
        draw_luxe_cover(c, 210)
        a = ease_out(self.appear)
        rise = (1 - a) * 12
        x0 = ROW_X
        c.text(i18n.upper("Library"), 12, x0 + 2, 34 - rise, accent, True)
        c.text("Game Library", 32, x0, 52 - rise, WHITE, True)
        # Order, at the right.
        order = "Recently played" if h.settings["sort"] == "recent" else "Name"
        label = i18n.translate(order)
        w = c.t.width(label, 15) + 40
        right = x0 + self.COLS * (self.TILE + self.GAP) - self.GAP
        c.rect(LUXE_INK + (170,), right - w, 60 - rise, w, 34, 17)
        c.rect(luxe_line(), right - w, 60 - rise, w, 34, 17, 1)
        c.text(label, 15, right - w / 2, 77 - rise, SOFT, False, "center")
        c.text(i18n.upper("Order"), 11, right - w - 12, 70 - rise, accent, True, "topright")
        # The tabs, with L1 and R1 at their ends.
        names = [f"{i18n.translate(name)}  {len(self.games(i))}" for i, (_, name) in enumerate(self.FILTERS)]
        ty = 122 - rise
        c.rect(LUXE_INK + (170,), x0, ty + 4, 40, 26, 8)
        c.rect(luxe_line(), x0, ty + 4, 40, 26, 8, 1)
        c.text("L1", 12, x0 + 20, ty + 17, SOFT, True, "center")
        end = draw_luxe_tabs(c, names, self.filter, x0 + 60, ty, self.on_tabs)
        c.rect(LUXE_INK + (170,), end - 24, ty + 4, 40, 26, 8)
        c.rect(luxe_line(), end - 24, ty + 4, 40, 26, 8, 1)
        c.text("R1", 12, end - 4, ty + 17, SOFT, True, "center")
        c.line(luxe_line(), x0, ty + 46, right, ty + 46, 1)
        if not games:
            c.text("No games here", 22, x0, ty + 90, WHITE, True)
            where = self.FILTERS[self.filter][0]
            tip = {"USB": "Put PS5 games on a USB drive to see them here.",
                   "PC": "Add a shared folder in Settings, Games from PC.",
                   "PS4": "Copy a game to the EmuFive disk from its options."}.get(where, "")
            if tip:
                c.text(tip, 16, x0, ty + 124, SOFT)
            return
        row_h = self.TILE + 52
        rows_shown = 2
        top_y = ty + 74
        row = self.index // self.COLS
        if row < self.top:
            self.top = row
        if row >= self.top + rows_shown:
            self.top = row - rows_shown + 1
        shape = h.settings["tile_shape"]
        for n in range(self.top * self.COLS, min(len(games), (self.top + rows_shown) * self.COLS)):
            game = games[n]
            col, r = n % self.COLS, n // self.COLS - self.top
            x = x0 + col * (self.TILE + self.GAP)
            y = top_y + r * row_h
            on = n == self.index and not self.on_tabs
            if on:
                glow = glow_sprite(px(self.TILE * 1.1), ui.mix((0, 0, 0), accent, 0.45))
                c.s.blit(glow, glow.get_rect(center=(px(x + self.TILE / 2), px(y + self.TILE / 2))),
                         special_flags=pygame.BLEND_RGB_ADD)
            picture = h.tile_picture(game, self.TILE, shape)
            if picture is not None:
                c.blit(picture, x, y)
            else:
                h.tile_shape(c, game.color, x, y, self.TILE)
                for k, line in enumerate(c.t.wrap(game.title, 14, self.TILE - 20)[:3]):
                    c.text(line, 14, x + 10, y + 10 + k * 18, (255, 255, 255))
            if h.is_running(game):
                c.rect(accent, x + 8, y + self.TILE - 28, 70, 20, 10)
                c.text("RUNNING", 11, x + 43, y + self.TILE - 18, LUXE_INK, True, "center")
            if on:
                h.tile_shape(c, accent, x, y, self.TILE, 3, 5)
            c.text(c.t.fit(game.title, 14, self.TILE), 14, x, y + self.TILE + 12,
                   WHITE if on else SOFT, on)
            if on and self.FILTERS[self.filter][0] == "all":
                c.text(getattr(game, "source_name", "") or game.source, 12, x, y + self.TILE + 32, accent)
        total_rows = (len(games) + self.COLS - 1) // self.COLS
        if total_rows > rows_shown:
            track = rows_shown * row_h - 52
            bar_h = max(24, track * rows_shown / total_rows)
            bar_y = top_y + (track - bar_h) * self.top / max(1, total_rows - rows_shown)
            c.rect(luxe_line(), right + 18, top_y, 3, track, 2)
            c.rect(accent, right + 18, bar_y, 3, bar_h, 2)


class MediaView:
    COLS = 4
    THUMB_W, THUMB_H = 268, 151
    # TV & Video, as on a PS5 (ps5-browser --app NAME): name, title, the kind of icon.
    APPS = [("youtube", "YouTube", "play")]
    GRID_Y = 217                  # The screenshots and videos, below the apps.

    def __init__(self, home):
        self.home = home
        self.on_apps = True       # The apps row is chosen (else the screenshots and videos).
        self.app = 0
        self.paths = []
        self.index = 0
        self.top_row = 0
        self.thumbs = {}
        self.loading = set()
        self.lock = threading.Lock()
        self.scanned = -10.0

    def refresh(self):
        h = self.home
        if h.t - self.scanned > 3.0:
            self.scanned = h.t
            self.paths = system.media_files()
            self.index = min(self.index, max(0, len(self.paths) - 1))

    def thumb(self, path):
        with self.lock:
            if path in self.thumbs:
                return self.thumbs[path]
            if path in self.loading:
                return None
            self.loading.add(path)

        def work():
            try:
                picture = pygame.image.load(system.video_thumb(path) if system.is_video(path) else path)
                small = pygame.transform.smoothscale(picture, (px(self.THUMB_W), px(self.THUMB_H)))
            except (pygame.error, OSError):
                small = False
            with self.lock:
                self.thumbs[path] = small
                self.loading.discard(path)

        threading.Thread(target=work, daemon=True).start()
        return None

    def open_app(self):
        h = self.home
        h.sounds.play("select")
        if h.running_path is not None:
            h.push(Dialog(h, "Close the paused game first (PS button, Close the game), so the "
                             "app has the memory."))
        else:
            # BROWSER, with the app named in a file (ps5-browser reads it), so any ps5-session runs it.
            try:
                with open(system.BROWSER_APP, "w") as f:
                    f.write(self.APPS[self.app][0])
            except OSError:
                return
            h.finish("BROWSER")

    def act(self, action):
        h = self.home
        if self.on_apps or not self.paths:
            self.on_apps = True
            if action == UP:
                h.focus = "settings" if h.ps5_layout else "wifi"
            elif action == LEFT and self.app > 0:
                self.app -= 1
            elif action == RIGHT and self.app < len(self.APPS) - 1:
                self.app += 1
            elif action == DOWN and self.paths:
                self.on_apps = False
            elif action == OK:
                self.open_app()
                return
            else:
                return
            h.sounds.play("move")
            return
        if action == UP:
            if self.index >= self.COLS:
                self.index -= self.COLS
            else:
                self.on_apps = True
            h.sounds.play("move")
            return
        if action == DOWN and self.index + self.COLS < len(self.paths):
            self.index += self.COLS
        elif action == LEFT and self.index > 0:
            self.index -= 1
        elif action == RIGHT and self.index < len(self.paths) - 1:
            self.index += 1
        elif action == OK:
            h.sounds.play("select")
            h.push(MediaViewer(h, self))
            return
        else:
            return
        h.sounds.play("move")

    def draw(self, c):
        self.refresh()
        h = self.home
        y0 = ROW_Y
        c.text("TV & Video", 18, ROW_X, y0 - 6, HOME_SOFT, True, shadow=not LIGHT)
        for n, (_, name, icon) in enumerate(self.APPS):
            x, y = ROW_X + n * (self.THUMB_W + 22), y0 + 26
            # Our own neutral tile, nothing from the app's logo or colors: a dark tile, a white
            # play circle and the name.
            c.rect((30, 30, 36), x, y, self.THUMB_W, self.THUMB_H, 10)
            cx, cy = x + self.THUMB_W / 2, y + self.THUMB_H / 2 - 14
            draw_app_icon(c, icon, cx, cy, 30)
            c.text(name, 22, cx, y + self.THUMB_H - 26, (255, 255, 255), True, "center")
            if self.on_apps and n == self.app and h.focus == "tiles" and not h.modals:
                c.rect(HOME_TEXT, x - 5, y - 5, self.THUMB_W + 10, self.THUMB_H + 10, 12, 3)
        y0 += self.GRID_Y
        if not self.paths:
            c.text("No screenshots or videos yet", 40, ROW_X, y0 + 40, HOME_TEXT, True, shadow=not LIGHT)
            c.text("Press PS + Square, or Share, for a screenshot, in a game too.", 18, ROW_X + 2, y0 + 100,
                   HOME_SOFT, shadow=not LIGHT)
            c.text("PS + Triangle starts and stops a video.", 18, ROW_X + 2, y0 + 128, HOME_SOFT, shadow=not LIGHT)
            return
        rows = (len(self.paths) + self.COLS - 1) // self.COLS
        more = f"  ·  {self.index // self.COLS + 1} / {rows}" if rows > 1 else ""
        c.text(f"Screenshots and videos  ·  {len(self.paths)}{more}", 18, ROW_X, y0 - 6, HOME_SOFT, True,
               shadow=not LIGHT)
        # One row fits under the apps, above the hints: it scrolls to the chosen one.
        self.top_row = self.index // self.COLS
        gap = 22
        for n in range(self.top_row * self.COLS, min(len(self.paths), (self.top_row + 1) * self.COLS)):
            col, r = n % self.COLS, n // self.COLS - self.top_row
            x = ROW_X + col * (self.THUMB_W + gap)
            y = y0 + 26 + r * (self.THUMB_H + 46)
            thumb = self.thumb(self.paths[n])
            if thumb:
                c.blit(thumb, x, y)
            else:
                c.rect(KEY, x, y, self.THUMB_W, self.THUMB_H, 10)
            if system.is_video(self.paths[n]):
                draw_play_badge(c, x + self.THUMB_W / 2, y + self.THUMB_H / 2, 22)
            if n == self.index and not self.on_apps and h.focus == "tiles" and not h.modals:
                c.rect(HOME_TEXT, x - 5, y - 5, self.THUMB_W + 10, self.THUMB_H + 10, 12, 3)
            name = os.path.basename(os.path.dirname(self.paths[n]))
            c.text(c.t.fit(name, 13, self.THUMB_W), 13, x, y + self.THUMB_H + 8, HOME_SOFT, shadow=not LIGHT)


def draw_library_icon(c, x, y, r, color, back=None):
    """The Game Library: three game cases fanned out, the front one filled. `back` (the tile's
    color) leaves a thin gap round each case so they read apart."""
    w, h = r, r * 1.36
    line = max(2, r * 0.06)
    for k, (dx, dy) in enumerate(((-0.34, 0.2), (0, 0), (0.34, -0.2))):
        cx, cy = x + dx * r * 1.1, y + dy * r * 0.7
        if back is not None:
            c.rect(back, cx - w / 2 - line, cy - h / 2 - line, w + 2 * line, h + 2 * line, r * 0.16)
        c.rect(color, cx - w / 2, cy - h / 2, w, h, r * 0.14, 0 if k == 2 else line)


def draw_app_icon(c, kind, x, y, r):
    """Media's app icons: our own plain white shapes (no app's logo or colors)."""
    white, dark = (240, 240, 245), (30, 30, 36)
    if kind == "play":
        c.circle(white, x, y, r)
        t = r * 0.42
        c.polygon(dark, [(x - t * 0.7, y - t), (x - t * 0.7, y + t), (x + t, y)])


def capture_folder(title):
    """The folder a game's screenshots and clips go in (ps5-guide names it by the game's title)."""
    return "".join(ch for ch in title if ch.isalnum() or ch in " -_").strip() or "Screenshot"


class GameMedia(MediaView):
    """One game's screenshots and clips (the Media card on its page), for the viewer."""

    def __init__(self, home, game):
        super().__init__(home)
        self.folder = capture_folder(game.title)
        self.on_apps = False
        self.refresh()

    def refresh(self):
        self.paths = [p for p in system.media_files() if os.path.basename(os.path.dirname(p)) == self.folder]
        self.index = min(self.index, max(0, len(self.paths) - 1))


def draw_play_badge(c, x, y, radius):
    """A round play button: on video thumbnails and a stopped video."""
    c.circle((0, 0, 0, 150), x, y, radius)
    c.circle((255, 255, 255, 200), x, y, radius, max(1, radius // 10))
    r = radius * 0.45
    c.polygon((255, 255, 255), [(x - r * 0.6, y - r), (x - r * 0.6, y + r), (x + r, y)])


class VideoPlayer:
    """Plays a clip in the viewer: ffmpeg decodes the picture into a pipe (at the clip's size; it is
    scaled to the screen), ffplay plays the sound. Frames come on time by the clock; late ones are
    skipped."""

    def __init__(self, path):
        import subprocess
        self.path = path
        self.size = self.probe(path)
        self.frame = None           # The newest due frame (bytes), and its number.
        self.number = -1
        self.done = False
        self.paused = False
        self.lock = threading.Lock()
        w, hgt = self.size
        self.decoder = subprocess.Popen(
            ["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-i", path, "-f", "rawvideo",
             "-pix_fmt", "rgb24", "-r", "30", "-"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            bufsize=w * hgt * 3 * 2)
        self.sound = subprocess.Popen(["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", path],
                                      stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                      stderr=subprocess.DEVNULL)
        self.start = time.monotonic()
        self.paused_at = None
        threading.Thread(target=self.read, daemon=True).start()

    @staticmethod
    def probe(path):
        code, out, _ = system.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                                   "stream=width,height", "-of", "csv=p=0", path], timeout=10)
        try:
            w, hgt = (int(v) for v in out.strip().split(",")[:2])
            return w, hgt
        except ValueError:
            return 1280, 720

    def read(self):
        w, hgt = self.size
        size = w * hgt * 3
        n = 0
        while True:
            data = self.decoder.stdout.read(size)
            if len(data) < size:
                break
            while True:
                with self.lock:
                    start, paused = self.start, self.paused
                if self.done:
                    return
                wait = start + n / 30 - time.monotonic()
                if paused or wait > 0:
                    time.sleep(0.01 if paused else min(wait, 0.05))
                    continue
                break
            with self.lock:
                self.frame, self.number = data, n
            n += 1
        self.done = True

    def toggle_pause(self):
        import signal as sig
        with self.lock:
            if self.done:
                return
            self.paused = not self.paused
            if self.paused:
                self.paused_at = time.monotonic()
            else:
                self.start += time.monotonic() - self.paused_at
        for process in (self.decoder, self.sound):
            try:
                process.send_signal(sig.SIGSTOP if self.paused else sig.SIGCONT)
            except OSError:
                pass

    def latest(self):
        with self.lock:
            return self.frame, self.number

    def elapsed(self):
        with self.lock:
            end = self.paused_at if self.paused else time.monotonic()
            return max(0.0, end - self.start)

    def stop(self):
        import signal as sig
        self.done = True
        for process in (self.decoder, self.sound):
            try:
                process.send_signal(sig.SIGCONT)
                process.kill()
                process.wait(2)
            except Exception:
                pass


class MediaViewer(Modal):
    covers = True

    def __init__(self, home, media):
        super().__init__(home)
        self.media = media
        self.picture = None
        self.loaded_for = None
        self.player = None
        self.shown = (None, -1)       # The frame number on the screen, and its scaled surface.
        self.seconds = {}             # Clip lengths.

    def stop_video(self):
        if self.player is not None:
            self.player.stop()
            self.player = None
            self.shown = (None, -1)

    def close(self):
        self.stop_video()
        super().close()

    def path(self):
        paths = self.media.paths
        return paths[self.media.index] if paths and self.media.index < len(paths) else None

    def act(self, action):
        h = self.home
        m = self.media
        video = self.path() is not None and system.is_video(self.path())
        if action == OK and video:
            h.sounds.play("select")
            if self.player is None or self.player.done:
                self.stop_video()
                self.player = VideoPlayer(self.path())
            else:
                self.player.toggle_pause()
        elif action in (BACK, OK):
            h.sounds.play("back")
            self.close()
        elif action == LEFT and m.index > 0:
            self.stop_video()
            m.index -= 1
            h.sounds.play("move")
        elif action == RIGHT and m.index < len(m.paths) - 1:
            self.stop_video()
            m.index += 1
            h.sounds.play("move")
        elif action == TRIANGLE and self.path():
            self.stop_video()
            h.sounds.play("select")
            # A copy: the Share page reads it in its own thread while this one is still drawn.
            ready = self.picture.copy() if self.picture is not None and self.loaded_for == self.path() else None
            h.push(ShareView(h, self.path(), ready))
        elif action == SQUARE and self.path():
            self.stop_video()
            path = self.path()

            def delete():
                system.delete_screenshot(path)
                m.scanned = -10.0
                m.refresh()
                if not m.paths:
                    self.close()

            h.push(Dialog(h, ("Delete this video? It cannot be brought back." if video else
                              "Delete this screenshot? It cannot be brought back."),
                          [("Delete", delete), ("Cancel", None)]))

    def draw(self, c):
        c.s.fill((0, 0, 0))
        path = self.path()
        if path is None:
            return
        video = system.is_video(path)
        if self.loaded_for != path:
            try:
                picture = pygame.image.load(system.video_thumb(path) if video else path)
                w, hgt = c.s.get_size()
                scale = min(w / picture.get_width(), hgt / picture.get_height())
                # Converted to the screen's format once: a PNG's own format made every frame's copy
                # slow (about 0.1 s a frame on a PS4), which also held up the Share page's work.
                self.picture = pygame.transform.smoothscale(
                    picture, (int(picture.get_width() * scale), int(picture.get_height() * scale))).convert()
            except (pygame.error, OSError):
                self.picture = None
            self.loaded_for = path
        frame = self.video_frame(c) if video else None
        if frame is not None:
            c.s.blit(frame, frame.get_rect(center=c.s.get_rect().center))
        elif self.picture is not None:
            c.s.blit(self.picture, self.picture.get_rect(center=c.s.get_rect().center))
        if video and (self.player is None or self.player.done or self.player.paused):
            draw_play_badge(c, ui.W / 2, ui.H / 2, 46)
        if video:
            if path not in self.seconds:
                self.seconds[path] = None
                threading.Thread(target=lambda: self.seconds.__setitem__(path, system.video_seconds(path)),
                                 daemon=True).start()
            total = self.seconds.get(path)
            now = self.player.elapsed() if self.player is not None and not self.player.done else 0
            if total:
                now = min(now, total)
                c.rect((0, 0, 0, 150), 0, ui.H - 40, ui.W, 40)
                c.rect((255, 255, 255, 60), 40, ui.H - 22, ui.W - 200, 4, 2)
                c.rect(ACCENT, 40, ui.H - 22, max(1, (ui.W - 200) * now / total), 4, 2)
                c.text(f"{int(now) // 60}:{int(now) % 60:02d} / {int(total) // 60}:{int(total) % 60:02d}", 15,
                       ui.W - 40, ui.H - 20, (255, 255, 255), False, "midright")
        name = os.path.basename(os.path.dirname(path))
        when = os.path.splitext(os.path.basename(path))[0]
        c.rect((0, 0, 0, 150), 0, 0, ui.W, 64)
        c.text(f"{name}  ·  {when}", 16, 40, 22, (255, 255, 255))
        c.text(f"{self.media.index + 1} / {len(self.media.paths)}", 16, ui.W - 40, 22, (255, 255, 255), False,
               "topright")

    def video_frame(self, c):
        """The player's newest frame, scaled to the screen (once per new frame), or None."""
        if self.player is None:
            return None
        data, number = self.player.latest()
        if data is None:
            return None
        if number != self.shown[1]:
            w, hgt = self.player.size
            raw = pygame.image.frombuffer(data, (w, hgt), "RGB")
            sw, sh = c.s.get_size()
            scale = min(sw / w, sh / hgt)
            self.shown = (pygame.transform.scale(raw, (int(w * scale), int(hgt * scale))), number)
        return self.shown[0]

    def hints(self):
        path = self.path()
        if path is not None and system.is_video(path):
            playing = self.player is not None and not self.player.done and not self.player.paused
            return [(None, "Left / Right: next"), ("cross", "Pause" if playing else "Play"), ("triangle", "Share"),
                    ("square", "Delete"), ("circle", "Back")]
        return [(None, "Left / Right: next"), ("triangle", "Share"), ("square", "Delete"), ("circle", "Back")]


def picture_palette(path):
    """Two colors of a picture file (a video's thumbnail; see surface_palette), or None."""
    try:
        return surface_palette(pygame.image.load(system.video_thumb(path) if system.is_video(path) else path))
    except (pygame.error, OSError):
        return None


def blurred_backdrop(picture, size, amount=14):
    """`picture` covering `size`, very blurred: scaled straight down to the blur's size, then up
    (a 4K screen in a tenth of the time of scaling up first)."""
    w, h = size
    scale = max(w / picture.get_width(), h / picture.get_height())
    cover = (int(picture.get_width() * scale) + 1, int(picture.get_height() * scale) + 1)
    small = pygame.transform.smoothscale(picture, (max(1, cover[0] // amount), max(1, cover[1] // amount)))
    big = pygame.transform.smoothscale(small, cover)
    out = pygame.Surface(size).convert()
    out.blit(big, big.get_rect(center=out.get_rect().center))
    return out


def soft_aurora_light(w, h, vivid):
    """aurora_light drawn at a third of the size and scaled up: it is soft light, so it looks the
    same, in a ninth of the time."""
    small = aurora_light(max(1, w // 3), max(1, h // 3), vivid)
    return pygame.transform.smoothscale(small, (w, h))


def png_size(path):
    """(width, height) from a PNG's header, without reading the picture; None if not a PNG."""
    try:
        with open(path, "rb") as f:
            head = f.read(24)
        if head[:8] == b"\x89PNG\r\n\x1a\n":
            return int.from_bytes(head[16:20], "big"), int.from_bytes(head[20:24], "big")
    except OSError:
        pass
    return None


def qr_surface(data, side, error="m"):
    """A QR code (dark on white, with its quiet zone) `side` pixels wide, or None without segno."""
    try:
        import segno
    except ImportError:
        return None
    matrix = list(segno.make(data, error=error).matrix)
    n = len(matrix)
    quiet = 4
    surface = pygame.Surface((n + 2 * quiet, n + 2 * quiet))
    surface.fill((255, 255, 255))
    for y, row in enumerate(matrix):
        for x, dark in enumerate(row):
            if dark:
                surface.set_at((x + quiet, y + quiet), (10, 10, 16))
    return pygame.transform.scale(surface, (side - side % (n + 2 * quiet) or side, ) * 2)


SHARE_DIM = (160, 160, 176)       # Faint text on the Share card (always dark glass, any theme).


class ShareView(Modal):
    """A QR code for a phone: it opens the screenshot in the phone's browser, to save or share.
    The Glass card design: the screenshot blurred behind, and on a glass card the picture, the code
    on a white tile and three steps. The screen dims at once; the pictures, the light and the code
    are made in the background (prepare, compose_base), the text is added on the main thread
    (compose_text), then the card fades in. Only the soft light around the code breathes."""
    CARD = (140, 113, 1000, 493)          # Units.
    PICTURE = (180, 160, 507, 285)
    CODE = (927, 280)                     # The code's center.
    CODE_SIDE = 220

    def __init__(self, home, path=None, picture=None):
        super().__init__(home)
        self.path = path
        self.qr = None
        self.error = None
        self.picture = None
        self.given = picture      # Already loaded (the media viewer's): no second PNG read.
        self.size = None          # The file's own size, for the line under the picture.
        self.vivid = ACCENT
        self.url = None
        self.server = None
        self.tile = None
        self.base = None          # The still screen without its text (made in the background).
        self.frame = None         # With its text.
        self.shown = 0.0          # The card's fade in, from when it is ready.
        size = home.c.s.get_size()
        threading.Thread(target=self._work, args=(size,), daemon=True).start()

    @property
    def covers(self):
        return self.frame is not None and self.shown >= 1.0

    def _work(self, size):
        try:
            self.prepare()
            self.base = self.compose_base(size)
        except Exception as error:          # Shown on the card rather than lost in a thread.
            self.error = self.error or str(error)
            if self.base is None:
                plain = pygame.Surface(size)
                plain.fill((12, 10, 28))
                self.base = plain

    def load_picture(self, path):
        try:
            return pygame.image.load(path).convert()
        except (pygame.error, OSError):
            return None

    def prepare(self):
        """Background: the picture, its colors, the phone page and the code."""
        self.video = system.is_video(self.path)
        if self.given is not None and not self.video:
            self.picture = self.given
            self.size = png_size(self.path)
        else:
            self.picture = self.load_picture(system.video_thumb(self.path) if self.video else self.path)
        palette = surface_palette(self.picture) if self.picture is not None else None
        self.vivid = palette[0] if palette else ACCENT
        try:
            import segno  # noqa: F401
        except ImportError:
            self.error = "Sharing needs the python3-segno package."
            return
        self.server = system.ShareServer(self.path, i18n.translate("Video" if self.video else "Screenshot"),
                                         i18n.translate("Download"), ACCENT, palette)
        self.url = self.server.start()
        if self.url is None:
            self.error = "Connect the PS4 to a network first."
            return
        self.qr = qr_surface(self.url, px(self.CODE_SIDE))

    def close(self):
        if self.server is not None:
            self.server.stop()
        super().close()

    def act(self, action):
        if action in (BACK, OK, TRIANGLE):
            self.home.sounds.play("back")
            self.close()

    @staticmethod
    def rect_px(x, y, w, h):
        return pygame.Rect(px(x), px(y), px(x + w) - px(x), px(y + h) - px(y))

    @staticmethod
    def cut(surface, radius):
        """`surface` with rounded corners."""
        out = surface.convert_alpha()
        out.blit(ui.round_mask(*out.get_size(), radius), (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
        return out

    def glass(self, frame, rect, radius):
        piece = soft_blur(frame.subsurface(rect).copy(), 8)
        frame.blit(self.cut(piece, radius), rect.topleft)
        tint = pygame.Surface(rect.size, pygame.SRCALPHA)
        tint.fill((255, 255, 255, 0))
        ui.draw_round(tint, (255, 255, 255, 20), tint.get_rect(), radius, 0, True)
        frame.blit(tint, rect.topleft)

    def compose_base(self, size):
        """Background: everything but the text. The soft layers (the blurred picture, the light,
        the frosted card) are made at half size and scaled up; the sharp ones at full size."""
        vivid = self.vivid
        picture = self.picture
        half = (max(1, size[0] // 2), max(1, size[1] // 2))
        # Behind: the picture, blurred and darkened, with the Aurora's ribbons of light.
        if picture is not None:
            back = blurred_backdrop(picture, half, 7)
        else:
            back = pygame.Surface(half).convert()
            back.fill(ui.mix(vivid, (6, 5, 14), 0.85))
        veil = pygame.Surface(half)
        veil.fill((6, 5, 14))
        veil.set_alpha(165)
        back.blit(veil, (0, 0))
        back.blit(soft_aurora_light(half[0], half[1], vivid), (0, 0), special_flags=pygame.BLEND_RGB_ADD)
        card = self.rect_px(*self.CARD)
        scale = half[0] / size[0]
        small_card = pygame.Rect(int(card.x * scale), int(card.y * scale), int(card.w * scale), int(card.h * scale))
        self.glass(back, small_card, max(1, int(px(27) * scale)))
        frame = pygame.transform.smoothscale(back, size).convert()
        frame.blit(gradient_border(card.w, card.h, px(27), vivid, CHAMPAGNE, max(1, px(1.4))), card.topleft)
        if self.error is None or isinstance(self, ReportView):
            pr = self.rect_px(*self.PICTURE)
            if picture is not None:
                scale = max(pr.w / picture.get_width(), pr.h / picture.get_height())
                shot = pygame.transform.smoothscale(picture, (max(pr.w, int(picture.get_width() * scale)),
                                                              max(pr.h, int(picture.get_height() * scale))))
                shot = shot.subsurface(pygame.Rect((shot.get_width() - pr.w) // 2,
                                                   (shot.get_height() - pr.h) // 2, pr.w, pr.h))
                frame.blit(self.cut(shot, px(15)), pr.topleft)
            frame.blit(gradient_border(pr.w, pr.h, px(15), vivid, CHAMPAGNE, max(1, px(1.4))), pr.topleft)
        if self.qr is not None and self.error is None:
            # The code on a white tile.
            cx, cy = self.CODE
            side = self.qr.get_width() / ui.S
            pad = 17
            tile = self.rect_px(cx - side / 2 - pad, cy - side / 2 - pad, side + 2 * pad, side + 2 * pad)
            ui.draw_round(frame, (255, 255, 255), tile, px(17))
            frame.blit(self.qr, self.qr.get_rect(center=tile.center))
            self.tile = tile
        return frame

    def steps(self, c, title, lines):
        """The title under the code and its numbered steps."""
        cx, cy = self.CODE
        side = self.qr.get_width() / ui.S
        top = cy + side / 2 + 17 + 30
        c.text(title, 23, cx, top, ART_TEXT, True, "midtop")
        ink = (14, 12, 20) if sum(self.vivid) > 300 else ART_TEXT
        sx = cx - 140
        for n, line in enumerate(lines):
            yy = top + 46 + n * 35
            c.circle(self.vivid, sx + 12, yy + 12, 12)
            c.text(str(n + 1), 13, sx + 12, yy + 12, ink, True, "center")
            c.text(line, 16, sx + 35, yy + 12, ART_TEXT, False, "midleft")

    def compose_text(self, frame, c):
        """Main thread: the text (fonts are not drawn from two threads)."""
        x, y, w, h = self.CARD
        if self.error:
            c.text("Share", 26, ui.W / 2, y + 60, ART_TEXT, True, "midtop")
            for n, line in enumerate(c.t.wrap(self.error, 18, w - 160)):
                c.text(line, 18, ui.W / 2, y + 130 + n * 28, ART_SOFT, False, "midtop")
            return
        video = self.video
        px_, py_, pw, ph = self.PICTURE
        pr = self.rect_px(*self.PICTURE)
        if video:
            draw_play_badge(c, pr.centerx / ui.S, pr.centery / ui.S, 26)
        name = os.path.basename(os.path.dirname(self.path))
        when = os.path.splitext(os.path.basename(self.path))[0]
        parts = when.split(" ")
        if len(parts) == 2 and parts[1].count("-") == 2:
            when = parts[0] + "  " + parts[1].replace("-", ":")[:5]
        c.text(c.t.fit(name, 20, pw, True), 20, px_, py_ + ph + 22, ART_TEXT, True)
        c.text(("Video" if video else "Screenshot") + i18n.SEPARATOR + i18n.Final(when), 15, px_, py_ + ph + 52, ART_SOFT)
        if video:
            size = VideoPlayer.probe(self.path)
            seconds = int(system.video_seconds(self.path) or 0)
            size_text = f"{size[0]} × {size[1]}  ·  MP4  ·  {seconds // 60}:{seconds % 60:02d}"
            c.text(i18n.Final(size_text), 15, px_, py_ + ph + 74, SHARE_DIM)
        elif self.picture is not None:
            w, hgt = self.size or self.picture.get_size()
            size_text = f"{w} × {hgt}  ·  PNG"
            c.text(i18n.Final(size_text), 15, px_, py_ + ph + 74, SHARE_DIM)
        self.steps(c, "Share to your phone", ("Open your phone's camera", "Point it at the code",
                                              "Save or share the video" if video else "Save or share the picture"))
        # The address, for typing it in.
        width = c.t.width(self.url, 13) + 30
        c.rect((255, 255, 255, 18), ui.W / 2 - width / 2, y + h + 18, width, 27, 13)
        c.rect((255, 255, 255, 40), ui.W / 2 - width / 2, y + h + 18, width, 27, 13, 1)
        c.text(i18n.Final(self.url), 13, ui.W / 2, y + h + 31, ART_SOFT, False, "center")
        c.text("Your phone must be on the same network as the PS4.", 13, ui.W / 2, y + h + 56, SHARE_DIM, False, "midtop")

    def update(self, dt):
        super().update(dt)
        if self.frame is not None:
            self.shown = min(1.0, self.shown + dt / 0.22)

    def draw(self, c):
        if self.frame is None and self.base is not None:
            self.frame = self.base
            self.base = None
            self.compose_text(self.frame, ui.Canvas(self.frame, c.t))
        # The screen dims at once, while the card is made.
        c.dim(165 * ease_out(self.appear), (6, 5, 14))
        if self.frame is None:
            return
        a = ease_out(self.shown)
        if a < 1.0:
            self.frame.set_alpha(int(255 * a))
            c.s.blit(self.frame, (0, 0))
            self.frame.set_alpha(None)
        else:
            c.s.blit(self.frame, (0, 0))
        if self.tile is not None and self.error is None and self.home.settings["animations"] != "off":
            # The light around the code breathes (8 cached strengths).
            k = (math.sin(self.home.t * 2.2) + 1) / 2
            k = round((0.35 + 0.65 * k) * a * 7) / 7
            if k > 0:
                radius = int(self.tile.w * 0.78)
                sprite = glow_sprite(radius, tuple(int(ch * k) for ch in self.vivid))
                c.s.blit(sprite, sprite.get_rect(center=self.tile.center), special_flags=pygame.BLEND_RGB_ADD)

    def hints(self):
        return [("circle", "Close")]


class ReportView(ShareView):
    """Report a test, in the Share screen's glass card: the game's art blurred behind, its picture,
    how it ran and the details on the left; on the right a QR code that opens a ready GitHub issue
    on a phone (lib/ps5/report.py). Square saves the report to the USB drive. The FPS and how the
    game ended come from its last run, when that was this game."""
    PICTURE = (180, 153, 507, 200)

    def __init__(self, home, game, result):
        self.game = game
        self.result = result
        last = report.last_game()
        if last is not None and last.get("title_id") == game.title_id and last.get("title") == game.title:
            self.record = last
            self.has_log = True
        else:
            entry = home.games_store.get(game.key)
            self.record = report.record_for(game, entry.get("play_seconds", 0), 0, "", [], "")
            self.has_log = False
        super().__init__(home)

    def prepare(self):
        """Background: the game's art (its colors are known from the home screen), and the code."""
        for name in ("pic0.png", "pic1.png", "icon0.png"):
            path = os.path.join(self.game.sys_dir, name)
            if os.path.isfile(path):
                self.picture = self.load_picture(path)
                if self.picture is not None:
                    break
        palette = getattr(self.game, "palette", None)
        if palette is None and self.picture is not None:
            palette = surface_palette(self.picture)
        self.vivid = palette[0] if palette else ACCENT
        self.qr = qr_surface(report.issue_url(self.record, self.result), px(self.CODE_SIDE), "l")
        if self.qr is None:
            self.error = "The QR code needs the python3-segno package. Square still saves the report."

    def details(self):
        """(label, value) lines shown under the picture."""
        r = self.record
        fps = r.get("fps")
        lines = [("FPS", i18n.Final(f"{fps['avg']}  ({fps['min']} – {fps['max']})") if fps else "Not measured"),
                 ("Console", i18n.Final(f"{r.get('console', 'PS4')}  ·  EmuFive {r.get('emufive', '?')}")),
                 ("Played", system.play_time_text(r.get("played", 0)))]
        if r.get("ended"):
            lines.append(("Ended", r["ended"]))
        if r.get("settings"):
            lines.append(("Settings", i18n.Final(", ".join(i18n.translate(x) for x in r["settings"]))))
        return lines

    def compose_text(self, frame, c):
        x, y, w, h = self.CARD
        px_, py_, pw, ph = self.PICTURE
        ty = py_ + ph + 18
        c.text(c.t.fit(self.game.title, 21, pw, True), 21, px_, ty, ART_TEXT, True)
        ty += 34
        label = compat.LABELS.get(self.result, self.result)
        pill_w = c.t.width(label, 14, True) + 24
        c.rect(compat.COLORS.get(self.result, ACCENT), px_, ty, pill_w, 24, 12)
        c.text(label, 14, px_ + pill_w / 2, ty + 12, ART_TEXT, True, "center")
        sub = self.game.subtitle()
        if sub:
            c.text(c.t.fit(i18n.Final(sub), 14, pw - pill_w - 14), 14, px_ + pill_w + 14, ty + 12, ART_SOFT, False, "midleft")
        ty += 40
        details = self.details()
        label_w = max(c.t.width(i18n.translate(lbl), 15) for lbl, _ in details) + 18
        for lbl, value in details:
            if ty > y + h - 30:
                break
            c.text(lbl, 15, px_, ty, SHARE_DIM)
            c.text(c.t.fit(value, 15, pw - label_w), 15, px_ + label_w, ty, ART_TEXT)
            ty += 24
        if self.error:
            cx, cy = self.CODE
            for n, line in enumerate(c.t.wrap(self.error, 17, 300)):
                c.text(line, 17, cx, cy - 40 + n * 26, ART_SOFT, False, "midtop")
        else:
            self.steps(c, "Post it on GitHub", ("Open your phone's camera", "Point it at the code",
                                                "Post the ready issue"))
        c.text("Square saves the report and the game's log on the USB drive.", 13, ui.W / 2, y + h + 22, SHARE_DIM,
               False, "midtop")

    def act(self, action):
        h = self.home
        if action in (BACK, OK):
            h.sounds.play("back")
            self.close()
        elif action == SQUARE:
            h.sounds.play("select")

            def work():
                if not system.mounted(system.USB_MOUNT):
                    return False, "Plug in a USB drive first."
                _, usb = report.save(self.record, self.result, self.has_log)
                if usb is None:
                    return False, "Could not write to the USB drive."
                return True, "The report is in PS5-logs on the USB drive."

            h.push(Busy(h, "Saving the report…", work))

    def hints(self):
        return [("square", "Save to USB"), ("circle", "Close")]


# --------------------------------------------------------------------------------------------
# The app.

ORB_COUNTS = {"few": 14, "normal": 34, "many": 60}
ORB_SPEEDS = {"slow": 0.5, "normal": 1.0, "fast": 1.8}


class Home:
    def __init__(self, args):
        self.args = args
        self.settings = SETTINGS
        size = None
        if args.size:
            w, _, ht = args.size.partition("x")
            size = (int(w), int(ht))
        self.overscan = self.settings["overscan"]
        self.real_screen, self.screen = ui.init_display(size, args.windowed or size is not None, self.overscan)
        pygame.display.set_caption("EmuFive")
        pygame.mouse.set_visible(False)
        pygame.key.set_repeat(320, 70)
        pygame.key.start_text_input()
        self.text = ui.Text(self.settings["font"], self.settings["text_size"] / 100)
        self.c = ui.Canvas(self.screen, self.text)
        self.make_sounds()
        self.input = ui.Input()
        self.make_input()
        self.profiles = store.Profiles(self.settings)
        current = self.profiles.current()
        if (self.settings["name"], self.settings["avatar"]) != (current["name"], current["avatar"]):
            self.settings.set(name=current["name"], avatar=current["avatar"])
        self.games_store = store.Games(current["id"])
        self.poll = Poller()
        self.quick = args.quick_menu is not None
        self.running_path = args.suspended            # The paused game (Home in the PS button menu).
        self.network = system.Network(args.dry_run_network or self.quick)
        self.pc = system.PcShare(args.pc_test) if not self.quick else None
        self.art = ArtLoader()
        self.clock = pygame.time.Clock()
        self.t = 0.0
        self.result = None
        self.fade_out = None
        self.modals = []
        self.avatar_cache = {}
        self.toast_text = None
        self.toast_until = 0.0
        self.idle_warned = False
        self.update_checked = False

        self.all_games = []
        self.games = []
        self.search = ""                # Triangle on the home screen: only games whose name has this.
        self.entries = {}
        self.game_signature = None
        self.games_changed = False
        # Badges from the tested-games list; a newer list is fetched once a day.
        compat.refresh(lambda: setattr(self, "games_changed", True))
        self.selected = 0
        self.focus = "tiles"     # tiles, wifi, settings
        self.tab = "games"       # games, media
        self.media = MediaView(self)
        self.ps5_layout = self.settings["home_layout"] == "ps5"
        sizes = PS5_TILE_SIZES if self.ps5_layout else TILE_SIZES
        self.tile_small, self.tile_big = sizes.get(self.settings["tile_size"], sizes["medium"])
        if self.ps5_layout:
            self.tiles_x, self.tiles_y, self.tiles_right = PS5_TILES_X, PS5_TILES_Y, ui.W - 40
        else:
            self.tiles_x, self.tiles_y, self.tiles_right = TILES_X, TILES_Y, TILES_RIGHT
        self.info_y = ROW_Y + self.tile_big + 74
        self.row_offset = 0.0
        self.tile_sizes = []
        self.info_alpha = 0.0
        self.bg_current = None
        self.bg_previous = None
        self.bg_mix = 1.0
        self.bg_switch_at = 0.0
        self.bg_index = 0
        self.static_bg = None     # The background when it is not the game's art (cached).
        self.static_palette = None
        self.particles = []
        self.make_particles()
        self.next_scan = 0.0
        self.quick_game = None
        self.saver_on = False
        self.saver_next = 0.0
        self.saver_index = -1

        if self.quick:
            self.quick_game = prepare(system.Game(args.quick_menu))
            self.art.want(self.quick_game, True)
            self.modals.append((ControlCenter if self.ps5_layout else QuickMenu)(self, True, self.quick_game.title))
            return
        self.refresh_games(force=True)
        self.apply_lightbar()
        self.apply_mic()
        if args.message:
            self.push(Dialog(self, args.message))
        note = system.take_after_game_note()   # From ps5-launch: failed shaders, a failed backup.
        for part in note.split("\n\n") if note else []:
            store.add_notification(part)
            self.push(Dialog(self, part))
        # Settings that restart the home screen (theme, text...) come back to the same page.
        try:
            with open(REOPEN) as f:
                category = int(f.read().strip())
            os.remove(REOPEN)
            self.push(SettingsScreen(self, category, focus="rows"))
        except (OSError, ValueError):
            pass
        # At the start of the session, with more than one profile: "Who's playing?"
        if not self.running_path and not self.modals and len(self.profiles.all()) > 1 \
                and not os.path.exists(PROFILE_CHOSEN):
            self.push(ProfilePicker(self))
        try:
            with open(PROFILE_CHOSEN, "w"):
                pass
        except OSError:
            pass

    # Helpers -----------------------------------------------------------------------------------

    def push(self, modal):
        self.modals.append(modal)

    def game_cheats_page(self):
        """The cheats page of the paused game (to turn cheats on and off in it), or None when the
        cheat manager is off or the game has no cheats."""
        game = self.quick_game if self.quick else None
        if game is None or not self.settings["cheats"] or not game.title_id or not game.version:
            return None
        if "game_has_cheats" not in self.__dict__:
            self.game_has_cheats = bool(cheats.entries(cheats.read_index(), game.title_id, game.version))
        return (lambda: CheatGame(self, game)) if self.game_has_cheats else None

    def toast(self, text, seconds=4.0, keep=True):
        """keep: also listed in Notifications (the quick menu)."""
        self.toast_text, self.toast_until = text, self.t + seconds
        if keep:
            store.add_notification(text)

    def set_search(self, text):
        self.search = text.strip()
        self.games_changed = True
        self.refresh_games(force=True)
        self.select(0)
        if self.search and not any(True for g in self.games):
            self.toast(f"No games match \"{self.search}\".", 3.0, keep=False)
        return None

    def finish(self, result):
        if self.result is None:
            self.result = result
            self.fade_out = 1.0 if self.settings["animations"] == "off" else 0.0

    def tell_update(self):
        """A note when a new EmuFive version is out, once for each version (until the PS4 restarts)."""
        check = update.check()
        if check["error"]:
            return
        self.poll.put("update_check", check)
        newest = check["newest"]
        if not newest:
            return
        try:
            with open(UPDATE_TOLD) as f:
                if f.read().strip() == newest:
                    return
        except OSError:
            pass
        self.toast(f"EmuFive {newest} is available in Settings, System.", 8.0)
        try:
            with open(UPDATE_TOLD, "w") as f:
                f.write(newest + "\n")
        except OSError:
            pass

    def request_reload(self, category):
        """Starts the home screen again (for settings it reads only at the start), on this page."""
        try:
            os.makedirs(os.path.dirname(REOPEN), exist_ok=True)
            with open(REOPEN, "w") as f:
                f.write(f"{category}\n")
        except OSError:
            pass
        self.finish("RELOAD")

    def make_sounds(self):
        s = self.settings
        self.sounds = ui.Sounds(s["sound_style"], s["sound_volume"], s["sounds"])

    def make_input(self):
        """The controller settings, kept on the same Input (it holds the open controllers)."""
        s = self.settings
        self.input.swap = s["swap_buttons"]
        self.input.rumble_on = s["rumble"]
        self.input.strength = store.vibration(s) / 100

    def apply_lightbar(self):
        threading.Thread(target=system.set_lightbar, args=(store.lightbar_rgb(self.settings),), daemon=True).start()

    def apply_mic(self):
        threading.Thread(target=system.set_controller_mic, args=(self.settings["controller_mic"],),
                         daemon=True).start()

    def make_particles(self):
        count = ORB_COUNTS.get(self.settings["orb_amount"], 34)
        self.particles = [ui.new_particle(True) for _ in range(count)]

    def avatar(self, size, profile=None, still=False):
        """A profile's picture (the current one's by default) as a circle `size` units wide. An
        animated one gives the frame for this moment (still: its first frame)."""
        profile = profile or {"id": self.profiles.current_id, "avatar": self.settings["avatar"]}
        choice = profile["avatar"]
        if choice == "anim" and not still and self.settings["avatar_motion"]:
            frames = self.anim_frames(store.avatar_anim_dir(profile["id"]), px(size))
            if frames:
                return frames[int(time.monotonic() * ANIM_FPS) % len(frames)]
        key = (profile["id"], choice, size)
        surface = self.avatar_cache.get(key)
        if surface is None:
            if choice in ("file", "anim"):
                try:
                    surface = avatar_disc(pygame.image.load(store.avatar_file(profile["id"])), px(size))
                except (pygame.error, OSError):
                    surface = None
            if surface is None:
                try:
                    index = int(choice.split(":")[1]) if choice.startswith("builtin:") else 0
                except (ValueError, IndexError):
                    index = 0
                surface = ui.builtin_avatar(index, px(size))
            self.avatar_cache[key] = surface
        return surface

    def anim_frames(self, folder, size_px):
        """An animated avatar's frames as round discs `size_px` wide, read in the background
        (None until they are ready, or if there are none)."""
        cache = self.__dict__.setdefault("anim_cache", {})
        key = (folder, size_px, ui.ACCENT)
        frames = cache.get(key)
        if frames is None:
            if len(cache) > 4:
                # Picker previews come and go: keep only the profiles' own avatars.
                for old in [k for k in cache if not k[0].startswith(store.CONFIG_DIR)]:
                    del cache[old]
            cache[key] = "loading"

            def work():
                try:
                    names = sorted(n for n in os.listdir(folder) if n.endswith(".png"))
                    cache[key] = [avatar_disc(pygame.image.load(os.path.join(folder, n)), size_px)
                                  for n in names] or "none"
                except (pygame.error, OSError):
                    cache[key] = "none"

            threading.Thread(target=work, daemon=True).start()
            return None
        return frames if isinstance(frames, list) else None

    def avatar_moves(self):
        return self.settings["avatar"] == "anim" and self.settings["avatar_motion"]

    def switch_profile(self, profile_id):
        self.profiles.switch(profile_id, self.settings)
        self.games_store = store.Games(profile_id)
        self.avatar_cache.clear()
        self.games_changed = True
        self.toast(f"Welcome, {self.settings['name']}", 3.0, keep=False)

    def set_profile(self, **changes):
        """Name or picture of the current profile."""
        self.settings.set(**changes)
        self.profiles.update(self.profiles.current_id, **changes)
        self.avatar_cache.clear()
        self.__dict__.get("anim_cache", {}).clear()

    def play(self, game):
        self.games_store.played(game.key)
        self.sounds.play("select")
        self.finish("PLAY " + game.path)

    def is_running(self, game):
        return self.running_path is not None and game.path == self.running_path

    def open_game(self, game):
        """Play, or back to the paused game; another game asks to close the paused one first."""
        if self.is_running(game):
            self.sounds.play("select")
            self.finish("RESUME")
        elif self.running_path is not None:
            running = next((g.title for g in self.all_games if g.path == self.running_path), "the game")
            self.sounds.play("select")
            self.push(Dialog(self, f"Close {running} and start {game.title}? What {running} has not saved "
                                   "is lost.", [("Close and start", lambda: self.play(game)), ("Cancel", None)]))
        else:
            self.play(game)

    # Games -------------------------------------------------------------------------------------

    def refresh_games(self, force=False):
        found = [(p, "USB", "USB drive") for p in system.find_games(self.args.games)]
        found += [(p, "PS4", "PS4 drive") for p in system.find_games(self.args.ps4_games)]
        found += [(p, "PS4", "EmuFive disk") for p in system.find_games(system.LOCAL_GAMES)]
        with self.pc.lock:
            pc_games = list(self.pc.games)
        signature = (tuple(f[0] for f in found) + tuple(g.path for g in pc_games),
                     self.settings["sort"], self.settings["show_hidden"])
        if not force and signature == self.game_signature and not self.games_changed:
            return
        self.game_signature = signature
        self.games_changed = False
        current = self.games[self.selected].path if self.games and self.selected < len(self.games) else None
        # A stand-in for the paused game (made while its drive or share was not listed yet) gives
        # way to the real one.
        known = {g.path: g for g in self.all_games if not getattr(g, "stand_in", False)}
        all_games = [known.get(p) or system.Game(p, source, name) for p, source, name in found]
        all_games += [known.get(g.path) or g for g in pc_games]
        if self.running_path and not any(g.path == self.running_path for g in all_games):
            stand_in = next((g for g in self.all_games if g.path == self.running_path), None)
            if stand_in is None:
                stand_in = system.Game(self.running_path)
                stand_in.stand_in = True
            all_games.append(stand_in)
        for g in all_games:
            prepare(g)
            if not g.icon_loaded:
                self.art.want(g, False)
        self.all_games = all_games
        show_hidden = self.settings["show_hidden"]
        entries = {g.path: self.games_store.get(g.key) for g in all_games}
        visible = [g for g in all_games if show_hidden or not entries[g.path].get("hidden") or self.is_running(g)]
        if self.search:
            words = self.search.lower().split()
            visible = [g for g in visible if self.is_running(g) or
                       all(w in (g.title + " " + g.title_id).lower() for w in words)]
        recent = self.settings["sort"] == "recent"
        visible.sort(key=lambda g: (not self.is_running(g),
                                    not entries[g.path].get("favorite", False),
                                    -entries[g.path].get("last_played", 0) if recent else 0,
                                    g.title.lower()))
        self.games = visible
        self.entries = entries
        if current is None and self.running_path:
            current = self.running_path
        # With no games, Power is chosen first, with the note on where to put them.
        self.selected = next((i for i, g in enumerate(self.games) if g.path == current),
                             0 if self.games else self.items() - 1)
        self.tile_sizes = [float(self.tile_small)] * self.items()
        self.select(self.selected, sound=False)

    def extra_tiles(self):
        """The tiles after the games: Internet, Cheats (with the cheat manager on), then Power."""
        return (["library"] if self.games else []) + ["browser"] + \
            (["cheats"] if self.settings["cheats"] else []) + ["power"]

    def items(self):
        return len(self.games) + len(self.extra_tiles())

    def tile_kind(self, index=None):
        index = self.selected if index is None else index
        if index < len(self.games):
            return "game"
        extra = self.extra_tiles()
        return extra[min(index - len(self.games), len(extra) - 1)]

    def on_browser(self):
        return self.tile_kind() == "browser"

    def game_media(self, game):
        """This game's screenshots and clips, newest first (from the Media tab's list)."""
        if game is None:
            return []
        self.media.refresh()
        folder = capture_folder(game.title)
        return [p for p in self.media.paths if os.path.basename(os.path.dirname(p)) == folder]

    def on_library(self):
        return self.tile_kind() == "library"

    def on_cheats(self):
        return self.tile_kind() == "cheats"

    def on_power(self):
        return self.tile_kind() == "power"

    def current_game(self):
        return None if self.selected >= len(self.games) else self.games[self.selected]

    def select(self, index, sound=True):
        index = max(0, min(self.items() - 1, index))
        if index != self.selected:
            self.bg_direction = 1 if index > self.selected else -1
        if sound and index != self.selected:
            self.sounds.play("move")
            self.input.rumble()
        self.selected = index
        self.select_t = self.t       # PS5 layout: the light that sweeps over the chosen tile.
        self.info_alpha = 1.0 if self.settings["animations"] == "off" else 0.0
        self.bg_index = 0
        self.bg_switch_at = self.t + 12.0
        for i in (index, index - 1, index + 1):
            if 0 <= i < len(self.games):
                self.art.want(self.games[i], True)
        self.set_background(self.current_background(), animate=True)

    def current_background(self):
        game = self.quick_game if self.quick else self.current_game()
        if game is None and not self.quick and self.selected < self.items():
            return self.tile_background(self.tile_kind(self.selected))
        if game is None or not game.backgrounds:
            return None
        return game.backgrounds[self.bg_index % len(game.backgrounds)]

    def tile_background(self, kind):
        """A background for Internet, Cheats or Power: its tile's color, lit from the right, with
        its icon large and faint there (made once)."""
        color = TILE_BACKGROUND_COLORS.get(kind)
        if color is None:
            return None
        cache = self.__dict__.setdefault("tile_backgrounds", {})
        surface = cache.get(kind)
        if surface is None:
            w, h = px(BG_W), px(BG_H)
            surface = h_gradient(w, h, ui.mix(color, (0, 0, 0), 0.3), ui.mix(color, (255, 255, 255), 0.22)).convert()
            light = glow_sprite(px(420), ui.mix(color, (255, 255, 255), 0.5))
            surface.blit(light, light.get_rect(center=(int(w * 0.72), int(h * 0.48))),
                         special_flags=pygame.BLEND_RGB_ADD)
            canvas = ui.Canvas(surface, self.text)
            faint = ui.mix(color, (255, 255, 255), 0.3)
            cx, cy = BG_W * 0.72, BG_H * 0.48
            if kind == "library":
                draw_library_icon(canvas, cx, cy, 150, faint)
            elif kind == "browser":
                ui.draw_globe(canvas, cx, cy, 150, faint, 10)
            elif kind == "cheats":
                ui.draw_wand(canvas, cx, cy, 150, faint, 10)
            else:
                ui.draw_power(canvas, cx, cy, 120, faint, 12)
            cache[kind] = surface
        return surface

    def set_background(self, surface, animate):
        if surface is self.bg_current:
            return
        animate = animate and self.settings["animations"] != "off"
        self.bg_previous = self.bg_current if animate else None
        self.bg_current = surface
        self.bg_mix = 0.0 if animate else 1.0

    # Actions -----------------------------------------------------------------------------------

    def act(self, action):
        if self.modals:
            self.modals[-1].act(action)
            return
        if action == GUIDE:
            self.sounds.play("select")
            if self.running_path is not None:
                self.finish("RESUME")           # Back to the paused game.
            else:
                self.push((ControlCenter if self.ps5_layout else QuickMenu)(self, False))
            return
        if action in (PAGE_UP, PAGE_DOWN):
            tab = "games" if action == PAGE_UP else "media"
            if tab != self.tab:
                self.tab = tab
                self.focus = "tiles"
                self.sounds.play("move")
            return
        if self.focus in ("wifi", "settings", "notifications", "search", "profile"):
            order = ["search", "settings", "profile"] if self.ps5_layout else ["notifications", "settings", "wifi"]
            if self.focus not in order:
                self.focus = "settings"
            at = order.index(self.focus)
            if action in (DOWN, BACK):
                self.focus = "tiles"
                self.sounds.play("move")
            elif action == LEFT and at > 0:
                self.focus = order[at - 1]
                self.sounds.play("move")
            elif action == RIGHT and at < len(order) - 1:
                self.focus = order[at + 1]
                self.sounds.play("move")
            elif action == OK:
                self.sounds.play("select")
                if self.focus == "search":
                    self.focus = "tiles"
                    self.push(KeyboardDialog(self, "Search games", self.search, on_done=self.set_search,
                                             max_length=40, done_label="Search"))
                elif self.focus == "profile":
                    self.push(ProfileView(self))
                else:
                    self.push(WifiPanel(self) if self.focus == "wifi" else
                              SettingsScreen(self) if self.focus == "settings" else NotificationList(self))
                self.poll.forget("unread")
            return
        if self.tab == "media":
            self.media.act(action)
            return
        if self.focus == "media":
            # PS5 layout: the Media card at the bottom of the game's page.
            if action == UP:
                self.focus = "play"
                self.sounds.play("move")
            elif action == BACK:
                self.focus = "tiles"
                self.sounds.play("back")
            elif action == OK and self.current_game() is not None:
                self.sounds.play("select")
                view = GameMedia(self, self.current_game())
                if view.paths:
                    self.push(MediaViewer(self, view))
            return
        if self.focus in ("play", "more"):
            # PS5 layout: Play Game and ... under the game's name.
            if action == DOWN and self.game_media(self.current_game()):
                self.focus = "media"
                self.sounds.play("move")
            elif action in (UP, BACK):
                self.focus = "tiles"
                self.sounds.play("move")
            elif action == RIGHT and self.focus == "play" and self.current_game() is not None:
                self.focus = "more"
                self.sounds.play("move")
            elif action == LEFT and self.focus == "more":
                self.focus = "play"
                self.sounds.play("move")
            elif action == OPTIONS or (action == OK and self.focus == "more"):
                if self.current_game() is not None:
                    self.sounds.play("select")
                    self.push(GameMenu(self, self.current_game()))
            elif action == OK:
                self.focus = "tiles"
                self.act(OK)
            return
        if action == DOWN and self.ps5_layout and (self.current_game() is not None or self.items()):
            self.focus = "play"
            self.sounds.play("move")
            return
        if action == LEFT:
            self.select(self.selected - 1)
        elif action == RIGHT:
            self.select(self.selected + 1)
        elif action == TRIANGLE:
            self.sounds.play("select")
            self.push(KeyboardDialog(self, "Search games", self.search, on_done=self.set_search,
                                     max_length=40, done_label="Search"))
        elif action == BACK and self.search:
            self.sounds.play("back")
            self.set_search("")
        elif action == UP:
            self.focus = "settings" if self.ps5_layout else "wifi"
            self.sounds.play("move")
        elif action == OPTIONS and self.current_game() is not None:
            self.sounds.play("select")
            self.push(GameMenu(self, self.current_game()))
        elif action == OK:
            if self.on_library():
                self.sounds.play("select")
                self.push(GameLibrary(self))
            elif self.on_browser():
                self.sounds.play("select")
                if self.running_path is not None:
                    self.push(Dialog(self, "Close the paused game first (PS button, Close the game), so the "
                                           "browser has the memory."))
                else:
                    self.finish("BROWSER")
            elif self.on_cheats():
                self.sounds.play("select")
                self.push(CheatManager(self))
            elif self.on_power():
                self.sounds.play("select")
                closing = " The paused game is closed first." if self.running_path else ""
                self.push(Dialog(self, "Turn off the PS4?" + closing,
                                 [("Turn off", lambda: self.finish("POWEROFF")),
                                  ("Restart", lambda: self.finish("REBOOT"))]))
            else:
                self.open_game(self.games[self.selected])

    # Frame -------------------------------------------------------------------------------------

    def update(self, dt):
        self.t += dt
        motion = self.settings["animations"]
        if not self.quick and self.t >= self.next_scan:
            self.next_scan = self.t + 3.0
            self.refresh_games()
        if self.input.typed:
            if self.modals:
                for chunk in self.input.typed:
                    self.modals[-1].typed(chunk)
            self.input.typed.clear()
        for modal in list(self.modals):
            modal.update(dt)
            if motion == "off":
                modal.appear = 1.0
        self.modals = [m for m in self.modals if not m.closed]
        if not self.quick and not self.update_checked and self.t > UPDATE_CHECK_AFTER:
            self.update_checked = True
            threading.Thread(target=self.tell_update, daemon=True).start()
        if self.quick and not self.modals and self.result is None:
            self.finish("RESUME")
        if self.games_changed and not self.quick:
            self.refresh_games()

        keep = set()
        for i in (self.selected - 1, self.selected, self.selected + 1):
            if 0 <= i < len(self.games):
                keep.add(self.games[i])
        if self.saver_on and 0 <= self.saver_index < len(self.games):
            keep.add(self.games[self.saver_index])
        pending = self.all_games + ([self.quick_game] if self.quick else [])
        if self.quick:
            keep.add(self.quick_game)
        for g in pending:
            if (g.raw_icon is not None and g.icon is None) or g.raw_backgrounds is not None:
                self.art.finish(g, keep)

        self.update_screensaver()
        if not self.saver_on:
            game = self.quick_game if self.quick else self.current_game()
            if game is not None and game.backgrounds and self.bg_current is None:
                self.set_background(self.current_background(), animate=True)
            if game is not None and game.backgrounds and len(game.backgrounds) > 1 and self.t >= self.bg_switch_at:
                self.bg_index += 1
                self.set_background(self.current_background(), animate=True)
                self.bg_switch_at = self.t + 12.0
        self.bg_mix = min(1.0, self.bg_mix + dt / (0.7 if motion == "full" else 0.3))

        step = self.tile_small + TILE_GAP
        before = self.tiles_before(step)
        target = max(0, self.selected - before) * step
        rate = 1000 if motion == "off" else 12
        self.row_offset = ease(self.row_offset, target, rate, dt)
        for i in range(len(self.tile_sizes)):
            want = self.tile_small
            if i == self.selected:
                want = self.tile_big if self.focus in ("tiles", "play", "more", "media") else self.tile_small + 18
            self.tile_sizes[i] = ease(self.tile_sizes[i], want, 1000 if motion == "off" else 14, dt)
        self.info_alpha = min(1.0, self.info_alpha + dt / (0.35 if motion == "full" else 0.15))

        if self.settings["orbs"] and motion != "off":
            speed = ORB_SPEEDS.get(self.settings["orb_speed"], 1.0)
            for p in self.particles:
                p[1] -= p[2] * dt * speed
                if motion == "full":
                    p[0] += math.sin(self.t * 0.6 + p[4]) * 6 * dt * speed
                if p[1] < ui.H * 0.18:
                    p[:] = ui.new_particle()
        if self.fade_out is not None:
            self.fade_out += dt / 0.45

        # Turn off when not used (home screen only, not while a game waits).
        minutes = self.settings["auto_off_minutes"]
        if minutes and not self.quick and self.running_path is None and self.result is None:
            left = minutes * 60 - (time.monotonic() - self.input.last_input)
            if left <= 60 and not self.idle_warned:
                self.idle_warned = True
                self.toast("The PS4 turns off in a minute. Press any button to keep it on.", 60, keep=False)
            if left <= 0:
                self.finish("POWEROFF")

    def update_screensaver(self):
        minutes = self.settings["screensaver_minutes"]
        idle = time.monotonic() - self.input.last_input
        if not self.saver_on:
            if minutes and not self.quick and self.result is None and idle >= minutes * 60:
                self.saver_on = True
                self.saver_next = self.t
                self.saver_index = self.selected - 1
            return
        if self.settings["screensaver_mode"] != "slideshow" or not self.games:
            return
        if self.t >= self.saver_next:
            self.saver_index = (self.saver_index + 1) % len(self.games)
            self.saver_next = self.t + 9.0
            self.art.want(self.games[self.saver_index], True)
            self.art.want(self.games[(self.saver_index + 1) % len(self.games)], True)
        game = self.games[self.saver_index % len(self.games)]
        if game.backgrounds:
            self.set_background(game.backgrounds[0], animate=True)

    def wake(self):
        """Any button ends the screensaver (and does nothing else)."""
        self.saver_on = False
        self.bg_index = 0
        self.set_background(self.current_background(), animate=True)

    def draw(self):
        c = self.c
        if self.overscan:
            self.real_screen.fill((0, 0, 0))
        if self.saver_on:
            self.draw_screensaver(c)
            return
        cover = max((i for i, m in enumerate(self.modals) if m.covers), default=-1)
        if cover < 0:
            self.draw_home(c)
        for modal in self.modals[max(0, cover):]:
            modal.draw(c)
        if self.settings["hints"]:
            if self.modals and isinstance(self.modals[-1], (ShareView, MediaViewer)):
                # Over a dark picture in every theme: light hints.
                ui.draw_hints(c, self.modals[-1].hints(), soft=ART_SOFT, dim=ART_SOFT)
            elif self.modals:
                ui.draw_hints(c, self.modals[-1].hints())
            else:
                soft = HOME_SOFT if self.ps5_layout else ART_SOFT
                ui.draw_hints(c, self.home_hints(), soft=soft, dim=soft)
        if self.toast_text and self.t < self.toast_until:
            width = c.t.width(self.toast_text, 18) + 48
            c.rect(DIALOG, ui.W / 2 - width / 2, 24, width, 48, 24)
            c.rect(ACCENT, ui.W / 2 - width / 2, 24, width, 48, 24, 2)
            c.text(self.toast_text, 18, ui.W / 2, 48, WHITE, False, "center")
        if self.fade_out is not None:
            c.dim(255 * min(1.0, self.fade_out), (0, 0, 0))

    def draw_screensaver(self, c):
        if self.settings["screensaver_mode"] == "slideshow" and self.games:
            self.draw_background(c, orbs=False)
            game = self.games[self.saver_index % len(self.games)]
            c.text(c.t.fit(game.title, 30, ui.W - 200, True), 30, ROW_X, ui.H - 110, ART_TEXT, True, shadow=True)
            c.text(clock_text(self.settings["clock_24h"]), 20, ui.W - 64, ui.H - 100, ART_TEXT, True, "topright",
                   shadow=True)
            return
        # Dim: almost black, with the clock moving slowly so nothing stays in one place.
        c.s.fill((0, 0, 0))
        x = ui.W / 2 + math.sin(self.t * 0.05) * ui.W * 0.3
        y = ui.H / 2 + math.sin(self.t * 0.037 + 1) * ui.H * 0.3
        c.text(clock_text(self.settings["clock_24h"]), 40, x, y, (90, 90, 100), True, "center")

    def make_static_background(self):
        """The background for the gradient, solid and picture choices (screen size, made once)."""
        w, h = self.screen.get_size()
        choice = self.settings["background"]
        surface = None
        if choice == "picture":
            try:
                picture = pygame.image.load(store.BACKGROUND_FILE)
                scale = max(w / picture.get_width(), h / picture.get_height())
                picture = pygame.transform.smoothscale(
                    picture, (int(picture.get_width() * scale) + 1, int(picture.get_height() * scale) + 1))
                surface = pygame.Surface((w, h))
                surface.blit(picture, picture.get_rect(center=(w // 2, h // 2)))
            except (pygame.error, OSError):
                surface = None
        if surface is None and choice in ("gradient", "picture"):
            # Dark at the bottom left, the accent color glowing at the top right.
            small = pygame.Surface((32, 18))
            base = ui.mix(ACCENT, (6, 6, 14), 0.86)
            glow = ui.mix(ACCENT, (6, 6, 14), 0.45)
            for y in range(18):
                for x in range(32):
                    t = max(0.0, min(1.0, (x / 31) * 0.6 + (1 - y / 17) * 0.6 - 0.25))
                    small.set_at((x, y), ui.mix(base, glow, t * t))
            surface = pygame.transform.smoothscale(small, (w, h))
        if surface is None:
            surface = pygame.Surface((w, h))
            surface.fill(ui.mix(ACCENT, (8, 8, 16), 0.82))
        vivid = surface_palette(surface)[0] if choice == "picture" else ACCENT
        self.static_palette = (vivid, ui.mix(vivid, (0, 0, 0), 0.7))
        self.static_bg = aurora_background(surface, vivid).convert()

    def draw_background(self, c, orbs=True):
        s = self.settings
        use_art = s["background"] == "art" or self.quick or self.saver_on
        # A still background with its veil is kept: a whole new frame (once a second with the
        # seconds on the clock) then copies it instead of dimming the full screen again.
        key = None
        if self.bg_mix >= 1.0:
            key = (c.s.get_size(), use_art, id(self.bg_current), id(self.static_bg), s["dim"], s["accent"], s["theme"], ACCENT)
            cached = getattr(self, "bg_layer", None)
            if cached is not None and cached[0] == key:
                c.s.blit(cached[1], (0, 0))
                if orbs:
                    self.draw_orbs(c)
                return
        if self.bg_mix < 1.0 and self.bg_previous is not None:
            # Cross-fade between two finished frames (art, veil and dim): one copy and one blend
            # per frame instead of painting and dimming both backgrounds again.
            old = self.background_layer(c, s, use_art, self.bg_previous)
            new = self.background_layer(c, s, use_art, self.bg_current)
            self.paint_transition(c, old, new, self.bg_mix, s["cover_transition"])
            if orbs:
                self.draw_orbs(c)
            return
        self.paint_background(c, s, use_art)
        if key is not None:
            self.bg_layer = (key, c.s.copy())
        if orbs:
            self.draw_orbs(c)

    def paint_transition(self, c, old, new, mix, style):
        """One frame of the cover change from frame old to frame new (mix 0 to 1). Every style
        only moves, crops or fades the two finished frames, so it stays cheap on the PS4's CPU."""
        w, h = c.s.get_size()
        d = getattr(self, "bg_direction", 1)          # 1: moved right, -1: moved left.
        t = mix * mix * (3 - 2 * mix)                   # Ease in and out.
        base = ui.mix(ACCENT, (6, 6, 14), 0.86)
        if style == "slide":
            c.s.blit(old, (int(-d * t * w), 0))
            c.s.blit(new, (int(d * (1 - t) * w), 0))
        elif style == "zoom":
            c.s.blit(old, (0, 0))
            scale = 1.0 + 0.08 * (1 - t)
            zw, zh = int(w * scale), int(h * scale)
            grown = pygame.transform.scale(new, (zw, zh))
            grown.set_alpha(int(255 * t))
            c.s.blit(grown, ((w - zw) // 2, (h - zh) // 2))
        elif style == "wipe":
            band = max(8, w // 12)                       # The soft edge, in 4 steps.
            edge = int(t * (w + band))
            c.s.blit(old, (0, 0))
            if d > 0:                                    # Sweeps from the right.
                start = w - edge
                c.s.blit(new, (start + band, 0), (start + band, 0, w, h))
                for i in range(4):
                    x = start + i * band // 4
                    new.set_alpha(int(255 * (i + 1) / 5))
                    c.s.blit(new, (x, 0), (x, 0, band // 4 + 1, h))
            else:                                        # Sweeps from the left.
                c.s.blit(new, (0, 0), (0, 0, max(0, edge - band), h))
                for i in range(4):
                    x = edge - band + i * band // 4
                    new.set_alpha(int(255 * (4 - i) / 5))
                    c.s.blit(new, (x, 0), (x, 0, band // 4 + 1, h))
            new.set_alpha(None)
        elif style == "dark":
            c.s.fill((0, 0, 0))
            layer, alpha = (old, 1 - 2 * mix) if mix < 0.5 else (new, 2 * mix - 1)
            layer.set_alpha(int(255 * alpha))
            c.s.blit(layer, (0, 0))
            layer.set_alpha(None)
        elif style == "parallax":
            c.s.fill(base)
            old.set_alpha(int(255 * (1 - t)))
            c.s.blit(old, (int(-d * 0.35 * t * w), 0))
            new.set_alpha(int(255 * t))
            c.s.blit(new, (int(d * 0.25 * (1 - t) * w), 0))
            old.set_alpha(None)
            new.set_alpha(None)
        elif style == "blinds":
            c.s.blit(old, (0, 0))
            count = 10
            strip = -(-w // count)
            for i in range(count):
                order = i if d > 0 else count - 1 - i
                p = min(1.0, max(0.0, mix * 1.8 - order * 0.08))
                p = p * p * (3 - 2 * p)
                x = i * strip
                c.s.blit(new, (x, 0), (x, 0, int(strip * p) + 1 if p > 0 else 0, h))
        elif style == "doors":
            c.s.blit(new, (0, 0))
            half = w // 2
            shift = int(t * half)
            c.s.blit(old, (-shift, 0), (0, 0, half, h))
            c.s.blit(old, (half + shift, 0), (half, 0, w - half, h))
        elif style == "push":
            c.s.blit(old, (0, int(-d * t * h)))
            c.s.blit(new, (0, int(d * (1 - t) * h)))
        elif style == "iris":
            c.s.blit(old, (0, 0))
            cx, cy = w // 2, h // 2
            r = t * math.hypot(cx, cy)
            step = 2
            for y in range(max(0, int(cy - r)), min(h, int(cy + r) + 1), step):
                dy = y - cy
                half = math.sqrt(max(0.0, r * r - dy * dy))
                if half >= 1:
                    x0 = max(0, int(cx - half))
                    c.s.blit(new, (x0, y), (x0, y, min(w, int(cx + half)) - x0, step))
        elif style == "pixelate":
            layer, p = (old, mix * 2) if mix < 0.5 else (new, 2 - mix * 2)
            block = 1 + int(p * p * 31)                  # 1 to 32 pixels per block.
            if block <= 1:
                c.s.blit(layer, (0, 0))
            else:
                small = pygame.transform.scale(layer, (max(1, w // block), max(1, h // block)))
                c.s.blit(pygame.transform.scale(small, (w, h)), (0, 0))
        else:                                            # Crossfade.
            c.s.blit(old, (0, 0))
            new.set_alpha(int(255 * mix))
            c.s.blit(new, (0, 0))
            new.set_alpha(None)

    def background_layer(self, c, s, use_art, surface):
        """One still background as a full frame, made once and kept for cross-fades."""
        key = (c.s.get_size(), use_art, id(surface), id(self.static_bg), s["dim"], s["accent"], s["theme"], ACCENT)
        layers = self.__dict__.setdefault("fade_layers", {})
        entry = layers.get(key)
        if entry is None:
            saved = self.bg_previous, self.bg_current, self.bg_mix
            self.bg_previous, self.bg_current, self.bg_mix = None, surface, 1.0
            target = c.s
            c.s = target.copy()
            try:
                self.paint_background(c, s, use_art)
                layer = c.s
            finally:
                c.s = target
                self.bg_previous, self.bg_current, self.bg_mix = saved
            if len(layers) >= 4:     # The surface is kept with its layer, so its id stays unique.
                layers.clear()
            entry = layers[key] = (surface, layer)
        return entry[1]

    def paint_background(self, c, s, use_art):
        if not use_art:
            if self.static_bg is None:
                self.make_static_background()
            c.s.blit(self.static_bg, (0, 0))
        else:
            c.s.fill(ui.mix(ACCENT, (6, 6, 14), 0.86))
            # Centred: the background no longer drifts, so a still home screen is drawn once and
            # kept (see draw_home).
            drift_x, drift_y = px(max(0.0, BG_W - ui.W)) / 2, px(BG_H - ui.H) / 2
            if self.bg_previous is not None and self.bg_mix < 1.0:
                c.s.blit(self.bg_previous, (-drift_x, -drift_y))
            if self.bg_current is not None:
                if self.bg_mix < 1.0:
                    self.bg_current.set_alpha(int(255 * self.bg_mix))
                    c.s.blit(self.bg_current, (-drift_x, -drift_y))
                    self.bg_current.set_alpha(None)
                else:
                    c.s.blit(self.bg_current, (-drift_x, -drift_y))
            elif self.bg_previous is not None and self.bg_mix < 1.0:
                c.dim(255 * self.bg_mix, ui.mix(ACCENT, (6, 6, 14), 0.86))
        if s["dim"]:
            c.dim(255 * s["dim"] / 100, (0, 0, 0))

    def draw_orbs(self, c, avoid=None):
        s = self.settings
        if s["orbs"]:
            color = s["orb_color"]
            pulse = s["animations"] != "off"
            for x, y, _, size, phase in self.particles:
                if avoid is not None and avoid.collidepoint(x, y):
                    continue
                glow = (math.sin(self.t * 1.3 + phase) + 1) / 2 if pulse else 0.5
                if color == "accent":
                    rgb = ui.mix(ACCENT, (255, 255, 255), 0.2 + 0.4 * glow)
                elif color == "gold":
                    rgb = ui.mix((200, 140, 40), (255, 225, 140), glow)
                else:
                    g = int(110 + 90 * (glow * 2 - 1))
                    rgb = (g, g, min(255, g + 40))
                c.circle(rgb, x, y, size, fast=True)

    def tiles_before(self, step):
        """How many tiles stay before the chosen one: none in the PS5 layout (it is at the left)."""
        if self.ps5_layout:
            return 0
        return max(0, int((self.tiles_right - self.tiles_x - self.tile_big - TILE_GAP) // step))

    def home_key(self):
        """What the home screen shows, or None while something moves (then it is drawn every
        frame). A still home screen is drawn once and kept; only the orbs and the breathing glow
        of the Play button are drawn each frame (the PS4's CPU is slow)."""
        if self.bg_mix < 1.0 or self.info_alpha < 1.0:
            return None
        step = self.tile_small + TILE_GAP
        before = self.tiles_before(step)
        if abs(self.row_offset - max(0, self.selected - before) * step) > 0.3:
            return None
        for i, size in enumerate(self.tile_sizes):
            want = self.tile_small
            if i == self.selected:
                want = self.tile_big if self.focus in ("tiles", "play", "more", "media") else self.tile_small + 18
            if abs(size - want) > 0.3:
                return None
        s = self.settings
        with self.network.lock:
            net = (self.network.state, self.network.ssid, self.network.ethernet)
        pads = tuple((p["mac"], p["battery"], p["charging"], p["connection"])
                     for p in self.poll.get("controllers", system.controllers, 2.0, []))
        game = self.current_game()
        media = (len(self.media.paths), self.media.index, self.media.top_row, len(self.media.thumbs),
                 self.media.on_apps, self.media.app) \
            if self.tab == "media" else None
        return (self.tab, self.focus, self.selected, bool(self.modals), self.game_signature, len(self.games),
                id(self.bg_current), id(self.static_bg), id(self.entries), self.running_path,
                clock_text(s["clock_24h"], s["clock_seconds"]), time.strftime("%d") if s["clock_date"] else "",
                net, pads, self.input.pad_count(), tuple(sorted(s.data.items())),
                sum(1 for g in self.games if g.icon is not None),
                self.trophy_summary(game) if game is not None else None,
                self.media_card_key(game),
                tuple(self.poll.get("ip", system.ip_addresses, 10.0, [])) if s["show_ip"] else None, media,
                self.poll.get("unread", store.unread_notifications, 2.0, 0))

    def draw_home(self, c):
        if self.quick:
            self.draw_background(c)
            c.dim(80)
            return
        key = self.home_key()
        size = c.s.get_size()
        frame = getattr(self, "frame", None)
        if key is None or key != getattr(self, "frame_key", None) or frame is None or frame.get_size() != size:
            if frame is None or frame.get_size() != size:
                self.frame = pygame.Surface(size).convert()
            canvas = ui.Canvas(self.frame, c.t)
            self.ring = None
            self.shine_tile = None
            self.avatar_spot = None
            self.draw_background(canvas, orbs=False)
            if self.ps5_layout and (self.tab != "media" or LIGHT):
                self.draw_ps5_shade(canvas)    # Under the top bar, so Games is as bright as Media.
            self.draw_top_bar(canvas)
            if self.tab == "media":
                self.media.draw(canvas)
            else:
                self.draw_tiles(canvas)
                if self.ps5_layout:
                    self.draw_ps5_info(canvas)
                else:
                    self.draw_info(canvas)
            self.frame_key = key
        c.s.blit(self.frame, (0, 0))
        spot = getattr(self, "avatar_spot", None)
        if spot is not None and self.avatar_moves():
            # An animated avatar: only its circle is drawn again over the kept frame.
            x, y, size, anchor = spot
            c.blit(self.avatar(size), x, y, anchor)
        avoid = pygame.Rect(CARD_X - 10, 0, ui.W, ui.H) if self.tab == "games" and not self.ps5_layout else None
        self.draw_orbs(c, avoid)
        if getattr(self, "shine_tile", None) is not None and self.focus == "tiles" and not self.modals \
                and self.settings["animations"] == "full":
            # Over the kept frame, so only the tile is drawn again (a full redraw is slow on a PS4).
            x, y, size = self.shine_tile
            since = self.t - getattr(self, "select_t", -9)
            shape = self.settings["tile_shape"]
            self.draw_shine(c, x, y, size, shape, (since - SHINE_DELAY) / SHINE_SECONDS, 1)
            # The outline fades in bright, then settles dimmer over a second (as on a PS5); the
            # crossing light brightens it again.
            if since < 0.15:
                strength = since / 0.15
            else:
                strength = 1.0 - 0.35 * min(1.0, (since - 0.15) / 1.0)
            shine = (since - SHINE_DELAY) / SHINE_SECONDS
            if 0 <= shine < 1:
                strength += 0.35 * math.sin(math.pi * shine)
            self.draw_halo(c, x, y, size, max(0.0, min(1.0, strength)))
        if getattr(self, "ring", None) is not None and not self.modals:
            x, y, width, vivid = self.ring
            ring = (math.sin(self.t * 2.6) + 1) / 2
            grow = 14 * ring
            # The glow's alpha in steps of 8, so the see-through outlines are reused.
            c.rect(vivid + (int(150 * (1 - ring)) // 8 * 8,), x - grow / 2, y - grow / 2, width + grow,
                   44 + grow, 28, 2)

    def draw_ps5_top_bar(self, c):
        """The PS5 layout's top bar: Games and Media at the left; Search, Settings, the profile
        picture and the clock at the right."""
        s = self.settings
        x = ROW_X
        for tab, label in (("games", "Games"), ("media", "Media")):
            on = self.tab == tab
            width = c.text(label, 21, x, 30, HOME_TEXT if on else HOME_SOFT, on, shadow=not LIGHT)
            x += width + 30
        right = ui.W - 56
        clock = clock_text(s["clock_24h"], s["clock_seconds"])
        clock_w = c.text(clock, 21, right, 30 if not s["clock_date"] else 21, HOME_TEXT, True, "topright",
                         shadow=not LIGHT)
        if s["clock_date"]:
            date = time.strftime("%a %d %b")
            clock_w = max(clock_w, c.text(date, 13, right, 49, HOME_SOFT, False, "topright", shadow=not LIGHT))
        focus_home = not self.modals
        spots = [("profile", right - clock_w - 40), ("settings", right - clock_w - 92),
                 ("search", right - clock_w - 144)]
        tips = {"profile": s["name"], "settings": "Settings", "search": "Search games"}
        for name, spot in spots:
            if self.focus == name and focus_home:
                c.circle(HOME_TEXT, spot, 44, 22, 2)
                self.tip(c, spot, tips[name])
        profile_x, gear_x, search_x = (spot for _, spot in spots)
        c.blit(self.avatar(32), profile_x, 44, "center")
        self.avatar_spot = (profile_x, 44, 32, "center")
        if self.poll.get("unread", store.unread_notifications, 2.0, 0):
            # New notifications (they are in the profile page): a dot on the profile picture.
            c.circle((10, 10, 16), profile_x + 13, 32, 7)
            c.circle(ACCENT, profile_x + 13, 32, 5)
        ui.draw_gear(c, gear_x, 44, HOME_TEXT)
        ui.draw_search(c, search_x, 44, HOME_TEXT)
        if self.search:
            c.circle(ACCENT, search_x + 12, 32, 5)

    def draw_ps5_shade(self, c):
        """Darker toward the left and the bottom, so the name and buttons read on any art."""
        size = c.s.get_size()
        key = ("ps5-shade", size)
        shade = GLOWS.get(key)
        if shade is None:
            small = pygame.Surface((64, 36), pygame.SRCALPHA)
            # Light theme: a white veil (the text is dark), stronger so it reads on any art.
            shade_color, strength = ((242, 242, 248), 1.25) if LIGHT else ((0, 0, 0), 1.0)
            for yy in range(36):
                for xx in range(64):
                    left = max(0.0, 1 - xx / 40) * 0.62
                    bottom = max(0.0, (yy - 20) / 16) * 0.7
                    top = max(0.0, 1 - yy / 6) * (0.6 if LIGHT else 0.35)
                    alpha = 1 - (1 - left) * (1 - bottom) * (1 - top)
                    small.set_at((xx, yy), shade_color + (min(255, int(255 * alpha * strength)),))
            shade = pygame.transform.smoothscale(small, size)
            GLOWS[key] = shade
        c.s.blit(shade, (0, 0))

    def draw_ps5_info(self, c):
        """The PS5 layout: the chosen game's name at the left over its art, Play and ... below it,
        the play time at the right, and cards with its details at the bottom."""
        a = self.info_alpha
        game = self.current_game()
        play_on = self.focus == "play" and not self.modals
        more_on = self.focus == "more" and not self.modals
        title, sub, button, notes, cards = "", "", None, [], []
        if not self.games and self.on_power():
            title = i18n.translate("No games yet")
            notes = ["Put PS5 game folders in one of these places:",
                     "  •  the PS5 folder of a USB drive",
                     f"  •  {system.PS4_GAMES_SHOWN} on the PS4, with GoldHEN FTP",
                     "  •  a shared folder on a PC (Settings, at the top)",
                     "They show up here by themselves."]
        elif self.on_library():
            title, sub, button = i18n.translate("Game Library"), "All your games in one place", "Open"
        elif self.on_browser():
            title, sub, button = i18n.translate("Internet"), "Browse the web with the controller", "Open"
        elif self.on_cheats():
            title, sub, button = i18n.translate("Cheats"), "Turn on cheats for your games", "Open"
        elif self.on_power():
            title, sub, button = i18n.translate("Power"), "Turn off or restart the PS4", "Power"
        elif game is not None:
            title, sub = game.title, game.subtitle()
            button = "Resume" if self.is_running(game) else "Play Game"
            entry = self.entries.get(game.path, {})
            seconds = entry.get("play_seconds", 0)
            trophies = self.trophy_summary(game)
            if trophies:
                cards.append(("Trophies", trophies))
            cards.append(("Played", (system.play_time_text(seconds) if seconds >= 60 else "not played yet",
                                     entry.get("last_played", 0))))
            cards.append(("From", getattr(game, "source_name", "") or game.source))
            shots = self.game_media(game)
            if shots:
                cards.append(("Media", shots))
        x, y = PS5_INFO_X, PS5_INFO_Y + (1 - a) * 12
        for line in c.t.wrap(title, 46, 640, True)[:2]:
            c.text(line, 46, x, y, HOME_TEXT, True, shadow=not LIGHT)
            y += 56
        if sub:
            c.text(c.t.fit(sub, 18, 640), 18, x + 2, y + 4, HOME_SOFT, shadow=not LIGHT)
            y += 30
        for line in notes:
            c.text(c.t.fit(line, 15, 640), 15, x + 2, y + 6, HOME_SOFT, shadow=not LIGHT)
            y += 22
        y += 26
        if button:
            label = i18n.translate(button)
            width = max(170, c.t.width(label, 18, True) + 60)
            fill, idle, ink = (HOME_TEXT + (240,), (0, 0, 0, 26), INK) if LIGHT else \
                ((255, 255, 255, 240), (255, 255, 255, 46), (22, 22, 28))
            c.rect(fill if play_on else idle, x, y, width, 46, 23)
            if play_on:
                c.rect(HOME_TEXT, x - 5, y - 5, width + 10, 56, 28, 2)
            c.text(label, 18, x + width / 2, y + 23, ink if play_on else HOME_TEXT, True, "center")
            if game is not None:
                ox = x + width + 14
                c.rect(fill if more_on else idle, ox, y, 46, 46, 23)
                if more_on:
                    c.rect(HOME_TEXT, ox - 5, y - 5, 56, 56, 28, 2)
                for n in (-1, 0, 1):
                    c.circle(ink if more_on else HOME_TEXT, ox + 23 + n * 8, y + 23, 2.5)
            if game is not None and self.entries.get(game.path, {}).get("play_seconds", 0) >= 60:
                hours = self.entries[game.path]["play_seconds"] / 3600
                text = f"{int(hours)}h" if hours >= 1 else f"{int(hours * 60)}m"
                width = c.t.width(text, 15, True) + 44
                px0 = ui.W - 64 - width
                c.rect((255, 255, 255, 150) if LIGHT else (0, 0, 0, 120), px0, y + 9, width, 28, 14)
                ui.draw_clock_icon(c, px0 + 17, y + 23, HOME_TEXT)
                c.text(text, 15, px0 + 30, y + 23, HOME_TEXT, True, "midleft")
        if cards:
            cw, ch, cy = 250, 78, ui.H - 172
            for n, (label, value) in enumerate(cards):
                cx = x + n * (cw + 14)
                self.draw_glass(c, cx, cy, cw, ch, 14, 120 if LIGHT else 16)
                if label == "Trophies":
                    # As on a PS5: a cup and the count earned for each grade, then the word.
                    grades = value[2] if len(value) > 2 else {}
                    tx = cx + 22
                    for grade in ("platinum", "gold", "silver", "bronze"):
                        ui.draw_trophy(c, tx, cy + 26, TROPHY_COLORS[grade], 8)
                        tx += 14 + c.text(str(grades.get(grade, 0)), 17, tx + 14, cy + 15, HOME_TEXT, True) + 16
                    c.text(f"Trophies  ·  {value[0]} / {value[1]}", 14, cx + 18, cy + 44, HOME_SOFT)
                    c.rect(HOME_TEXT + (50,), cx + 18, cy + ch - 12, cw - 36, 3, 1)
                    c.rect(HOME_TEXT, cx + 18, cy + ch - 12, max(3, (cw - 36) * value[0] / max(1, value[1])), 3, 1)
                    continue
                if label == "Played":
                    # The play time, and when it was last played.
                    played, last = value
                    c.text(label, 14, cx + 18, cy + 14, HOME_SOFT)
                    if last:
                        c.text(time.strftime("%d %b", time.localtime(last)), 14, cx + cw - 18, cy + 14, HOME_SOFT,
                               False, "topright")
                    c.text(c.t.fit(played, 20, cw - 36, True), 20, cx + 18, cy + 38, HOME_TEXT, True)
                    continue
                if label == "Media":
                    # This game's screenshots and videos: the newest small at the right; X opens them.
                    if self.focus == "media" and not self.modals:
                        c.rect(HOME_TEXT, cx - 5, cy - 5, cw + 10, ch + 10, 19, 2)
                    thumb = self.small_thumb(value[0])
                    if thumb is not None:
                        c.blit(thumb, cx + cw - 12 - 96, cy + 12)
                    c.text("Media", 14, cx + 18, cy + 14, HOME_SOFT)
                    c.text(str(len(value)), 20, cx + 18, cy + 38, HOME_TEXT, True)
                    continue
                c.text(label, 14, cx + 18, cy + 14, HOME_SOFT)
                c.text(c.t.fit(value, 20, cw - 36, True), 20, cx + 18, cy + 38, HOME_TEXT, True)

    def media_card_key(self, game):
        """What the Media card shows (so the page is drawn again when it changes)."""
        if not self.ps5_layout or game is None or self.tab != "games":
            return None
        shots = self.game_media(game)
        return (len(shots), shots[0] in self.__dict__.get("small_thumbs", {}) or
                self.media.thumbs.get(shots[0]) is not None) if shots else None

    def small_thumb(self, path):
        """A screenshot or clip, 96 x 54, for the Media card (None while it loads)."""
        cache = self.__dict__.setdefault("small_thumbs", {})
        if path in cache:
            return cache[path]
        big = self.media.thumb(path)
        if big is None:
            return None
        small = pygame.transform.smoothscale(big, (px(96), px(54))) if big else None
        if len(cache) > 50:
            cache.clear()
        cache[path] = small
        return small

    def draw_top_bar(self, c):
        s = self.settings
        if self.ps5_layout:
            self.draw_ps5_top_bar(c)
            return
        x = ROW_X
        if s["show_avatar"]:
            c.blit(self.avatar(40), x, 24)
            self.avatar_spot = (x, 24, 40, "topleft")
            x += 52
        if s["show_name"]:
            x += c.text(c.t.fit(s["name"], 19, 300, True), 19, x, 33, ART_TEXT, True, shadow=True) + 36
        # The tabs: Games and Media (L1 / R1).
        for tab, label in (("games", "Games"), ("media", "Media")):
            on = self.tab == tab
            width = c.text(label, 19, x, 33, ART_TEXT if on else ART_SOFT, on, shadow=True)
            if on:
                c.rect(ART_TEXT, x, 60, width, 3, 2)
            x += width + 28

        right = ui.W - 56
        clock = clock_text(s["clock_24h"], s["clock_seconds"])
        clock_w = c.text(clock, 20, right, 33 if not s["clock_date"] else 24, ART_TEXT, True, "topright",
                         shadow=True)
        if s["clock_date"]:
            date = time.strftime("%a %d %b")
            clock_w = max(clock_w, c.text(date, 13, right, 50, ART_SOFT, False, "topright", shadow=True))
        x = right - clock_w
        with self.network.lock:
            state, ssid, ethernet = self.network.state, self.network.ssid, self.network.ethernet
        bars = 3 if state == "connected" else 1 if state == "connecting" else 0
        wifi_x = x - 40
        focus_home = not self.modals
        if self.focus == "wifi" and focus_home:
            c.circle(ART_TEXT, wifi_x, 44, 22, 2)
            label = ssid if state == "connected" else ("Network cable" if ethernet == "connected" else
                                                       "Wi-Fi: not connected")
            self.tip(c, wifi_x, label)
        ui.draw_wifi(c, wifi_x, 54, ART_TEXT, bars)
        pads = self.poll.get("controllers", system.controllers, 2.0, [])
        pad_x = wifi_x - 50
        ui.draw_pad(c, pad_x, 44, ART_TEXT if (self.input.pad_count() or pads) else ART_SOFT)
        if s["show_battery"]:
            bluetooth = next((p for p in pads if p["connection"] == "Bluetooth" and p["battery"] is not None), None)
            if bluetooth is not None:
                ui.draw_battery(c, pad_x - 12, 56, bluetooth["battery"], ART_SOFT, bluetooth["charging"])
        gear_x = pad_x - 50
        if self.focus == "settings" and focus_home:
            c.circle(ART_TEXT, gear_x, 44, 22, 2)
            self.tip(c, gear_x, "Settings")
        ui.draw_gear(c, gear_x, 44, ART_TEXT)
        bell_x = gear_x - 50
        if self.focus == "notifications" and focus_home:
            c.circle(ART_TEXT, bell_x, 44, 22, 2)
            self.tip(c, bell_x, "Notifications")
        ui.draw_bell(c, bell_x, 42, ART_TEXT)
        unread = self.poll.get("unread", store.unread_notifications, 2.0, 0)
        if unread:
            c.circle(ACCENT, bell_x + 11, 32, 9)
            c.text(str(min(unread, 9)), 12, bell_x + 11, 32, WHITE, True, "center")
        if s["show_ip"]:
            addresses = self.poll.get("ip", system.ip_addresses, 10.0, [])
            if addresses:
                c.text(addresses[0][1], 15, bell_x - 34, 36, ART_SOFT, False, "topright", shadow=True)

    def tip(self, c, x, label):
        width = c.t.width(label, 14) + 24
        left = min(x - width / 2, ui.W - 16 - width)
        c.rect(DIALOG, left, 74, width, 26, 13)
        c.text(label, 14, left + width / 2, 87, WHITE, False, "center")

    def tile_shape(self, c, color, x, y, size, width=0, grow=0):
        """A filled (or outlined) tile-shaped area, `grow` units larger on each side."""
        shape = self.settings["tile_shape"]
        if shape == "circle":
            c.circle(color, x + size / 2, y + size / 2, size / 2 + grow, width)
        else:
            radius = (20 if shape == "rounded" else 4) + (grow and 5)
            c.rect(color, x - grow, y - grow, size + 2 * grow, size + 2 * grow, radius, width)

    def palette(self):
        """(vivid, deep): the colors of the Aurora light now on screen."""
        if self.settings["background"] != "art" and not self.quick:
            if self.static_bg is None:
                self.make_static_background()
            return self.static_palette
        game = self.quick_game if self.quick else self.current_game()
        if game is not None and getattr(game, "palette", None):
            return game.palette
        return ACCENT, ui.mix(ACCENT, (0, 0, 0), 0.7)

    def tile_picture(self, game, size, shape):
        """The picture of a game's tile at `size` units (None while its icon loads)."""
        if game.icon is None:
            return None
        if shape == "rounded":
            size_px = max(8, px(size) - px(size) % 4)
            key = (size_px, "aurora")
            tile = game.tiles.get(key)
            if tile is None:
                tile = ui.rounded_image(game.icon, size_px, px(20))
                game.tiles[key] = tile
            return tile
        return tile_image(game, px(size), shape)

    def draw_tiles(self, c):
        """Aurora tiles: the chosen one larger with light behind it, a border in the light's colors
        and a reflection; the others turned slightly away."""
        vivid = self.palette()[0]
        shape = self.settings["tile_shape"]
        full = self.settings["animations"] == "full"
        big, small = self.tile_big, self.tile_small
        old_clip = c.s.get_clip()
        ps5 = self.ps5_layout
        tiles_x, tiles_right = self.tiles_x, self.tiles_right
        c.s.set_clip(pygame.Rect(px(tiles_x - 40), 0, px(tiles_right - tiles_x + 40), c.s.get_height()))
        x = tiles_x - self.row_offset
        for i in range(self.items()):
            size = self.tile_sizes[i] if i < len(self.tile_sizes) else small
            # PS5: the tiles' tops line up; Aurora: their middles.
            y = self.tiles_y if ps5 else self.tiles_y + (big - size) / 2
            if x + size < tiles_x - 60 or x > tiles_right + 20:
                x += size + (TILE_GAP + 11 if i == self.selected else TILE_GAP)
                continue
            focused = i == self.selected and self.focus == "tiles" and not self.modals
            settled = abs(size - big) < 0.6
            if focused and not ps5:
                light = glow_sprite(px(big * 0.95), vivid)
                c.s.blit(light, light.get_rect(center=(px(x + size / 2), px(y + size / 2))),
                         special_flags=pygame.BLEND_RGB_ADD)
            game = self.games[i] if i < len(self.games) else None
            picture = self.tile_picture(game, size, shape) if game is not None else None
            if picture is not None:
                if not focused and abs(size - small) < 0.6 and full and not ps5:
                    key = (picture.get_width(), shape, "tilted")
                    turned = game.tiles.get(key)
                    if turned is None:
                        turned = tilted(picture, 0.12)
                        turned.set_alpha(215)
                        game.tiles[key] = turned
                    c.s.blit(turned, (px(x), px(y)))
                else:
                    c.blit(picture, x, y)
                    if focused and settled and not ps5:
                        key = (picture.get_width(), shape, "reflection")
                        mirror = game.tiles.get(key)
                        if mirror is None:
                            mirror = reflection(picture, 55)
                            game.tiles[key] = mirror
                        c.blit(mirror, x, y + size + 6)
            elif game is not None:
                self.tile_shape(c, game.color, x, y, size)
                for n, line in enumerate(c.t.wrap(game.title, 14, size - 24)[:3]):
                    c.text(line, 14, x + 12, y + 12 + n * 18, (255, 255, 255))
            elif self.tile_kind(i) == "library":
                self.tile_shape(c, TILE_BACKGROUND_COLORS["library"], x, y, size)
                draw_library_icon(c, x + size / 2, y + size / 2, size / 4.2, (255, 255, 255),
                                  TILE_BACKGROUND_COLORS["library"])
            elif self.tile_kind(i) == "browser":
                self.tile_shape(c, (36, 52, 96), x, y, size)
                ui.draw_globe(c, x + size / 2, y + size / 2, size / 4.2, (255, 255, 255), 3 if size < 130 else 4)
            elif self.tile_kind(i) == "cheats":
                self.tile_shape(c, (78, 40, 92), x, y, size)
                ui.draw_wand(c, x + size / 2, y + size / 2, size / 4.2, (255, 255, 255), 3 if size < 130 else 4)
            else:
                self.tile_shape(c, (40, 38, 48), x, y, size)
                ui.draw_power(c, x + size / 2, y + size / 2, size / 5, (255, 255, 255), 3 if size < 130 else 4)
            if game is not None:
                entry = self.entries.get(game.path, {})
                if entry.get("hidden"):
                    self.tile_shape(c, (0, 0, 0, 150), x, y, size)
                    c.text("Hidden", 13, x + size / 2, y + size / 2, (255, 255, 255), True, "center")
                if self.is_running(game):
                    label = "RUNNING"
                    width = c.t.width(label, 11, True) + 16
                    c.rect(vivid, x + size / 2 - width / 2, y + size - 30, width, 20, 10)
                    c.text(label, 11, x + size / 2, y + size - 20, (20, 16, 10), True, "center")
                elif self.settings["tile_badges"]:
                    self.draw_badge(c, game.source, x, y + size, size if shape == "circle" else None)
                if entry.get("favorite"):
                    ui.draw_star(c, x + size - 16, y + 16, 10, GOLD)
                if self.settings["show_compat_badges"] and shape != "circle":
                    self.draw_compat(c, game, x, y)
            if focused and ps5:
                # PS5: a thin light-grey line a little outside the tile; the light that crosses
                # the tile lights it up as it passes.
                live = settled and shape != "circle" and self.settings["animations"] == "full" \
                    and c.s is getattr(self, "frame", None)
                if live:
                    self.shine_tile = (x, y, size)   # draw_home draws its turning outline, frame by frame.
                else:
                    self.tile_shape(c, (205, 205, 212), x, y, size, 2, 4)
            elif focused:
                if settled and shape != "circle":
                    radius = (20 if shape == "rounded" else 4) + 5
                    border = gradient_border(px(size + 10), px(size + 10), px(radius), CHAMPAGNE, vivid,
                                             max(2, px(2.5)))
                    c.s.blit(border, (px(x - 5), px(y - 5)))
                else:
                    self.tile_shape(c, CHAMPAGNE, x, y, size, 2.5, 5)
            x += size + (TILE_GAP + 11 if i == self.selected else TILE_GAP)
        c.s.set_clip(old_clip)
        if ps5:
            # The chosen one's name under the small tiles, as on a PS5.
            label = self.tile_label()
            if label:
                # It comes in from the left and fades in with the rest of the game's info.
                a = ease_out(self.info_alpha)
                lx = self.tiles_x + self.tile_big + TILE_GAP + 11 - (1 - a) * 18
                ly = self.tiles_y + self.tile_small + 12
                alpha = int(255 * a)
                if self.current_game() is not None:
                    # As on a PS5: a white tag with the name in dark letters.
                    bw = c.t.width("PS5", 12, True) + 18
                    c.rect((255, 255, 255, alpha // 8 * 8), lx, ly + 2, bw, 20, 3)
                    badge = c.t.render("PS5", 12, (28, 28, 34), True)
                    badge.set_alpha(alpha)
                    c.blit(badge, lx + bw / 2, ly + 12, "center")
                    lx += bw + 10
                text = c.t.fit(label, 17, tiles_right - lx, True)
                shadows = ((HOME_TEXT, 0),) if LIGHT and self.ps5_layout else (((0, 0, 0), 2 / ui.S), (ART_TEXT, 0))
                for color, dx in shadows:
                    piece = c.t.render(text, 17, color, True)
                    piece.set_alpha(alpha)
                    c.blit(piece, lx + dx, ly + dx)

    def draw_halo(self, c, x, y, size, strength=1.0):
        """PS5: the chosen tile's thin outline, a little outside it, lit like a turning cone of
        light: two bright arcs and two dim ones run slowly around the tile."""
        shape = self.settings["tile_shape"]
        side = px(size + 8)
        key = ("halo", side, shape)
        parts = GLOWS.get(key)
        if parts is None:
            # The cone of light, made small and smoothed up (its colors change slowly).
            n = 96
            cone = pygame.Surface((n, n), pygame.SRCALPHA)
            for j in range(n):
                for i in range(n):
                    a = math.atan2(j - n / 2 + 0.5, i - n / 2 + 0.5)
                    lit = (math.cos(2 * a) + 1) / 2          # Bright twice around, dim between.
                    lit = lit ** 1.5
                    v = int(120 + 135 * lit)
                    cone.set_at((i, j), (v, v, v, int(70 + 185 * lit)))
            big = int(side * 1.5)
            cone = pygame.transform.smoothscale(cone, (big, big))
            radius = (20 if shape == "rounded" else 4) + 4
            ring = ui.round_mask(side, side, px(radius), max(2, px(2.5)))
            parts = GLOWS[key] = (cone, ring)
        cone, ring = parts
        turned = pygame.transform.rotate(cone, -(self.t * HALO_SPEED) % 180)
        piece = pygame.Surface((side, side), pygame.SRCALPHA)
        piece.blit(turned, ((side - turned.get_width()) // 2, (side - turned.get_height()) // 2))
        piece.blit(ring, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
        if strength < 1.0:
            piece.set_alpha(int(255 * strength))
        c.s.blit(piece, (px(x - 4), px(y - 4)))

    def draw_shine(self, c, x, y, size, shape, progress, direction=-1, strength=255):
        """PS5: a wide soft light that crosses the chosen tile once (progress 0 to 1), right to left
        (direction -1) or left to right (1)."""
        if not 0 <= progress < 1:
            return
        side = px(size)
        key = ("shine", side, shape)
        band = GLOWS.get(key)
        if band is None:
            half = side * 5 // 8                  # The light is 1 1/4 tiles wide, softest at its edges.
            stripe = pygame.Surface((half * 2, side * 2), pygame.SRCALPHA)
            stripe.blit(h_gradient(half, side * 2, (255, 255, 255, 0), (255, 255, 255, 96)), (0, 0))
            stripe.blit(pygame.transform.flip(h_gradient(half, side * 2, (255, 255, 255, 0),
                                                         (255, 255, 255, 96)), True, False), (half, 0))
            band = pygame.transform.rotate(stripe, -18)
            GLOWS[key] = band
        piece = pygame.Surface((side, side), pygame.SRCALPHA)
        travel = side + band.get_width()
        if direction > 0:
            piece.blit(band, (int(-band.get_width() + travel * ease_in_out(progress)), -band.get_height() // 4))
        else:
            piece.blit(band, (int(side - travel * ease_in_out(progress)), -band.get_height() // 4))
        if strength < 255:
            piece.set_alpha(strength)
        radius = 20 if shape == "rounded" else 4
        piece.blit(ui.round_mask(side, side, px(radius)), (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
        c.s.blit(piece, (px(x), px(y)))

    def tile_label(self):
        game = self.current_game()
        if game is not None:
            return game.title
        if self.on_library():
            return i18n.translate("Game Library")
        if self.on_browser():
            return i18n.translate("Internet")
        if self.on_cheats():
            return i18n.translate("Cheats")
        if self.on_power():
            return i18n.translate("Power")
        return ""

    def draw_compat(self, c, game, x, y):
        """Works, Slow or Doesn't work, from the tested-games list, at the tile's top left."""
        tested = compat.lookup(game.title_id, game.title)
        if tested is None:
            return
        label = compat.LABELS[tested["status"]]
        width = c.t.width(label, 11, True) + 14
        c.rect(compat.COLORS[tested["status"]], x + 6, y + 6, width, 18, 9)
        c.text(label, 11, x + 6 + width / 2, y + 15, (255, 255, 255), True, "center")

    def draw_badge(self, c, source, x, bottom, centered_in=None):
        width = c.t.width(source, 12, True) + 14
        if centered_in:
            x = x + centered_in / 2 - width / 2 - 6       # Circle tiles: at the bottom middle.
        c.rect(SOURCE_COLORS.get(source, (64, 64, 76)), x + 6, bottom - 26, width, 20, 10)
        c.text(source, 12, x + 6 + width / 2, bottom - 16, (255, 255, 255), True, "center")

    def preview(self, w, h):
        """The home screen, small (for the Appearance preview); drawn again only when something it
        shows changes."""
        key = (w, h, tuple(sorted(self.settings.data.items())), id(self.bg_current), id(self.static_bg),
               self.selected, len(self.games))
        if getattr(self, "preview_key", None) != key:
            full = pygame.Surface(self.screen.get_size()).convert()
            modals, self.modals = self.modals, []
            try:
                self.draw_home(ui.Canvas(full, self.text))
            finally:
                self.modals = modals
            small = pygame.transform.smoothscale(full, (w, h)).convert_alpha()
            small.blit(ui.round_mask(w, h, px(16)), (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
            self.preview_surface, self.preview_key = small, key
        return self.preview_surface

    def draw_glass(self, c, x, y, w, h, radius, tint=22):
        """Frosted glass: what is behind, blurred, with a light tint."""
        rect = pygame.Rect(px(x), px(y), px(w), px(h)).clip(c.s.get_rect())
        if rect.width < 4 or rect.height < 4:
            return
        # The blur is made again 8 times a second at most (the background drifts slowly).
        cache = getattr(self, "glass_cache", None)
        key = (tuple(rect), id(c.s), id(self.bg_current), id(self.static_bg))
        if cache is None or cache[0] != key or self.t - cache[1] > 0.125:
            piece = soft_blur(c.s.subsurface(rect).copy(), 10).convert_alpha()
            piece.blit(ui.round_mask(*rect.size, px(radius)), (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
            self.glass_cache = cache = (key, self.t, piece)
        c.s.blit(cache[2], rect.topleft)
        c.rect((255, 255, 255, tint), x, y, w, h, radius)

    def trophy_summary(self, game):
        """(earned, total) for a game with trophies, else None (read in the background)."""
        if not os.path.isdir(os.path.join(game.path, "sce_sys", "trophy2")):
            return None

        def read():
            _, items = system.trophies(game.path, game.title_id, self.settings["console_language"],
                                       self.profiles.current_id)
            if not items:
                return None
            grades = {g: sum(1 for t in items if t["earned"] and t["grade"] == g)
                      for g in ("platinum", "gold", "silver", "bronze")}
            return (sum(1 for t in items if t["earned"]), len(items), grades)

        return self.poll.get(("trophies", game.key, self.profiles.current_id), read, 120.0)

    def play_button(self, c, x, y, label, vivid, focused, width=None):
        """The Aurora play button: a pill from light gold to the picture's color."""
        width = width or max(160, c.t.width(label, 20, True) + 70)
        if focused and self.settings["animations"] == "full" and c.s is getattr(self, "frame", None):
            self.ring = (x, y, width, vivid)      # Breathing glow, drawn each frame by draw_home.
        key = ("button", px(width), vivid)
        pill = GLOWS.get(key)
        if pill is None:
            pill = h_gradient(px(width), px(44), CHAMPAGNE, vivid)
            pill.blit(ui.round_mask(*pill.get_size(), px(22)), (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
            GLOWS[key] = pill
        c.blit(pill, x, y)
        c.text(label, 20, x + width / 2, y + 22, (24, 16, 8), True, "center")

    def draw_info(self, c):
        """Aurora: the selected game in a glass card on the right, with a border in the light's
        colors."""
        vivid = self.palette()[0]
        a = self.info_alpha
        grow = self.settings["text_size"] / 100
        game = self.current_game()
        focused = self.focus == "tiles" and not self.modals
        lines, sub, stats, button, notes = [], "", [], None, []
        if not self.games and self.on_power():
            lines = c.t.wrap(i18n.translate("No games yet"), 30, CARD_W - 60, True)[:2]
            notes = ["Put PS5 game folders in one of these places:",
                     "  •  the PS5 folder of a USB drive",
                     f"  •  {system.PS4_GAMES_SHOWN} on the PS4, with GoldHEN FTP",
                     "  •  a shared folder on a PC (Settings, at the top)",
                     "They show up here by themselves."]
        elif self.on_library():
            lines, sub, button = [i18n.translate("Game Library")], "All your games in one place", "Open"
        elif self.on_browser():
            lines, sub, button = [i18n.translate("Internet")], "Browse the web with the controller", "Open"
        elif self.on_cheats():
            lines, sub, button = [i18n.translate("Cheats")], "Turn on cheats for your games", "Open"
        elif self.on_power():
            lines, sub, button = [i18n.translate("Power")], "Turn off or restart the PS4", "Power"
        else:
            lines = c.t.wrap(game.title, 30, CARD_W - 60, True)[:2]
            sub = game.subtitle()
            entry = self.entries.get(game.path, {})
            seconds = entry.get("play_seconds", 0)
            stats.append(("Played", system.play_time_text(seconds) if seconds >= 60 else "not played yet"))
            trophies = self.trophy_summary(game)
            if trophies:
                stats.append(("Trophies", f"{trophies[0]} / {trophies[1]}"))
            stats.append(("From", game.source))
            button = "Resume" if self.is_running(game) else "Play"
        height = 24 + 22 + len(lines) * 36 * grow + (24 * grow if sub else 0) + (16 + 38 * grow if stats else 0) \
            + (len(notes) * 20 * grow + 8) + (20 + 44 if button else 0) + 24
        x, w = CARD_X, CARD_W
        y = CARD_Y + CARD_H - height + (1 - a) * 12
        self.draw_glass(c, x, y, w, height, 24)
        border = gradient_border(px(w), px(height), px(24), CHAMPAGNE, vivid, max(1, px(1.5)))
        c.s.blit(border, (px(x), px(y)))
        tx, ty = x + 30, y + 24
        c.text(i18n.upper("Selected"), 12, tx, ty, CHAMPAGNE, True)
        ty += 22
        for line in lines:
            c.text(line, 30, tx, ty, ART_TEXT, True)
            ty += 36 * grow
        if sub:
            c.text(c.t.fit(sub, 15, w - 60), 15, tx + 2, ty + 2, ART_SOFT)
            ty += 24 * grow
        for line in notes:
            c.text(c.t.fit(line, 13, w - 60), 13, tx + 2, ty + 4, ART_SOFT)
            ty += 20 * grow
        if stats:
            ty += 16
            column = (w - 60) / len(stats)
            for n, (label, value) in enumerate(stats):
                c.text(label, 12, tx + n * column, ty, ART_SOFT)
                c.text(c.t.fit(value, 16, column - 10, True), 16, tx + n * column, ty + 16 * grow, ART_TEXT, True)
            ty += 38 * grow
        if button:
            self.play_button(c, tx, ty + 20, button, vivid, focused)

    def home_hints(self):
        if self.quick:
            return []
        back = ("ps", "Back to the game") if self.running_path else ("ps", "Quick menu")
        if self.focus == "wifi":
            return [("cross", "Wi-Fi"), (None, "Left: Settings"), ("circle", "Back")]
        if self.focus == "settings":
            around = "Left: Search  ·  Right: Profile" if self.ps5_layout else "Left: Notifications  ·  Right: Wi-Fi"
            return [("cross", "Settings"), (None, around), ("circle", "Back")]
        if self.focus == "notifications":
            return [("cross", "Notifications"), (None, "Right: Settings"), ("circle", "Back")]
        if self.focus == "search":
            return [("cross", "Search games"), (None, "Right: Settings"), ("circle", "Back")]
        if self.focus == "profile":
            return [("cross", "Profile"), (None, "Left: Settings"), ("circle", "Back")]
        if self.focus == "play":
            game = self.current_game()
            down = [(None, "Down: Media")] if self.game_media(game) else []
            return [("cross", "Open" if game is None else "Resume" if self.is_running(game) else "Play"),
                    (None, "Right: More")] + down + [(None, "Up: Games"), back]
        if self.focus == "more":
            return [("cross", "Options"), (None, "Left: Play Game"), (None, "Up: Games"), back]
        if self.focus == "media":
            return [("cross", "View"), (None, "Up: Play Game"), back]
        if self.tab == "media":
            hints = [("cross", "View")] if self.media.paths else []
            return hints + [("l1r1", "Games"), back]
        game = self.current_game()
        if self.on_browser() or self.on_cheats() or self.on_library():
            hints = [("cross", "Open")]
        elif self.on_power():
            hints = [("cross", "Select")]
        else:
            hints = [("cross", "Resume" if game is not None and self.is_running(game) else "Play")]
        if game is not None:
            hints.append(("options", "Options"))
        hints.append(("triangle", f"Search: {self.search}" if self.search else "Search"))
        if self.search:
            hints.append(("circle", "Show all games"))
        up = "Up: Search and Settings" if self.ps5_layout else "Up: Wi-Fi and Settings"
        return hints + [("l1r1", "Media"), back, (None, up)]

    def run(self):
        last = time.monotonic()
        self.input.last_input = last
        reload_requested = []
        signal.signal(signal.SIGUSR1, lambda *_: reload_requested.append(True))
        while True:
            if reload_requested and self.result is None:
                self.finish("RELOAD")       # A live update: ps5-session starts the home screen again.
            now = time.monotonic()
            dt = min(0.1, now - last)
            last = now
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    return None
                for action in self.input.handle(event, now):
                    if self.idle_warned:
                        self.idle_warned = False
                        self.toast_until = 0
                    if self.saver_on:
                        self.wake()
                        continue
                    if self.fade_out is None:
                        self.act(action)
            for action in self.input.repeats(now):
                if self.fade_out is None and not self.saver_on:
                    self.act(action)
            self.update(dt)
            self.draw()
            pygame.display.flip()
            if self.fade_out is not None and self.fade_out >= 1.0:
                return self.result
            # Each frame is drawn on the CPU, a whole core at 4K. Left alone, with no transition
            # running, fewer frames are enough (the orbs move slowly); a button brings 60 back at once.
            idle = now - self.input.last_input
            if (idle < 10 or self.input.held or self.fade_out is not None or self.bg_mix < 1.0
                    or self.info_alpha < 1.0 or any(m.appear < 1.0 for m in self.modals)):
                self.clock.tick(60)
            elif getattr(self, "shine_tile", None) is not None and self.focus == "tiles" and not self.modals \
                    and not self.quick and not self.saver_on and idle < 600:
                self.clock.tick(40)     # The chosen tile's outline turns: smooth enough at 40.
            else:
                self.clock.tick(5 if self.saver_on else 20 if idle < 60 else 10)


def main():
    parser = argparse.ArgumentParser(description="EmuFive home screen")
    parser.add_argument("--games", default=system.USB_GAMES, help="the USB drive's folder of PS5 games")
    parser.add_argument("--ps4-games", default=system.PS4_GAMES, help="the PS4 drive's folder of PS5 games")
    parser.add_argument("--pc-test", default=None, metavar="DIR",
                        help="for testing: DIR stands for the mounted PC shares (no smbnetfs)")
    parser.add_argument("--message", default=None, help="a message to show first (after an error)")
    parser.add_argument("--size", default=None, help="for testing: a window of this size, like 1920x1080")
    parser.add_argument("--windowed", action="store_true", help="a window instead of full screen")
    parser.add_argument("--dry-run-network", action="store_true",
                        help="look up Wi-Fi but never change it (for testing)")
    parser.add_argument("--quick-menu", default=None, metavar="GAME",
                        help="only the quick menu, over this paused game (from ps5-guide)")
    parser.add_argument("--suspended", default=None, metavar="GAME",
                        help="the home screen while this game waits, paused (from ps5-guide)")
    args = parser.parse_args()
    result = Home(args).run()
    pygame.quit()
    if result:
        print(result, flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
