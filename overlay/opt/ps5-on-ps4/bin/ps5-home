            rows.append(Row("info", "Fan", f"{sensors['fan']} rpm"))
        rows.append(Row("info", "CPU load", f"{sensors['load']}%" if "load" in sensors else "measuring…"))
        rows.append(Row("header", "Settings"))
        rows.append(Row("action", "Back up settings to USB", ok=lambda: h.push(Busy(
            h, "Backing up settings to the USB drive…", system.backup_settings))))
        rows.append(Row("action", "Reset all settings", ok=lambda: h.push(Dialog(
            h, "Put all settings back to their defaults? Your games, saves, play time, favorites and Wi-Fi "
