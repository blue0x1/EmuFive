# The About page (full screen): see lib/ps5/about.py.

class AboutPage(Modal):
    covers = True

    def __init__(self, home):
        super().__init__(home)
        version = system.read_first("/etc/ps5-on-ps4-release") or "unknown"
        kyty = system.read_first("/opt/kytyps5/VERSION").replace("KytyPS5 ", "").split(",")[0] or "unknown"
        self.art = about.AboutArt((version, kyty))

