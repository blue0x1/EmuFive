        h.push(Busy(h, "Backing up saves to the USB drive…", system.backup_saves))
        h.poll.forget("backups")

    def restore(self):
        h = self.home
        backups = system.save_backups()

        def pick(name):
            if name is None:
                return
            h.push(Dialog(h, f"Restore the saves from {name}? The saves on the PS4 now are kept in "
                             "~/data.before-restore.",
                          [("Restore", lambda: h.push(Busy(h, "Restoring saves…",
                                                           lambda: system.restore_saves(name)))),
                           ("Cancel", None)]))

        h.push(Picker(h, "Restore saves", [(n, n) for n in backups], None, pick))

    def rows_power(self):
        h = self.home
        minutes = h.settings["auto_off_minutes"]
        label = "Never" if not minutes else f"After {minutes} minutes" if minutes < 60 else \
            f"After {minutes // 60} hour" + ("s" if minutes >= 120 else "")
        return [
            Row("action", "Restart", ok=lambda: h.push(Dialog(h, "Restart the PS4?",
                                                              [("Restart", lambda: h.finish("REBOOT")),
                                                               ("Cancel", None)]))),
            Row("action", "Power off", ok=lambda: h.push(Dialog(h, "Turn off the PS4?",
                                                                [("Turn off", lambda: h.finish("POWEROFF")),
                                                                 ("Cancel", None)]))),
            Row("choice", "Turn off when not used", label, ok=lambda: self.cycle_off(1),
                left=lambda: self.cycle_off(-1), right=lambda: self.cycle_off(1)),
            Row("info", "Only on the home screen, never during a game."),
        ]

    def cycle_off(self, step):
        h = self.home
        options = [0, 30, 60, 120]
        current = h.settings["auto_off_minutes"]
        index = options.index(current) if current in options else 0
        h.settings.set(auto_off_minutes=options[(index + step) % len(options)])
        h.idle_warned = False
        h.sounds.play("move")

    def rows_date_and_time(self):
