import random
import signal
import sys
import threading
import time
import types
import urllib.request


def give_back_freed_memory():
    """Pictures at 4K are tens of MB each. glibc keeps memory freed by them for later instead of
    giving it back to Linux (its mmap threshold grows after the first big free), so the home
    screen grew to about 950 MB. With a fixed threshold, every block of 128 KB or more is
    returned when freed: about 170 MB less (measured on the PS4 at 4K)."""
    try:
        import ctypes
        libc = ctypes.CDLL("libc.so.6")
        libc.mallopt(-1, 128 * 1024)    # M_TRIM_THRESHOLD
        libc.mallopt(-3, 128 * 1024)    # M_MMAP_THRESHOLD (also stops it growing)
    except (OSError, AttributeError):
        pass


give_back_freed_memory()

