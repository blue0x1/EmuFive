#!/bin/sh
# Copyright (C) 2026 Chokri Hammedi (blue0x1) <https://github.com/blue0x1>
# Pairs PlayStation controllers over Bluetooth with no screens: hold SHARE + PS
# (DualShock 4) or Create + PS (DualSense) until the light bar double-blinks.
# A paired controller reconnects by itself when its PS button is pressed.
# While a controller is connected over Bluetooth, it does not search, so Wi-Fi
# (the same chip on the PS4) keeps its full speed.
NAMES='Wireless Controller'

log() { echo "ps5-pad-pair: $*"; }

bluetoothctl power on > /dev/null 2>&1

# A pairing agent that stays registered for as long as this runs. Without one,
# the controller pairs but no key is saved ("Bonded: no"), and BlueZ then
# refuses its input. It answers yes to any question.
( echo "agent NoInputNoOutput"; echo "default-agent"; while :; do sleep 2; echo yes; done ) \
    | bluetoothctl > /dev/null 2>&1 &
sleep 2

while :; do
    if bluetoothctl devices Connected 2>/dev/null | grep -q "$NAMES"; then
        sleep 10
        continue
    fi

    # Search for a few seconds, then try the controllers that showed up and are
    # not bonded yet. (BlueZ clears their signal strength when the search
    # stops, so it cannot tell which ones answered just now.)
    bluetoothctl --timeout 10 scan on > /dev/null 2>&1
    bluetoothctl devices 2>/dev/null | grep "$NAMES" | while read -r _ mac _; do
        bluetoothctl info "$mac" 2>/dev/null | grep -q "Bonded: yes" && continue
        log "found $mac, pairing"
        # Trusted first: the controller opens its input connection as soon as
        # it is paired, and an untrusted one would be asked to wait.
        bluetoothctl trust "$mac" > /dev/null 2>&1
        bluetoothctl pair "$mac" > /dev/null 2>&1
        if bluetoothctl info "$mac" 2>/dev/null | grep -q "Bonded: yes"; then
            bluetoothctl connect "$mac" > /dev/null 2>&1
            log "paired and connected $mac"
        else
            log "could not pair $mac, trying again on the next search"
            bluetoothctl remove "$mac" > /dev/null 2>&1
        fi
    done
    sleep 7
done
