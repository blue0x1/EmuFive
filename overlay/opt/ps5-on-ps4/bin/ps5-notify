#!/usr/bin/env python3
# Copyright (C) 2026 Chokri Hammedi (blue0x1) <https://github.com/blue0x1>
# A small notification in the top-right corner for a few seconds, over anything, a game too: a
# tooltip window (the window manager leaves it alone and it never takes the input focus).
#   ps5-notify TITLE [TEXT] [--picture PNG]
import argparse
import os
import sys
import time

os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
os.environ.setdefault("SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS", "0")
import pygame  # noqa: E402
from pygame._sdl2 import video  # noqa: E402

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from ps5 import i18n, store, ui  # noqa: E402


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("title")
    parser.add_argument("text", nargs="?", default="")
    parser.add_argument("--picture", default=None)
    parser.add_argument("--seconds", type=float, default=3.5)
    args = parser.parse_args()

    settings = store.Settings()
    ui.apply_theme(settings["theme"], settings["accent"])
    i18n.set_language(settings["menu_language"])
    pygame.init()
    info = pygame.display.Info()
    scale = (info.current_h or 1080) / 720
    ui.S = scale
    text = ui.Text(settings["font"], settings["text_size"] / 100)
    w, h = int(380 * scale), int(86 * scale)
    window = video.Window("PS5 on PS4", size=(w, h), position=((info.current_w or 1920) - w - int(28 * scale),
                                                               int(28 * scale)),
                          tooltip=True, always_on_top=True, skip_taskbar=True)
    renderer = video.Renderer(window)
    surface = pygame.Surface((w, h), pygame.SRCALPHA)
    c = ui.Canvas(surface, text)
    c.rect(ui.DIALOG, 0, 0, 380, 86)
    c.rect(ui.ACCENT, 0, 0, 6, 86)
    x = 24
    if args.picture and os.path.exists(args.picture):
        try:
            thumb = pygame.image.load(args.picture)
            tw = int(96 * scale)
            th = int(tw * thumb.get_height() / max(1, thumb.get_width()))
            surface.blit(pygame.transform.smoothscale(thumb, (tw, min(th, int(62 * scale)))),
                         (int(20 * scale), int(12 * scale)))
            x = 130
        except pygame.error:
            pass
    c.text(text.fit(args.title, 18, 380 - x - 20, True), 18, x, 20, ui.WHITE, True)
    if args.text:
        c.text(text.fit(args.text, 14, 380 - x - 20), 14, x, 48, ui.SOFT)
    texture = video.Texture.from_surface(renderer, surface)
    start = time.monotonic()
    while time.monotonic() - start < args.seconds:
        for _ in pygame.event.get():
            pass
        renderer.clear()
        texture.draw()
        renderer.present()
        time.sleep(0.05)
    window.destroy()
    return 0


if __name__ == "__main__":
    sys.exit(main())
