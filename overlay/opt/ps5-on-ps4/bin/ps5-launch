#!/usr/bin/env python3
# Copyright (C) 2026 Chokri Hammedi (blue0x1) <https://github.com/blue0x1>
# Runs one game in KytyPS5 (called by ps5-session) and waits for it:
#   - the profile chosen on the home screen is the game's user (name and user ID), and its own
#     KytyPS5 folder keeps its saves and trophies,
#   - the settings for all games (Settings, Games and Controller) and the game's own options
#     (OPTIONS on its tile) become KytyPS5 options,
#   - $XDG_RUNTIME_DIR/ps5-game.json says which game runs and its process (for ps5-guide),
#   - the time played is added to the game (minus the time it spent paused by the PS button),
#   - memory is watched: when memory and swap are almost used up, the game is closed before the
#     PS4 freezes, and the home screen says why.
# Exits with KytyPS5's exit code (128 + the signal when it was stopped by one).
#   ps5-launch GAME [extra KytyPS5 options...]
import json
import os
import signal
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from ps5 import store, system  # noqa: E402

KYTY = "/opt/kytyps5/kyty_emulator"
STATE = os.path.join(system.RUNTIME, "ps5-game.json")
LOW_MEMORY_MB = 160         # Memory plus swap left when the game is closed...
LOW_MEMORY_SECONDS = 3      # ...for this long.
PAUSED = os.path.join(system.RUNTIME, "ps5-game-paused")   # Seconds paused, added by ps5-guide.


def user_name(name):
    """At most 16 bytes of UTF-8, cut at a character boundary."""
    data = name.strip().encode("utf-8")[:16]
    return data.decode("utf-8", errors="ignore").strip() or "Player"


def memory_left_mb():
    """Memory that can still be had (MemAvailable) plus free swap, in MB."""
    values = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                key, _, rest = line.partition(":")
                values[key] = int(rest.split()[0])
    except (OSError, ValueError, IndexError):
        return None
    return (values.get("MemAvailable", 0) + values.get("SwapFree", 0)) // 1024


def wait_watching_memory(child):
    """Waits for the game; closes it when memory runs out. Returns (exit code, closed for memory)."""
    low_since = None
    while True:
        try:
            return child.wait(timeout=1.0), False
        except subprocess.TimeoutExpired:
            pass
        left = memory_left_mb()
        if left is None or left > LOW_MEMORY_MB:
            low_since = None
            continue
        now = time.monotonic()
        low_since = low_since or now
        if now - low_since < LOW_MEMORY_SECONDS:
            continue
        print(f"ps5-launch: only {left} MB of memory left; closing the game", flush=True)
        child.terminate()
        try:
            child.wait(timeout=5)
        except subprocess.TimeoutExpired:
            child.kill()
        # ps5-session shows the two lines after an "--- ... Error ---" line.
        print("--- Memory Error ---", flush=True)
        print("The PS4 ran out of memory, so the game was closed before the PS4 froze.", flush=True)
        print("Save often in long sessions.", flush=True)
        return child.wait(), True


def kyty_options(settings, games, game, profile):
    args = ["--user-name", user_name(profile["name"]), "--user-id", str(profile["id"]),
            "--console-language", str(settings["console_language"]),
            "--present-mode", settings["present_mode"]]
    if settings["hdr"]:
        args.append("--hdr")
    rgb = store.lightbar_rgb(settings)
    args += ["--controller-color", "#%02X%02X%02X" % rgb,
             "--controller-vibration", str(store.vibration(settings))]
    if settings["swap_buttons"]:
        args += ["--keymap", "Cross=East", "--keymap", "Circle=South"]
    return args + games.options(game.key, settings)


def main():
    if len(sys.argv) < 2:
        print("usage: ps5-launch GAME [options...]", file=sys.stderr)
        return 2
    path = sys.argv[1]
    extra = sys.argv[2:]
    game = system.Game(path)
    settings = store.Settings()
    profile = store.Profiles(settings).current()
    games = store.Games(profile["id"])
    work = store.work_dir(profile["id"])     # Saves, trophies; caches shared by all profiles.

    mounts = "/data=" + system.DATA_DIR
    if system.mounted(system.USB_MOUNT):
        mounts += ";/mnt/usb0=" + system.USB_MOUNT
    os.environ["KYTY_MOUNTS"] = mounts
    # KytyPS5 (SDL) would hide its full-screen window when the screenshot notice takes the focus.
    os.environ["SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS"] = "0"
    if settings["fps_counter"]:
        os.environ["KYTY_FPS_COUNTER"] = "1"     # Patch 0005: FPS in the bottom-left corner.
    os.makedirs(system.DATA_DIR, exist_ok=True)
    os.chdir(work)
    system.set_controller_mic(settings["controller_mic"])

    args = [KYTY, "--game", path, "--fullscreen", "--hide-cursor"] + kyty_options(settings, games, game, profile) + extra
    print("ps5-launch: " + " ".join(args), flush=True)
    try:
        os.remove(PAUSED)
    except OSError:
        pass
    started = time.monotonic()
    child = subprocess.Popen(args)
    # A stop request for the launcher goes to the game.
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda number, _frame: child.send_signal(number))
    state = {"pid": child.pid, "path": path, "title": game.title, "key": game.key}
    try:
        store.write_private(STATE, json.dumps(state) + "\n")
    except OSError:
        pass
    code, _ = wait_watching_memory(child)
    played = time.monotonic() - started
    try:
        with open(PAUSED) as f:
            played -= float(f.read().strip() or 0)
    except (OSError, ValueError):
        pass
    if played > 5:
        games.add_play_time(game.key, played)
    return 128 - code if code < 0 else code


if __name__ == "__main__":
    sys.exit(main())
